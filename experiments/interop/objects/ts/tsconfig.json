{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "solid-fuse/*": ["../../../../packages/solid-fuse/src/*"],
      "~/*": ["../../../../packages/solid-fuse/src/*"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "@solidjs/universal": ["./node_modules/@solidjs/universal"]
    }
  },
  "include": [
    "sample.ts",
    "sample-modules.ts",
    "fuse-objects.ts",
    "generated/*.ts",
    "../../../../packages/solid-fuse/src/global.d.ts"
  ]
}
