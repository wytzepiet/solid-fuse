+    final all = FuseSyncListView.buildCalls + firstCalls;
+    say('sync list: of which inside JS (render + Solid flush + drain): '
+        '${(jsMs * 1000 / all).toStringAsFixed(1)} µs per item; the rest is '
+        'the FFI hop, marshalling ~13 ops and applying them in Dart');
+
+    // Built items stay reactive: a signal write in JS updates visible rows
+    // through the ordinary async op path.
+    await settle(tester);
+    await js('__spike.tick()');
+    await settle(tester);
+    final top = (scrollable.position.pixels / extent).ceil();
+    expect(find.text('Item $top · 1'), findsOneWidget);
+
+    // Items Flutter unmounted were disposed on both sides.
+    await settle(tester, 10);
+    final liveItems = runtime.registry.liveCount('fuseItem');
+    say('sync list: after scrolling past ${FuseSyncListView.buildCalls + firstCalls} '
+        'items, $liveItems item subtrees are alive');
+    expect(liveItems, lessThan(60));
+
+    await js('__spike.unmount()');
+    await settle(tester, 10);
+    expect(runtime.registry.liveCount('fuseItem'), 0);
+  });
+
+  testWidgets('windowed virtualization: async, placeholders on a jump',
+      (tester) async {
+    const count = 10000;
+    const extent = 72.0;
+    FuseVirtualListView.placeholderBuilds = 0;
+    FuseVirtualListView.itemBuilds = 0;
+
+    await js('__spike.mountVirtual($count, $extent, 15)');
+    await tester.pumpWidget(app());
+    await settle(tester);
+    expect(find.text('Item 0 · 0'), findsOneWidget);
+    say('virtual list: after mount, ${await js('__spike.built()')} items rendered in JS, '
+        '${FuseVirtualListView.placeholderBuilds} placeholder builds');
+
+    final scrollable = tester.state<ScrollableState>(find.byType(Scrollable));
+
+    // Steady scroll well inside the overscan: JS keeps ahead, no holes.
+    FuseVirtualListView.placeholderBuilds = 0;
+    for (var f = 0; f < 60; f++) {
+      scrollable.position.jumpTo(scrollable.position.pixels + 40);
+      await tester.pump();
+      await Future<void>.delayed(const Duration(milliseconds: 4));
+    }
+    say('virtual list: 60 frames at 40 px/frame (2.4 k px/s) → '
+        '${FuseVirtualListView.placeholderBuilds} placeholder builds');
+    final slowHoles = FuseVirtualListView.placeholderBuilds;
+
+    // Fast fling: 400 px/frame outruns a 15-item overscan.
+    await settle(tester);
+    FuseVirtualListView.placeholderBuilds = 0;
+    var framesWithHoles = 0;
+    for (var f = 0; f < 60; f++) {
+      final before = FuseVirtualListView.placeholderBuilds;
+      scrollable.position.jumpTo(scrollable.position.pixels + 400);
+      await tester.pump();
+      await Future<void>.delayed(const Duration(milliseconds: 4));
+      if (FuseVirtualListView.placeholderBuilds > before) framesWithHoles++;
+    }
+    say('virtual list: 60 frames at 400 px/frame (24 k px/s) → '
+        '${FuseVirtualListView.placeholderBuilds} placeholder builds in '
+        '$framesWithHoles frames');
+
+    // A jump far outside the pool: how long until real content is on screen?
+    await settle(tester);
+    FuseVirtualListView.placeholderBuilds = 0;
+    scrollable.position.jumpTo(300000);
+    final sw = Stopwatch()..start();
+    await tester.pump();
+    final target = (300000 / extent).ceil();
+    expect(find.text('Item $target · 0'), findsNothing,
+        reason: 'the jump frame shows placeholders');
+    var frames = 1;
+    while (find.text('Item $target · 0').evaluate().isEmpty) {
+      await Future<void>.delayed(const Duration(milliseconds: 2));
+      await tester.pump();
+      frames++;
+      if (sw.elapsed > const Duration(seconds: 5)) fail('never filled');
+    }
+    say('virtual list: jump to offset 300000 → real items on screen after '
+        '${sw.elapsedMicroseconds / 1000} ms / $frames pumps '
+        '(${FuseVirtualListView.placeholderBuilds} placeholder builds)');
+    expect(slowHoles, 0);
+
+    await js('__spike.unmount()');
+    await settle(tester, 10);
+    expect(runtime.registry.liveCount('fuseItem'), 0);
+  });
+
+  testWidgets('cost of the recursive prop walk inside QuickJS', (tester) async {
+    final r = Map<String, dynamic>.from(await js('__spike.benchEncode()') as Map);
+    for (final e in r.entries) {
+      say('encodeProp  ${e.key.padRight(44)} ${(e.value as num).round().toString().padLeft(9)} ns');
+    }
+  });
+}
