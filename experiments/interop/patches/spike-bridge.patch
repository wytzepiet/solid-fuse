+/// The deadline variant: answers when the runtime is idle, gives up after
+/// its wait budget when a worker is running JS.
+#[tokio::test(flavor = "multi_thread")]
+async fn try_sync_call_waits_at_most_its_budget() {
+    let engine = engine_with(
+        "globalThis.busy = (ms) => { const t = Date.now(); while (Date.now() - t < ms) {} return 1; };
+         globalThis.quick = () => 7;",
+    )
+    .await;
+
+    // Idle runtime: behaves like call_global_sync, even with no budget.
+    let e = engine.clone();
+    let idle = on_small_thread(move || e.try_call_global_sync("quick".into(), None, 0));
+    assert!(matches!(idle.unwrap(), Some(JsValue::Integer(7))));
+
+    let bg = engine.clone();
+    let task = tokio::spawn(async move {
+        bg.eval(JsCode::Code("busy(400)".to_string()), None).await.unwrap();
+    });
+    tokio::time::sleep(Duration::from_millis(100)).await;
+
+    let e = engine.clone();
+    let (none, none_took, short, short_took) = on_small_thread(move || {
+        let t = Instant::now();
+        let a = e.try_call_global_sync("quick".into(), None, 0);
+        let a_took = t.elapsed();
+        let t = Instant::now();
+        let b = e.try_call_global_sync("quick".into(), None, 20_000);
+        (a, a_took, b, t.elapsed())
+    });
+    println!("while a worker is busy: budget 0 returned in {none_took:?}, budget 20 ms in {short_took:?}");
+    assert!(matches!(none.unwrap(), None), "expected None while busy");
+    assert!(none_took < Duration::from_millis(10));
+    assert!(matches!(short.unwrap(), None), "expected None after the budget");
+    assert!(short_took >= Duration::from_millis(20) && short_took < Duration::from_millis(80));
+
+    // A budget longer than the remaining task gets the answer.
+    let e = engine.clone();
+    let patient = on_small_thread(move || e.try_call_global_sync("quick".into(), None, 2_000_000));
+    assert!(matches!(patient.unwrap(), Some(JsValue::Integer(7))));
+
+    task.await.unwrap();
+    // Withdrawn lock requests left the runtime usable.
+    let e = engine.clone();
+    let after = on_small_thread(move || e.try_call_global_sync("quick".into(), None, 0));
+    assert!(matches!(after.unwrap(), Some(JsValue::Integer(7))));
+    engine.close().await.unwrap();
+}
