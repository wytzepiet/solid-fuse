+  handlers: Map<string, Function> | undefined = undefined;
+
+  /** Per prop name: what the last encoded value of that prop registered —
+   *  handler paths and owned slot nodes — so the next set (or a dispose) can
+   *  release exactly that. Lazily allocated; absent for plain-data props. */
+  refs: Map<string, PropRefs> | undefined = undefined;
+
+  constructor(public type: K) {}
+}
+
+export type PropRefs = {
+  /** Handler paths registered under this prop. */
+  fns: string[] | undefined;
+  /** Orphan JSX nodes owned by this prop (nested at any depth). */
+  slots: FuseNode[] | undefined;
+};
