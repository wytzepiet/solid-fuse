+
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_call_surfaces_errors() {
+    let engine = engine_with(
+        "globalThis.boom = () => { throw new TypeError('nope'); };
+         globalThis.later = async () => 1;
+         globalThis.notFn = 3;",
+    )
+    .await;
+
+    let e = engine.clone();
+    let (thrown, promise, not_fn, missing) = on_small_thread(move || {
+        (
+            e.call_global_sync("boom".into(), None),
+            e.call_global_sync("later".into(), None),
+            e.call_global_sync("notFn".into(), None),
+            e.call_global_sync("missing".into(), None),
+        )
+    });
+    assert!(thrown.unwrap_err().to_string().contains("nope"));
+    assert!(promise.unwrap_err().to_string().contains("Promise"));
+    assert!(not_fn.unwrap_err().to_string().contains("not a function"));
+    assert!(missing.unwrap_err().to_string().contains("not a function"));
