+/// Body of a synchronous call; runs with the runtime lock held, on the
+/// caller's thread.
+fn sync_call_in_ctx<'js>(
+    ctx: &rquickjs::Ctx<'js>,
+    function: &str,
+    params: Vec<JsValue>,
+    restore_stack_limit: usize,
