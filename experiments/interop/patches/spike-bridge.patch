+  /// How long [tryCallFunctionSync] may wait for the JS thread to finish
+  /// what it is doing before giving up. Long enough to ride out JS handling
+  /// an event (a callback, a dispose), short against a frame.
+  Duration syncCallWaitBudget = const Duration(milliseconds: 2);
+
+  bool _jsBusyThisFrame = false;
+
+  /// EXPERIMENTAL. As [callFunctionSync], but waits for the JS thread for at
+  /// most [syncCallWaitBudget], then returns [fuseJsBusy]
+  /// (`JsEngine.tryCallGlobalSync`). This is the variant to use from build:
+  /// a long JS task then costs a placeholder frame instead of a stalled one.
+  dynamic tryCallFunctionSync(int nodeId, String name, [dynamic value]) {
+    final engine = _connection?.channels?.engine;
+    if (engine == null) {
+      throw StateError('tryCallFunctionSync: no JS engine connected');
+    }
+    // The budget is per frame, not per call: once JS proved busy, the other
+    // callers in this frame (the rest of a list's items) get the answer at
+    // once instead of each waiting out the budget again.
+    if (_jsBusyThisFrame) return fuseJsBusy;
+    final result = engine.tryCallGlobalSync(
+      maxWaitMicros: syncCallWaitBudget.inMicroseconds,
+      function: '__fuseCallSync',
+      params: [
+        JsValue.integer(nodeId),
+        JsValue.string(name),
+        if (value != null) JsValue.from(value),
+      ],
