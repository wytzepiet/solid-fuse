+/// A sync-called function may queue promise jobs and bridge calls. They do not
+/// run inside the call; the background driver runs them afterwards.
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_call_defers_jobs_and_bridge_calls_to_the_driver() {
+    let received: Arc<Mutex<Vec<i64>>> = Arc::new(Mutex::new(Vec::new()));
+    let sink = received.clone();
+
+    let engine = JsEngine::create(None, None, None).await.unwrap();
+    engine
+        .init(move |value| {
+            let sink = sink.clone();
+            Box::pin(async move {
+                if let JsValue::Integer(n) = value {
+                    sink.lock().unwrap().push(n);
+                }
+                JsResult::Ok(JsValue::None)
+            })
+        })
+        .await
+        .unwrap();
+    engine
+        .eval(
+            JsCode::Code(
+                "globalThis.ticks = 0;
+                 globalThis.build = (i) => {
+                   Promise.resolve().then(() => { globalThis.ticks++; });
+                   fjs.bridge_call(i);
+                   return 'built ' + i + ' ticks=' + globalThis.ticks;
+                 };
+                 globalThis.getTicks = () => globalThis.ticks;"
+                    .to_string(),
+            ),
+            None,
+        )
+        .await
+        .unwrap();
+    engine.start_drive().await.unwrap();
+    let engine = Arc::new(engine);
+
+    let e = engine.clone();
+    let first = on_small_thread(move || e.call_global_sync("build".into(), Some(vec![JsValue::Integer(5)])));
+    // The microtask had not run when the function returned.
+    assert!(matches!(first.unwrap(), JsValue::String(s) if s == "built 5 ticks=0"));
+
+    // …but the driver runs it, and delivers the bridge call, shortly after.
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        let e = engine.clone();
+        let ticks = on_small_thread(move || e.call_global_sync("getTicks".into(), None)).unwrap();
+        let delivered = received.lock().unwrap().clone();
+        if matches!(ticks, JsValue::Integer(1)) && delivered == vec![5] {
+            break;
+        }
+        assert!(Instant::now() < deadline, "driver never ran the queued work");
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+    engine.close().await.unwrap();
+}
+
+/// The cost model: a sync call waits for the runtime lock. While a worker is
+/// inside a long JS task the caller is blocked for the rest of that task.
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_call_blocks_while_a_worker_runs_js() {
+    let engine = engine_with(
+        "globalThis.started = 0;
+         globalThis.busy = (ms) => { globalThis.started = 1; const t = Date.now(); while (Date.now() - t < ms) {} return 1; };
+         globalThis.quick = () => 1;",
+    )
+    .await;
+
+    let bg = engine.clone();
+    let task = tokio::spawn(async move {
+        bg.eval(JsCode::Code("busy(300)".to_string()), None).await.unwrap();
+    });
+    // Give the worker time to enter the busy loop.
+    tokio::time::sleep(Duration::from_millis(100)).await;
+
+    let e = engine.clone();
+    let waited = on_small_thread(move || {
+        let t = Instant::now();
+        e.call_global_sync("quick".into(), None).unwrap();
+        t.elapsed()
+    });
+    task.await.unwrap();
+    println!("sync call behind a 300 ms JS task waited {waited:?}");
+    assert!(
+        waited > Duration::from_millis(100),
+        "expected the sync call to wait for the busy worker, waited {waited:?}"
+    );
+    engine.close().await.unwrap();
+}
+
+/// Many threads hammering sync calls while async calls run: results stay
+/// correct (the runtime lock serialises everything).
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_calls_interleave_safely_with_async_calls() {
+    let engine = engine_with("globalThis.n = 0; globalThis.inc = () => ++globalThis.n;").await;
+    engine.start_drive().await.unwrap();
+    let done = Arc::new(AtomicUsize::new(0));
+
+    let mut threads = Vec::new();
+    for _ in 0..4 {
+        let e = engine.clone();
+        let done = done.clone();
+        threads.push(std::thread::spawn(move || {
+            for _ in 0..500 {
+                e.call_global_sync("inc".into(), None).unwrap();
+                done.fetch_add(1, Ordering::Relaxed);
+            }
+        }));
+    }
+    for _ in 0..500 {
+        engine.eval(JsCode::Code("inc()".to_string()), None).await.unwrap();
+    }
+    for t in threads {
+        t.join().unwrap();
+    }
+    let n = engine.eval(JsCode::Code("n".to_string()), None).await.unwrap();
+    assert!(matches!(n, JsValue::Integer(2500)));
+    engine.close().await.unwrap();
+}
+
+/// Not an assertion — prints per-call latency. Run with
+/// `cargo test --release sync_call_latency -- --nocapture --ignored`.
+#[tokio::test(flavor = "multi_thread")]
+#[ignore]
+async fn sync_call_latency() {
+    let engine = engine_with(
+        "globalThis.label = (i) => 'Item ' + i;
+         globalThis.row = (i) => ({ title: 'Item ' + i, subtitle: 'Row', index: i, even: i % 2 === 0 });",
+    )
+    .await;
+    engine.start_drive().await.unwrap();
+
+    for (name, n) in [("label", 20_000usize), ("row", 20_000)] {
+        let e = engine.clone();
+        let per = on_small_thread(move || {
+            for i in 0..1000 {
+                e.call_global_sync(name.into(), Some(vec![JsValue::Integer(i)])).unwrap();
+            }
+            let t = Instant::now();
+            for i in 0..n {
+                e.call_global_sync(name.into(), Some(vec![JsValue::Integer(i as i64)])).unwrap();
+            }
+            t.elapsed() / n as u32
+        });
+        println!("call_global_sync({name}): {per:?} per call");
+    }
+
+    // The async path for comparison (worker hop + promise resolution).
+    let n = 2_000u32;
+    let t = Instant::now();
+    for i in 0..n {
+        engine
+            .eval(JsCode::Code(format!("label({i})")), None)
+            .await
+            .unwrap();
+    }
+    println!("eval(label) async: {:?} per call", t.elapsed() / n);
+    engine.close().await.unwrap();
+}
