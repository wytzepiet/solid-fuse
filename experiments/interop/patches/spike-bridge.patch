+// Dart side of the recursive prop encoding (JS side: src/wire.ts,
+// src/wire.test.ts). Ops are fed straight into FuseRuntime.applyOps in the
+// exact JSON shapes the renderer emits.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+Map<String, dynamic> create(int id, String type, [Map<String, dynamic>? props]) =>
+    {'op': 'create', 'id': id, 'type': type, 'props': props ?? {}};
+Map<String, dynamic> setProp(int id, String name, dynamic value) =>
+    {'op': 'setProp', 'id': id, 'name': name, 'value': value};
+Map<String, dynamic> insert(int parent, int child, [int index = 0]) =>
+    {'op': 'insert', 'parentId': parent, 'childId': child, 'index': index};
+Map<String, dynamic> remove(int parent, int child) =>
+    {'op': 'remove', 'parentId': parent, 'childId': child};
+
+class _TestHandle extends FuseHandle<ScrollController> {
+  _TestHandle(super.node);
+  @override
+  final ScrollController object = ScrollController();
+  bool disposed = false;
+  @override
+  Future<dynamic> call(String method, dynamic value) async => null;
+  @override
+  void dispose() {
+    disposed = true;
+    object.dispose();
+  }
+}
+
+void main() {
+  late FuseRuntime rt;
+  late List<(int, String, dynamic)> calls;
+
+  setUp(() {
+    calls = [];
+    rt = FuseRuntime.forTesting(
+      onCall: (id, name, value) => calls.add((id, name, value)),
+      onCallAsync: (id, name, value) async => 'async:$name',
+      onCallSync: (id, name, value) => 'sync:$name:$value',
+    );
+    rt.registerHandle('scrollController', _TestHandle.new);
+  });
+
+  FuseNode node(int id) => rt.registry.get(id);
+  bool alive(int id) => rt.registry.tryGet(id) != null;
+
+  group('callbacks', () {
+    test('top-level {\$fn} and the legacy `true` marker both give a callback', () {
+      rt.applyOps([
+        create(1, 'gestureDetector'),
+        setProp(1, 'onTap', {r'$fn': 'onTap'}),
+        setProp(1, 'onLongPress', true),
+        setProp(1, 'enabled', false),
+      ]);
+      node(1).callback('onTap')!(7);
+      node(1).callback('onLongPress')!();
+      expect(node(1).callback('enabled'), isNull);
+      expect(node(1).callback('missing'), isNull);
+      expect(calls, [(1, 'onTap', 7), (1, 'onLongPress', null)]);
+    });
+
+    test('a real boolean true is still readable as a bool', () {
+      rt.applyOps([create(1, 'x'), setProp(1, 'enabled', true)]);
+      expect(node(1).bool('enabled'), true);
+    });
+
+    test('nested callback: map → map → fn, addressed by path', () async {
+      rt.applyOps([
+        create(1, 'lineChart'),
+        setProp(1, 'lineTouchData', {
+          'enabled': true,
+          'touchCallback': {r'$fn': 'lineTouchData/touchCallback'},
+          'tooltip': {
+            'getItems': {r'$fn': 'lineTouchData/tooltip/getItems'},
+          },
+        }),
+      ]);
+      final touch = node(1).map('lineTouchData')!;
+      expect(touch.bool('enabled'), true);
