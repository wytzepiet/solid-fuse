+
+/// Runaway recursion on a 1 MB caller thread must throw in JS, not overflow
+/// the native stack; and the worker-side budget must be back afterwards.
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_call_protects_callers_stack_and_restores_budget() {
+    let engine = engine_with(
+        "globalThis.forever = function f() { return f() + 1; };
+         globalThis.depth = function d() { try { return 1 + d(); } catch { return 1; } };",
+    )
+    .await;
+    let as_int = |v: JsValue| match v {
+        JsValue::Integer(n) => n,
+        other => panic!("expected integer, got {other:?}"),
+    };
