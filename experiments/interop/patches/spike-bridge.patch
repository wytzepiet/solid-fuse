index 0000000..6619ace
--- /dev/null
+++ b/packages/solid-fuse/dart/lib/src/fjs/libfjs/src/tests/sync_call_tests.rs
@@ -0,0 +1,303 @@
+//! # Synchronous call tests
+//!
+//! `JsEngine::call_global_sync` runs JS on the caller's thread. These tests
+//! pin down its contract: plain values only, errors surface, the caller's
+//! stack is protected, queued async work still runs (later, on a worker), and
+//! the cost model (lock contention with a busy worker).
+
+use crate::api::engine::JsEngine;
+use crate::api::error::JsResult;
+use crate::api::source::JsCode;
+use crate::api::value::JsValue;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+async fn engine_with(code: &str) -> Arc<JsEngine> {
+    let engine = JsEngine::create(None, None, None).await.unwrap();
+    engine.init_without_bridge().await.unwrap();
+    engine
+        .eval(JsCode::Code(code.to_string()), None)
+        .await
+        .unwrap();
+    Arc::new(engine)
+}
+
+/// Runs `f` on a plain OS thread with a small stack — a stand-in for the Dart
+/// UI thread, which is not one of fjs's big-stack workers.
+fn on_small_thread<R: Send + 'static>(f: impl FnOnce() -> R + Send + 'static) -> R {
+    std::thread::Builder::new()
+        .stack_size(1024 * 1024)
+        .spawn(f)
+        .unwrap()
+        .join()
+        .unwrap()
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn sync_call_returns_plain_values() {
+    let engine = engine_with(
+        "globalThis.add = (a, b) => a + b;
+         globalThis.label = (i) => ({ text: 'Item ' + i, even: i % 2 === 0 });",
+    )
+    .await;
+
+    let e = engine.clone();
+    let (sum, obj) = on_small_thread(move || {
+        (
+            e.call_global_sync(
+                "add".into(),
+                Some(vec![JsValue::Integer(3), JsValue::Integer(4)]),
+            ),
+            e.call_global_sync("label".into(), Some(vec![JsValue::Integer(2)])),
+        )
+    });
+    assert!(matches!(sum.unwrap(), JsValue::Integer(7)));
+    match obj.unwrap() {
+        JsValue::Object(map) => {
+            assert!(matches!(map.get("text"), Some(JsValue::String(s)) if s == "Item 2"));
+            assert!(matches!(map.get("even"), Some(JsValue::Boolean(true))));
+        }
+        other => panic!("expected object, got {other:?}"),
+    }
+    engine.close().await.unwrap();
