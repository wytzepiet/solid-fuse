+/// Drives `future` on the current thread until it completes or `deadline`
+/// passes (it is always polled at least once).
+pub(crate) fn block_on_until<F: std::future::Future>(
+    future: F,
+    deadline: std::time::Instant,
+) -> Option<F::Output> {
+    use std::task::{Context, Poll, Wake, Waker};
+
+    struct Unpark(std::thread::Thread);
+    impl Wake for Unpark {
+        fn wake(self: std::sync::Arc<Self>) {
+            self.0.unpark();
+        }
+    }
+
+    let waker = Waker::from(std::sync::Arc::new(Unpark(std::thread::current())));
+    let mut cx = Context::from_waker(&waker);
+    // Box::pin, not `pin!`: the macro expands to `super let`, which the frb
+    // codegen (it parses `cargo expand` output) cannot read.
+    let mut future = Box::pin(future);
+    loop {
+        if let Poll::Ready(value) = future.as_mut().poll(&mut cx) {
+            return Some(value);
+        }
+        let now = std::time::Instant::now();
+        if now >= deadline {
+            return None;
+        }
+        std::thread::park_timeout(deadline - now);
+    }
+}
