+    FuseSyncListView.buildClock.reset();
+    FuseSyncListView.buildCalls = 0;
+    final scrollable = tester.state<ScrollableState>(find.byType(Scrollable));
+    var worstFrame = Duration.zero;
+    var missing = 0;
+    for (var f = 0; f < 60; f++) {
+      scrollable.position.jumpTo(scrollable.position.pixels + 400);
+      final before = FuseSyncListView.buildClock.elapsed;
+      await tester.pump();
+      final spent = FuseSyncListView.buildClock.elapsed - before;
+      if (spent > worstFrame) worstFrame = spent;
+      // The item at the top of the viewport is present in this same frame.
+      final top = (scrollable.position.pixels / extent).ceil();
+      if (find.text('Item $top · 0').evaluate().isEmpty) missing++;
+    }
