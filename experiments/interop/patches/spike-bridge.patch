+import { beforeEach, describe, expect, test } from "bun:test";
+import { createRoot, createSignal, flush } from "solid-js";
+
+// The renderer talks to Dart through `fjs.bridge_call` and reads `__fuseHost`
+// at import time; stub both before loading it.
+const sent: any[] = [];
+(globalThis as any).fjs = { bridge_call: (m: any) => (sent.push(m), Promise.resolve()) };
+(globalThis as any).__fuseHost = { mode: "release", platform: "linux", brightness: "light" };
+
+const R = await import("./renderer");
+const { createHandle } = await import("./handle");
+const { encodeProp, MAX_DEPTH } = await import("./wire");
+const { FuseNode } = await import("./node");
+
+const dispatch = (ch: string, data: any) => (globalThis as any).__dispatch(ch, data);
+
+/** Flush and return the ops of every `_ops` message sent since last call. */
+function takeOps(): any[] {
+  R.flushOps();
+  const out = sent.filter((m) => m.channel === "_ops").flatMap((m) => m.ops);
+  sent.length = 0;
+  return out;
+}
+const setProps = (ops: any[], id: number) =>
+  ops.filter((o) => o.op === "setProp" && o.id === id);
+
+beforeEach(() => {
+  takeOps();
+});
+
+describe("encodeProp (pure)", () => {
+  test("plain data is returned by identity, no refs", () => {
+    const n = new FuseNode("x");
+    const v = { a: 1, b: [1, 2, { c: "s" }], d: null };
+    const e = encodeProp(n, "p", v);
+    expect(e.value).toBe(v);
+    expect(e.refs).toBeUndefined();
+    expect(n.handlers).toBeUndefined();
+  });
+
+  test("true stays a boolean; a function becomes {$fn}", () => {
+    const n = new FuseNode("x");
+    expect(encodeProp(n, "enabled", true).value).toBe(true);
+    expect(encodeProp(n, "onTap", () => {}).value).toEqual({ $fn: "onTap" });
+  });
+
+  test("copy-on-write: input is never mutated, untouched branches are shared", () => {
+    const n = new FuseNode("x");
+    const plain = { k: [1, 2, 3] };
+    const fn = () => {};
+    const v = { plain, deep: { cb: fn } };
+    const e = encodeProp(n, "p", v);
+    expect(v.deep.cb).toBe(fn);
+    expect(e.value).not.toBe(v);
+    expect(e.value.plain).toBe(plain);
+    expect(e.value.deep).toEqual({ cb: { $fn: "p/deep/cb" } });
+  });
+
+  test("paths: arrays index, keys with / and ~ are escaped", () => {
+    const n = new FuseNode("x");
+    const e = encodeProp(n, "items", [{ onTap: () => 1 }, { "a/b": { "c~d": () => 2 } }]);
+    expect(e.value).toEqual([
+      { onTap: { $fn: "items/0/onTap" } },
+      { "a/b": { "c~d": { $fn: "items/1/a~1b/c~0d" } } },
+    ]);
+    expect(e.refs!.fns).toEqual(["items/0/onTap", "items/1/a~1b/c~0d"]);
+    expect(n.handlers!.get("items/1/a~1b/c~0d")!()).toBe(2);
+  });
+
+  test("nodes → $node (owned), handles → $handle (borrowed)", () => {
+    const n = new FuseNode("x");
+    const icon = new FuseNode("icon");
+    const ctrl = { node: new FuseNode("scrollController"), jumpTo() {} };
+    const e = encodeProp(n, "decoration", { prefixIcon: icon, list: [icon], controller: ctrl });
+    expect(e.value).toEqual({
+      prefixIcon: { $node: icon.id },
+      list: [{ $node: icon.id }],
+      controller: { $handle: ctrl.node.id },
+    });
+    expect(e.refs!.slots).toEqual([icon, icon]);
+    // The handle's own methods are not walked into (no stray $fn).
+    expect(e.refs!.fns).toBeUndefined();
+  });
+
+  test("class instances are not walked", () => {
+    const n = new FuseNode("x");
+    const d = new Date(0);
+    const v = { when: d };
+    expect(encodeProp(n, "p", v).value).toBe(v);
+  });
+
+  test("cyclic values throw instead of overflowing the stack", () => {
+    const n = new FuseNode("x");
+    const a: any = {};
+    a.self = a;
+    expect(() => encodeProp(n, "p", a)).toThrow(String(MAX_DEPTH));
+  });
+});
+
+describe("renderer ops", () => {
+  test("top-level function prop: {$fn: name}, callable via _functionCall", async () => {
+    const el = R.createElement("gestureDetector");
+    let got: any;
+    R.setProp(el, "onTap", (v: any) => (got = v));
+    R.setProp(el, "enabled", true);
+    const ops = takeOps();
+    expect(setProps(ops, el.id).map((o) => o.value)).toEqual([{ $fn: "onTap" }, true]);
+    await dispatch("_functionCall", { nodeId: el.id, name: "onTap", value: 7 });
+    expect(got).toBe(7);
+  });
+
+  test("nested callback inside an object prop round-trips by path", async () => {
+    const el = R.createElement("lineChart");
+    const calls: any[] = [];
+    R.setProp(el, "lineTouchData", {
+      enabled: true,
