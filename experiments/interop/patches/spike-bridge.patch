+// Cost of decoding a setProp on the Dart side (FuseRuntime._decodeProp),
+// printed as `[bench]` lines. Not an assertion; JIT numbers are upper bounds.
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+void main() {
+  test('applyOps setProp: decode cost by value shape', () {
+    final rt = FuseRuntime.forTesting();
+    rt.applyOps([
+      {'op': 'create', 'id': 1, 'type': 'x', 'props': {}},
+      {'op': 'create', 'id': 2, 'type': 'icon', 'props': {}},
+      {'op': 'create', 'id': 3, 'type': 'icon', 'props': {}},
+    ]);
+
+    // Best of 7 batches.
+    double time(int n, dynamic Function() value) {
+      final per = (n / 7).ceil();
+      var best = double.infinity;
+      for (var b = 0; b < 8; b++) {
+        final ops = [
+          for (var i = 0; i < per; i++)
+            {'op': 'setProp', 'id': 1, 'name': 'p', 'value': value()},
+        ];
+        final sw = Stopwatch()..start();
+        rt.applyOps(ops);
+        final ns = sw.elapsedMicroseconds * 1000 / per;
+        if (b > 0 && ns < best) best = ns;
+      }
+      return best;
+    }
+
+    Map<String, dynamic> decoration() => {
+      'color': '#ffffff',
+      'borderRadius': 12,
+      'border': {'width': 1, 'color': '#dddddd'},
+      'boxShadow': [
+        {'color': '#00000020', 'blurRadius': 8, 'offset': {'x': 0, 'y': 2}},
+      ],
+      'gradient': {'colors': ['#fff', '#eee'], 'begin': 'topLeft', 'end': 'bottomRight'},
+    };
+    Map<String, dynamic> withRefs() => {
+      'hintText': 'Search',
+      'prefixIcon': {r'$node': 2},
+      'suffixIcon': {r'$node': 3},
+      'onClear': {r'$fn': 'p/onClear'},
+      'border': {'width': 1, 'color': '#dddddd'},
+    };
+    List<dynamic> points(int n) => [
+      for (var i = 0; i < n; i++) {'x': i, 'y': i * 0.5},
+    ];
+    final p1k = points(1000), p10k = points(10000);
+
+    final rows = <String, double>{
+      'number': time(70000, () => 12),
+      'padding {4 numbers}': time(70000, () => {'left': 16, 'right': 16, 'top': 8, 'bottom': 8}),
+      'decoration (5 nested classes)': time(35000, decoration),
+      'InputDecoration w/ 2 widgets + 1 callback': time(35000, withRefs),
+      '1,000 chart points {x,y}': time(700, () => p1k),
+      '10,000 chart points {x,y}': time(70, () => p10k),
+    };
+    for (final e in rows.entries) {
+      debugPrint('[bench] decode ${e.key.padRight(44)} ${e.value.round().toString().padLeft(9)} ns');
+    }
+  });
+}
