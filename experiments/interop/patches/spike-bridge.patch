+    let worker_after = as_int(
+        engine.eval(JsCode::Code("depth()".to_string()), None).await.unwrap(),
+    );
+    println!("max JS recursion depth: worker {worker_before}, sync {sync_depth}, worker after {worker_after}");
+    assert!(sync_depth > 100, "sync budget too small to be useful: {sync_depth}");
+    assert!(sync_depth < worker_before / 4, "sync budget was not lowered");
+    // Same budget as before the sync calls (allow jitter from frame layout).
+    assert!((worker_after - worker_before).abs() < worker_before / 20);
+    engine.close().await.unwrap();
