+    let raw_rt = unsafe { rquickjs::qjs::JS_GetRuntime(ctx.as_raw().as_ptr()) };
+    unsafe { rquickjs::qjs::JS_SetMaxStackSize(raw_rt, SYNC_CALL_STACK_SIZE as _) };
+
+    let result = (|| -> anyhow::Result<JsValue> {
+        let func: rquickjs::Value = ctx
+            .globals()
+            .get(function)
+            .catch(ctx)
+            .map_err(|e| anyhow!("Failed to read globalThis.{function}: {e}"))?;
+        let func = func
+            .as_function()
+            .ok_or_else(|| anyhow!("globalThis.{function} is not a function"))?;
+        let value: rquickjs::Value = func
+            .call((rquickjs::function::Rest(params),))
+            .catch(ctx)
+            .map_err(|e| anyhow!("{e}"))?;
+        if value.is_promise() {
