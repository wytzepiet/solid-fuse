+// EXPERIMENTAL — bridge spike (experiments/interop/reports/05-bridge.md).
+// Dart halves of src/experimental/list-builder.ts.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/scheduler.dart';
+
+import '../node.dart';
+import '../node_widget.dart';
+import '../runtime.dart';
+
+/// Registers the experimental list widgets on [runtime].
+void registerExperimentalListBuilders(FuseRuntime runtime) {
+  runtime.registerWidget('fuseItem', FuseItemHolder.new);
+  runtime.registerWidget('syncListView', FuseSyncListView.new);
+  runtime.registerWidget('virtualListView', FuseVirtualListView.new);
+}
+
+/// Container for one built item: renders whatever the JS `itemBuilder`
+/// produced (one node, several, or text).
+class FuseItemHolder extends StatelessWidget {
+  const FuseItemHolder(this.node, {super.key});
+  final FuseNode node;
+
+  @override
+  Widget build(BuildContext context) {
+    final c = node.childWidgets;
+    if (c.isEmpty) return const SizedBox.shrink();
+    if (c.length == 1) return c.first;
+    return Column(mainAxisSize: MainAxisSize.min, children: c);
+  }
+}
+
+// ── Strategy S: synchronous builder ─────────────────────────────────────────
+
+/// `ListView.builder` whose `itemBuilder` calls JS synchronously.
+class FuseSyncListView extends StatefulWidget {
+  const FuseSyncListView(this.node, {super.key});
+  final FuseNode node;
+
+  /// Wall time spent inside synchronous `buildItem` calls (JS + op apply),
+  /// and their count. Test instrumentation.
+  static final Stopwatch buildClock = Stopwatch();
+  static int buildCalls = 0;
+
+  @override
+  State<FuseSyncListView> createState() => _FuseSyncListViewState();
+}
+
+class _FuseSyncListViewState extends State<FuseSyncListView> {
+  /// Items JS has built and Flutter still has mounted, by index.
+  final Map<int, FuseNode> _built = {};
+
+  FuseNode _build(int index) {
+    final build = widget.node.syncCallback('buildItem')!;
+    FuseSyncListView.buildClock.start();
+    final node = build(index) as FuseNode;
+    FuseSyncListView.buildClock.stop();
+    FuseSyncListView.buildCalls++;
+    return node;
+  }
+
+  void _release(int index, FuseNode item) {
+    if (identical(_built[index], item)) _built.remove(index);
+    widget.node.callback('disposeItem')?.call(item.id);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final node = widget.node;
+    return ListView.builder(
+      itemCount: node.int('itemCount'),
+      itemExtent: node.double('itemExtent'),
+      itemBuilder: (context, index) {
+        final item = _built[index] ??= _build(index);
+        return _ItemLifetime(
+          key: ValueKey(index),
+          onDispose: () => _release(index, item),
+          child: FuseNodeWidget(node: item),
+        );
+      },
+    );
+  }
+}
+
+/// Reports when the list unmounts an item's element.
+class _ItemLifetime extends StatefulWidget {
+  const _ItemLifetime({super.key, required this.child, this.onInit, this.onDispose});
+  final Widget child;
+  final VoidCallback? onInit;
+  final VoidCallback? onDispose;
+
+  @override
+  State<_ItemLifetime> createState() => _ItemLifetimeState();
+}
+
+class _ItemLifetimeState extends State<_ItemLifetime> {
+  @override
+  void initState() {
+    super.initState();
+    widget.onInit?.call();
+  }
+
+  @override
+  void dispose() {
+    widget.onDispose?.call();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.child;
+}
+
+// ── Strategy B: windowed virtualization ─────────────────────────────────────
+
+/// `ListView.builder` over a JS-maintained pool of rendered items. Reports
+/// the mounted index range to JS; shows a placeholder for an index JS has
+/// not materialised yet.
+class FuseVirtualListView extends StatefulWidget {
+  const FuseVirtualListView(this.node, {super.key});
+  final FuseNode node;
+
+  /// Placeholder builds / real builds. Test instrumentation.
+  static int placeholderBuilds = 0;
+  static int itemBuilds = 0;
+
+  @override
+  State<FuseVirtualListView> createState() => _FuseVirtualListViewState();
+}
+
+class _FuseVirtualListViewState extends State<FuseVirtualListView> {
+  final Set<int> _mounted = {};
+  (int, int)? _reported;
+  bool _reportScheduled = false;
+
+  void _scheduleReport() {
+    if (_reportScheduled) return;
+    _reportScheduled = true;
+    SchedulerBinding.instance.addPostFrameCallback((_) {
+      _reportScheduled = false;
+      if (!mounted || _mounted.isEmpty) return;
+      var lo = _mounted.first, hi = lo;
+      for (final i in _mounted) {
+        if (i < lo) lo = i;
+        if (i > hi) hi = i;
+      }
+      if (_reported == (lo, hi)) return;
+      _reported = (lo, hi);
+      widget.node.callback('onRange')?.call({'first': lo, 'last': hi});
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final node = widget.node;
+    final extent = node.double('itemExtent');
+    final byIndex = <int, FuseNode>{
+      for (final c in node.children)
+        if (c.int('index') case final int i) i: c,
+    };
+    return ListView.builder(
+      itemCount: node.int('itemCount'),
+      itemExtent: extent,
+      itemBuilder: (context, index) {
+        final item = byIndex[index];
+        if (item == null) {
+          FuseVirtualListView.placeholderBuilds++;
+        } else {
+          FuseVirtualListView.itemBuilds++;
+        }
+        return _ItemLifetime(
+          key: ValueKey(index),
+          onInit: () {
+            _mounted.add(index);
+            _scheduleReport();
+          },
+          onDispose: () {
+            _mounted.remove(index);
+            _scheduleReport();
+          },
+          child: item != null
+              ? FuseNodeWidget(node: item)
+              : SizedBox(height: extent ?? 48),
+        );
+      },
+    );
+  }
+}
