@@ -0,0 +1,120 @@
+// EXPERIMENTAL — bridge spike (experiments/interop/reports/05-bridge.md).
+// Two ways to project `ListView.builder` without rendering every item up
+// front. Written against the renderer API rather than JSX so they bundle
+// with plain `bun build`; not exported from the package index.
+
+import { createMemo, createRoot, createSignal, For, onCleanup } from "solid-js";
+import {
+  FuseNode,
+  createComponent,
+  createElement,
+  effect,
+  insert,
+  ops,
+  releaseSubtree,
+  scheduleFlush,
+  setProp,
+} from "../renderer";
+
+export type ListBuilderProps = {
+  itemCount: number;
+  /** Renders the item at `index`. May read signals; the item stays reactive. */
+  itemBuilder: (index: number) => any;
+  /** Fixed main-axis extent of every item, if known. */
+  itemExtent?: number;
+};
+
+/**
+ * Strategy S — synchronous builder.
+ *
+ * Flutter's `itemBuilder(context, i)` calls JS synchronously (engine
+ * `callGlobalSync`). JS renders the item under its own reactive root into a
+ * `fuseItem` holder node and returns it; the ops that create the subtree ride
+ * back in the same call, so Dart has a real widget before `itemBuilder`
+ * returns — no placeholder frame. Dart tells JS when an item's element is
+ * unmounted, and JS disposes that root.
+ */
+export function SyncListView(props: ListBuilderProps): FuseNode {
+  const el = createElement("syncListView");
+  // Keyed by holder id, not index: Dart may drop index i and rebuild it
+  // before the (async) dispose message for the old holder is processed.
+  const roots = new Map<number, { holder: FuseNode; dispose: () => void }>();
+
+  effect(() => props.itemCount, (v) => void setProp(el, "itemCount", v));
+  effect(() => props.itemExtent, (v) => void setProp(el, "itemExtent", v));
+
+  setProp(el, "buildItem", (index: number) => {
+    const holder = createElement("fuseItem");
+    const dispose = createRoot((d) => {
+      insert(holder, () => props.itemBuilder(index));
+      return d;
+    });
+    roots.set(holder.id, { holder, dispose });
+    return holder;
+  });
+
+  const drop = (id: number) => {
+    const r = roots.get(id);
+    if (!r) return;
+    roots.delete(id);
+    r.dispose();
+    releaseSubtree(r.holder);
+    ops.push({ op: "dispose", id });
+    scheduleFlush();
+  };
+  setProp(el, "disposeItem", drop);
+  onCleanup(() => [...roots.keys()].forEach(drop));
+  return el;
+}
+
+/**
+ * Strategy B — windowed virtualization, fully asynchronous.
+ *
+ * Dart reports the range of indices it currently has mounted (Flutter's
+ * viewport plus its cache extent). JS keeps a keyed pool of rendered items
+ * for that range plus `overscan` on each side, as ordinary children of the
+ * list node. Dart's real `itemBuilder` returns the already-materialised
+ * child for an index, or a placeholder of `itemExtent` when JS has not
+ * caught up yet (a fast fling past the overscan).
+ */
+export function VirtualListView(
+  props: ListBuilderProps & { overscan?: number; initialCount?: number },
+): FuseNode {
+  const el = createElement("virtualListView");
+  const [range, setRange] = createSignal<[number, number]>(
+    [0, (props.initialCount ?? 20) - 1],
+    { equals: (a, b) => a[0] === b[0] && a[1] === b[1] },
+  );
+
+  effect(() => props.itemCount, (v) => void setProp(el, "itemCount", v));
+  effect(() => props.itemExtent, (v) => void setProp(el, "itemExtent", v));
+  setProp(el, "onRange", (r: { first: number; last: number }) =>
+    setRange([r.first, r.last]),
+  );
+
+  const indices = createMemo(() => {
+    const [first, last] = range();
+    const over = props.overscan ?? 10;
+    const lo = Math.max(0, first - over);
+    const hi = Math.min(props.itemCount - 1, last + over);
+    const out: number[] = [];
+    for (let i = lo; i <= hi; i++) out.push(i);
+    return out;
+  });
+
+  insert(
+    el,
+    createComponent(For, {
+      get each() {
+        return indices();
+      },
+      children: (index: number) => {
+        const holder = createElement("fuseItem");
+        setProp(holder, "index", index);
+        insert(holder, () => props.itemBuilder(index));
+        return holder;
+      },
+    }),
+  );
+  return el;
+}
