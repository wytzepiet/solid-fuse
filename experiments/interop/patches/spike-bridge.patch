+// Wire encoding of prop values.
+//
+// A prop value is JSON-shaped data in which three kinds of leaves cannot cross
+// the bridge as-is. `encodeProp` walks the value and replaces each with a
+// tagged single-key object, at any depth:
+//
+//   function                      → { $fn: "<path>" }     callback ref
+//   FuseNode (orphan JSX element) → { $node: <id> }       owned slot
+//   handle ({ node: FuseNode })   → { $handle: <id> }     borrowed handle
+//
+// `<path>` is the location of the function inside the node's props, joined
+// with "/" (`onTap`, `decoration/onTap`, `items/2/onTap`). It is the handler
+// key on both sides: Dart invokes `_functionCall { nodeId, name: path }`. A
+// path is stable across re-renders, so replacing a closure with a fresh one
+// (the common case for inline arrow functions) changes nothing on the wire.
+//
+// The walk is copy-on-write: a value with no refs inside is returned by
+// identity, with no allocation.
+
+import { FuseNode, type PropRefs } from "./node";
+
+/** Guard against cyclic prop values. Real props nest a handful of levels. */
+export const MAX_DEPTH = 32;
+
+export type Encoded = { value: any; refs: PropRefs | undefined };
+
+// Module-level collectors, reset per encodeProp call — avoids allocating a
+// context object for the (overwhelmingly common) prop with no refs.
+let _fns: string[] | undefined;
+let _slots: FuseNode[] | undefined;
+let _handlers: Map<string, Function> | undefined;
+// Path of the value being visited, as a key stack. The string form is only
+// built when a function is actually found, so walking plain data (a chart's
+// 10k points) concatenates nothing.
+const _stack: (string | number)[] = [];
+
+/**
+ * Encode one prop value of `node`. Registers nested functions into
+ * `node.handlers` under their path and returns the wire value plus what was
+ * registered (undefined when the value holds no functions or slot nodes).
+ */
+export function encodeProp(node: FuseNode, name: string, value: any): Encoded {
+  // Fast path: primitives are ~all setProps (numbers, strings, booleans).
+  if (value === null || typeof value !== "object" && typeof value !== "function") {
+    return { value, refs: undefined };
+  }
+  _fns = undefined;
+  _slots = undefined;
+  _handlers = node.handlers;
+  _stack.length = 0;
+  _stack.push(name);
+  let wire: any;
+  try {
+    wire = walk(value, 0);
+  } catch (e) {
+    _fns = _slots = _handlers = undefined;
+    throw e;
+  }
+  if (_handlers !== node.handlers) node.handlers = _handlers;
+  const refs = _fns || _slots ? { fns: _fns, slots: _slots } : undefined;
+  _fns = _slots = _handlers = undefined;
+  return { value: wire, refs };
+}
+
+function seg(key: string): string {
+  return key.indexOf("/") < 0 && key.indexOf("~") < 0
+    ? key
+    : key.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function currentPath(): string {
+  let p = seg(String(_stack[0]));
+  for (let i = 1; i < _stack.length; i++) {
+    const k = _stack[i];
+    p += "/" + (typeof k === "number" ? k : seg(k));
+  }
+  return p;
+}
+
+function walk(v: any, depth: number): any {
+  const t = typeof v;
+  if (t === "function") {
+    const path = currentPath();
+    (_handlers ??= new Map()).set(path, v);
+    (_fns ??= []).push(path);
+    return { $fn: path };
+  }
+  if (t !== "object" || v === null) return v;
+  if (v instanceof FuseNode) {
+    (_slots ??= []).push(v);
+    return { $node: v.id };
+  }
+  if (depth >= MAX_DEPTH) {
+    throw new Error(
+      `[solid-fuse] prop "${currentPath()}" nests deeper than ${MAX_DEPTH} levels (cyclic value?)`,
+    );
+  }
+  if (Array.isArray(v)) {
+    let out: any[] | undefined;
+    for (let i = 0; i < v.length; i++) {
+      const el = v[i];
+      // Inline the primitive check: big numeric arrays stay a tight loop.
+      if (el === null || typeof el !== "object" && typeof el !== "function") continue;
+      _stack.push(i);
+      const enc = walk(el, depth + 1);
+      _stack.pop();
+      if (enc !== el) (out ??= v.slice())[i] = enc;
+    }
+    return out ?? v;
+  }
+  // A handle: any object carrying its node in `.node` (see handle.ts).
+  if (v.node instanceof FuseNode) return { $handle: v.node.id };
+  // Only plain objects are walked; class instances (Date, Map, typed arrays…)
+  // are left for the marshaller, as before.
+  const proto = Object.getPrototypeOf(v);
+  if (proto !== Object.prototype && proto !== null) return v;
+  let out: Record<string, any> | undefined;
+  for (const k in v) {
+    const el = v[k];
+    if (el === null || typeof el !== "object" && typeof el !== "function") continue;
+    _stack.push(k);
+    const enc = walk(el, depth + 1);
+    _stack.pop();
+    if (enc !== el) (out ??= { ...v })[k] = enc;
+  }
+  return out ?? v;
+}
