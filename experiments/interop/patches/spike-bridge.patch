+    let worker_before = as_int(
+        engine.eval(JsCode::Code("depth()".to_string()), None).await.unwrap(),
+    );
+
+    let e = engine.clone();
+    let (runaway, sync_depth) = on_small_thread(move || {
+        (
+            e.call_global_sync("forever".into(), None),
+            e.call_global_sync("depth".into(), None),
+        )
+    });
+    let msg = runaway.unwrap_err().to_string();
+    assert!(
+        msg.to_lowercase().contains("stack"),
+        "expected a JS stack overflow error, got: {msg}"
+    );
+    let sync_depth = as_int(sync_depth.unwrap());
