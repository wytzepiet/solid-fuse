+// Bridge spike (experiments/interop/reports/05-bridge.md): the real renderer
+// running in QuickJS against a real FuseRuntime and real Flutter widgets.
+//
+//   xvfb-run -a flutter test integration_test/bridge_spike_test.dart -d linux
+//
+// Measures (and prints, prefixed `[spike]`):
+//   - raw synchronous Dart → JS call latency vs the async paths
+//   - what a synchronous call costs when the JS thread is busy
+//   - a ListView.builder whose itemBuilder calls JS synchronously
+//   - the asynchronous alternative: windowed virtualization with placeholders
+//   - the recursive prop-encoding walk inside QuickJS
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:solid_fuse/fjs.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+import 'package:solid_fuse/src/experimental/list_builder.dart';
+
+class _EngineConnection extends FuseConnection {
+  _EngineConnection(this.result);
+  final EngineResult result;
+  @override
+  FuseChannels? get channels => result.channels;
+  @override
+  bool get isConnected => true;
+  @override
+  Future<void> connect() async {}
+  @override
+  Future<void> start() async {}
+  @override
+  Future<void> restart() async {}
+  @override
+  void dispose() {}
+}
+
+void say(String s) => debugPrint('[spike] $s');
+
+String us(Duration d, int n) =>
+    '${(d.inMicroseconds / n).toStringAsFixed(1)} µs';
+
+void main() {
+  final binding = IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+  binding.framePolicy = LiveTestWidgetsFlutterBindingFramePolicy.fullyLive;
+
+  late FuseRuntime runtime;
+  late EngineResult eng;
+  FuseNode? probe;
+
+  Future<dynamic> js(String code) async =>
+      (await eng.engine.eval(source: JsCode.code(code))).value;
+
+  setUpAll(() async {
+    runtime = await FuseRuntime.create();
+    registerSolidFuse(runtime);
+    registerExperimentalListBuilders(runtime);
+    runtime.registerWidget('syncProbe', (n) {
+      probe = n;
+      return const SizedBox.shrink();
+    });
+    eng = await createEngine();
+    runtime.connectForTesting(_EngineConnection(eng));
+    final bundle = await rootBundle.loadString('assets/bridge_spike.js');
+    await eng.engine.eval(source: JsCode.code(bundle));
+  });
+
+  tearDownAll(() async {
+    await retireEngine(eng.engine, eng.wsManager, eng.brightnessObserver);
+  });
+
+  Widget app() => MaterialApp(
+    home: Scaffold(body: FuseView(runtime: runtime)),
+  );
+
+  /// Let JS (another thread) and the bridge make progress, then build frames.
+  Future<void> settle(WidgetTester tester, [int rounds = 6]) async {
+    for (var i = 0; i < rounds; i++) {
+      await Future<void>.delayed(const Duration(milliseconds: 8));
+      await tester.pump();
+    }
+  }
+
+  testWidgets('raw latency: callGlobalSync vs async paths', (tester) async {
+    final engine = eng.engine;
+    // Best of 10 batches of 500: the machine is shared and noisy.
+    String sync(String fn) {
+      var best = const Duration(days: 1);
+      for (var b = 0; b < 11; b++) {
+        final sw = Stopwatch()..start();
+        for (var i = 0; i < 500; i++) {
+          engine.callGlobalSync(function: fn, params: [JsValue.integer(i)]);
+        }
+        if (b > 0 && sw.elapsed < best) best = sw.elapsed;
+      }
+      return us(best, 500);
+    }
+
+    expect(
+      engine.callGlobalSync(
+        function: '__spikeLabel',
+        params: [const JsValue.integer(7)],
+      ).value,
+      'Item 7',
+    );
+    say('callGlobalSync int → string:          ${sync('__spikeLabel')} per call');
+    say('callGlobalSync int → 4-field object:  ${sync('__spikeRow')} per call');
+
+    // Async baselines: awaited one at a time, as a builder would have to.
+    const m = 1000;
+    var sw = Stopwatch()..start();
+    for (var i = 0; i < m; i++) {
+      await engine.call(
+        module: '__fuse_dispatch',
+        method: 'dispatch',
+        params: [const JsValue.string('_spikeLabel'), JsValue.from({'i': i})],
+      );
+    }
