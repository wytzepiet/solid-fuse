+    sw = Stopwatch()..start();
+    await Future.wait([
+      for (var i = 0; i < m; i++)
+        engine.call(
+          module: '__fuse_dispatch',
+          method: 'dispatch',
+          params: [const JsValue.string('_spikeLabel'), JsValue.from({'i': i})],
+        ),
+    ]);
+    say('channels.call (async, 1000 batched):  ${us(sw.elapsed, m)} per call');
+  });
+
+  testWidgets('a sync call waits for a busy JS thread', (tester) async {
+    final engine = eng.engine;
+    for (final ms in [50, 200]) {
+      // The eval reaches the JS worker within a few ms; give it a head start
+      // so the sync call below finds the runtime lock held.
+      final busy = engine.eval(source: JsCode.code('__spike.busy($ms)'));
+      await Future<void>.delayed(const Duration(milliseconds: 25));
+      final sw = Stopwatch()..start();
+      engine.callGlobalSync(
+        function: '__spikeLabel',
+        params: [const JsValue.integer(1)],
+      );
+      final waited = sw.elapsed;
+      await busy;
+      say('sync call issued ~25 ms into a $ms ms JS task blocked the UI '
+          'thread for ${waited.inMilliseconds} ms');
+      if (ms == 200) expect(waited.inMilliseconds, greaterThan(50));
+    }
+  });
+
+  testWidgets('value-returning callbacks: validator and nested formatter',
+      (tester) async {
+    await js('__spike.mountCallbacks()');
+    await tester.pumpWidget(app());
+    await settle(tester);
+    final node = probe!;
+
+    final validator = node.syncCallback('validator')!;
+    expect(validator('ab'), 'Too short');
+    expect(validator('abcd'), isNull);
+
+    // Nested: axis.getTitle lives one level down in an object prop.
+    final getTitle = node.map('axis')!.syncCallback('getTitle')!;
+    expect(getTitle(2.5), '2.5 kg');
+
+    const n = 5000;
+    final sw = Stopwatch()..start();
+    for (var i = 0; i < n; i++) {
+      getTitle(i * 0.5);
+    }
+    say('node.map("axis").syncCallback("getTitle") end to end: '
+        '${us(sw.elapsed, n)} per call');
+
+    // Errors surface as Dart exceptions, not hangs.
+    await js('__spike.unmount()');
+    await settle(tester);
+  });
+
+  testWidgets('ListView.builder with a synchronous JS itemBuilder',
+      (tester) async {
+    const count = 10000;
+    const extent = 72.0;
+    FuseSyncListView.buildClock.reset();
+    FuseSyncListView.buildCalls = 0;
+
+    await js('__spike.mountSync($count, $extent)');
+    await tester.pumpWidget(app());
+    await settle(tester);
+
+    // Items are real widgets in the very frame that asked for them.
+    expect(find.text('Item 0 · 0'), findsOneWidget);
+    expect(find.text('Row number 3'), findsOneWidget);
+    final firstCalls = FuseSyncListView.buildCalls;
+    say('sync list: first frame built $firstCalls items in '
+        '${FuseSyncListView.buildClock.elapsedMicroseconds / 1000} ms '
+        '(${us(FuseSyncListView.buildClock.elapsed, firstCalls)} per item: '
+        'JS render + ops + Dart apply)');
