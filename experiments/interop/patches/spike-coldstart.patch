diff --git a/packages/solid-fuse/cli/prerender-worker.ts b/packages/solid-fuse/cli/prerender-worker.ts
new file mode 100644
index 0000000..d9ab1fc
--- /dev/null
+++ b/packages/solid-fuse/cli/prerender-worker.ts
@@ -0,0 +1,48 @@
+// Runs a built app bundle (the IIFE `fuse build` writes) with a stub bridge
+// and prints the op batches of its first render as one JSON batch.
+// Spawned by cli/prerender.ts; experimental (REPORT-13-cold-start.md).
+//
+//   bun prerender-worker.ts <bundle.js> <host.json>
+//
+// The bundle runs under Bun (JavaScriptCore), not QuickJS: anything whose
+// output differs between the two engines would differ from what the device
+// renders. No network: `fetch` never settles. Channel calls to Dart resolve to
+// undefined, so a first screen that needs an answer from Dart (stored auth,
+// preferences) renders its "no answer yet" state.
+import { readFileSync } from "fs";
+
+const [bundlePath, hostJson] = process.argv.slice(2);
+const g = globalThis as any;
+const write = (s: string) => process.stdout.write(s);
+const batches: any[][] = [];
+let structured = 0;
+const calls: string[] = [];
+
+g.fjs = {
+  bridge_call(msg: any) {
+    if (msg && msg.channel === "_ops") {
+      if (typeof msg.json === "string") batches.push(JSON.parse(msg.json));
+      else structured++;
+    } else if (msg && typeof msg.channel === "string" && msg.channel !== "_log") {
+      calls.push(msg.channel);
+    }
+    return Promise.resolve(undefined);
+  },
+};
+g.__fuseHost = JSON.parse(hostJson);
+g.fetch = () => new Promise(() => {});
+
+(0, eval)(readFileSync(bundlePath, "utf8"));
+// Microtask-scheduled flushes, and one macrotask turn.
+await new Promise((r) => setTimeout(r, 0));
+
+// The journal is flat (opcode, operands, ...), so batches concatenate.
+const ops = ([] as any[]).concat(...batches);
+const ARITY = [4, 3, 4, 3, 4, 3, 2, 3, 4];
+let count = 0, creates = 0;
+for (let i = 0; i < ops.length; i += ARITY[ops[i]]) {
+  count++;
+  if (ops[i] === 0 || ops[i] === 1) creates++;
+}
+write(JSON.stringify({ json: JSON.stringify(ops), ops: count, nodes: creates, batches: batches.length, structured, calls }));
+process.exit(0);
diff --git a/packages/solid-fuse/cli/prerender.ts b/packages/solid-fuse/cli/prerender.ts
new file mode 100644
index 0000000..38282a1
--- /dev/null
+++ b/packages/solid-fuse/cli/prerender.ts
@@ -0,0 +1,58 @@
+import { spawnSync } from "child_process";
+import { writeFileSync } from "fs";
+import { join } from "path";
+
+export interface PrerenderHost {
+  mode: "release" | "profile" | "debug";
+  platform: string;
+  brightness: "light" | "dark";
+}
+
+export interface PrerenderResult {
+  /** The first screen as one op batch (the renderer's journal as JSON text). */
+  json: string;
+  ops: number;
+  nodes: number;
+  /** `_ops` messages the bundle sent before it settled. */
+  batches: number;
+  /** Batches that held a value JSON cannot carry; those cannot be prerendered. */
+  structured: number;
+  /** Channels the bundle used while rendering (Dart was not there to answer). */
+  calls: string[];
+}
+
+/**
+ * Experimental (examples/perf_bench/REPORT-13-cold-start.md): run a built app
+ * bundle at build time and capture the op batch of its first screen, to ship
+ * as an asset that Dart applies before the JS engine has started
+ * (`FuseRuntime.applyPrerendered`).
+ *
+ * `host` is what the bundle sees as `host.platform` / `host.brightness()`: a
+ * build-time guess of facts that are only known on the device.
+ */
+export function prerenderBundle(
+  bundlePath: string,
+  host: PrerenderHost = { mode: "release", platform: "android", brightness: "light" },
+): PrerenderResult {
+  const worker = join(import.meta.dirname, "prerender-worker.ts");
+  const r = spawnSync("bun", [worker, bundlePath, JSON.stringify(host)], {
+    encoding: "utf-8",
+    maxBuffer: 256 * 1024 * 1024,
+    timeout: 60_000,
+  });
+  if (r.status !== 0) {
+    throw new Error(`[fuse] prerender failed (${r.status}):\n${r.stderr || r.stdout}`);
+  }
+  const out = JSON.parse(r.stdout) as PrerenderResult;
+  if (out.structured > 0) {
+    throw new Error("[fuse] prerender: the first screen sends a value JSON cannot carry (Date, bytes, NaN); not prerendered");
+  }
+  return out;
+}
+
+/** Prerender `bundlePath` and write `prerender.json` next to it. */
+export function writePrerender(bundlePath: string, outPath: string, host?: PrerenderHost): PrerenderResult {
+  const out = prerenderBundle(bundlePath, host);
+  writeFileSync(outPath, out.json);
+  return out;
+}
