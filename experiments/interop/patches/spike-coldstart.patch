new file mode 100644
index 0000000..e0fb115
--- /dev/null
+++ b/examples/perf_bench/tools/cold-agg.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Aggregates COLD lines of tools/cold.sh (REPORT-13-cold-start.md).
+
+  tools/cold-agg.py [--md] label=file [label=file ...]
+
+Per file: n, and median (min-max) in ms of the spans below. All spans are on
+the Dart Timeline clock; "proc" is the launcher's wall clock mapped onto it.
+"""
+import json, statistics, sys
+
+def load(path):
+    rows = []
+    for line in open(path):
+        if line.startswith("COLD {"):
+            rows.append(json.loads(line[5:]))
+    return rows
+
+def span(r, a, b):
+    m = r["marks"]
+    if a == "proc":
+        return m.get(b)
+    if a in m and b in m:
+        return m[b] - m[a]
+    return None
+
+SPANS = [
+    ("proc→main", "proc", "main"),
+    ("initFjs", "initFjs0", "initFjs1"),
+    ("engine create", "engineCreate0", "engineCreate1"),
+    ("engine init", "engineCreate1", "engineInit1"),
+    ("seed+shim+drive", "engineInit1", "engineReady"),
+    ("read source", "sourceRead0", "sourceRead1"),
+    ("sha256", "sourceRead1", "hash1"),
+    ("cache dir+read", "hash1", "cacheLoad1"),
+    ("compile+write", "cacheLoad1", "compile1"),
+    ("read bc asset", "bcAssetRead0", "bcAssetRead1"),
+    ("eval (to Dart)", "eval0", "eval1"),
+    ("eval0→ops recv", "eval0", "firstOpsRecv"),
+    ("decode+apply", "firstOpsRecv", "firstOpsApplied"),
+    ("pre read", "preRead0", "preRead1"),
+    ("pre apply", "preRead1", "preApplied"),
+    ("main→runApp", "main", "runApp"),
+    ("runApp→frame0", "runApp", "contentFrame0"),
+    ("content frame", "contentFrame0", "contentFrame1"),
+    ("main→js ready", "main", "jsReady"),
+    ("main→content", "main", "contentFrame1"),
+    ("main→tap applied", "main", "tapApplied"),
+    ("proc→content", "proc", "contentFrame1"),
+    ("proc→js ready", "proc", "jsReady"),
+    ("proc→tap applied", "proc", "tapApplied"),
+]
+
+def fmt(vals):
+    vals = [v for v in vals if v is not None]
+    if not vals:
+        return ""
+    med = statistics.median(vals)
+    d = 2 if med < 10 else 1 if med < 100 else 0
+    return f"{med:.{d}f} ({min(vals):.{d}f}–{max(vals):.{d}f})"
+
+def main():
+    args = [a for a in sys.argv[1:] if a != "--md"]
+    cols = []
+    for a in args:
+        label, path = a.split("=", 1)
+        cols.append((label, load(path)))
+    print("| span (ms) | " + " | ".join(l for l, _ in cols) + " |")
+    print("|---|" + "---:|" * len(cols))
+    print("| n | " + " | ".join(str(len(r)) for _, r in cols) + " |")
+    for name, a, b in SPANS:
+        cells = [fmt([span(r, a, b) for r in rows]) for _, rows in cols]
+        if any(cells):
+            print(f"| {name} | " + " | ".join(cells) + " |")
+    def extra(name, fn):
+        cells = [fmt([fn(r) for r in rows]) for _, rows in cols]
+        if any(cells):
+            print(f"| {name} | " + " | ".join(cells) + " |")
+    extra("proc→raster done*", lambda r: r.get("ft", {}).get("rasterFinish"))
+    extra("frame after takeover", lambda r: next((f[1] for f in r["uiFrames"] if "takeover1" in r["marks"] and f[0] >= r["marks"]["takeover1"] - 0.01), None))
+    for key in ("takeoverResult", "textAfter"):
+        cells = [",".join(sorted({str(r.get(key)) for r in rows})) for _, rows in cols]
+        print(f"| {key} | " + " | ".join(cells) + " |")
+    cells = [",".join(sorted({str(r["info"].get("path")) for r in rows})) for _, rows in cols]
+    print("| bundle path | " + " | ".join(cells) + " |")
+    cells = [f'{min(float(r["load"]) for r in rows):.2f}–{max(float(r["load"]) for r in rows):.2f}' if rows else "" for _, rows in cols]
+    print("| load avg | " + " | ".join(cells) + " |")
+
+main()
