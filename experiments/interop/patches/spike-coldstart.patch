@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Vite/Rolldown settings against bundle size and engine start-up, in the Rust harness
+# (real engine, no Flutter): REPORT-13-cold-start.md.
+#   HARNESS=<fjs test binary> tools/cold-vite.sh <reps> <out-file>
+# For every variant: builds the bundle, compiles it to bytecode with the harness, then
+# <reps> fresh processes each for: evaluate source, compile + load (first launch today),
+# load bytecode with fjs's validation pass, load bytecode without it.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+: "${HARNESS:?set HARNESS to the fjs test binary}"
+reps=${1:-20}; out=${2:-results/r13/vite.txt}
+mkdir -p build-cold/vite "$(dirname "$out")"
+# name | entry | COLD_NODES | COLD_VITE json
+variants=(
+  'small|small|0|{}'
+  'small-minify|small|0|{"build":{"minify":true}}'
+  'small-esnext|small|0|{"build":{"target":"esnext"}}'
+  'small-minify-esnext|small|0|{"build":{"minify":true,"target":"esnext"}}'
+  'small-no-treeshake|small|0|{"build":{"rollupOptions":{"treeshake":false}}}'
+  'small-treeshake-no-side-effects|small|0|{"build":{"rollupOptions":{"treeshake":{"moduleSideEffects":false}}}}'
+  'small-icons|small-icons|0|{}'
+  'bench200|index|200|{}'
+  'bench200-minify|index|200|{"build":{"minify":true}}'
+  'bench200-minify-esnext|index|200|{"build":{"minify":true,"target":"esnext"}}'
+  'bench1000|index|1000|{}'
+)
+: > "$out"
+echo "# $(date -Is) reps=$reps loadavg=$(cut -d' ' -f1-3 /proc/loadavg)" >> "$out"
+for row in "${variants[@]}"; do
+  IFS='|' read -r name entry nodes vite <<< "$row"
+  js=$PWD/build-cold/vite/$name.js; bc=$PWD/build-cold/vite/$name.bc
+  if ! COLD_ENTRY=$entry COLD_NODES=$nodes COLD_VITE=$vite bun fuse build --js-only > build-cold/vite/$name.log 2>&1; then
+    echo "VITE {\"name\":\"$name\",\"error\":\"build failed\"}" >> "$out"; continue
+  fi
+  cp dart/assets/js/bundle.js "$js"
+  FJS_COLD_MODE=compile FJS_COLD_BUNDLE=$js FJS_COLD_BC=$bc "$HARNESS" cold_harness --ignored --nocapture >/dev/null 2>&1 || true
+  echo "VITE {\"name\":\"$name\",\"vite\":$vite,\"jsBytes\":$(stat -c %s "$js"),\"gzBytes\":$(gzip -9c "$js" | wc -c),\"bcBytes\":$(stat -c %s "$bc" 2>/dev/null || echo 0),\"bcGzBytes\":$(gzip -9c "$bc" 2>/dev/null | wc -c)}" >> "$out"
+  for kind in source compile bytecode bytecode-novalidate; do
+    for ((i = 0; i < reps; i++)); do
+      FJS_COLD_BUNDLE=$js FJS_COLD_BC=$bc FJS_COLD_EVAL=$kind nice -n "${NICE:-0}" "$HARNESS" cold_harness --ignored --nocapture 2>&1 \
+        | grep -E '^COLD |panicked|Error' | sed "s/^COLD {/COLD {\"name\":\"$name\",/" >> "$out" || true
+    done
+  done
+done
+echo "# end $(date -Is) loadavg=$(cut -d' ' -f1-3 /proc/loadavg)" >> "$out"
+bun fuse build --js-only >/dev/null
