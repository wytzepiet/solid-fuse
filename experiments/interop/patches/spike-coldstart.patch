+// Cold-start screens (REPORT-13-cold-start.md). The first screen is fixed at
+// build time by the `__COLD_NODES__` define (0 = the bench app's empty screen),
+// because a first screen that is to be prerendered at build time cannot depend
+// on anything Dart says at launch.
+import { View, Text, ScrollView, GestureDetector, For } from "solid-fuse";
+import { createSignal } from "solid-js";
+import { Card, cardsFor } from "./screens";
+
+declare const __COLD_NODES__: number;
+declare const __COLD_GREETING__: string;
+export const COLD_NODES: number = typeof __COLD_NODES__ === "number" ? __COLD_NODES__ : 0;
+/** A value that can differ between the build-time render and the device ("data that differs from the snapshot"). */
+const GREETING: string = typeof __COLD_GREETING__ === "string" ? __COLD_GREETING__ : "Hello";
+
+/** Timing mark; a no-op unless the bundle went through tools/mark-bundle.py. */
+export const coldMark = (name: string) => (globalThis as any).__fuseMark?.(name);
+
+const [taps, setTaps] = createSignal(0);
+
+/** Header (tap counter, 6 nodes) plus cards of 11 nodes each. */
+export function ColdScreen(p: { nodes: number }) {
+  const items = Array.from({ length: cardsFor(p.nodes - 6) }, (_, i) => i);
+  return (
+    <ScrollView>
+      <View padding={16}>
+        <GestureDetector onTap={() => setTaps(taps() + 1)}>
+          <View padding={12} decoration={{ color: "#e8f0ff", borderRadius: 8 }}>
+            <Text fontSize={16}>{`${GREETING}. Taps: ${taps()}`}</Text>
+          </View>
+        </GestureDetector>
+        <For each={items}>{(i) => <Card i={i} />}</For>
+      </View>
+    </ScrollView>
+  );
+}
