+  test('hydrate: a structural difference falls back to a remount', () {
+    rt.applyPrerendered(jsonEncode(screen()));
+    final old = node(1);
+    live(screen(extra: true));
+    expect(rt.takeoverResult, 'remounted');
+    expect(node(1), isNot(same(old)));
+    expect(node(1).children.map((c) => c.id), [2, 5, 7]);
+    expect(node(0).children.single, same(node(1)));
+  });
+
+  test('hydrate: fewer live nodes than prerendered falls back to a remount (no stale nodes)', () {
+    rt.applyPrerendered(jsonEncode(screen(extra: true)));
+    live(screen());
+    expect(rt.takeoverResult, 'remounted');
+    expect(rt.registry.tryGet(7), isNull);
+    expect(node(1).children.map((c) => c.id), [2, 5]);
+  });
