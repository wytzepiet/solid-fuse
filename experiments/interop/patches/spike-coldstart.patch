+/**
+ * Experimental (examples/perf_bench/REPORT-13-cold-start.md): one instance of
+ * a subtree that was rendered at build time. Its shape is not in the bundle:
+ * Dart has it under `key` (`FuseRuntime.registerBaked`, from the `baked.json`
+ * asset the build wrote). Emitted by the `*.baked.tsx` build plugin; `size`
+ * is the node count of the subtree, whose ids are reserved here.
+ */
+export function _baked(key: string, type: string, size: number): FuseNode {
+  const node = new FuseNode(type);
+  nextId += size - 1;
+  ops.push(OP_CLONE, key, node.id, NO_VALUES);
+  opCount++;
+  return node;
+}
+const NO_VALUES: any[] = [];
+
