@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Adds timing marks to a built bundle (REPORT-13-cold-start.md); measurement only.
+
+  tools/mark-bundle.py <bundle.js> <out.js>
+
+The unminified IIFE Vite writes has one `// <module path>` comment line in
+front of each module's top-level statements. A `__fuseMark("<path>")` call is
+put in front of each, one at the end, and `fjs.bridge_call` is wrapped so the
+first `_ops` send is bracketed. `globalThis.__fuseMarks` then holds
+[name, performance.now(), name, ...]: the time between two marks is the
+top-level evaluation of the module named by the first. The app's entry calls
+`__fuseMark("render0"/"render1")` around render() itself (src/cold.tsx).
+"""
+import re, sys
+
+src = open(sys.argv[1]).read().split("\n")
+assert src[0].startswith("(function"), "expected the IIFE bundle of fuse build"
+prelude = (
+    "\tglobalThis.__fuseMarks = [];"
+    "var __fuseNow = typeof performance !== 'undefined' && performance.now ? function() { return performance.now(); } : Date.now;"
+    "var __fuseMark = globalThis.__fuseMark = function(n) { globalThis.__fuseMarks.push(n, __fuseNow()); };"
+    "(function() { var o = fjs.bridge_call, first = true; fjs.bridge_call = function(m) {"
+    " if (first && m && m.channel === '_ops') { first = false; __fuseMark('bridge0'); var r = o.call(fjs, m); __fuseMark('bridge1'); return r; }"
+    " return o.call(fjs, m); }; })();"
+    "__fuseMark('start');"
+)
+out = [src[0], prelude]
+header = re.compile(r"^\t// (\S.*)$")
+n = 0
+for line in src[1:]:
+    m = header.match(line)
+    # module headers are paths; skip ordinary one-level comments
+    if m and ("/" in m.group(1) or m.group(1).startswith("\\0")) and " " not in m.group(1):
+        name = m.group(1).replace("\\", "\\\\").replace('"', '\\"')
+        out.append('\t__fuseMark("%s");' % name)
+        n += 1
+    if line.startswith("})();"):
+        out.append('\t__fuseMark("end");')
+    out.append(line)
+open(sys.argv[2], "w").write("\n".join(out))
+print("marked %d modules" % n, file=sys.stderr)
