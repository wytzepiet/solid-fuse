+#!/usr/bin/env bash
+# The whole cold-start matrix (REPORT-13-cold-start.md): every configuration of every
+# variant, <rounds> rounds of <per> launches each, rounds interleaved so that a busy
+# minute on the machine is spread over all configurations.
+#   NICE=-10 tools/cold-all.sh <tag> [rounds=3] [per=4]
+# Output: results/r13/cold-<variant>-<config>-<tag>.txt (appended per round).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+tag=${1:-a}; rounds=${2:-3}; per=${3:-4}
+# config name | arguments for tools/cold.sh
+configs=(
+  'first-launch|CLEAR=1 COLD_BC=cache'
+  'cached|COLD_BC=cache'
+  'source|COLD_BC=source'
+  'asset|COLD_BC=asset'
+  'asset-early|COLD_BC=asset COLD_ORDER=early'
+  'asset-min-builtins|COLD_BC=asset COLD_BUILTINS=min'
+  'pre-hydrate|COLD_BC=asset COLD_PRE=asset'
+  'pre-hydrate-overlap|COLD_BC=asset COLD_PRE=asset COLD_ORDER=overlap'
+  'pre-trust|COLD_BC=asset COLD_PRE=asset COLD_TAKEOVER=trust'
+  'pre-remount|COLD_BC=asset COLD_PRE=asset COLD_TAKEOVER=remount'
+  'pre-text-differs|COLD_BC=asset COLD_PRE=asset PRE_FILE=prerender-text.json'
+  'pre-structure-differs|COLD_BC=asset COLD_PRE=asset PRE_FILE=prerender-other.json'
+  'saved-batch|COLD_BC=asset COLD_PRE=saved SEED=1 COLD_SAVE=1'
+  'saved-tree|COLD_BC=asset COLD_PRE=tree SEED=1'
+)
+mkdir -p results/r13
+for ((r = 0; r < rounds; r++)); do
+  for v in ${VARIANTS:-small n200 n1000}; do
+    for row in "${configs[@]}"; do
+      name=${row%%|*}; args=${row#*|}
+      [ -n "${ONLY:-}" ] && [[ ! " $ONLY " == *" $name "* ]] && continue
+      tmp=$(mktemp)
+      # shellcheck disable=SC2086
+      tools/cold.sh "$v" "$per" "$tmp" $args
+      cat "$tmp" >> "results/r13/cold-$v-$name-$tag.txt"; rm -f "$tmp"
+    done
+  done
+done
