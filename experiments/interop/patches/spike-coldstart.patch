+    rt.applyOps([
+      create, 10, 'view', <String, dynamic>{'width': 40},
+      create, 30, 'text', <String, dynamic>{'fontSize': 12},
+      createText, 31, 'hi',
+      insert, 30, 31, 0,
+      insert, 10, 30, 0,
+      create, 20, 'icon', <String, dynamic>{},
+      setProp, 10, 'leading', {'_node': 20},
+      insert, 0, 10, 0,
+    ]);
+    final json = rt.snapshotOps();
+    final rt2 = FuseRuntime.forTest()..applyPrerendered(json, takeover: FuseTakeover.remount);
+    final root = rt2.registry.get(0).children.single;
