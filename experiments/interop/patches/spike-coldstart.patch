diff --git a/packages/solid-fuse/cli/ops-to-shape.ts b/packages/solid-fuse/cli/ops-to-shape.ts
new file mode 100644
index 0000000..4c8541f
--- /dev/null
+++ b/packages/solid-fuse/cli/ops-to-shape.ts
@@ -0,0 +1,72 @@
+// Turns a first-render op batch into the shape of the template op
+// (`TemplateShape` in src/renderer.ts). Used by the experimental build-time
+// "baked" subtrees (examples/perf_bench/REPORT-13-cold-start.md).
+
+export type Shape =
+  | { t: string; p?: Record<string, any>; c?: Shape[] }
+  | { x: string };
+
+interface N { id: number; t?: string; x?: string; p: Record<string, any>; c: N[]; parent?: N }
+
+const ARITY = [4, 3, 4, 3, 4, 3, 2, 3, 4];
+
+/**
+ * Replays `ops` (the flat journal) and returns the single subtree left under
+ * the root, with the number of nodes in it. Throws when the batch cannot be a
+ * static subtree: a prop that refers to another node, more or fewer than one
+ * root child, or an op kind a first render does not produce.
+ */
+export function opsToShape(ops: any[]): { shape: Shape & { t: string }; size: number } {
+  const nodes = new Map<number, N>();
+  const root: N = { id: 0, p: {}, c: [] };
+  nodes.set(0, root);
+  const get = (id: number) => {
+    const n = nodes.get(id);
+    if (!n) throw new Error(`op batch refers to unknown node ${id}`);
+    return n;
+  };
+  const detach = (n: N) => {
+    if (!n.parent) return;
+    const i = n.parent.c.indexOf(n);
+    if (i >= 0) n.parent.c.splice(i, 1);
+    n.parent = undefined;
+  };
+  for (let i = 0; i < ops.length; i += ARITY[ops[i]]) {
+    switch (ops[i]) {
+      case 0: nodes.set(ops[i + 1], { id: ops[i + 1], t: ops[i + 2], p: { ...ops[i + 3] }, c: [] }); break;
+      case 1: nodes.set(ops[i + 1], { id: ops[i + 1], x: String(ops[i + 2]), p: {}, c: [] }); break;
+      case 2: {
+        const v = ops[i + 3];
+        if (v && typeof v === "object" && ("_node" in v || (Array.isArray(v) && v.some((e) => e && typeof e === "object" && "_node" in e)))) {
+          throw new Error(`prop "${ops[i + 2]}" refers to another node; such a subtree cannot be baked`);
+        }
+        get(ops[i + 1]).p[ops[i + 2]] = v;
+        break;
+      }
+      case 3: get(ops[i + 1]).x = String(ops[i + 2]); break;
+      case 4: {
+        const parent = get(ops[i + 1]), child = get(ops[i + 2]);
+        detach(child);
+        parent.c.splice(Math.min(ops[i + 3], parent.c.length), 0, child);
+        child.parent = parent;
+        break;
+      }
+      case 5: detach(get(ops[i + 2])); break;
+      default: throw new Error(`op ${ops[i]} cannot appear in a baked subtree`);
+    }
+  }
+  if (root.c.length !== 1 || root.c[0].t === undefined) {
+    throw new Error(`a baked component must render exactly one element (got ${root.c.length} root nodes)`);
+  }
+  let size = 0;
+  const toShape = (n: N): Shape => {
+    size++;
+    if (n.t === undefined) return { x: n.x ?? "" };
+    const s: Shape = { t: n.t };
+    if (Object.keys(n.p).length) s.p = n.p;
+    if (n.c.length) s.c = n.c.map(toShape);
+    return s;
+  };
+  const shape = toShape(root.c[0]) as Shape & { t: string };
+  return { shape, size };
+}
