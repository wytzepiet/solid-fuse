index 0000000..84e63e9
--- /dev/null
+++ b/packages/solid-fuse/dart/lib/src/fjs/libfjs/src/tests/cold_harness.rs
@@ -0,0 +1,222 @@
+//! Cold-start harness (solid-fuse examples/perf_bench/REPORT-13-cold-start.md).
+//!
+//! One engine boot per process, timed phase by phase with the same calls
+//! `createEngine` (engine.dart) and `QuickJsConnection.start` make, without
+//! Flutter. Also the stand-in for a host-side build tool: it compiles a
+//! bundle to bytecode with the engine the app ships, and captures the first
+//! op batch of a bundle under QuickJS. Ignored by default:
+//!
+//! ```sh
+//! FJS_COLD_MODE=boot FJS_COLD_BUNDLE=/path/bundle.js cargo test --release cold_harness -- --ignored --nocapture
+//! ```
+//!
+//! `FJS_COLD_MODE`:
+//! - `boot` (default): prints one `COLD {json}` line. `FJS_COLD_EVAL` is
+//!   `source`, `compile` (compile, then load the bytecode: first launch
+//!   today), `bytecode` (load `FJS_COLD_BC`, with fjs's validation pass) or
+//!   `bytecode-novalidate`. `FJS_COLD_BUILTINS` is `all`, `web`, `essential`
+//!   or `none`.
+//! - `compile`: writes the bytecode of the bundle to `FJS_COLD_BC`.
+//! - `prerender`: writes every `_ops` batch sent while the bundle is
+//!   evaluated to `FJS_COLD_OUT`, one JSON array per line.
+
+use crate::api::bytecode::JsBytecode;
+use crate::api::engine::JsEngine;
+use crate::api::error::JsResult;
+use crate::api::source::{JsBuiltinOptions, JsCode, JsModule, JsScriptBytecode};
+use crate::api::value::JsValue;
+use crate::bytecode_support::validate_script_bytecode_impl;
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+fn ms(t: Instant) -> f64 {
+    t.elapsed().as_secs_f64() * 1e3
+}
+
+#[tokio::test(flavor = "multi_thread")]
+#[ignore]
+async fn cold_harness() {
+    let t_proc = Instant::now();
+    let mode = std::env::var("FJS_COLD_MODE").unwrap_or_else(|_| "boot".into());
+    let Ok(bundle_path) = std::env::var("FJS_COLD_BUNDLE") else {
+        eprintln!("FJS_COLD_BUNDLE not set");
+        return;
+    };
+
+    if mode == "compile" {
+        let source = std::fs::read_to_string(&bundle_path).unwrap();
+        let t = Instant::now();
+        let bc = JsBytecode::compile_script("bundle.js".to_string(), JsCode::Code(source), None)
+            .await
+            .unwrap();
+        println!("COLD_COMPILE ms={:.2} bytes={}", ms(t), bc.bytes.len());
+        std::fs::write(std::env::var("FJS_COLD_BC").unwrap(), &bc.bytes).unwrap();
+        return;
+    }
+
+    let eval_kind = std::env::var("FJS_COLD_EVAL").unwrap_or_else(|_| "source".into());
+    let builtins_name = std::env::var("FJS_COLD_BUILTINS").unwrap_or_else(|_| "all".into());
+    let builtins = match builtins_name.as_str() {
+        "web" => JsBuiltinOptions::web(),
+        "essential" => JsBuiltinOptions::essential(),
+        "none" => JsBuiltinOptions::none(),
+        // What solid-fuse needs from fjs for its own code: timers and
+        // performance.now; console and URL are replaced by its polyfills.
+        "min" => JsBuiltinOptions {
+            timers: Some(true),
+            perf_hooks: Some(true),
+            url: Some(true),
+            ..Default::default()
+        },
+        _ => JsBuiltinOptions::all(),
+    };
+
+    // (ms since eval start, batch JSON) of every `_ops` message.
+    let batches: Arc<Mutex<Vec<(f64, String)>>> = Arc::new(Mutex::new(Vec::new()));
+    let eval_start: Arc<Mutex<Option<Instant>>> = Arc::new(Mutex::new(None));
+    let (b2, e2) = (batches.clone(), eval_start.clone());
+
+    let t = Instant::now();
+    let engine = JsEngine::create(Some(builtins), None, None).await.unwrap();
+    let create_ms = ms(t);
+
+    let t = Instant::now();
+    engine
+        .init(move |v: JsValue| {
+            if let JsValue::Object(map) = &v {
+                if let Some(JsValue::String(ch)) = map.get("channel") {
+                    if ch == "_ops" {
+                        let at = e2.lock().unwrap().map(|s| ms(s)).unwrap_or(-1.0);
+                        let json = match map.get("json") {
+                            Some(JsValue::String(s)) => s.clone(),
+                            _ => String::from("null"),
+                        };
+                        b2.lock().unwrap().push((at, json));
+                    }
+                }
+            }
+            Box::pin(async move { JsResult::Ok(JsValue::None) })
+        })
+        .await
+        .unwrap();
+    let init_ms = ms(t);
+
+    let t = Instant::now();
+    engine
+        .eval(
+            JsCode::Code(
+                "globalThis.__fuseHost = { mode: 'release', platform: 'linux', brightness: 'light' };"
+                    .to_string(),
+            ),
+            None,
+        )
+        .await
+        .unwrap();
+    let seed_ms = ms(t);
+
+    let t = Instant::now();
+    engine
+        .declare_new_module(JsModule::code(
+            "__fuse_dispatch".to_string(),
+            "export function dispatch(ch, data) { return globalThis.__dispatch(ch, data); }"
