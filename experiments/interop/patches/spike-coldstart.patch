diff --git a/packages/solid-fuse/src/renderer-trust.test.ts b/packages/solid-fuse/src/renderer-trust.test.ts
new file mode 100644
index 0000000..4a3655a
--- /dev/null
+++ b/packages/solid-fuse/src/renderer-trust.test.ts
@@ -0,0 +1,59 @@
+import { expect, test } from "bun:test";
+import { createSignal } from "solid-js";
+
+// Run with `bun test --conditions browser src/renderer-trust.test.ts`.
+//
+// Experimental "trust" takeover of a prerendered first screen
+// (examples/perf_bench/REPORT-13-cold-start.md): Dart seeds the op and node
+// counts of the batch it already applied; a first render with the same counts
+// is not sent. Each case needs its own renderer instance, so the module is
+// loaded with a distinct query string.
+const sent: any[] = [];
+(globalThis as any).fjs = { bridge_call: (msg: any) => (sent.push(msg), Promise.resolve(null)) };
+const opsMessages = () => sent.filter((m) => m.channel === "_ops");
+
+async function load(tag: string, prerender?: { ops: number; nodes: number }) {
+  (globalThis as any).__fuseHost = { mode: "release", platform: "linux", brightness: "light", prerender };
+  sent.length = 0;
+  return (await import(`./renderer.ts?${tag}`)) as typeof import("./renderer");
+}
+
+/** view > text > "n": 3 nodes, 6 ops (3 creates, 3 inserts). */
+function screen(R: typeof import("./renderer"), label: () => string) {
+  const view = R.createElement("view");
+  R.setProp(view, "width", 40);
+  const text = R.createElement("text");
+  R.insertNode(view, text);
+  R.insert(text, label);
+  return view;
+}
+
+test("same op and node counts: the first batch is not sent, later updates are", async () => {
+  const R = await load("match", { ops: 6, nodes: 3 });
+  const [label, setLabel] = createSignal("a");
+  R.render(() => screen(R, label));
+  expect(opsMessages()).toEqual([{ channel: "_ops", hydrated: true }]);
+
+  sent.length = 0;
+  setLabel("b");
+  R.flushOps();
+  const [msg] = opsMessages();
+  // the text node keeps the id it would have had in a normal first render
+  expect(JSON.parse(msg.json)).toEqual([3, 3, "b"]);
+});
+
+test("different counts: the batch is sent as usual", async () => {
+  const R = await load("mismatch", { ops: 9, nodes: 4 });
+  R.render(() => screen(R, () => "a"));
+  const [msg] = opsMessages();
+  expect(msg.hydrated).toBeUndefined();
+  const ops = JSON.parse(msg.json);
+  expect(ops.slice(0, 4)).toEqual([0, 1, "view", { width: 40 }]);
+  expect(msg.n).toBe(6);
+});
+
+test("no prerender seed: nothing changes", async () => {
+  const R = await load("none");
+  R.render(() => screen(R, () => "a"));
+  expect(opsMessages()[0].json).toBeDefined();
+});
