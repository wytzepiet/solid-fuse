+// Cold-start driver (REPORT-13-cold-start.md). `COLD=1 perf_bench` starts the
+// app the way a real app starts, records where the time goes from process
+// start to the first frame with content and to the first handled tap, prints
+// one `COLD {json}` line and exits. tools/cold.sh launches it repeatedly.
+//
+// Environment:
+//   COLD_T0_US      wall clock (epoch µs) taken by the launcher right before exec
+//   COLD_ORDER      late (default; `await start()` then `runApp`, as the docs show)
+//                   or early (`runApp` first)
+//   COLD_BC         cache (default; compile on first launch, cache in the documents
+//                   directory), asset (assets/js/bundle.bc shipped by the build) or
+//                   source (evaluate the source text)
+//   COLD_BUILTINS   all (default), web, essential, min
+//   COLD_PRE        none (default), asset (assets/js/prerender.json), saved (the
+//                   first batch a previous launch saved) or tree (the node tree a
+//                   previous launch saved with snapshotOps)
+//   COLD_TAKEOVER   hydrate (default), remount, trust
+//   COLD_SAVE       1: save this launch's first batch and tree for COLD_PRE=saved/tree
+//   COLD_TAP        1 (default): tap the counter as soon as content is on screen
+import 'dart:async';
+import 'dart:convert';
+import 'dart:developer' show Timeline;
+import 'dart:io';
+import 'dart:ui' show FramePhase, FrameTiming;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/services.dart' show rootBundle;
+import 'package:path_provider/path_provider.dart';
+import 'package:solid_fuse/fjs.dart' show JsBuiltinOptions;
+import 'package:solid_fuse/solid_fuse.dart';
+
+import '_generated/fuse_packages.dart';
+import 'bench_widgets.dart';
+
+Future<void> coldMain() async {
+  final tMain = Timeline.now;
+  final wallMain = DateTime.now().microsecondsSinceEpoch;
+  final env = Platform.environment;
+  FuseStartup.on = true;
+  FuseStartup.mark('main');
+  final marks = FuseStartup.marks;
+  final info = FuseStartup.info;
+  void mark(String name) => FuseStartup.mark(name);
+
+  final order = env['COLD_ORDER'] ?? 'late';
+  final bc = env['COLD_BC'] ?? 'cache';
+  final pre = env['COLD_PRE'] ?? 'none';
+  final takeover = switch (env['COLD_TAKEOVER']) {
+    'remount' => FuseTakeover.remount,
+    'trust' => FuseTakeover.trust,
+    _ => FuseTakeover.hydrate,
+  };
+  final tap = (env['COLD_TAP'] ?? '1') == '1';
+  if (bc == 'asset') QuickJsConnection.bytecodeAsset = 'assets/js/bundle.bc';
+  if (bc == 'source') QuickJsConnection.evalSourceInRelease = true;
+  QuickJsConnection.defaultBuiltins = switch (env['COLD_BUILTINS']) {
+    'web' => JsBuiltinOptions.web(),
+    'essential' => JsBuiltinOptions.essential(),
+    'min' => const JsBuiltinOptions(timers: true, perfHooks: true, url: true),
+    _ => null,
+  };
+
+  WidgetsFlutterBinding.ensureInitialized();
+  mark('binding');
+
+  late final FuseRuntime rt;
+  final timings = <FrameTiming>[];
+  SchedulerBinding.instance.addTimingsCallback(timings.addAll);
+  var frames = 0;
+  var content = false;
+  final contentDone = Completer<void>();
+  SchedulerBinding.instance.addPersistentFrameCallback((_) {
+    frames++;
+    if (frames == 1) mark('firstFrame0');
+    if (!content && rt.registry.get(0).children.isNotEmpty) {
+      content = true;
+      mark('contentFrame0');
+      info['contentFrameNo'] = frames;
+      SchedulerBinding.instance.addPostFrameCallback((_) {
+        mark('contentFrame1');
+        contentDone.complete();
+      });
+    }
+  });
+
+  Widget app() => MaterialApp(
+        debugShowCheckedModeBanner: false,
+        home: Material(child: FuseView(runtime: rt)),
+      );
+
+  String? preJson;
+  File? savedBatch, savedTree;
+  if (pre == 'saved' || pre == 'tree' || env['COLD_SAVE'] == '1') {
+    mark('supportDir0');
+    final dir = await getApplicationSupportDirectory();
+    mark('supportDir1');
+    savedBatch = File('${dir.path}/fuse_first_batch.json');
+    savedTree = File('${dir.path}/fuse_tree.json');
+  }
+
+  final ready = Completer<void>();
+  void wire() {
+    registerFusePackages(rt);
+    registerBenchWidgets(rt);
+  }
+
+  Future<void> startJs() async {
+    await rt.start();
+    mark('start1');
+  }
+
+  // `coldReady` is sent by the bundle right after render(): handlers exist.
+  FuseRuntime.perfOnConnect = (channels) {
+    channels.on('coldReady', (_) {
+      mark('jsReady');
+      if (!ready.isCompleted) ready.complete();
+    });
+  };
+
+  if (pre != 'none') {
+    // Prerendered first screen: nodes first, then the frame, then the engine.
+    rt = FuseRuntime.deferred();
+    wire();
+    mark('preRead0');
+    try {
+      preJson = switch (pre) {
+        'asset' => await rootBundle.loadString('assets/js/prerender.json'),
+        'saved' => savedBatch!.readAsStringSync(),
+        _ => savedTree!.readAsStringSync(),
+      };
+    } catch (e) {
+      info['preError'] = '$e';
+    }
+    mark('preRead1');
+    if (preJson != null) {
+      info['preOps'] = rt.applyPrerendered(preJson, takeover: pre == 'tree' ? FuseTakeover.remount : takeover);
+      info['preBytes'] = preJson.length;
+      rt.replayEarlyEvents = true;
+    }
+    mark('preApplied');
+    runApp(app());
+    mark('runApp');
+    // Not awaited before the first frame.
+    unawaited(startJs());
+  } else if (order == 'early') {
+    rt = FuseRuntime.deferred();
+    wire();
+    runApp(app());
+    mark('runApp');
+    unawaited(startJs());
+  } else {
+    rt = await FuseRuntime.create();
+    wire();
+    await startJs();
+    runApp(app());
+    mark('runApp');
+  }
+
+  if (env['COLD_SAVE'] == '1') {
+    rt.onFirstBatch = (json) {
+      final t = Timeline.now;
+      savedBatch!.writeAsStringSync(json);
+      info['saveBatchMs'] = (Timeline.now - t) / 1000;
+    };
+  }
+
+  await contentDone.future;
+  final contentNodes = rt.registry.length;
+
+  // Tap the counter the moment content is on screen. With a prerendered
+  // screen JS may not be up: the runtime queues the event and replays it.
+  FuseNode? counterText() {
+    for (final n in rt.registry.nodes) {
+      final t = n.props['text'];
+      if (n.type == '__text__' && t is String && t.contains('Taps: ')) return n;
+    }
+    return null;
+  }
+
+  String? textBefore, textAfter;
+  if (tap) {
+    FuseNode? target;
+    for (final n in rt.registry.nodes) {
+      if (n.type == 'gestureDetector' && n.props['onTap'] == true) {
+        target = n;
+        break;
+      }
+    }
+    textBefore = counterText()?.props['text'] as String?;
+    if (target != null) {
+      mark('tapSent');
+      rt.callFunction(target.id, 'onTap', <String, dynamic>{});
+      final deadline = Timeline.now + 5000000;
+      while (Timeline.now < deadline) {
+        final t = counterText()?.props['text'] as String?;
+        if (t != null && t.contains('Taps: 1')) {
+          mark('tapApplied');
+          break;
+        }
+        await Future<void>.delayed(const Duration(microseconds: 200));
+      }
+      await SchedulerBinding.instance.endOfFrame;
+      mark('tapFrame1');
+      textAfter = counterText()?.props['text'] as String?;
+    }
+  }
+  await ready.future.timeout(const Duration(seconds: 5), onTimeout: () {});
+  // Let the takeover and its frame land, and the frame timings arrive.
+  await Future<void>.delayed(const Duration(milliseconds: 300));
+  await SchedulerBinding.instance.endOfFrame;
+
+  if (env['COLD_SAVE'] == '1') {
+    final t = Timeline.now;
+    final tree = rt.snapshotOps();
+    info['snapshotMs'] = (Timeline.now - t) / 1000;
+    info['snapshotBytes'] = tree.length;
+    savedTree!.writeAsStringSync(tree);
+  }
+
+  // Process start on the Timeline clock.
+  final t0us = int.tryParse(env['COLD_T0_US'] ?? '');
+  final t0 = t0us == null ? tMain : tMain - (wallMain - t0us);
+  double rel(int us) => (us - t0) / 1000;
+  FrameTiming? contentTiming;
+  final c0 = marks['contentFrame0'];
+  for (final ft in timings) {
+    if (c0 != null && ft.timestampInMicroseconds(FramePhase.buildStart) <= c0) contentTiming = ft;
+  }
+  final view = WidgetsBinding.instance.platformDispatcher.views.first;
+  final out = <String, dynamic>{
+    'order': order,
+    'bc': bc,
+    'pre': pre,
+    'takeover': pre == 'none' ? null : takeover.name,
+    'builtins': env['COLD_BUILTINS'] ?? 'all',
+    'hasT0': t0us != null,
+    'load': File('/proc/loadavg').readAsStringSync().split(' ').first,
+    'window': '${view.physicalSize.width.round()}x${view.physicalSize.height.round()}',
+    'frames': frames,
+    'nodes': rt.registry.length,
+    'contentNodes': contentNodes,
+    'takeoverResult': rt.takeoverResult,
+    'textBefore': textBefore,
+    'textAfter': textAfter,
+    'marks': {for (final e in marks.entries) e.key: double.parse(rel(e.value).toStringAsFixed(3))},
+    'info': info,
+    if (contentTiming != null)
+      'ft': {
+        'vsyncStart': rel(contentTiming.timestampInMicroseconds(FramePhase.vsyncStart)),
+        'buildStart': rel(contentTiming.timestampInMicroseconds(FramePhase.buildStart)),
+        'buildFinish': rel(contentTiming.timestampInMicroseconds(FramePhase.buildFinish)),
+        'rasterStart': rel(contentTiming.timestampInMicroseconds(FramePhase.rasterStart)),
+        'rasterFinish': rel(contentTiming.timestampInMicroseconds(FramePhase.rasterFinish)),
+      },
+    'frameBuildMs': [for (final ft in timings) ft.buildDuration.inMicroseconds / 1000],
+  };
+  // ignore: avoid_print
+  print('COLD ${jsonEncode(out)}');
+  exit(0);
+}
