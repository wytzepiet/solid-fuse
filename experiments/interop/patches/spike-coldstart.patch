+++ b/examples/perf_bench/tools/cold.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Cold launches of one variant; saves the COLD lines (REPORT-13-cold-start.md).
+#   tools/cold.sh <variant> <reps> <out-file> [NAME=value ...]
+# NAME=value pairs are passed to the app (COLD_BC, COLD_PRE, COLD_TAKEOVER, COLD_ORDER,
+# COLD_BUILTINS, ...; see dart/lib/cold.dart) and recorded in the header. Also:
+#   CLEAR=1    delete the on-device bytecode cache before every launch (first launch after install)
+#   DROP=1     drop the OS page cache before every launch (root)
+#   PRE_FILE=prerender-text.json   use this file of the variant as assets/js/prerender.json
+# One Xvfb serves all launches, so X server start-up is not in the numbers. Process
+# start is taken with bash's EPOCHREALTIME immediately before exec.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+v=$1; reps=$2; out=$3; shift 3
+CLEAR=0; DROP=0; PRE_FILE=prerender.json; pass=()
+for kv in "$@"; do
+  case $kv in CLEAR=*) CLEAR=${kv#*=};; DROP=*) DROP=${kv#*=};; PRE_FILE=*) PRE_FILE=${kv#*=};; *) pass+=("$kv");; esac
+done
+dir=$PWD/build-cold/$v; bin=$dir/perf_bench; a=$dir/data/flutter_assets/assets/js
+mkdir -p "$(dirname "$out")"
+home=$(mktemp -d); export HOME=$home XDG_DATA_HOME=$home/.local/share
+if [ "$PRE_FILE" != prerender.json ]; then cp "$a/prerender.json" "$a/prerender.keep"; cp "$a/$PRE_FILE" "$a/prerender.json"; fi
+disp=:$((90 + RANDOM % 9)); Xvfb $disp -screen 0 1280x1024x24 -nolisten tcp >/dev/null 2>&1 & xpid=$!
+trap 'kill $xpid 2>/dev/null || true; [ -f "$a/prerender.keep" ] && mv "$a/prerender.keep" "$a/prerender.json"; rm -rf "$home"' EXIT
+sleep 1; export DISPLAY=$disp
+{
+  echo "# $(date -Is) variant=$v reps=$reps clear=$CLEAR drop=$DROP pre_file=$PRE_FILE ${pass[*]:-} loadavg=$(cut -d' ' -f1-3 /proc/loadavg)"
+  for ((i = 0; i < reps; i++)); do
+    [ "$CLEAR" = 1 ] && rm -rf "$home"/Documents/fuse_cache "$home"/fuse_cache "$home"/.local/share/*/fuse_cache 2>/dev/null
+    [ "$DROP" = 1 ] && { sync; echo 3 > /proc/sys/vm/drop_caches; }
+    ( exec env "${pass[@]}" COLD=1 COLD_T0_US=${EPOCHREALTIME/./} "$bin" 2>&1 ) | grep --line-buffered -E '^(COLD|\[Fuse\]|flutter:.*rror|#[0-9])' || true
+  done
+  echo "# end $(date -Is) loadavg=$(cut -d' ' -f1-3 /proc/loadavg)"
+} > "$out"
