@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Engine-only cold boots in the Rust harness (REPORT-13-cold-start.md): one fresh process
+# per boot, no Flutter. Needs tools/cold-build.sh to have run.
+#   HARNESS=<fjs test binary> tools/cold-harness.sh <reps> <out-prefix>
+# Writes <prefix>-marks.txt (bundles with per-module timing marks, from bytecode and from
+# source) and <prefix>-builtins.txt (the n200 bundle under each set of fjs built-ins).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+: "${HARNESS:?set HARNESS to the fjs test binary}"
+reps=${1:-20}; pre=${2:-results/r13/harness}
+mkdir -p "$(dirname "$pre")"
+run() { # run <name> <bundle.js> <bundle.bc> <kind> <builtins> <out>
+  for ((i = 0; i < reps; i++)); do
+    FJS_COLD_BUNDLE=$2 FJS_COLD_BC=$3 FJS_COLD_EVAL=$4 FJS_COLD_BUILTINS=$5 nice -n "${NICE:-0}" "$HARNESS" cold_harness --ignored --nocapture 2>&1 \
+      | grep -E '^COLD |panicked|rror' | sed "s/^COLD {/COLD {\"name\":\"$1\",/" >> "$6" || true
+  done
+}
+echo "# $(date -Is) reps=$reps loadavg=$(cut -d' ' -f1-3 /proc/loadavg)" > "$pre-marks.txt"
+for v in small n200 n1000; do
+  for kind in bytecode-novalidate source; do
+    run "$v" "$PWD/build-cold/$v/marked/bundle.js" "$PWD/build-cold/$v/marked/bundle.bc" $kind all "$pre-marks.txt"
+  done
+done
+echo "# $(date -Is) reps=$reps loadavg=$(cut -d' ' -f1-3 /proc/loadavg)" > "$pre-builtins.txt"
+a=$PWD/build-cold/n200/data/flutter_assets/assets/js
+for b in all web essential min none; do
+  run "n200-$b" "$a/bundle.js" "$a/bundle.bc" bytecode-novalidate $b "$pre-builtins.txt"
+done
diff --git a/examples/perf_bench/tools/cold-vite-agg.py b/examples/perf_bench/tools/cold-vite-agg.py
new file mode 100644
index 0000000..62d129c
--- /dev/null
+++ b/examples/perf_bench/tools/cold-vite-agg.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Aggregates tools/cold-vite.sh output (and any file of harness COLD lines).
+
+  tools/cold-vite-agg.py <file>            one row per bundle variant
+  tools/cold-vite-agg.py --phases <file>   engine phases per variant and eval kind
+  tools/cold-vite-agg.py --marks <file>    per-module top-level evaluation (marked bundles)
+"""
+import json, statistics, sys
+from collections import defaultdict
+
+def med(v):
+    if not v:
+        return ""
+    m = statistics.median(v)
+    d = 2 if m < 10 else 1
+    return f"{m:.{d}f} ({min(v):.{d}f}–{max(v):.{d}f})"
+
+args = [a for a in sys.argv[1:] if not a.startswith("--")]
+mode = next((a for a in sys.argv[1:] if a.startswith("--")), "")
+meta, rows = {}, defaultdict(list)
+order = []
+for path in args:
+    for line in open(path):
+        if line.startswith("VITE {"):
+            m = json.loads(line[5:]); meta[m["name"]] = m
+            if m["name"] not in order: order.append(m["name"])
+        elif line.startswith("COLD {"):
+            r = json.loads(line[5:]); name = r.get("name", "?")
+            if name not in order: order.append(name)
+            rows[(name, r["eval"])].append(r)
+
+if mode == "--marks":
+    for name in order:
+        for kind in ("bytecode-novalidate", "bytecode", "source"):
+            rs = [r for r in rows.get((name, kind), []) if r.get("marks")]
+            if not rs: continue
+            spans = defaultdict(list)
+            for r in rs:
+                m = r["marks"]
+                for i in range(0, len(m) - 2, 2):
+                    spans[m[i]].append(m[i + 3] - m[i + 1])
+                spans["(all marks)"].append(m[-1] - m[1])
+                spans["(evalMs - marks: read bytecode, thread hop)"].append(r["evalMs"] - (m[-1] - m[1]))
+            print(f"\n**{name}, {kind}, n={len(rs)}**\n\n| module / phase | ms |\n|---|---:|")
+            for k, v in spans.items():
+                if statistics.median(v) >= 0.005 or k.startswith("("):
+                    print(f"| `{k}` | {med(v)} |")
+            break
+    sys.exit(0)
+
+if mode == "--phases":
+    print("| bundle | how | n | create | init | seed+shim | read file | compile | validate | eval | first ops at | builtins |")
+    print("|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|")
+    for name in order:
+        for kind in ("source", "compile", "bytecode", "bytecode-novalidate"):
+            rs = rows.get((name, kind), [])
+            if not rs: continue
+            g = lambda k: med([r[k] for r in rs])
+            print(f"| {name} | {kind} | {len(rs)} | {g('createMs')} | {g('initMs')} | {med([r['seedMs'] + r['declareMs'] for r in rs])} | {g('readMs')} | {g('compileMs') if kind == 'compile' else ''} | {g('validateMs') if kind == 'bytecode' else ''} | {g('evalMs')} | {med([r['firstOpsMs'] for r in rs if r['firstOpsMs'] >= 0])} | {rs[0]['builtins']} |")
+    sys.exit(0)
+
+print("| bundle | JS bytes | gzip | bytecode bytes | gzip | eval source | compile on device | then load | bytecode load (validated) | bytecode load (no validation) | first batch OK |")
+print("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|")
+for name in order:
+    m = meta.get(name, {})
+    def g(kind, key):
+        return med([r[key] for r in rows.get((name, kind), [])])
+    ok = {r["firstOpsBytes"] for k in ("source", "compile", "bytecode", "bytecode-novalidate") for r in rows.get((name, k), [])}
+    val = med([r["validateMs"] + r["evalMs"] for r in rows.get((name, "bytecode"), [])])
+    print(f"| {name} | {m.get('jsBytes','')} | {m.get('gzBytes','')} | {m.get('bcBytes','')} | {m.get('bcGzBytes','')} | {g('source','evalMs')} | {g('compile','compileMs')} | {g('compile','evalMs')} | {val} | {g('bytecode-novalidate','evalMs')} | {','.join(str(x) for x in sorted(ok))} |")
diff --git a/examples/perf_bench/tools/cold-vite.sh b/examples/perf_bench/tools/cold-vite.sh
