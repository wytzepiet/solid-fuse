+    expect(root.props['width'], 40);
+    expect((root.props['leading'] as FuseNode).type, 'icon');
+    expect(root.children.single.type, 'text');
+    expect(root.children.single.children.single.props['text'], 'hi');
+    expect(rt2.registry.length, 5);
+    // ids start at 1 again
+    expect(root.id, 1);
+  });
