+  test('remount: prerendered nodes are disposed and the batch applied fresh', () {
+    rt.applyPrerendered(jsonEncode(screen()), takeover: FuseTakeover.remount);
+    final old = node(1);
+    live(screen());
+    expect(rt.takeoverResult, 'remounted');
+    expect(node(1), isNot(same(old)));
+    expect(node(0).children.single, same(node(1)));
