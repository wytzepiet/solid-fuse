+#!/usr/bin/env bash
+# Builds the app variants of the cold-start measurements (REPORT-13-cold-start.md).
+#   tools/cold-build.sh [variant ...]        variants: small n200 n1000 (default: all three)
+# Needs: a Flutter release build (dart/build/linux/x64/release/bundle) and the fjs
+# test binary as HARNESS (cargo test --release --no-run in libfjs) for the bytecode.
+# Each variant is a copy of the release bundle directory under build-cold/<variant>
+# (libraries hard-linked) with its own assets:
+#   bundle.js            the JS bundle (`fuse build --js-only`)
+#   bundle.bc            the same bundle as QuickJS bytecode, compiled by HARNESS
+#   prerender.json       first-screen op batch (`fuse build --prerender=linux`)
+#   prerender-text.json  first screen of a build whose greeting text differs
+#   prerender-other.json first screen of another variant (structure differs)
+set -euo pipefail
+cd "$(dirname "$0")/.."
+: "${HARNESS:?set HARNESS to the fjs test binary}"
+src=dart/build/linux/x64/release/bundle
+variants=("$@"); [ ${#variants[@]} -eq 0 ] && variants=(small n200 n1000)
+mkdir -p build-cold
+js() { # js <variant> [extra env...]: builds dart/assets/js/bundle.js (+prerender.json)
+  local v=$1; shift
+  case $v in
+    small) env COLD_ENTRY=small "$@" bun fuse build --js-only --prerender=linux >/dev/null ;;
+    n*)    env COLD_NODES=${v#n} "$@" bun fuse build --js-only --prerender=linux >/dev/null ;;
+  esac
+}
+for v in "${variants[@]}"; do
+  out=build-cold/$v; a=$out/data/flutter_assets/assets/js
+  rm -rf "$out"; cp -al "$src" "$out"
+  # assets are replaced, so they must not stay hard links into the release build
+  rm -rf "$a"; mkdir -p "$a"
+  js "$v" COLD_GREETING="Hi Bob"; cp dart/assets/js/prerender.json "$a/prerender-text.json"
+  js "$v"
+  cp dart/assets/js/bundle.js dart/assets/js/prerender.json "$a/"
+  # measurement-only twin with timing marks (used by the harness attribution runs)
+  mkdir -p "$out/marked"; python3 tools/mark-bundle.py "$a/bundle.js" "$out/marked/bundle.js"
+  FJS_COLD_MODE=compile FJS_COLD_BUNDLE=$PWD/$out/marked/bundle.js FJS_COLD_BC=$PWD/$out/marked/bundle.bc \
+    "$HARNESS" cold_harness --ignored --nocapture >/dev/null 2>&1
+  FJS_COLD_MODE=compile FJS_COLD_BUNDLE=$PWD/$a/bundle.js FJS_COLD_BC=$PWD/$a/bundle.bc \
+    "$HARNESS" cold_harness --ignored --nocapture 2>&1 | grep COLD_COMPILE
+  echo "$v: bundle.js $(stat -c %s "$a/bundle.js") B, bundle.bc $(stat -c %s "$a/bundle.bc") B, prerender.json $(stat -c %s "$a/prerender.json") B"
+done
+# structure-differs snapshots: each variant gets the first screen of another one
+for v in "${variants[@]}"; do
+  o=small; [ "$v" = small ] && o=n200
+  [ -f build-cold/$o/data/flutter_assets/assets/js/prerender.json ] && \
+    cp build-cold/$o/data/flutter_assets/assets/js/prerender.json build-cold/$v/data/flutter_assets/assets/js/prerender-other.json
+done
+# leave the default (empty first screen) bundle in dart/assets/js for the benchmark suites
+bun fuse build --js-only >/dev/null; rm -f dart/assets/js/prerender.json
