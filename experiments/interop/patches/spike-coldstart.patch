@@ -0,0 +1,101 @@
+// Takeover of a prerendered screen in a real widget tree (experimental,
+// examples/perf_bench/REPORT-13-cold-start.md): what is rebuilt, and whether
+// widget state (a scroll offset) survives.
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+import 'package:solid_fuse/src/widgets/scroll_view.dart';
+
+const create = 0, createText = 1, insert = 4;
+
+/// scrollView#1 > 40 x probe (ids from [first]), each 100 px high.
+List<dynamic> screen({int first = 2, String label = 'row'}) => [
+      create, 1, 'scrollView', <String, dynamic>{},
+      for (var i = 0; i < 40; i++) ...[
+        create, first + i, 'probe', {'label': '$label $i'},
+        insert, 1, first + i, i,
+      ],
+      insert, 0, 1, 0,
+    ];
+
+void main() {
+  late FuseRuntime rt;
+  late Map<int, int> builds;
+
+  setUp(() {
+    rt = FuseRuntime.forTest();
+    builds = {};
+    rt.registerWidget('scrollView', FuseScrollView.new);
+    rt.registerWidget('probe', (node) {
+      builds[node.id] = (builds[node.id] ?? 0) + 1;
+      return SizedBox(height: 100, child: Text(node.string('label') ?? ''));
+    });
+  });
+
+  Future<void> pump(WidgetTester tester) => tester.pumpWidget(
+        Directionality(textDirection: TextDirection.ltr, child: FuseView(runtime: rt)),
+      );
+  void live(List<dynamic> ops) => rt.receiveOpsForTest({'json': jsonEncode(ops), 'n': 0});
+  double offset(WidgetTester tester) => tester.state<ScrollableState>(find.byType(Scrollable)).position.pixels;
+
+  Future<void> showAndScroll(WidgetTester tester, FuseTakeover takeover) async {
+    rt.applyPrerendered(jsonEncode(screen()), takeover: takeover);
+    await pump(tester);
+    expect(find.text('row 0'), findsOneWidget);
+    tester.state<ScrollableState>(find.byType(Scrollable)).position.jumpTo(300);
+    await tester.pump();
+    expect(offset(tester), 300);
+    builds.clear();
+  }
+
+  testWidgets('hydrate, identical batch: nothing is rebuilt and the scroll offset stays', (tester) async {
+    await showAndScroll(tester, FuseTakeover.hydrate);
+    live(screen());
+    await tester.pump();
+    expect(rt.takeoverResult, 'identical');
+    expect(builds, isEmpty);
+    expect(offset(tester), 300);
+  });
+
+  testWidgets('hydrate, one text differs: only that node is rebuilt, the offset stays', (tester) async {
+    await showAndScroll(tester, FuseTakeover.hydrate);
+    final ops = screen();
+    (ops[ops.indexOf(5) + 2] as Map)['label'] = 'changed';
+    live(ops);
+    await tester.pump();
+    expect(rt.takeoverResult, 'patched');
+    expect(builds, {5: 1});
+    expect(find.text('changed'), findsOneWidget);
+    expect(offset(tester), 300);
+  });
+
+  testWidgets('remount with the same ids: every node is rebuilt, but elements are reused and the offset stays', (tester) async {
+    await showAndScroll(tester, FuseTakeover.remount);
+    final before = tester.element(find.byType(Scrollable));
+    live(screen());
+    await tester.pump();
+    expect(rt.takeoverResult, 'remounted');
+    expect(builds.length, 40);
+    // FuseNodeWidget is keyed by node id, so Flutter updates the elements in place.
+    expect(tester.element(find.byType(Scrollable)), same(before));
+    expect(offset(tester), 300);
+  });
+
+  testWidgets('remount with different ids (a saved tree): elements are replaced and the offset is lost', (tester) async {
+    await showAndScroll(tester, FuseTakeover.remount);
+    // The live render numbers its nodes differently (scrollView is still #1 here; rows differ).
+    final ops = screen(first: 100);
+    ops[1] = 99; // scrollView id
+    for (var i = 0; i < ops.length; i++) {
+      if (ops[i] == insert && ops[i + 1] == 1) ops[i + 1] = 99;
+    }
+    ops[ops.length - 2] = 99;
+    live(ops);
+    await tester.pump();
+    expect(rt.takeoverResult, 'remounted');
+    expect(find.text('row 0'), findsOneWidget);
+    expect(offset(tester), 0);
+  });
+}
