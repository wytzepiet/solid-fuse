diff --git a/packages/solid-fuse/cli/baked-plugin.ts b/packages/solid-fuse/cli/baked-plugin.ts
new file mode 100644
index 0000000..38f1106
--- /dev/null
+++ b/packages/solid-fuse/cli/baked-plugin.ts
@@ -0,0 +1,77 @@
+import { mkdirSync, rmSync, writeFileSync } from "fs";
+import { join, relative } from "path";
+import { build as viteBuild, type InlineConfig, type Plugin } from "vite";
+import { opsToShape } from "./ops-to-shape";
+import { prerenderBundle, type PrerenderHost } from "./prerender";
+
+/**
+ * Experimental (examples/perf_bench/REPORT-13-cold-start.md): build-time-only
+ * subtrees.
+ *
+ * A module named `*.baked.tsx` default-exports a component that takes no
+ * props. In a production build the component is run now (under Bun, with the
+ * real renderer); what it renders is written to `baked.json` as a template
+ * shape, and the module is replaced by a stub that emits one `clone` op naming
+ * that shape. The component's code, and everything only it imports, is not in
+ * the bundle. Dart needs the shapes before the bundle runs:
+ * `runtime.registerBaked(jsonDecode(await rootBundle.loadString('assets/js/baked.json')))`.
+ *
+ * In `fuse dev` the plugin is not installed and the module is an ordinary
+ * component.
+ *
+ * Limits of the prototype: no props, no event handlers inside (a handler
+ * would be registered in the build process and be gone), nothing inside can
+ * be updated from JS, one root element.
+ */
+export function fuseBakedPlugin(opts: {
+  projectRoot: string;
+  /** Vite config for the nested build of one baked module (the app's config, without this plugin). */
+  innerConfig: () => InlineConfig;
+  /** Where `baked.json` is written (the app's `assets/js`). */
+  outDir: string;
+  host?: PrerenderHost;
+}): Plugin {
+  const shapes: Record<string, any> = {};
+  const tmp = join(opts.projectRoot, "node_modules", ".fuse-baked");
+  let n = 0;
+  return {
+    name: "fuse-baked",
+    enforce: "pre",
+    async load(id) {
+      const file = id.split("?")[0];
+      if (!/\.baked\.[jt]sx?$/.test(file)) return null;
+      const key = relative(opts.projectRoot, file);
+      mkdirSync(tmp, { recursive: true });
+      const entry = join(tmp, `entry-${n++}.tsx`);
+      writeFileSync(
+        entry,
+        `import Baked from ${JSON.stringify(file)};\nimport { render } from "solid-fuse";\nrender(() => Baked({}));\n`,
+      );
+      const inner = opts.innerConfig();
+      await viteBuild({
+        ...inner,
+        logLevel: "silent",
+        build: {
+          ...inner.build,
+          sourcemap: false,
+          emptyOutDir: false,
+          outDir: tmp,
+          lib: { entry, formats: ["iife"], name: "FuseBaked", fileName: () => `out-${n}.js` },
+        },
+      });
+      const r = prerenderBundle(join(tmp, `out-${n}.js`), opts.host);
+      const { shape, size } = opsToShape(JSON.parse(r.json));
+      shapes[key] = shape;
+      return (
+        `import { _baked } from "solid-fuse";\n` +
+        `export default function Baked() { return _baked(${JSON.stringify(key)}, ${JSON.stringify(shape.t)}, ${size}); }\n`
+      );
+    },
+    closeBundle() {
+      if (Object.keys(shapes).length === 0) return;
+      mkdirSync(opts.outDir, { recursive: true });
+      writeFileSync(join(opts.outDir, "baked.json"), JSON.stringify(shapes));
+      rmSync(tmp, { recursive: true, force: true });
+    },
+  };
+}
