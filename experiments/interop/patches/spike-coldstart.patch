+// A small app for the cold-start measurements (REPORT-13-cold-start.md): one
+// screen of 26 nodes, a tap handler, nothing else imported.
+import { render, View, Text, GestureDetector, For, channels } from "solid-fuse";
+import { createSignal } from "solid-js";
+
+declare const __COLD_GREETING__: string;
+const GREETING: string = typeof __COLD_GREETING__ === "string" ? __COLD_GREETING__ : "Hello";
+const [taps, setTaps] = createSignal(0);
+const ROWS = ["Inbox", "Starred", "Sent", "Drafts", "Archive"];
+
+function Home() {
+  return (
+    <View padding={24} flex={{ gap: 12 }}>
+      <Text fontSize={24} fontWeight="bold">Small app</Text>
+      <GestureDetector onTap={() => setTaps(taps() + 1)}>
+        <View padding={12} decoration={{ color: "#e8f0ff", borderRadius: 8 }}>
+          <Text fontSize={16}>{`${GREETING}. Taps: ${taps()}`}</Text>
+        </View>
+      </GestureDetector>
+      <For each={ROWS}>
+        {(name) => (
+          <View padding={{ horizontal: 12, vertical: 8 }} decoration={{ color: "#ffffff", borderRadius: 8 }}>
+            <Text fontSize={15}>{name}</Text>
+          </View>
+        )}
+      </For>
+    </View>
+  );
+}
+
+const coldMark = (name: string) => (globalThis as any).__fuseMark?.(name);
+coldMark("render0");
+render(() => <Home />);
+coldMark("render1");
+channels.send("coldReady", {});
