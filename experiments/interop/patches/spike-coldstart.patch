+
+/// A first screen: view#1 > [gestureDetector#2 > text#3 > "Taps: 0"#4, text#5 > "b"#6].
+List<dynamic> screen({String label = 'Taps: 0', int width = 40, bool extra = false}) => [
+      create, 1, 'view', {'width': width, 'padding': {'left': 1}},
+      create, 2, 'gestureDetector', {'onTap': true},
+      create, 3, 'text', {'fontSize': 16},
+      createText, 4, label,
+      insert, 3, 4, 0,
+      insert, 2, 3, 0,
+      insert, 1, 2, 0,
+      create, 5, 'text', <String, dynamic>{},
+      createText, 6, 'b',
+      insert, 5, 6, 0,
+      insert, 1, 5, 1,
+      if (extra) ...[create, 7, 'view', <String, dynamic>{}, insert, 1, 7, 2],
+      insert, 0, 1, 0,
+    ];
+
+void main() {
+  late FuseRuntime rt;
+  FuseNode node(int id) => rt.registry.get(id);
+  void live(List<dynamic> ops) => rt.receiveOpsForTest({'json': jsonEncode(ops), 'n': 0});
+
+  setUp(() => rt = FuseRuntime.forTest());
+
+  test('applyPrerendered builds the tree before any JS batch', () {
+    final n = rt.applyPrerendered(jsonEncode(screen()));
+    expect(n, 12);
+    expect(rt.isPrerendered, isTrue);
+    expect(node(0).children.single.id, 1);
+    expect(node(4).props['text'], 'Taps: 0');
+    expect(rt.takeoverResult, isNull);
+  });
+
+  test('hydrate: an identical first batch keeps every node and notifies nobody', () {
+    rt.applyPrerendered(jsonEncode(screen()));
+    final before = [for (var i = 0; i <= 6; i++) node(i)];
+    var notified = 0;
+    for (final n in before) {
+      n.addListener(() => notified++);
+    }
+    live(screen());
+    expect(rt.takeoverResult, 'identical');
+    expect(rt.isPrerendered, isFalse);
+    expect(notified, 0);
+    for (var i = 0; i <= 6; i++) {
+      expect(node(i), same(before[i]));
+    }
+  });
+
+  test('hydrate: a different text or prop is patched in place; only those nodes are notified', () {
+    rt.applyPrerendered(jsonEncode(screen()));
+    final view = node(1), text = node(4), other = node(6);
+    var viewN = 0, textN = 0, otherN = 0;
+    view.addListener(() => viewN++);
+    text.addListener(() => textN++);
+    other.addListener(() => otherN++);
+    live(screen(label: 'Taps: 3', width: 50));
+    expect(rt.takeoverResult, 'patched');
+    expect(node(1), same(view));
+    expect(node(4), same(text));
+    expect(text.props['text'], 'Taps: 3');
+    expect(view.props['width'], 50);
+    expect(view.props['padding'], {'left': 1});
+    expect(viewN, 1);
+    expect(textN, 1);
+    expect(otherN, 0);
+  });
+
