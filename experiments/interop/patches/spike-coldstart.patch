+    rt.applyPrerendered(jsonEncode(screen()));
+    live(screen());
+    live([remove, 1, 5]);
+    expect(node(1).children.map((c) => c.id), [2]);
+    expect(rt.registry.tryGet(6), isNull);
+  });
+
+  test('events before the takeover are held, not sent; dropped by default', () {
+    rt.applyPrerendered(jsonEncode(screen()));
+    // No connection in a test runtime: a send would be a no-op either way, so
+    // observe the queue through replay below. Here: must not throw.
+    rt.callFunction(2, 'onTap');
+    live(screen());
+    expect(rt.takeoverResult, 'identical');
+  });
