+import { afterAll, expect, test } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import { prerenderBundle } from "./prerender";
+
+// prerenderBundle runs a bundle in a child Bun process with a stub bridge and
+// returns the op batches of its first render as one batch. These "bundles"
+// are hand-written scripts that talk to the bridge directly.
+const dir = mkdtempSync(join(tmpdir(), "fuse-prerender-"));
+afterAll(() => rmSync(dir, { recursive: true, force: true }));
+const bundle = (name: string, code: string) => {
+  const p = join(dir, name);
+  writeFileSync(p, code);
+  return p;
+};
+
+test("batches sent while the bundle runs (and in microtasks) are concatenated and counted", () => {
+  const p = bundle(
+    "a.js",
+    `fjs.bridge_call({ channel: "_ops", json: JSON.stringify([0, 1, "view", { w: 1 }, 1, 2, "hi", 4, 1, 2, 0]), n: 3 });
+     fjs.bridge_call({ channel: "storage", key: "token" });
+     Promise.resolve().then(() => fjs.bridge_call({ channel: "_ops", json: JSON.stringify([4, 0, 1, 0]), n: 1 }));`,
+  );
+  const r = prerenderBundle(p);
+  expect(JSON.parse(r.json)).toEqual([0, 1, "view", { w: 1 }, 1, 2, "hi", 4, 1, 2, 0, 4, 0, 1, 0]);
+  expect(r.ops).toBe(4);
+  expect(r.nodes).toBe(2);
+  expect(r.batches).toBe(2);
+  expect(r.calls).toEqual(["storage"]);
+});
+
+test("the bundle sees the host facts the build chose", () => {
+  const p = bundle(
+    "b.js",
+    `fjs.bridge_call({ channel: "_ops", json: JSON.stringify([1, 1, __fuseHost.platform + "/" + __fuseHost.brightness, 4, 0, 1, 0]), n: 2 });`,
+  );
+  const r = prerenderBundle(p, { mode: "release", platform: "ios", brightness: "dark" });
+  expect(JSON.parse(r.json)[2]).toBe("ios/dark");
+});
+
+test("a channel call gets no answer and fetch never settles: the screen is what renders without them", () => {
+  const p = bundle(
+    "c.js",
+    `let label = "signed out";
+     fjs.bridge_call({ channel: "auth" }).then((u) => { if (u) label = "signed in"; });
+     fetch("https://example.invalid/").then(() => { label = "fetched"; });
+     setTimeout(() => {}, 0);
+     Promise.resolve().then(() => Promise.resolve()).then(() =>
+       fjs.bridge_call({ channel: "_ops", json: JSON.stringify([1, 1, label, 4, 0, 1, 0]), n: 2 }));`,
+  );
+  expect(JSON.parse(prerenderBundle(p).json)[2]).toBe("signed out");
+});
+
+test("a batch JSON cannot carry is refused", () => {
+  const p = bundle("d.js", `fjs.bridge_call({ channel: "_ops", ops: [0, 1, "view", { at: new Date() }] });`);
+  expect(() => prerenderBundle(p)).toThrow("JSON cannot carry");
+});
+
+test("a bundle that throws fails the prerender", () => {
+  const p = bundle("e.js", `throw new Error("boom");`);
+  expect(() => prerenderBundle(p)).toThrow("prerender failed");
+});
