+#!/usr/bin/env python3
+"""Report 14: medians (min-max) of numeric fields per record name.
+
+    python3 tools/r14-agg.py [-s suite] [-f field,field] [-n name-substring] file [file ...]
+
+Files are pooled. Records from the detail pass are skipped for timings.
+Nested dist() objects (anim suite) are flattened as field.p50Ms etc.
+"""
+import json, sys
+from statistics import median
+args = sys.argv[1:]
+suite = fields = sub = None
+files = []
+while args:
+    a = args.pop(0)
+    if a == "-s": suite = args.pop(0)
+    elif a == "-f": fields = args.pop(0).split(",")
+    elif a == "-n": sub = args.pop(0)
+    else: files.append(a)
+recs, order, checks = {}, [], [0, 0]
+for f in files:
+    for line in open(f):
+        if not line.startswith("BENCH {"): continue
+        d = json.loads(line[6:])
+        if d.get("name") == "list_order_check":
+            checks[1] += 1; checks[0] += 1 if d.get("dartTreeMatchesJs") else 0
+            continue
+        if suite and d.get("suite") != suite: continue
+        if sub and sub not in d["name"]: continue
+        if d.get("detail"): continue
+        flat = {}
+        for k, v in d.items():
+            if isinstance(v, dict) and k not in ("kinds", "types", "ft"):
+                for k2, v2 in v.items(): flat[f"{k}.{k2}"] = v2
+            else: flat[k] = v
+        if d["name"] not in recs: order.append(d["name"])
+        recs.setdefault(d["name"], []).append(flat)
+def fmt(v):
+    m = median(v)
+    nd = 0 if abs(m) >= 100 else (1 if abs(m) >= 10 else 2)
+    return f"{m:.{nd}f} ({min(v):.{nd}f}–{max(v):.{nd}f})"
+DEFAULT = ["jsMs","decodeMs","applyMs","uiFrameMs","preDrawMs","buildMs","layoutMs","paintMs","compositeMs","semanticsMs","finalizeMs","totalMs","e2eMs","elements","renderObjects"]
+fields = fields or DEFAULT
+print("| record | n | load | " + " | ".join(fields) + " |")
+print("|---|---:|---|" + "---:|" * len(fields))
+for name in order:
+    rs = recs[name]
+    cells = []
+    for k in fields:
+        v = [float(r[k]) for r in rs if isinstance(r.get(k), (int, float)) and not isinstance(r.get(k), bool)]
+        cells.append(fmt(v) if v else "")
+    loads = [float(r["load"]) for r in rs if "load" in r]
+    print(f"| {name} | {len(rs)} | {min(loads):.2f}–{max(loads):.2f} | " + " | ".join(cells) + " |")
+if checks[1]: print(f"\nlist-order checks: {checks[0]}/{checks[1]}")
