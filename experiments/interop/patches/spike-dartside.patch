+        final end = start + (horizontal ? child.size.width : child.size.height);
+        if (end > extent + precisionErrorTolerance || start < -precisionErrorTolerance) overflowing = true;
+        if (shift != Offset.zero) pd.offset = o + shift;
+        child = pd.nextSibling;
+      }
