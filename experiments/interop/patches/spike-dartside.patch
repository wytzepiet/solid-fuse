+  });
+
+  testWidgets('children: add, remove, reorder keep elements and state; one child to two keeps the first', (tester) async {
+    final rt = makeRuntime(lean: true);
+    rt.applyOps([
+      create, 1, 'view', <String, dynamic>{},
+      create, 2, 'view', <String, dynamic>{'width': 10, 'height': 10},
