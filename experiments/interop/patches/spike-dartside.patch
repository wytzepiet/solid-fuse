+    direction = flex.direction;
+    spacing = flex.gap;
+    crossAxisAlignment = flex.crossAxis;
+    mainAxisAlignment = flex.mainAxis;
+    mainAxisSize = flex.mainAxisSize;
+    this.textDirection = textDirection;
+
