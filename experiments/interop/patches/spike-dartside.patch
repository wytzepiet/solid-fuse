+// Report 14: the Dart side of a frame.
+//
+//   fa     plain-Flutter versions of the benchmark screens (cards, list,
+//          update rows), with the frame split into phases; ablations of the
+//          card (no text, no decoration); paragraph layout alone; the cost of
+//          a frame with nothing to do; all six one-signal updates.
+//   anim   an animation driven from JS: N boxes, one step per frame (or per
+//          8 ms timer), per-frame UI-thread work and dropped frames.
+//   prof   profile mode only: CPU samples and heap/allocation deltas through
+//          the VM service, written as JSON for tools/r14-prof.py.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:developer' as dev;
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/semantics.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+import 'package:vm_service/vm_service.dart' as vms;
+import 'package:vm_service/vm_service_io.dart';
+
+import 'harness.dart';
+import 'suite_attr.dart';
+
+/// When non-null, shown instead of the Fuse tree.
+final nativeWidget = ValueNotifier<Widget?>(null);
+
+Map<String, int> fullCounts() {
+  var elements = 0, renderObjects = 0, component = 0, stateful = 0, inherited = 0;
+  void visit(Element e) {
+    elements++;
+    if (e is RenderObjectElement) renderObjects++;
+    if (e is ComponentElement) component++;
+    if (e is StatefulElement) stateful++;
+    if (e is InheritedElement) inherited++;
+    e.visitChildren(visit);
+  }
+
+  WidgetsBinding.instance.rootElement?.visitChildren(visit);
+  var layers = 0;
+  void lv(Layer? l) {
+    if (l == null) return;
+    layers++;
+    if (l is ContainerLayer) {
+      for (var c = l.firstChild; c != null; c = c.nextSibling) {
+        lv(c);
+      }
+    }
+  }
+
+  // ignore: invalid_use_of_protected_member
+  lv(RendererBinding.instance.renderViews.first.layer);
+  return {
+    'elements': elements,
+    'renderObjects': renderObjects,
+    'componentElements': component,
+    'statefulElements': stateful,
+    'layers': layers,
+  };
+}
+
+Map<String, int> typeCounts() {
+  final m = <String, int>{};
+  void visit(Element e) {
+    final k = e is RenderObjectElement ? 'RO:${e.renderObject.runtimeType}' : 'W:${e.widget.runtimeType}';
+    m[k] = (m[k] ?? 0) + 1;
+    e.visitChildren(visit);
+  }
+
+  WidgetsBinding.instance.rootElement?.visitChildren(visit);
+  final keys = m.keys.toList()..sort((a, b) => m[b]!.compareTo(m[a]!));
+  return {for (final k in keys.take(16)) k: m[k]!};
+}
+
+// ---- plain-Flutter screens ----------------------------------------------------------
+
+const _colors = [0xFF3366FF, 0xFF2E9E5B, 0xFFE08A00, 0xFFD64545, 0xFF7A4FD6, 0xFF0AA5A5, 0xFFC2478F, 0xFF5B6B7A];
+
+/// The card of `NativeCard` with parts removed, to attribute layout and paint.
+class AblCard extends StatelessWidget {
+  const AblCard(this.i, {required this.text, required this.deco, super.key});
+  final int i;
+  final bool text, deco;
+
+  Widget _t(String s, double w, double h, TextStyle style, {int? maxLines, TextOverflow? overflow}) =>
+      text ? Text(s, style: style, maxLines: maxLines, overflow: overflow) : SizedBox(width: w, height: h);
+  Widget _d(BoxDecoration d, Widget child) => deco ? DecoratedBox(decoration: d, child: child) : child;
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 8),
+      child: _d(
+        BoxDecoration(
+          color: const Color(0xFFFFFFFF),
+          borderRadius: BorderRadius.circular(12),
+          border: Border.all(color: const Color(0xFFE2E2E2)),
+        ),
+        Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            spacing: 12,
+            children: [
+              SizedBox(
+                width: 40,
+                height: 40,
+                child: _d(
+                  BoxDecoration(color: Color(_colors[i % 8]), shape: BoxShape.circle),
+                  Align(
+                    child: _t(String.fromCharCode(65 + i % 26), 10, 20,
+                        const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
+                  ),
+                ),
+              ),
+              Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.start,
+                spacing: 2,
+                children: [
+                  _t('Item title $i', 90, 23, const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
+                  _t('Subtitle for row $i, with some detail', 220, 19,
+                      const TextStyle(fontSize: 13, color: Color(0xFF666666)),
+                      maxLines: 1, overflow: TextOverflow.ellipsis),
+                ],
+              ),
+              _t('${i % 60}m', 22, 17, const TextStyle(fontSize: 12, color: Color(0xFF999999))),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+Widget _scroll(List<Widget> children, double pad) => SingleChildScrollView(
+      child: Padding(
+        padding: EdgeInsets.all(pad),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: children,
+        ),
+      ),
+    );
+
+class NRow {
+  NRow(this.id, this.name, this.value);
+  final int id;
+  final String name;
+  final int value;
+}
+
+/// `ListScreen` in plain Flutter: keyed rows of two texts.
+class NativeList extends StatelessWidget {
+  const NativeList(this.rows, {super.key});
+  final List<NRow> rows;
+  @override
+  Widget build(BuildContext context) => _scroll([
+        for (final r in rows)
+          Padding(
+            key: ValueKey(r.id),
+            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+            child: Row(
+              mainAxisSize: MainAxisSize.min,
+              spacing: 8,
+              children: [
+                Text(r.name, style: const TextStyle(fontSize: 13)),
+                Text('${r.value}', style: const TextStyle(fontSize: 13, color: Color(0xFF777777))),
+              ],
+            ),
+          ),
+      ], 8);
+}
+
+/// `UpdateScreen` in plain Flutter: 1,000 rows, each its own State so that an
+/// update rebuilds only the rows that changed (what Fuse does per node).
+final _updRows = <_NUpdRowState>[];
+
+class NUpdRow extends StatefulWidget {
+  const NUpdRow(this.i, {super.key});
+  final int i;
+  @override
+  State<NUpdRow> createState() => _NUpdRowState();
+}
+
+class _NUpdRowState extends State<NUpdRow> {
+  int t = 0, c = 0;
+  @override
+  void initState() {
+    super.initState();
+    _updRows.add(this);
+  }
+
+  @override
+  void dispose() {
+    _updRows.remove(this);
+    super.dispose();
+  }
+
+  void bump({bool text = false, bool color = false}) => setState(() {
+        if (text) t++;
+        if (color) c++;
+      });
+
+  @override
+  Widget build(BuildContext context) => DecoratedBox(
+        decoration: BoxDecoration(color: c.isEven ? const Color(0xFFFFFFFF) : const Color(0xFFE8F0FF)),
+        child: Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
+          child: Text('Row ${widget.i}: $t', style: const TextStyle(fontSize: 12)),
+        ),
+      );
+}
+
+class NativeUpdate extends StatelessWidget {
+  const NativeUpdate({super.key});
+  @override
+  Widget build(BuildContext context) => _scroll([for (var i = 0; i < 1000; i++) NUpdRow(i)], 8);
+}
+
+int _seed = 0x2545f491;
+int _rnd() {
+  _seed ^= (_seed << 13) & 0xFFFFFFFF;
+  _seed ^= _seed >> 17;
+  _seed ^= (_seed << 5) & 0xFFFFFFFF;
+  return _seed & 0xFFFFFFFF;
+}
+
+int _nextId = 1;
+List<NRow> makeNRows(int n) => List.generate(n, (_) {
+      final id = _nextId++;
+      return NRow(id, 'Row $id', _rnd() % 100000);
+    });
+
+/// Runs [change] and reports the frame that shows it.
+Future<void> nativeOp(String s, String name, Map<String, dynamic> x, void Function() change, {bool counts = false}) async {
+  final before = counts ? fullCounts() : null;
+  final t0 = now();
+  change();
+  await SchedulerBinding.instance.endOfFrame;
+  final t1 = now();
+  final p = phases();
+  final frame = BenchBinding.endAt - BenchBinding.beginAt;
+  final after = counts ? fullCounts() : null;
+  emit(s, name, {
+    ...x,
+    'totalMs': ms(t1 - t0),
+    'uiFrameMs': ms(frame),
+    ...p,
+    if (after != null)
+      for (final k in after.keys) k: after[k]! - before![k]!,
+  });
+}
+
+Future<void> fa() async {
+  const s = 'fa';
+  final reps = envInt('REPS', 7);
+  emit(s, 'env', {
+    'semanticsEnabled': SemanticsBinding.instance.semanticsEnabled,
+    'refreshHz': WidgetsBinding.instance.platformDispatcher.views.first.display.refreshRate,
+    'fuseLean': env['FUSE_LEAN'] ?? '',
+  });
+
+  // A frame with nothing to do.
+  await cmd('clear');
+  await settle(200);
+  for (var r = 0; r < reps * 3; r++) {
+    final t0 = now();
+    SchedulerBinding.instance.scheduleFrame();
+    await SchedulerBinding.instance.endOfFrame;
+    final t1 = now();
+    emit(s, 'idle_frame', {
+      'rep': r,
+      'waitMs': ms(BenchBinding.beginAt - t0),
+      'uiFrameMs': ms(BenchBinding.endAt - BenchBinding.beginAt),
+      'totalMs': ms(t1 - t0),
+      ...phases(),
+    });
+    await Future<void>.delayed(const Duration(milliseconds: 20));
+  }
+
+  // Fuse: counts by type for the three screens (once).
+  await cmd('mount', {'nodes': 1000});
+  await settle(200);
+  emit(s, 'fuse_types_mount_1000', {...fullCounts(), 'types': typeCounts()});
+  await cmd('clear');
+  await settle();
+  await cmd('listPrep', {'n': 500});
+  await settle(200);
+  emit(s, 'fuse_types_list_500', {...fullCounts(), 'types': typeCounts()});
+  await cmd('clear');
+  await settle();
+
+  // Fuse: all six one-signal updates, with phases.
+  await cmd('updPrep');
+  await settle(300);
+  emit(s, 'fuse_types_update', {...fullCounts(), 'types': typeCounts()});
+  for (var r = 0; r < reps; r++) {
+    for (final sig in ['t1', 't50', 't1000', 'c1', 'c50', 'c1000']) {
+      await measure(s, 'update_$sig', 'upd', {'sig': sig}, {'rep': r});
+      await settle(30);
+    }
+  }
+  await cmd('clear');
+  await settle();
+
+  for (var r = 0; r < reps; r++) {
+    // Cards.
+    for (final cards in [91, 454]) {
+      await nativeOp(s, 'native_mount_${cards == 91 ? 1000 : 5000}', {'rep': r}, () => nativeWidget.value = NativeScreen(cards), counts: true);
+      await settle();
+      nativeWidget.value = const SizedBox();
+      await settle(100);
+    }
+    // Card ablations.
+    for (final v in ['full', 'notext', 'nodeco', 'bare']) {
+      final text = v == 'full' || v == 'nodeco';
+      final deco = v == 'full' || v == 'notext';
+      await nativeOp(s, 'abl_cards_$v', {'rep': r},
+          () => nativeWidget.value = _scroll([for (var i = 0; i < 91; i++) AblCard(i, text: text, deco: deco)], 16),
+          counts: true);
+      await settle();
+      nativeWidget.value = const SizedBox();
+      await settle(100);
+    }
+    // List: mount 500, replace 500 (twice), then 2,000: sort, shuffle.
+    var rows = makeNRows(500);
+    await nativeOp(s, 'native_list_mount_500', {'rep': r}, () => nativeWidget.value = NativeList(rows), counts: true);
+    await settle();
+    for (var i = 0; i < 2; i++) {
+      rows = makeNRows(500);
+      await nativeOp(s, 'native_list_replace_500', {'rep': r}, () => nativeWidget.value = NativeList(rows));
+      await settle();
+    }
+    nativeWidget.value = const SizedBox();
+    await settle(100);
+    rows = makeNRows(2000);
+    nativeWidget.value = NativeList(rows);
+    await settle(300);
+    rows = [...rows]..sort((a, b) => a.value.compareTo(b.value));
+    await nativeOp(s, 'native_list_sort_2000', {'rep': r}, () => nativeWidget.value = NativeList(rows));
+    await settle();
+    rows = rows.reversed.toList();
+    await nativeOp(s, 'native_list_reverse_2000', {'rep': r}, () => nativeWidget.value = NativeList(rows));
+    await settle();
+    nativeWidget.value = const SizedBox();
+    await settle(100);
+    // Updates.
+    nativeWidget.value = const NativeUpdate();
+    await settle(300);
+    for (final (name, k, text) in [('t1', 1, true), ('t50', 50, true), ('t1000', 1000, true), ('c1', 1, false), ('c50', 50, false), ('c1000', 1000, false)]) {
+      for (var i = 0; i < 2; i++) {
+        await nativeOp(s, 'native_update_$name', {'rep': r}, () {
+          for (var j = 0; j < k; j++) {
+            _updRows[j].bump(text: text, color: !text);
+          }
+        });
+        await settle(30);
+      }
+    }
+    nativeWidget.value = const SizedBox();
+    await settle(100);
+  }
+
+  // Paragraph layout alone: the 364 texts of the 91-card screen, laid out
+  // with TextPainter outside any frame.
+  const styles = [
+    TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14),
+    TextStyle(fontSize: 16, fontWeight: FontWeight.w600, color: Colors.black),
+    TextStyle(fontSize: 13, color: Color(0xFF666666)),
+    TextStyle(fontSize: 12, color: Color(0xFF999999)),
+  ];
+  for (var r = 0; r < reps; r++) {
+    var createUs = 0, layoutUs = 0, n = 0;
+    double w = 0;
+    for (var i = 0; i < 91; i++) {
+      final texts = [String.fromCharCode(65 + i % 26), 'Item title $i@$r', 'Subtitle for row $i, with some detail $r', '${(i + r) % 60}m'];
+      for (var k = 0; k < 4; k++) {
+        final t0 = now();
+        final tp = TextPainter(
+          text: TextSpan(text: texts[k], style: styles[k]),
+          textDirection: TextDirection.ltr,
+          maxLines: k == 2 ? 1 : null,
+          ellipsis: k == 2 ? '…' : null,
+        );
+        final t1 = now();
+        tp.layout(maxWidth: 700);
+        final t2 = now();
+        w += tp.width;
+        tp.dispose();
+        createUs += t1 - t0;
+        layoutUs += t2 - t1;
+        n++;
+      }
+    }
+    emit(s, 'paragraphs_364', {'rep': r, 'n': n, 'createMs': ms(createUs), 'layoutMs': ms(layoutUs), 'w': w.round()});
+    // The same strings again: is there a cache?
+    var again = 0;
+    for (var i = 0; i < 91; i++) {
+      final t0 = now();
+      final tp = TextPainter(text: TextSpan(text: 'Item title $i@$r', style: styles[1]), textDirection: TextDirection.ltr)..layout(maxWidth: 700);
+      again += now() - t0;
+      tp.dispose();
+    }
+    emit(s, 'paragraphs_91_repeat', {'rep': r, 'layoutMs': ms(again)});
+    await settle(20);
+  }
+  nativeWidget.value = null;
+  await settle(100);
+}
+
+// ---- animation driven from JS ----------------------------------------------------------
+
+class _Frame {
+  _Frame(this.begin, this.end, this.build, this.layout, this.paint, this.rest, this.applyUs, this.batches);
+  final int begin, end, build, layout, paint, rest, applyUs, batches;
+}
+
+Future<void> anim() async {
+  const s = 'anim';
+  final reps = envInt('REPS', 3);
+  final frames = envInt('ANIM_FRAMES', 180);
+  FusePerf.on = true;
+  for (var r = 0; r < reps; r++) {
+    for (final backdrop in [0, 91]) {
+      for (final kind in ['transform', 'color', 'opacity', 'size']) {
+        if (backdrop > 0 && kind != 'transform' && kind != 'size') continue;
+        for (final n in [1, 20, 200]) {
+          for (final mode in ['vsync', 'timer8']) {
+            if (backdrop > 0 && mode != 'vsync') continue;
+            await cmd('clear');
+            await settle();
+            await cmd('animPrep', {'n': n, 'kind': kind, 'backdrop': backdrop});
+            await settle(250);
+            final rec = <_Frame>[];
+            var applyUs = 0, batches = 0, handleUs = 0;
+            opsTap = (ops, recv, apply) {
+              applyUs += apply;
+              batches++;
+              // decode + apply, from the bridge callback to the end of applyOps
+              handleUs += (recv + apply) - FusePerf.bridgeEnterAt;
+            };
+            sampler = (t) {
+              rec.add(_Frame(BenchBinding.beginAt, BenchBinding.endAt, BenchBinding.buildUs, BenchBinding.layoutUs,
+                  BenchBinding.paintUs, BenchBinding.bitsUs + BenchBinding.compositeUs + BenchBinding.semanticsUs + BenchBinding.finalizeUs, handleUs, batches));
+              applyUs = 0;
+              batches = 0;
+              handleUs = 0;
+            };
+            final t0 = now();
+            final res = await cmd('animRun', {'frames': frames, 'mode': mode == 'vsync' ? 'vsync' : 'timer', 'everyMs': 8});
+            await SchedulerBinding.instance.endOfFrame;
+            final t1 = now();
+            sampler = null;
+            opsTap = null;
+            // Drop the first frames (first-use warm-up of the prop path).
+            final fs = rec.length > 10 ? rec.sublist(5) : rec;
+            final work = [for (final f in fs) (f.end - f.begin) + f.applyUs];
+            var over16 = 0, over8 = 0, gaps = 0;
+            for (var i = 0; i < fs.length; i++) {
+              if (work[i] > 16667) over16++;
+              if (work[i] > 8333) over8++;
+              if (i > 0 && fs[i].begin - fs[i - 1].begin > 25000) gaps += ((fs[i].begin - fs[i - 1].begin) / 16667).round() - 1;
+            }
+            pending.add(Pending(s, 'anim_${kind}_${n}_${mode}_bd$backdrop', {
+              'rep': r,
+              'kind': kind,
+              'n': n,
+              'mode': mode,
+              'backdrop': backdrop,
+              'steps': res['steps'],
+              'frames': fs.length,
+              'wallMs': ms(t1 - t0),
+              'jsStepMs': ((res['jsSumMs'] as num) / (res['steps'] as num) * 1000).round() / 1000,
+              'jsMaxMs': res['jsMaxMs'],
+              'work': dist(work),
+              'apply': dist([for (final f in fs) f.applyUs]),
+              'build': dist([for (final f in fs) f.build]),
+              'layout': dist([for (final f in fs) f.layout]),
+              'paint': dist([for (final f in fs) f.paint]),
+              'rest': dist([for (final f in fs) f.rest]),
+              'frame': dist([for (final f in fs) f.end - f.begin]),
+              'over16': over16,
+              'over8': over8,
+              'skippedVsyncs': gaps,
+              'load': loadavg(),
+            }, t0, t1));
+          }
+        }
+      }
+    }
+    await flushPending();
+  }
+  FusePerf.on = false;
+  await cmd('clear');
+}
+
+// ---- profile mode: CPU samples and heap through the VM service -----------------------------
+
+Future<void> prof() async {
+  const s = 'prof';
+  final outDir = env['PROF_OUT'] ?? '/tmp/prof';
+  Directory(outDir).createSync(recursive: true);
+  var info = await dev.Service.getInfo();
+  if (info.serverWebSocketUri == null) info = await dev.Service.controlWebServer(enable: true);
+  final uri = info.serverWebSocketUri;
+  if (uri == null) {
+    emit(s, 'error', {'msg': 'no VM service (release build?)'});
+    return;
+  }
+  final svc = await vmServiceConnectUri(uri.toString());
+  final vm = await svc.getVM();
+  final iso = vm.isolates!.firstWhere((i) => i.name == 'main').id!;
+  final reps = envInt('REPS', 10);
+
+  Future<void> heap(String name, Future<void> Function() body) async {
+    await svc.getAllocationProfile(iso, gc: true, reset: true);
+    final m0 = await svc.getMemoryUsage(iso);
+    await body();
+    final m1 = await svc.getMemoryUsage(iso);
+    final p = await svc.getAllocationProfile(iso);
+    final cls = [
+      for (final c in p.members!)
+        if ((c.accumulatedSize ?? 0) > 0 || (c.bytesCurrent ?? 0) > 0)
+          {'c': c.classRef!.name, 'lib': c.classRef!.library?.uri, 'n': c.instancesAccumulated, 'b': c.accumulatedSize, 'live': c.instancesCurrent, 'liveB': c.bytesCurrent}
+    ]..sort((a, b) => (b['b'] as int).compareTo(a['b'] as int));
+    final p2 = await svc.getAllocationProfile(iso, gc: true);
+    final live = [
+      for (final c in p2.members!)
+        if ((c.bytesCurrent ?? 0) > 0) {'c': c.classRef!.name, 'lib': c.classRef!.library?.uri, 'live': c.instancesCurrent, 'liveB': c.bytesCurrent}
+    ]..sort((a, b) => (b['liveB'] as int).compareTo(a['liveB'] as int));
+    final m2 = await svc.getMemoryUsage(iso);
+    File('$outDir/heap-$name.json').writeAsStringSync(jsonEncode({
+      'name': name,
+      'heapBefore': m0.heapUsage,
+      'heapAfter': m1.heapUsage,
+      'heapAfterGc': m2.heapUsage,
+      'allocated': cls.take(60).toList(),
+      'liveAfterGc': live.take(60).toList(),
+    }));
+    emit(s, 'heap_$name', {'heapBefore': m0.heapUsage, 'heapAfter': m1.heapUsage, 'heapAfterGc': m2.heapUsage});
+  }
+
+  Future<void> cpu(String name, int n, Future<void> Function() setup, Future<Map<String, dynamic>?> Function() body) async {
+    final windows = <List<int>>[];
+    final all = <Map<String, dynamic>>[];
+    await svc.clearCpuSamples(iso);
+    final tl0 = (await svc.getVMTimelineMicros()).timestamp!;
+    for (var r = 0; r < n; r++) {
+      await setup();
+      final a = now();
+      final m = await body();
+      final b = now();
+      windows.add([a, b]);
+      if (m != null) all.add(m);
+      await settle(40);
+    }
+    final tl1 = (await svc.getVMTimelineMicros()).timestamp!;
+    final samples = await svc.getCpuSamples(iso, tl0, tl1 - tl0);
+    final fns = [
+      for (final f in samples.functions!)
+        {
+          'n': f.function is vms.FuncRef ? (f.function as vms.FuncRef).name : (f.function as vms.NativeFunction).name,
+          'o': f.function is vms.FuncRef ? _owner((f.function as vms.FuncRef).owner) : 'native',
+          'u': f.resolvedUrl,
+        }
+    ];
+    File('$outDir/cpu-$name.json').writeAsStringSync(jsonEncode({
+      'name': name,
+      'period': samples.samplePeriod,
+      'reps': n,
+      'windows': windows,
+      'frames': all,
+      'functions': fns,
+      'samples': [
+        for (final sm in samples.samples!) {'t': sm.timestamp, 'tid': sm.tid, 's': sm.stack}
+      ],
+    }));
+    emit(s, 'cpu_$name', {'samples': samples.samples!.length, 'period': samples.samplePeriod});
+  }
+
+  Future<Map<String, dynamic>?> op(String c, [Map<String, dynamic> a = const {}]) => measure(s, 'op', c, a);
+  Future<void> clear() async {
+    await cmd('clear');
+    await settle();
+  }
+
+  Future<Map<String, dynamic>?> native(void Function() change) async {
+    change();
+    await SchedulerBinding.instance.endOfFrame;
+    return phases();
+  }
+
+  // Heap and allocations of one mount.
+  await clear();
+  await cmd('mount', {'nodes': 1000});
+  await settle(200);
+  await clear();
+  await heap('fuse_mount_1000', () async {
+    await cmd('mount', {'nodes': 1000});
+    await settle(200);
+  });
+  await clear();
+  nativeWidget.value = NativeScreen(91);
+  await settle(200);
+  nativeWidget.value = const SizedBox();
+  await settle(200);
+  await heap('native_mount_1000', () async {
+    nativeWidget.value = NativeScreen(91);
+    await settle(200);
+  });
+  nativeWidget.value = null;
+  await settle(200);
+
+  await cpu('fuse_mount_1000', reps, clear, () => op('mount', {'nodes': 1000}));
+  await cpu('fuse_mount_5000', (reps / 2).ceil(), clear, () => op('mount', {'nodes': 5000}));
+  await clear();
+  await cmd('listPrep', {'n': 500});
+  await settle(200);
+  await cpu('fuse_list_replace_500', reps, () async {}, () => op('listReplace', {'n': 500}));
+  await clear();
+  await cpu('fuse_list_sort_2000', reps, () async {
+    await clear();
+    await cmd('listPrep', {'n': 2000});
+    await settle(300);
+  }, () => op('listSort'));
+  await clear();
+  await cmd('updPrep');
+  await settle(300);
+  for (final sig in ['t1', 't1000', 'c1000']) {
+    await cpu('fuse_update_$sig', sig == 't1' ? reps * 5 : reps * 2, () async {}, () => op('upd', {'sig': sig}));
+  }
+  await clear();
+
+  Future<void> nclear() async {
+    nativeWidget.value = const SizedBox();
+    await settle(100);
+  }
+
+  await cpu('native_mount_1000', reps, nclear, () => native(() => nativeWidget.value = NativeScreen(91)));
+  await cpu('native_mount_5000', (reps / 2).ceil(), nclear, () => native(() => nativeWidget.value = NativeScreen(454)));
+  await nclear();
+  nativeWidget.value = NativeList(makeNRows(500));
+  await settle(200);
+  await cpu('native_list_replace_500', reps, () async {}, () => native(() => nativeWidget.value = NativeList(makeNRows(500))));
+  await nclear();
+  nativeWidget.value = const NativeUpdate();
+  await settle(300);
+  await cpu('native_update_t1000', reps * 2, () async {}, () => native(() {
+        for (final r in _updRows) {
+          r.bump(text: true);
+        }
+      }));
+  await cpu('native_update_c1000', reps * 2, () async {}, () => native(() {
+        for (final r in _updRows) {
+          r.bump(color: true);
+        }
+      }));
+  nativeWidget.value = null;
+  await settle(100);
+  await svc.dispose();
+}
+
+String _owner(dynamic o) {
+  if (o is vms.ClassRef) return o.name ?? '';
+  if (o is vms.LibraryRef) return o.uri ?? '';
+  if (o is vms.FuncRef) return '${_owner(o.owner)}.${o.name}';
+  return '';
+}
