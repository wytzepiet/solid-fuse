+  }
+
+  @override
+  void describeSemanticsConfiguration(SemanticsConfiguration config) {
+    super.describeSemanticsConfiguration(config);
+    config.isBlockingUserActions = _ignorePointer;
+  }
+
+  @override
+  void debugFillProperties(DiagnosticPropertiesBuilder properties) {
+    super.debugFillProperties(properties);
+    properties.add(DiagnosticsProperty<EdgeInsets>('padding', _padding, defaultValue: null));
+    properties.add(DiagnosticsProperty<EdgeInsets>('margin', _margin, defaultValue: null));
