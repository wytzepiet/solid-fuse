diff --git a/examples/perf_bench/tools/r14-prof.py b/examples/perf_bench/tools/r14-prof.py
new file mode 100644
index 0000000..fc93fda
--- /dev/null
+++ b/examples/perf_bench/tools/r14-prof.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""Report 14: reads the CPU-sample dumps of the `prof` suite (profile mode).
+
+    python3 tools/r14-prof.py <dir> <name> [--tree PCT] [--top N] [--under FRAME]
+
+<dir>/cpu-<name>.json. Only samples inside the measured windows count (from
+the command being sent to the end of the frame that shows it). Times are
+samples x period / repetitions, i.e. milliseconds per operation, in a profile
+build with the sampler on (slower than release: use the proportions).
+"""
+import json, sys
+from collections import Counter, defaultdict
+args = sys.argv[1:]
+d, name = args[0], args[1]
+tree_pct = float(args[args.index("--tree") + 1]) if "--tree" in args else None
+top_n = int(args[args.index("--top") + 1]) if "--top" in args else 25
+under = args[args.index("--under") + 1] if "--under" in args else None
+j = json.load(open(f"{d}/cpu-{name}.json"))
+fns = j["functions"]
+def label(i):
+    f = fns[i]
+    o = f["o"]
+    if o == "native": return f["n"]
+    if o.startswith("dart:") or o.startswith("package:") or o.startswith("file:"): return f["n"]
+    return f"{o}.{f['n']}"
+labels = [label(i) for i in range(len(fns))]
+wins = j["windows"]
+samples = [s for s in j["samples"] if any(a <= s["t"] <= b for a, b in wins)]
+# the UI isolate's thread is the one with the most samples
+tids = Counter(s["tid"] for s in samples)
+main_tid = tids.most_common(1)[0][0] if tids else None
+samples = [s for s in samples if s["tid"] == main_tid]
+per = j["period"] / 1000.0 / j["reps"]  # ms per op per sample
+total = len(samples)
+print(f"# {name}: {total} samples in {j['reps']} ops, period {j['period']} us -> {total*per:.1f} ms sampled per op")
+# Deep element recursion overflows the sampler's stack depth, so the frame
+# that names the phase (buildScope, flushLayout, ...) is often cut off; the
+# phase is taken from the innermost frames that identify it.
+PH = [("semantics", ("flushSemantics", "_RenderObjectSemantics", "SemanticsOwner", "SemanticsNode", "SemanticsConfiguration", "_SemanticsConfigurationProvider", "SemanticsUpdateBuilder", "updateSemantics")),
+      ("layout", ("flushLayout", "performLayout", "RenderObject.layout", "TextPainter.layout")),
+      ("paint", ("flushPaint", "PaintingContext", "repaintCompositedChild")),
+      ("compositing bits", ("flushCompositingBits", "_updateCompositingBits")),
+      ("composite", ("compositeFrame", "buildScene", "addToScene")),
+      ("finalize (unmount)", ("finalizeTree", "_InactiveElements", "Element.unmount", "_unmount")),
+      ("applyOps", ("FuseRuntime.applyOps", "FuseRuntime._instantiate", "FuseRuntime._removeSubtree")),
+      ("decode", ("jsonDecode", "_JsonParser", "_ChunkedJsonParser")),
+      ("build", ("buildScope", "Element.", "Element.inflateWidget", "performRebuild", "ComponentElement", "RenderObjectElement", "StatelessElement", "FuseBoxElement", ".build", "mount"))]
+def phase(stack_labels):
+    for n, pats in PH:
+        if any(p in l for l in stack_labels for p in pats): return n
+    return "other"
+ph = Counter(); vm = Counter(); self_c = Counter(); incl = Counter()
+phase_of = []
+for s in samples:
+    ls = [labels[i] for i in s["s"]]
+    p = phase(ls); phase_of.append(p); ph[p] += 1
+    vm[s.get("v") or "?"] += 1
+    if ls: self_c[ls[0]] += 1
+    for l in set(ls): incl[l] += 1
+print("\n| phase | ms per op | % |\n|---|---:|---:|")
+for n, c in ph.most_common(): print(f"| {n} | {c*per:.2f} | {100*c/total:.0f} |")
+gc = [e for e in j.get("gc", []) if e.get("ph") == "X" and e.get("dur")]
+if gc:
+    byname = defaultdict(lambda: [0, 0])
+    for e in gc: byname[e["n"]][0] += 1; byname[e["n"]][1] += e["dur"]
+    print("\n| GC events in the windows (all threads) | count per op | ms per op |\n|---|---:|---:|")
+    for n, (c, dur) in sorted(byname.items(), key=lambda kv: -kv[1][1]): print(f"| {n} | {c/j['reps']:.1f} | {dur/1000/j['reps']:.2f} |")
+print(f"\n| self time, top {top_n} | ms per op | % |\n|---|---:|---:|")
+for n, c in self_c.most_common(top_n): print(f"| `{n}` | {c*per:.2f} | {100*c/total:.1f} |")
+MARK = ["TextPainter.layout", "RenderParagraph.performLayout", "RenderFlex.performLayout", "RenderFuseBox.performLayout",
+        "RenderPadding.performLayout", "RenderConstrainedBox.performLayout", "RenderPositionedBox.performLayout",
+        "RenderParagraph.paint", "RenderDecoratedBox.paint", "RenderFuseBox.paint", "_FuseNodeElement", "FuseNodeWidget.build",
+        "FuseViewWidget", "FuseText.", "Text.build", "RichText.createRenderObject", "RichText.updateRenderObject",
+        "FuseBox._apply", "FuseBox.createRenderObject", "_TextConfig", "FuseTextLeaf.createRenderObject", "FuseTextLeaf.updateRenderObject",
+        "Element.inflateWidget", "Element.updateChild", "Element.updateChildren", "RenderObjectElement.mount", "ComponentElement.mount",
+        "Element.dependOnInheritedWidgetOfExactType", "InheritedModel.inheritFrom", "MediaQuery.", "DefaultTextStyle.of",
+        "createLocalImageConfiguration", "parseBoxDecoration", "parseEdgeInsets", "parseColor", "TextStyle.merge",
+        "ParagraphBuilder", "_NativeParagraph", "TextPainter._createParagraph", "TextSpan.build", "TextStyle.getTextStyle",
+        "RenderObject.markNeedsLayout", "RenderObject.markNeedsPaint", "RenderObject.attach", "RenderObject.adoptChild",
+        "ChangeNotifier.addListener", "FuseNode.", "FuseRuntime._instantiate", "SemanticsOwner", "RenderObject._getSemantics",
+        "Element.unmount", "Element.deactivateChild", "RenderObject.dispose", "Paragraph.dispose", "BoxPainter", "_BoxDecorationPainter.paint",
+        "PaintingContext.paintChild", "Canvas.", "_NativeCanvas", "PictureRecorder", "GC", "Element._sort", "BuildScope._flushDirtyElements"]
+print("\n| inclusive (any frame matching) | ms per op | % |\n|---|---:|---:|")
+for m in MARK:
+    c = sum(1 for s in samples if any(m in labels[i] for i in s["s"]))
+    if c: print(f"| `{m}` | {c*per:.2f} | {100*c/total:.1f} |")
+if tree_pct is not None:
+    # top-down tree; stacks are leaf first
+    root = {"n": 0, "c": {}}
+    for s in samples:
+        ls = [labels[i] for i in reversed(s["s"])]
+        if under:
+            idx = next((k for k, l in enumerate(ls) if under in l), None)
+            if idx is None: continue
+            ls = ls[idx:]
+        node = root; node["n"] += 1
+        for l in ls:
+            node = node["c"].setdefault(l, {"n": 0, "c": {}}); node["n"] += 1
+    base = root["n"] or 1
+    print(f"\n```\ntop-down, branches >= {tree_pct}% of {'the samples under ' + under if under else 'all samples'} ({base*per:.1f} ms per op)")
+    def walk(node, depth):
+        kids = sorted(node["c"].items(), key=lambda kv: -kv[1]["n"])
+        for l, k in kids:
+            if 100 * k["n"] / base < tree_pct: continue
+            # collapse chains with one significant child
+            chain = [l]; cur = k
+            while True:
+                sig = [(l2, k2) for l2, k2 in cur["c"].items() if 100 * k2["n"] / base >= tree_pct]
+                if len(sig) == 1 and sig[0][1]["n"] >= 0.92 * cur["n"]:
+                    chain.append(sig[0][0]); cur = sig[0][1]
+                else: break
+            shown = chain[0] if len(chain) == 1 else f"{chain[0]} > ... > {chain[-1]}" if len(chain) > 2 else " > ".join(chain)
+            print(f"{'  '*depth}{k['n']*per:6.2f} ms {100*k['n']/base:4.1f}%  {shown}")
+            walk(cur, depth + 1)
+    walk(root, 0)
+    print("```")
diff --git a/examples/perf_bench/tools/r14-run.sh b/examples/perf_bench/tools/r14-run.sh
