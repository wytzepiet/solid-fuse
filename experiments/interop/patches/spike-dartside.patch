+    var seen = 0;
+    List<FuseNode>? block;
+    for (final b in _blocks) {
+      if (at <= seen + b.length) {
+        block = b;
+        break;
+      }
+      seen += b.length;
+    }
+    if (block == null) _blocks.add(block = []);
+    block.insert(at - seen, child);
+    _where[child] = block;
+    child.parent = parent;
+    _length++;
