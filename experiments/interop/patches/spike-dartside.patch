+// `view` as one widget, one element and one render object.
+//
+// `FuseViewWidget` (view.dart) builds a stack of single-purpose widgets around
+// a Flex: Flexible > Visibility > IgnorePointer > Padding (margin) >
+// Transform x3 > Opacity > ConstrainedBox > SizedBox > AspectRatio >
+// DecoratedBox x2 > Clip > Align > Padding > Flex. `RenderFuseBox` does the
+// same layout, painting and hit testing in that order in a single render
+// object, and its element watches the node, so a prop change goes from the
+// node to the render object without building a widget.
+import 'dart:collection';
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/widgets.dart';
+
+import '../lean.dart';
+import '../node.dart';
+import '../perf.dart';
+
+/// The widget of a `view` node. One instance per node (`FuseNode.selfWidget`).
+class FuseBox extends RenderObjectWidget {
+  FuseBox(this.node) : super(key: ValueKey<int>(node.id));
+
+  final FuseNode node;
+
+  @override
+  RenderObjectElement createElement() => FuseBoxElement(this);
+
+  @override
+  RenderFuseBox createRenderObject(BuildContext context) {
+    final box = RenderFuseBox();
+    _sync(context, box);
+    return box;
+  }
+
+  @override
+  void updateRenderObject(BuildContext context, RenderFuseBox renderObject) => _sync(context, renderObject);
+
+  void _sync(BuildContext context, RenderFuseBox box) {
+    if (!FusePerf.on) {
+      _apply(context, box);
+      return;
+    }
+    final t = FusePerf.now;
+    _apply(context, box);
+    FusePerf.widgetBuildUs += FusePerf.now - t;
+    FusePerf.widgetBuilds++;
+  }
+
+  void _apply(BuildContext context, RenderFuseBox box) {
+    final node = this.node;
+    final decoration = node.boxDecoration('decoration');
+    final foreground = node.boxDecoration('foregroundDecoration');
+    final transform = node.map('transform');
+    final clip = node.string('clipBehavior');
+    final direction = Directionality.maybeOf(context);
+    final needsImages = decoration?.image != null || foreground?.image != null;
+    box.configure(
+      flex: node.flexSpec,
+      textDirection: direction,
+      padding: node.edgeInsets('padding'),
+      margin: node.edgeInsets('margin'),
+      width: node.double('width'),
+      height: node.double('height'),
+      minWidth: node.double('minWidth'),
+      maxWidth: node.double('maxWidth'),
+      minHeight: node.double('minHeight'),
+      maxHeight: node.double('maxHeight'),
+      aspectRatio: node.double('aspectRatio'),
+      alignment: node.alignment('alignment'),
+      decoration: decoration,
+      foregroundDecoration: foreground,
+      configuration: needsImages
+          ? createLocalImageConfiguration(context)
+          : (direction == TextDirection.rtl ? _rtlConfiguration : _ltrConfiguration),
+      clip: clip == null ? Clip.none : node.clipBehavior('clipBehavior'),
+      rotate: transform?.double('rotate'),
+      scale: transform?.double('scale'),
+      translateX: transform?.double('translateX'),
+      translateY: transform?.double('translateY'),
+      opacity: node.double('opacity'),
+      visible: node.bool('visible') ?? true,
+      ignorePointer: node.bool('ignorePointer') ?? false,
+    );
+  }
+
+  static const _ltrConfiguration = ImageConfiguration(textDirection: TextDirection.ltr);
+  static const _rtlConfiguration = ImageConfiguration(textDirection: TextDirection.rtl);
+
+  // Same identity in the widget inspector as FuseNodeWidget.
+  @override
+  String toStringShort() => node.component != null ? '${node.type} «${node.component}»' : node.type;
+
+  @override
+  void debugFillProperties(DiagnosticPropertiesBuilder properties) {
+    super.debugFillProperties(properties);
+    properties.add(StringProperty('fuseType', node.type, quoted: false));
+    if (node.component != null) {
+      properties.add(StringProperty('component', node.component, quoted: false));
+    }
+    properties.add(IntProperty('nodeId', node.id));
+  }
+}
+
+/// Applies `grow` / `fit` of [node] to [renderObject]'s parent data when its
+/// parent lays out with flex parent data (what `Flexible` does).
+void applyFuseFlexParentData(FuseNode node, RenderObject renderObject) {
+  final pd = renderObject.parentData;
+  if (pd is! FlexParentData) return;
+  final grow = node.int('grow');
+  final int? flex = grow != null && grow > 0 ? grow : null;
+  final FlexFit? fit = flex == null ? null : (node.string('fit') == 'tight' ? FlexFit.tight : FlexFit.loose);
+  if (pd.flex != flex || pd.fit != fit) {
+    pd.flex = flex;
+    pd.fit = fit;
+    renderObject.parent?.markNeedsLayout();
+  }
+}
+
+/// The element of a [FuseBox]: a multi-child render-object element that
+/// watches its node. `MultiChildRenderObjectElement` only looks at its
+/// children when it is given a new widget; this one has one widget for life
+/// and looks at the node's child list when the node says it changed.
+class FuseBoxElement extends RenderObjectElement implements FuseNodeSink {
+  FuseBoxElement(FuseBox super.widget);
+
+  FuseNode get _node => (widget as FuseBox).node;
+
+  @override
+  RenderFuseBox get renderObject => super.renderObject as RenderFuseBox;
+
+  List<Element> _children = const <Element>[];
+  List<Widget>? _shown;
+  Set<Element>? _forgotten;
+
+  @override
+  void nodeChanged() => markNeedsBuild();
+
+  List<Widget> get _wanted => renderObject.visible ? _node.childWidgets : const <Widget>[];
+
+  @override
+  void mount(Element? parent, Object? newSlot) {
+    _node.attachSink(this);
+    super.mount(parent, newSlot);
+    final wanted = _wanted;
+    if (wanted.isNotEmpty) {
+      final children = List<Element>.filled(wanted.length, this);
+      Element? previous;
+      for (var i = 0; i < wanted.length; i++) {
+        previous = children[i] = inflateWidget(wanted[i], IndexedSlot<Element?>(i, previous));
+      }
+      _children = children;
+    }
+    _shown = wanted;
+  }
+
+  @override
+  void attachRenderObject(Object? newSlot) {
+    super.attachRenderObject(newSlot);
+    applyFuseFlexParentData(_node, renderObject);
+  }
+
+  @override
+  void update(FuseBox newWidget) {
+    final old = _node;
+    if (!identical(old, newWidget.node)) {
+      old.detachSink(this);
+      newWidget.node.attachSink(this);
+    }
+    super.update(newWidget); // syncs the render object
+    _afterSync();
+  }
+
+  @override
+  void performRebuild() {
+    if (kDebugMode) {
+      try {
+        super.performRebuild(); // syncs the render object
+      } catch (e) {
+        debugPrint('[Fuse] <${_node.type}> #${_node.id}: $e');
+        rethrow;
+      }
+    } else {
+      super.performRebuild();
+    }
+    _afterSync();
+  }
+
+  void _afterSync() {
+    applyFuseFlexParentData(_node, renderObject);
+    final wanted = _wanted;
+    if (identical(wanted, _shown)) return;
+    _children = updateChildren(_children, wanted, forgottenChildren: _forgotten);
+    _forgotten?.clear();
+    _shown = wanted;
+  }
+
+  @override
+  void unmount() {
+    _node.detachSink(this);
+    super.unmount();
+  }
+
+  @override
+  void insertRenderObjectChild(RenderObject child, IndexedSlot<Element?> slot) {
+    renderObject.insert(child as RenderBox, after: slot.value?.renderObject as RenderBox?);
+  }
+
+  @override
+  void moveRenderObjectChild(RenderObject child, IndexedSlot<Element?> oldSlot, IndexedSlot<Element?> newSlot) {
+    renderObject.move(child as RenderBox, after: newSlot.value?.renderObject as RenderBox?);
+  }
+
+  @override
+  void removeRenderObjectChild(RenderObject child, Object? slot) {
+    renderObject.remove(child as RenderBox);
+  }
+
+  @override
+  void visitChildren(ElementVisitor visitor) {
+    final forgotten = _forgotten;
+    for (final child in _children) {
+      if (forgotten == null || !forgotten.contains(child)) visitor(child);
+    }
+  }
+
+  @override
+  void forgetChild(Element child) {
+    (_forgotten ??= HashSet<Element>()).add(child);
+    super.forgetChild(child);
+  }
+}
+
+/// A transform layer that also applies an opacity to its children, so a box
+/// with both needs one composited layer of its own.
+class _FuseFxLayer extends TransformLayer {
+  int get alpha => _alpha;
+  int _alpha = 255;
+  set alpha(int value) {
+    if (value == _alpha) return;
+    _alpha = value;
+    markNeedsAddToScene();
+  }
+
+  @override
+  void addChildrenToScene(ui.SceneBuilder builder) {
+    if (_alpha == 255) {
+      super.addChildrenToScene(builder);
+      return;
+    }
+    builder.pushOpacity(_alpha);
+    super.addChildrenToScene(builder);
+    builder.pop();
+  }
+}
+
+/// Lays out, paints and hit-tests a `view`. See the top of this file.
+///
+/// It is a [RenderFlex] for its children; everything around the flex
+/// (padding, alignment, size, margin) is applied before and after the flex
+/// layout by narrowing the constraints the flex sees and shifting the
+/// children afterwards.
+class RenderFuseBox extends RenderFlex {
+  RenderFuseBox() : super(direction: Axis.vertical, mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.start);
+
+  // ── configuration ────────────────────────────────────────────────────────
+
+  EdgeInsets? _padding, _margin;
+  double? _width, _height, _minWidth, _maxWidth, _minHeight, _maxHeight, _aspectRatio;
+  Alignment? _alignment;
+  BoxDecoration? _decoration, _foreground;
+  BoxPainter? _painter, _foregroundPainter;
+  ImageConfiguration _configuration = ImageConfiguration.empty;
+  Clip _clip = Clip.none;
+  double? _rotate, _scale, _translateX, _translateY;
+  int _alpha = 255;
+  bool _visible = true;
+  bool _ignorePointer = false;
+  bool _passThroughSpec = true;
+
+  bool get visible => _visible;
+
+  /// Sets every property; marks layout, paint, compositing and semantics as
+  /// needed for what actually changed.
+  void configure({
+    required FuseFlexSpec flex,
+    required TextDirection? textDirection,
+    required EdgeInsets? padding,
+    required EdgeInsets? margin,
+    required double? width,
+    required double? height,
+    required double? minWidth,
+    required double? maxWidth,
+    required double? minHeight,
+    required double? maxHeight,
+    required double? aspectRatio,
+    required Alignment? alignment,
+    required BoxDecoration? decoration,
+    required BoxDecoration? foregroundDecoration,
+    required ImageConfiguration configuration,
+    required Clip clip,
+    required double? rotate,
+    required double? scale,
+    required double? translateX,
+    required double? translateY,
+    required double? opacity,
+    required bool visible,
+    required bool ignorePointer,
+  }) {
