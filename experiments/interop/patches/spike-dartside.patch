+    _mBoxSize = box;
+    _mContentOrigin = boxOrigin + origin;
+    _mContentSize = content;
+    _mPaddedOrigin = boxOrigin + paddedOrigin;
+    _mPaddedSize = padded;
+    _mContentConstraints = inner;
