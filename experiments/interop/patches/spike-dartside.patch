+/// is cut into blocks, an op touches one block, and the list is written back
+/// once at the end of the batch ([flush]).
+class _ChildEditor {
+  _ChildEditor(this.parent) {
+    final children = parent.children;
+    for (var i = 0; i < children.length; i += _block) {
+      final end = i + _block < children.length ? i + _block : children.length;
+      final block = children.sublist(i, end);
+      _blocks.add(block);
+      for (final c in block) {
+        _where[c] = block;
+      }
+    }
+    _length = children.length;
+  }
+
+  /// Child lists shorter than this are edited in place.
+  static const threshold = 128;
+  static const _block = 64;
