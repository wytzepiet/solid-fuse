@@ -0,0 +1,38 @@
+/// Switches for the Dart-side render path (report 14). All of them can be
+/// turned off to get the previous behaviour; they are read when a runtime is
+/// created and when a node's widget is first asked for, so set them before
+/// `FuseRuntime.create()`.
+class FuseLean {
+  /// The node element builds a keyless `StatelessWidget` returned by a
+  /// builder in place (one element less per node).
+  static bool inlineBuilders = true;
+
+  /// The node's element is told about changes directly instead of through a
+  /// `ChangeNotifier` listener.
+  static bool sink = true;
+
+  /// `view` is one render object (`RenderFuseBox`) and one element.
+  static bool box = true;
+
+  /// `text` is a `RenderParagraph` under one element.
+  static bool text = true;
+
+  /// Constant props of a compiler template are parsed once per template.
+  static bool sharedParse = true;
+
+  /// A box with a transform or a fractional opacity gets its own layer, so
+  /// changing them does not repaint anything.
+  static bool layerFx = true;
+
+  /// Sets every switch from a string of letters: i(nline) s(ink) b(ox) t(ext)
+  /// p(arse once) l(ayers). `all` and `none` are accepted.
+  static void configure(String letters) {
+    final all = letters == 'all';
+    inlineBuilders = all || letters.contains('i');
+    sink = all || letters.contains('s');
+    box = all || letters.contains('b');
+    text = all || letters.contains('t');
+    sharedParse = all || letters.contains('p');
+    layerFx = all || letters.contains('l');
+  }
+}
