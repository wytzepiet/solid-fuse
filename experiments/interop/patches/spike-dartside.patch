+// Report 14: animation driven from JS. N boxes whose transform, colour or
+// opacity follow one signal that JS advances once per step.
+import { View, Text, ScrollView, For, channels, flushOps } from "solid-fuse";
+import { createSignal } from "solid-js";
+import { now } from "./harness";
+import { Card } from "./screens";
+
+const [tick, setTick] = createSignal(0);
+const HUES = ["#3366ff", "#2e9e5b", "#e08a00", "#d64545", "#7a4fd6", "#0aa5a5"];
+
+/** `kind`: transform | color | opacity | size. `backdrop` cards sit behind the boxes (static content in the same frame). */
+export function AnimScreen(p: { n: number; kind: string; backdrop: number }) {
+  const rows = Array.from({ length: Math.ceil(p.n / 20) }, (_, r) => r);
+  const cards = Array.from({ length: p.backdrop }, (_, i) => i);
+  const box = (i: number) => {
+    if (p.kind === "transform")
+      return <View width={16} height={16} decoration={{ color: HUES[i % 6] }}
+        transform={{ translateX: Math.sin(tick() / 10 + i) * 6, translateY: Math.cos(tick() / 10 + i) * 6 }} />;
+    if (p.kind === "color")
+      return <View width={16} height={16} decoration={{ color: HUES[(i + tick()) % 6] }} />;
+    if (p.kind === "opacity")
+      return <View width={16} height={16} decoration={{ color: HUES[i % 6] }} opacity={0.5 + 0.5 * Math.sin(tick() / 10 + i)} />;
+    return <View width={10 + ((tick() + i) % 8)} height={16} decoration={{ color: HUES[i % 6] }} />;
+  };
+  return (
+    <ScrollView>
+      <View padding={8} flex={{ gap: 6 }}>
+        <For each={rows}>
+          {(r) => (
+            <View flex={{ direction: "horizontal", gap: 6 }}>
+              <For each={Array.from({ length: Math.min(20, p.n - r * 20) }, (_, k) => r * 20 + k)}>{box}</For>
+            </View>
+          )}
+        </For>
+        <For each={cards}>{(i) => <Card i={i} />}</For>
+      </View>
+    </ScrollView>
+  );
+}
+
+export const animCmds: Record<string, (a: any) => any> = {
+  /** One step: advance the signal and flush. */
+  animStep: () => {
+    const t = now();
+    setTick((v) => v + 1);
+    flushOps();
+    return { jsMs: now() - t };
+  },
+  /** `frames` steps. mode "vsync": the next step starts when Dart has drawn a frame; "timer": every `everyMs`. */
+  animRun: async (a) => {
+    const t0 = now();
+    let sum = 0, max = 0;
+    for (let i = 0; i < a.frames; i++) {
+      const s = now();
+      setTick((v) => v + 1);
+      flushOps();
+      const d = now() - s;
+      sum += d; if (d > max) max = d;
+      if (a.mode === "vsync") await channels.call("benchFrame", {});
+      else await new Promise<void>((r) => setTimeout(r, Math.max(0, a.everyMs - (now() - s))));
+    }
+    return { totalMs: now() - t0, jsSumMs: sum, jsMaxMs: max, steps: a.frames };
+  },
+};
