+    final contentSize = _mContentSize;
+    _boxOrigin = _mBoxOrigin;
+    _boxSize = _mBoxSize;
+    _contentOrigin = shift;
+    _contentSize = contentSize;
+    _paddedRect = _mPaddedOrigin & _mPaddedSize;
