+    final passThroughSpec = flex.passThrough;
+    if (passThroughSpec != _passThroughSpec) {
+      _passThroughSpec = passThroughSpec;
+      layout = true;
+    }
+    if (padding != _padding) {
+      _padding = padding;
+      layout = true;
+    }
+    if (margin != _margin) {
+      _margin = margin;
+      layout = true;
+    }
+    if (width != _width || height != _height) {
+      _width = width;
+      _height = height;
+      layout = true;
+    }
+    if (minWidth != _minWidth || maxWidth != _maxWidth || minHeight != _minHeight || maxHeight != _maxHeight) {
+      _minWidth = minWidth;
+      _maxWidth = maxWidth;
+      _minHeight = minHeight;
+      _maxHeight = maxHeight;
