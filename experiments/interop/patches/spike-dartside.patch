+/// What `Text.build` and `RichText` compute, for one node in one context.
+class _TextConfig {
+  _TextConfig(BuildContext context, FuseNode node) {
+    final defaults = DefaultTextStyle.of(context);
+    final isLeaf = node.type == '__text__';
+    final own = isLeaf ? null : fuseTextStyle(node);
+    final bold = MediaQuery.boldTextOf(context);
+    // The three spacing overrides Text applies are null unless the platform
+    // asks for them.
+    final lineHeight = MediaQuery.maybeLineHeightScaleFactorOverrideOf(context);
+    final letterSpacing = MediaQuery.maybeLetterSpacingOverrideOf(context);
+    final wordSpacing = MediaQuery.maybeWordSpacingOverrideOf(context);
+    final plain = !bold && lineHeight == null && letterSpacing == null && wordSpacing == null;
+
+    TextStyle effective;
+    // One merged style per (template node, default style): instances of a
+    // template under the same DefaultTextStyle share the TextStyle object.
+    final shared = FuseLean.sharedParse && plain && own != null ? node.shared : null;
+    final cached = shared != null && node.rev == 0 && shared.constantKeys ? shared.cache['#merged'] : null;
+    if (cached is (TextStyle, TextStyle) && identical(cached.$1, defaults.style)) {
+      effective = cached.$2;
+    } else {
+      effective = own == null || own.inherit ? defaults.style.merge(own) : own;
+      if (bold) effective = effective.merge(const TextStyle(fontWeight: FontWeight.bold));
+      if (!plain) {
+        effective = effective.merge(TextStyle(height: lineHeight, letterSpacing: letterSpacing, wordSpacing: wordSpacing));
+      }
+      if (shared != null && node.rev == 0 && shared.constantKeys) {
+        shared.cache['#merged'] = (defaults.style, effective);
+      }
+    }
+
+    final String text = isLeaf ? (node.props['text']?.toString() ?? '') : fuseExtractText(node);
+    final locale = isLeaf ? null : fuseParseLocale(node.string('locale'));
+    span = TextSpan(text: text, style: effective, locale: locale);
+    textAlign = (isLeaf ? null : fuseParseTextAlign(node.string('textAlign'))) ?? defaults.textAlign ?? TextAlign.start;
+    textDirection = (isLeaf ? null : fuseParseTextDirection(node.string('textDirection'))) ?? Directionality.of(context);
+    softWrap = (isLeaf ? null : node.props['softWrap'] as bool?) ?? defaults.softWrap;
+    overflow = (isLeaf ? null : fuseParseOverflow(node.string('overflow'))) ?? effective.overflow ?? defaults.overflow;
+    textScaler = MediaQuery.textScalerOf(context);
+    maxLines = (isLeaf ? null : node.int('maxLines')) ?? defaults.maxLines;
+    textWidthBasis = defaults.textWidthBasis;
+    textHeightBehavior = defaults.textHeightBehavior ?? DefaultTextHeightBehavior.maybeOf(context);
+    this.locale = locale ?? Localizations.maybeLocaleOf(context);
+    registrar = SelectionContainer.maybeOf(context);
+    selectionColor = DefaultSelectionStyle.of(context).selectionColor ?? DefaultSelectionStyle.defaultColor;
+  }
+
+  late final TextSpan span;
+  late final TextAlign textAlign;
+  late final TextDirection textDirection;
+  late final bool softWrap;
+  late final TextOverflow overflow;
+  late final TextScaler textScaler;
+  late final int? maxLines;
+  late final TextWidthBasis textWidthBasis;
+  late final ui.TextHeightBehavior? textHeightBehavior;
+  late final Locale? locale;
+  late final SelectionRegistrar? registrar;
+  late final Color selectionColor;
+}
