diff --git a/examples/perf_bench/tools/r14-run.sh b/examples/perf_bench/tools/r14-run.sh
new file mode 100755
index 0000000..584f581
--- /dev/null
+++ b/examples/perf_bench/tools/r14-run.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# Report 14: one suite on several saved bundles back to back.
+#   BUILDS=/path/to/builds tools/r14-run.sh <suite> <reps> <tag> <sem> <name> [<name> ...]
+# <sem> is 1 (semantics on, what the Linux embedder does) or 0 (off, as on a
+# phone without an accessibility service). Each <name> is a directory under
+# $BUILDS holding a copy of dart/build/linux/x64/release/bundle.
+# Output: results/r14/<suite>-<name>-s<sem><tag>.txt. Waits for the 1-minute
+# load average to drop below 0.5 before each run; an empty output (xvfb did
+# not start) is retried up to three times.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+suite=$1; reps=$2; tag=$3; sem=$4; shift 4
+for name in "$@"; do
+  out="results/r14/$suite-$name-s$sem$tag.txt"
+  for try in 1 2 3; do
+    until awk '{exit !($1 < 0.5)}' /proc/loadavg; do sleep 5; done
+    BENCH_SEMANTICS=$sem BIN=$BUILDS/$name/perf_bench tools/run.sh "$suite" "$reps" "$out" "${MODE:-release}"
+    grep -q '^BENCH' "$out" && break
+  done
+done
