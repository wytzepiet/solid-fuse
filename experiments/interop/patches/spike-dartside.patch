+    if (one(.1) && p['width'] != null && p['height'] == null) p['aspectRatio'] = n([0.5, 1, 2]);
+    if (one(.25)) p['alignment'] = ['center', 'topLeft', 'bottomRight', 'centerLeft', 'topCenter'][r.nextInt(5)];
+    if (one(.5)) {
+      p['decoration'] = {
+        'color': ['#3366ff', '#e08a00', '#2e9e5b'][r.nextInt(3)],
+        if (one(.4)) 'borderRadius': n([4, 12]),
+        if (one(.3)) 'border': {'width': n([1, 3]), 'color': '#222222'},
+      };
+    }
+    if (one(.1)) p['foregroundDecoration'] = {'color': '#ff000033'};
+    if (one(.15)) p['clipBehavior'] = ['hardEdge', 'antiAlias', 'none'][r.nextInt(3)];
+    if (one(.12)) p['opacity'] = n([0, 0.3, 0.75, 1]);
+    if (one(.12)) p['transform'] = {if (one(.7)) 'translateX': n([-6, 9, 25]), if (one(.5)) 'translateY': n([4, 13])};
+    if (one(.06)) p['ignorePointer'] = true;
+    if (one(.05)) p['visible'] = false;
+    if (one(.6)) {
+      final horizontal = one(.5);
+      // Stretch and expand need a bounded axis: only with both sizes fixed.
+      p['flex'] = {
+        if (horizontal) 'direction': 'horizontal',
+        if (one(.5)) 'gap': n([2, 6]),
+        if (one(.5)) 'align': sized ? ['center', 'end', 'stretch', 'start'][r.nextInt(4)] : ['center', 'end'][r.nextInt(2)],
+        if (one(.4) && sized) 'justify': ['center', 'end', 'spaceBetween', 'spaceAround', 'spaceEvenly'][r.nextInt(5)],
+        if (one(.15) && sized) 'expand': true,
+      };
+    }
+    if (hasParentFlex && one(.3)) {
+      p['grow'] = 1 + r.nextInt(2);
+      if (one(.5)) p['fit'] = 'tight';
+    }
+    return p;
+  }
+
+  int nextId = 0;
+  int build(Random r, List<dynamic> ops, int depth, {required bool parentFlexSized}) {
+    final id = ++nextId;
+    final kids = depth >= 3 ? r.nextInt(3) : r.nextInt(4);
+    final props = randomProps(r, hasParentFlex: parentFlexSized, children: kids);
+    ops.addAll([create, id, 'view', props]);
+    // Children may grow only in a flex that is really a flex and has a fixed size.
+    final flexSized = props['width'] != null && props['height'] != null && kids >= 2;
+    for (var i = 0; i < kids; i++) {
+      final int child;
+      if (depth < 3 && r.nextDouble() < .45) {
+        child = build(r, ops, depth + 1, parentFlexSized: flexSized);
+      } else {
+        child = ++nextId;
+        ops.addAll([
+          create, child, 'probe',
+          <String, dynamic>{'w': 12.0 + r.nextInt(40), 'h': 8.0 + r.nextInt(30), if (flexSized && r.nextDouble() < .25) 'grow': 1},
+        ]);
+      }
+      ops.addAll([insert, id, child, i]);
+    }
+    return id;
+  }
+
+  for (final mode in ['loose', 'tight', 'scroll']) {
+    testWidgets('random trees, host "$mode"', (tester) async {
+      var compared = 0, skipped = 0;
+      for (var seed = 0; seed < 120; seed++) {
+        final r = Random(seed * 7 + mode.length);
+        nextId = 0;
+        final ops = <dynamic>[];
+        final root = build(r, ops, 1, parentFlexSized: false);
+        ops.addAll([insert, 0, root, 0]);
+        final d = await compare(tester, ops, mode: mode, layerFx: seed.isEven);
+        if (d == 'skip') {
+          skipped++;
+          continue;
+        }
+        compared++;
+        expect(d, isNull, reason: 'seed $seed host $mode ops $ops');
+      }
+      // ignore: avoid_print
+      print('host $mode: $compared random trees compared, $skipped rejected by the widget stack');
+      expect(compared, greaterThan(60));
+    });
+  }
+
+  testWidgets('random prop changes after mount', (tester) async {
+    var compared = 0, skipped = 0;
+    for (var seed = 0; seed < 60; seed++) {
+      final r = Random(1000 + seed);
+      nextId = 0;
+      final ops = <dynamic>[];
+      final root = build(r, ops, 1, parentFlexSized: false);
+      ops.addAll([insert, 0, root, 0]);
+      final viewIds = <int>[];
+      for (var i = 0; i < ops.length; i++) {
+        if (i + 2 < ops.length && ops[i] == create && ops[i + 2] == 'view') viewIds.add(ops[i + 1] as int);
+      }
+      const keys = ['padding', 'margin', 'width', 'height', 'alignment', 'decoration', 'clipBehavior', 'opacity', 'transform', 'flex', 'visible', 'ignorePointer', 'maxWidth', 'foregroundDecoration'];
+      final updates = <List<dynamic>>[];
+      for (var step = 0; step < 6; step++) {
+        final batch = <dynamic>[];
+        for (var k = 0; k < 1 + r.nextInt(3); k++) {
+          final id = viewIds[r.nextInt(viewIds.length)];
+          final fresh = randomProps(r, hasParentFlex: false, children: 1);
+          final key = keys[r.nextInt(keys.length)];
+          batch.addAll([setProp, id, key, fresh[key]]); // null removes the effect
+        }
+        updates.add(batch);
+      }
+      final d = await compare(tester, ops, updates: updates, layerFx: seed.isEven);
+      if (d == 'skip') {
+        skipped++;
+        continue;
+      }
+      compared++;
+      expect(d, isNull, reason: 'seed $seed ops $ops updates $updates');
+    }
+    // ignore: avoid_print
+    print('$compared update sequences compared, $skipped rejected by the widget stack; $pixelExact snapshot pairs so far were pixel-exact comparisons');
+    expect(compared, greaterThan(25));
+  });
+}
