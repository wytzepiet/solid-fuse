+// RenderFuseBox against the widget stack FuseViewWidget builds: the same op
+// batches rendered both ways must give the same rectangles, the same pixels
+// and the same hit-test results. Hand-picked cases first, then seeded random
+// trees, then random prop changes applied to both.
+import 'dart:math';
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+const create = 0, createText = 1, setProp = 2, setText = 3, insert = 4, remove = 5, dispose = 6;
+
+FuseRuntime makeRuntime({required bool lean}) {
+  final rt = FuseRuntime.forTest();
+  rt.registerWidget('view', FuseViewWidget.new);
+  rt.registerWidget('text', FuseText.new);
+  // A fixed-size coloured leaf that reports hits under its own tag.
+  rt.registerWidget('probe', (node) {
+    Widget w = MetaData(
+      metaData: 'probe:${node.id}',
+      behavior: HitTestBehavior.opaque,
+      child: SizedBox(
+        width: node.double('w'),
+        height: node.double('h'),
+        child: ColoredBox(color: Color(0xFF000000 | (node.id * 2654435761) & 0xFFFFFF)),
+      ),
+    );
+    final grow = node.int('grow');
+    if (grow != null) w = Flexible(flex: grow, fit: node.string('fit') == 'tight' ? FlexFit.tight : FlexFit.loose, child: w);
+    return w;
+  });
+  if (lean) {
+    rt.registerDirectWidget('view', FuseBox.new);
+    rt.registerDirectWidget('text', FuseTextLeaf.new);
+    rt.registerDirectWidget('__text__', FuseTextLeaf.new);
+  }
+  return rt;
+}
+
+final _boundary = GlobalKey();
+
+Widget host(FuseRuntime rt, String mode, {TextDirection direction = TextDirection.ltr}) {
+  Widget content = FuseView(runtime: rt);
+  content = switch (mode) {
+    'tight' => SizedBox(width: 300, height: 220, child: content),
+    'loose' => Align(alignment: Alignment.topLeft, child: content),
+    'scroll' => SingleChildScrollView(child: content),
+    'row' => Row(crossAxisAlignment: CrossAxisAlignment.start, children: [content]),
+    _ => throw ArgumentError(mode),
+  };
+  return Directionality(
+    textDirection: direction,
+    child: DefaultTextStyle(
+      style: const TextStyle(fontSize: 14, color: Color(0xFF000000)),
+      child: Align(
+        alignment: Alignment.topLeft,
+        child: SizedBox(
+          width: 400,
+          height: 300,
+          child: RepaintBoundary(
+            key: _boundary,
+            child: ColoredBox(
+              color: const Color(0xFFFFFFFF),
+              child: Stack(
+                children: [
+                  const Positioned.fill(child: MetaData(metaData: 'bg', behavior: HitTestBehavior.opaque)),
+                  Positioned.fill(child: content),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+}
+
+// A node keeps the props map of its create op, so every run needs its own.
+dynamic deepCopy(dynamic v) {
+  if (v is Map) return <String, dynamic>{for (final e in v.entries) e.key as String: deepCopy(e.value)};
+  if (v is List) return [for (final e in v) deepCopy(e)];
+  return v;
+}
+
+/// Snapshot pairs compared with no pixel allowance at all.
+int pixelExact = 0;
+
+bool isOverflow(Object? e) => e.toString().contains('overflowed by');
+
+class Snapshot {
+  final rects = <int, Rect>{};
+  final hits = <String?>[];
+  Uint8List? pixels;
+  Object? error;
+}
+
+void _collect(FuseNode node, WidgetTester tester, Snapshot s) {
+  if (node.type == 'view' || node.type == 'probe' || node.type == 'text') {
+    final finder = find.byWidget(node.selfWidget);
+    if (finder.evaluate().isNotEmpty) {
+      final ro = tester.renderObject(finder);
+      if (ro is RenderBox && ro.hasSize) {
+        // The outermost render object of the node, in global coordinates.
+        final m = ro.getTransformTo(null);
+        s.rects[node.id] = MatrixUtils.transformRect(m, Offset.zero & ro.size);
+      }
+    }
+  }
+  node.children.forEach((c) => _collect(c, tester, s));
+}
+
+Future<Snapshot> snap(WidgetTester tester, FuseRuntime rt, {bool pixels = true}) async {
+  final s = Snapshot();
+  s.error = tester.takeException();
+  // An overflowing flex reports an error but the tree is laid out; anything
+  // else leaves nothing to compare.
+  if (s.error != null && !isOverflow(s.error)) return s;
+  _collect(rt.registry.get(0), tester, s);
+  for (var y = 3.0; y < 300; y += 11) {
+    for (var x = 3.0; x < 400; x += 13) {
+      final result = tester.hitTestOnBinding(Offset(x, y));
+      String? tag;
+      for (final e in result.path) {
+        final t = e.target;
+        if (t is RenderMetaData) {
+          tag = t.metaData as String?;
+          break;
+        }
+      }
+      s.hits.add(tag);
+    }
+  }
+  if (pixels) {
+    final boundary = _boundary.currentContext!.findRenderObject()! as RenderRepaintBoundary;
+    s.pixels = await tester.runAsync(() async {
+      final image = await boundary.toImage();
+      final data = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
+      image.dispose();
+      return data!.buffer.asUint8List();
+    });
+  }
+  return s;
+}
+
+/// Null when equal, otherwise what differs.
+String? diff(Snapshot a, Snapshot b, {int pixelTolerance = 0, int allowed = 0}) {
+  if (a.rects.length != b.rects.length) return 'node count ${a.rects.length} vs ${b.rects.length}';
+  for (final id in a.rects.keys) {
+    final ra = a.rects[id]!, rb = b.rects[id];
+    if (rb == null) return 'node $id missing';
+    if ((ra.left - rb.left).abs() > 0.01 || (ra.top - rb.top).abs() > 0.01 || (ra.width - rb.width).abs() > 0.01 || (ra.height - rb.height).abs() > 0.01) {
+      return 'rect of node $id: $ra vs $rb';
+    }
+  }
+  for (var i = 0; i < a.hits.length; i++) {
+    if (a.hits[i] != b.hits[i]) return 'hit at point $i: ${a.hits[i]} vs ${b.hits[i]}';
+  }
+  final pa = a.pixels, pb = b.pixels;
+  if (pa != null && pb != null) {
+    if (pa.length != pb.length) return 'image size';
+    var bad = 0;
+    for (var i = 0; i < pa.length; i++) {
+      if ((pa[i] - pb[i]).abs() > pixelTolerance) bad++;
+    }
+    if (bad > allowed) return '$bad of ${pa.length} channel values differ by more than $pixelTolerance';
+  }
+  return null;
+}
+
+/// Renders [ops] (then each batch of [updates]) with the widget stack and with
+/// the box, and returns the first difference.
+Future<String?> compare(
+  WidgetTester tester,
+  List<dynamic> ops, {
+  String mode = 'loose',
+  List<List<dynamic>> updates = const [],
+  TextDirection direction = TextDirection.ltr,
+  bool layerFx = true,
+  int pixelTolerance = 0,
+  int allowed = 0,
+}) async {
+  final snaps = <bool, List<Snapshot>>{};
+  for (final lean in [false, true]) {
+    FuseLean.layerFx = layerFx;
+    final rt = makeRuntime(lean: lean);
+    rt.applyOps(deepCopy(ops) as List);
+    await tester.pumpWidget(host(rt, mode, direction: direction));
+    final list = [await snap(tester, rt)];
+    for (final u in updates) {
+      rt.applyOps(deepCopy(u) as List);
+      await tester.pump();
+      list.add(await snap(tester, rt));
+    }
+    snaps[lean] = list;
+    await tester.pumpWidget(const SizedBox());
+    tester.takeException();
+  }
+  FuseLean.layerFx = true;
+  var overflowed = false;
+  for (var i = 0; i < snaps[false]!.length; i++) {
+    final a = snaps[false]![i], b = snaps[true]![i];
+    // The widget stack itself rejects this tree (a layout error): nothing to compare.
+    if (a.error != null && !isOverflow(a.error)) return 'skip';
+    if (b.error != null && !isOverflow(b.error)) return 'step $i: only the box threw: ${b.error}';
+    // On first layout both must agree on whether something overflows. Later
+    // the stack may report again where the box does not: it reports once per
+    // RenderFlex and makes a new RenderFlex when its layers change.
+    if (i == 0 && (a.error == null) != (b.error == null)) return 'overflow reported by one only: ${a.error} / ${b.error}';
+    overflowed = overflowed || a.error != null || b.error != null;
+    // The debug-only overflow marker (stripes and a label bar) is drawn by
+    // different code and differs in the phase of its stripes; a tree that
+    // shows one is compared on rectangles and hits, and loosely on pixels.
+    // Everything else must be identical to the pixel.
+    final d = diff(a, b, pixelTolerance: pixelTolerance, allowed: overflowed ? 4000 : allowed);
+    if (!overflowed) pixelExact++;
+    if (d != null) return 'step $i: $d\n  stack: ${a.rects}\n  box:   ${b.rects}';
+  }
+  return null;
+}
+
+List<dynamic> tree(Map<String, dynamic> rootProps, List<Map<String, dynamic>> probes, {Map<String, dynamic>? outer}) {
+  // root(0) > [outer view 1 >] view 2 > probes 10..
+  final ops = <dynamic>[create, 2, 'view', Map<String, dynamic>.of(rootProps)];
+  for (var i = 0; i < probes.length; i++) {
+    ops.addAll([create, 10 + i, 'probe', Map<String, dynamic>.of(probes[i]), insert, 2, 10 + i, i]);
+  }
+  if (outer != null) {
+    ops.addAll([create, 1, 'view', Map<String, dynamic>.of(outer), insert, 1, 2, 0, insert, 0, 1, 0]);
+  } else {
+    ops.addAll([insert, 0, 2, 0]);
+  }
+  return ops;
+}
