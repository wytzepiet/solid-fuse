+// `text` as a RenderParagraph under one element.
+//
+// `FuseText` (text.dart) builds a `Text`, which builds a `RichText`: three
+// elements per text node with the node's own. `FuseTextLeaf` resolves the
+// same inherited values `Text` and `RichText` read (default text style, text
+// scaler, bold-text setting, directionality, locale, selection) and
+// configures the RenderParagraph itself. Its element watches the node, so a
+// new string or colour goes to the render object without building a widget.
+//
+// Not carried over from `Text`: inside a `SelectionArea` it wraps itself in a
+// MouseRegion that shows the text cursor. Selection itself works (the
+// paragraph registers with the selection registrar).
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/widgets.dart';
+
+import '../lean.dart';
+import '../node.dart';
+import '../perf.dart';
+import 'text.dart';
+
+class FuseTextLeaf extends LeafRenderObjectWidget {
+  FuseTextLeaf(this.node) : super(key: ValueKey<int>(node.id));
+
+  final FuseNode node;
+
+  @override
+  LeafRenderObjectElement createElement() => _FuseTextElement(this);
+
+  @override
+  RenderParagraph createRenderObject(BuildContext context) {
+    final c = _resolve(context);
+    return RenderParagraph(
+      c.span,
+      textAlign: c.textAlign,
+      textDirection: c.textDirection,
+      softWrap: c.softWrap,
+      overflow: c.overflow,
+      textScaler: c.textScaler,
+      maxLines: c.maxLines,
+      textWidthBasis: c.textWidthBasis,
+      textHeightBehavior: c.textHeightBehavior,
+      locale: c.locale,
+      registrar: c.registrar,
+      selectionColor: c.selectionColor,
+    );
+  }
+
+  @override
+  void updateRenderObject(BuildContext context, RenderParagraph renderObject) {
+    final c = _resolve(context);
+    renderObject
+      ..text = c.span
+      ..textAlign = c.textAlign
+      ..textDirection = c.textDirection
+      ..softWrap = c.softWrap
+      ..overflow = c.overflow
+      ..textScaler = c.textScaler
+      ..maxLines = c.maxLines
+      ..textWidthBasis = c.textWidthBasis
+      ..textHeightBehavior = c.textHeightBehavior
+      ..locale = c.locale
+      ..registrar = c.registrar
+      ..selectionColor = c.selectionColor;
+  }
+
+  _TextConfig _resolve(BuildContext context) {
+    if (!FusePerf.on) return _TextConfig(context, node);
+    final t = FusePerf.now;
+    final c = _TextConfig(context, node);
+    FusePerf.widgetBuildUs += FusePerf.now - t;
+    FusePerf.widgetBuilds++;
+    return c;
+  }
+
+  @override
+  String toStringShort() => node.component != null ? '${node.type} «${node.component}»' : node.type;
+
+  @override
+  void debugFillProperties(DiagnosticPropertiesBuilder properties) {
