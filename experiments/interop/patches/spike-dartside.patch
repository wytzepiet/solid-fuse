+// The lean render path (report 14): what a node costs in elements, how a
+// change reaches the render object, and FuseTextLeaf against FuseText.
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+const create = 0, createText = 1, setProp = 2, setText = 3, insert = 4, remove = 5, dispose = 6, tpl = 9, inst = 10;
+
+FuseRuntime makeRuntime({required bool lean}) {
+  final rt = FuseRuntime.forTest();
+  rt.registerWidget('view', FuseViewWidget.new);
+  rt.registerWidget('text', FuseText.new);
+  if (lean) {
+    rt.registerDirectWidget('view', FuseBox.new);
+    rt.registerDirectWidget('text', FuseTextLeaf.new);
+    rt.registerDirectWidget('__text__', FuseTextLeaf.new);
+  }
+  return rt;
+}
+
+final _boundary = GlobalKey();
+
+Widget host(FuseRuntime rt, {MediaQueryData? media, TextStyle? defaults, TextAlign? align, int? maxLines}) => MediaQuery(
+  data: media ?? const MediaQueryData(),
+  child: Directionality(
+    textDirection: TextDirection.ltr,
+    child: DefaultTextStyle(
+      style: defaults ?? const TextStyle(fontSize: 14, color: Color(0xFF112233)),
+      textAlign: align,
+      maxLines: maxLines,
+      child: Align(
+        alignment: Alignment.topLeft,
+        child: SizedBox(
+          width: 300,
+          height: 200,
+          child: RepaintBoundary(key: _boundary, child: ColoredBox(color: const Color(0xFFFFFFFF), child: Align(alignment: Alignment.topLeft, child: FuseView(runtime: rt)))),
+        ),
+      ),
+    ),
+  ),
+);
+
+int countElements(WidgetTester tester) {
+  var n = 0;
+  void visit(Element e) {
+    n++;
+    e.visitChildren(visit);
+  }
+
+  tester.element(find.byType(FuseView)).visitChildren(visit);
+  return n;
+}
+
+Future<Uint8List> pixels(WidgetTester tester) async {
+  final boundary = _boundary.currentContext!.findRenderObject()! as RenderRepaintBoundary;
+  return (await tester.runAsync(() async {
+    final image = await boundary.toImage();
+    final data = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
+    image.dispose();
+    return data!.buffer.asUint8List();
+  }))!;
+}
+
+/// What a RenderParagraph was configured with.
+String describe(RenderParagraph p) {
+  final span = p.text as TextSpan;
+  return [
+    span.toPlainText(), span.style, p.textAlign, p.textDirection, p.softWrap, p.overflow, p.textScaler, p.maxLines,
+    p.textWidthBasis, p.textHeightBehavior, p.locale, p.size,
+  ].join(' | ');
+}
+
+void main() {
+  tearDown(() => FuseLean.configure('all'));
+
+  final card = <dynamic>[
+    create, 1, 'view', <String, dynamic>{'padding': 10, 'decoration': {'color': '#ffffff'}, 'flex': {'direction': 'horizontal', 'gap': 8}},
+    create, 2, 'text', <String, dynamic>{'fontSize': 16, 'fontWeight': 'semiBold'},
+    createText, 3, 'Title',
+    insert, 2, 3, 0,
+    create, 4, 'view', <String, dynamic>{'width': 20, 'height': 20, 'decoration': {'color': '#3366ff'}},
+    insert, 1, 2, 0,
+    insert, 1, 4, 1,
+    insert, 0, 1, 0,
+  ];
+
+  testWidgets('elements per node: the lean path adds none', (tester) async {
+    final counts = <bool, int>{};
+    for (final lean in [false, true]) {
+      FuseLean.configure(lean ? 'all' : 'none');
+      final rt = makeRuntime(lean: lean);
