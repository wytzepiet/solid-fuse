diff --git a/examples/perf_bench/tools/r14-chain.py b/examples/perf_bench/tools/r14-chain.py
new file mode 100644
index 0000000..09cea0a
--- /dev/null
+++ b/examples/perf_bench/tools/r14-chain.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Report 14: one table per field, records down, variants across.
+
+    python3 tools/r14-chain.py <sem 0|1> <field> <variant> [<variant> ...] [-r] [-b build]
+
+A variant is `base` (results/r14/core-00-base-s<sem>-*.txt) or a FUSE_LEAN
+string (results/r14/core-<build>-<variant>-s<sem>-*.txt). Files of all
+passes are pooled; the cell is the median, with -r also (min-max).
+`ui` is applyMs + uiFrameMs (everything the UI thread does for the change).
+"""
+import glob, json, sys
+from statistics import median
+args = sys.argv[1:]
+rng = "-r" in args
+if rng: args.remove("-r")
+build = "02-lean"
+if "-b" in args:
+    i = args.index("-b"); build = args[i + 1]; del args[i:i + 2]
+suite = "core"
+if "-s" in args:
+    i = args.index("-s"); suite = args[i + 1]; del args[i:i + 2]
+sem, field, variants = args[0], args[1], args[2:]
+def load(v):
+    pat = f"results/r14/{suite}-00-base-s{sem}-[ab].txt" if v == "base" else f"results/r14/{suite}-{build}-{v}-s{sem}-[ab].txt"
+    recs, order, ok, n = {}, [], 0, 0
+    for f in sorted(glob.glob(pat)):
+        for line in open(f):
+            if not line.startswith("BENCH {"): continue
+            d = json.loads(line[6:])
+            if d.get("name") == "list_order_check":
+                n += 1; ok += 1 if d.get("dartTreeMatchesJs") else 0
+                continue
+            if d.get("suite") != suite or d.get("detail"): continue
+            if field == "ui":
+                if "uiFrameMs" not in d: continue
+                val = d["uiFrameMs"] + d.get("applyMs", 0)
+            elif field in d and isinstance(d[field], (int, float)): val = d[field]
+            else: continue
+            if d["name"] not in recs: order.append(d["name"])
+            recs.setdefault(d["name"], []).append(val)
+    return recs, order, (ok, n), len(glob.glob(pat))
+data = [load(v) for v in variants]
+def fmt(x): return f"{x:.0f}" if abs(x) >= 100 else (f"{x:.1f}" if abs(x) >= 10 else f"{x:.2f}")
+print(f"{field}, semantics {'on' if sem == '1' else 'off'}: median" + (" (min-max)" if rng else ""))
+print("| record | " + " | ".join(variants) + " |")
+print("|---|" + "---:|" * len(variants))
+for name in data[0][1]:
+    cells = []
+    for recs, _, _, _ in data:
+        v = recs.get(name)
+        if not v: cells.append(""); continue
+        cells.append(fmt(median(v)) + (f" ({fmt(min(v))}-{fmt(max(v))})" if rng else ""))
+    print(f"| {name} | " + " | ".join(cells) + " |")
+print("| reps / order checks | " + " | ".join(f"{len(next(iter(d[0].values()), []))} / {d[2][0]} of {d[2][1]}" for d in data) + " |")
