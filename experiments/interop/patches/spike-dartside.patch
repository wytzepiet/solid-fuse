+          sep == null ? (_, i) => children[i].selfWidget : (_, i) => i.isEven ? children[i ~/ 2].selfWidget : sep,
+          childCount: sep == null || children.isEmpty ? children.length : children.length * 2 - 1,
+          findChildIndexCallback: find,
+          semanticIndexCallback: sep == null ? (_, i) => i : (_, i) => i.isEven ? i ~/ 2 : null,
+        ),
+      );
     }
 
     return SingleChildScrollView(
diff --git a/packages/solid-fuse/dart/test/node_widget_test.dart b/packages/solid-fuse/dart/test/node_widget_test.dart
index 1b9f0fb..d141045 100644
--- a/packages/solid-fuse/dart/test/node_widget_test.dart
+++ b/packages/solid-fuse/dart/test/node_widget_test.dart
@@ -127,4 +127,35 @@ void main() {
     expect(find.text('row10'), findsNothing);
     expect(tester.getTopLeft(find.text('row11')).dy, 0);
   });
+
+  testWidgets('a lazy scrollView keeps the elements of rows that move', (tester) async {
+    for (final gap in [0, 6]) {
+      final rt = FuseRuntime.forTest();
+      rt.registerWidget('scrollView', (node) => FuseScrollView(node));
+      rt.registerWidget('row', (node) => SizedBox(height: 50, child: Text('row${node.id}')));
+      rt.applyOps([
+        create, 1, 'scrollView', <String, dynamic>{'lazy': true, if (gap > 0) 'flex': {'gap': gap}},
+        for (var i = 0; i < 400; i++) ...[create, 10 + i, 'row', <String, dynamic>{}, insert, 1, 10 + i, i],
+        insert, 0, 1, 0,
+      ]);
+      await tester.pumpWidget(Directionality(
+        textDirection: TextDirection.ltr,
+        child: SizedBox(height: 600, child: FuseView(runtime: rt)),
+      ));
+      final e10 = tester.element(find.text('row10'));
+      final e12 = tester.element(find.text('row12'));
+      final r12 = tester.renderObject(find.text('row12'));
+      // Row 12 first, a row from far below second, row 10 fourth.
+      rt.applyOps([remove, 1, 10, remove, 1, 12, insert, 1, 12, 0, insert, 1, 10, 2, remove, 1, 300, insert, 1, 300, 1]);
+      await tester.pump();
+      expect(tester.getTopLeft(find.text('row12')).dy, 0);
+      expect(tester.getTopLeft(find.text('row300')).dy, 50 + gap);
+      expect(tester.getTopLeft(find.text('row10')).dy, 3 * (50 + gap));
+      expect(tester.element(find.text('row10')), same(e10));
+      expect(tester.element(find.text('row12')), same(e12));
+      expect(tester.renderObject(find.text('row12')), same(r12));
+      await tester.pumpWidget(const SizedBox());
+      rt.dispose();
+    }
+  });
 }
