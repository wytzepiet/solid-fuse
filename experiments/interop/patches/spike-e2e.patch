+// End-to-end proof for `fuse add` / `fuse gen`.
+//
+// Pipeline under test, with nothing mocked:
+//   Solid JSX (src/index.tsx) -> generated TS wrappers (src/_generated/*.ts)
+//   -> universal renderer ops -> QuickJS bridge -> generated Dart adapters
+//   (lib/_generated/*.fuse.g.dart) -> real Flutter widgets -> a Flutter
+//   callback -> JS handler -> signal update -> re-render.
+//
+// The bundle is built by the CLI: `fuse build --js-only --dev` (dev mode keeps
+// the manifest-driven prop validators in the bundle). The runtime falls back
+// to that bundle because no dev server is running.
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:gen_e2e/fuse/rating_badge.dart';
+import 'package:gen_e2e/main.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:percent_indicator/percent_indicator.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+Future<void> pumpUntil(WidgetTester tester, Finder finder, {String? reason}) async {
+  for (var i = 0; i < 100; i++) {
+    await tester.pump(const Duration(milliseconds: 50));
+    if (finder.evaluate().isNotEmpty) return;
+  }
+  fail('timed out waiting for ${reason ?? finder}');
+}
+
+Finder text(String s) => find.textContaining(s, findRichText: true);
+
+Future<void> tapVisible(WidgetTester tester, Finder finder) async {
+  await tester.ensureVisible(finder);
+  await tester.pump(const Duration(milliseconds: 50));
+  await tester.tap(finder);
+}
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  late FuseRuntime runtime;
+  setUpAll(() async {
+    runtime = await startFuse();
+  });
+
+  testWidgets('generated wrappers render real widgets and round-trip callbacks', (tester) async {
+    await tester.pumpWidget(GenE2eApp(runtime: runtime));
+    await pumpUntil(tester, text('level 25'), reason: 'first JS render');
+
+    // Flutter SDK widgets from the allow-list, built by generated adapters.
+    expect(find.byType(Scaffold), findsOneWidget);
+    expect(find.byType(AppBar), findsOneWidget);
+    expect(find.byType(ListTile), findsNWidgets(2));
+    expect(find.byType(Slider), findsOneWidget);
+    expect(tester.widget<Switch>(find.byType(Switch)).value, isFalse);
+    expect(tester.widget<Slider>(find.byType(Slider)).value, 25);
+    expect(tester.widget<Slider>(find.byType(Slider)).divisions, 4);
+
+    // Widget slots (`title`, `subtitle`, `trailing`) and the node-list prop `actions`.
+    expect(find.descendant(of: find.byType(ListTile), matching: text('boost is off')), findsOneWidget);
+    expect(find.descendant(of: find.byType(ListTile), matching: find.byType(Switch)), findsOneWidget);
+    expect(find.descendant(of: find.byType(AppBar), matching: text('Generated interop')), findsOneWidget);
+    expect(find.descendant(of: find.byType(AppBar), matching: text('taps 0')), findsOneWidget);
+
+    // pub package widgets: one through a hand-written JS wrapper (Gauge), one direct.
+    final circle = tester.widget<CircularPercentIndicator>(find.byType(CircularPercentIndicator));
+    expect(circle.percent, 0.25);
+    expect(circle.radius, 48);
+    expect(circle.circularStrokeCap, CircularStrokeCap.round);
+    expect(circle.progressColor, const Color(0xFF3366FF));
+    final bar = tester.widget<LinearPercentIndicator>(find.byType(LinearPercentIndicator));
+    expect(bar.percent, 0.25);
+    expect(bar.progressColor, Colors.teal); // static const by name: "Colors.teal"
+    expect(bar.barRadius, const Radius.circular(4));
+
+    // The app's own plain Flutter widget.
+    final badge = tester.widget<RatingBadge>(find.byType(RatingBadge));
+    expect(badge.label, 'Rating');
+    expect(badge.stars, 2);
+    expect(badge.tone, BadgeTone.neutral);
+    expect(badge.padding, const EdgeInsets.symmetric(horizontal: 12, vertical: 6)); // regenerated default
+
+    // Flutter -> JS: Switch.onChanged(bool) updates two signals; both re-render.
+    await tapVisible(tester, find.byType(Switch));
+    await pumpUntil(tester, text('level 75'), reason: 'Switch.onChanged round trip');
+    expect(text('boost is on'), findsOneWidget);
+    expect(tester.widget<Switch>(find.byType(Switch)).value, isTrue);
+    expect(tester.widget<CircularPercentIndicator>(find.byType(CircularPercentIndicator)).percent, 0.75);
+    expect(tester.widget<CircularPercentIndicator>(find.byType(CircularPercentIndicator)).progressColor, const Color(0xFF2E9E5B));
+    expect(tester.widget<LinearPercentIndicator>(find.byType(LinearPercentIndicator)).percent, 0.75);
+    expect(tester.widget<Slider>(find.byType(Slider)).value, 75);
+
+    // void callback with no payload, rendered into the AppBar's `actions` list.
+    await tapVisible(tester, text('Boost'));
+    await pumpUntil(tester, text('taps 1'), reason: 'ListTile.onTap round trip');
+
+    // Typed payload from the app widget: ValueChanged<int>.
+    await tapVisible(tester, find.byKey(const ValueKey('star-5')));
+    await pumpUntil(tester, text('stars 5'), reason: 'RatingBadge.onRated round trip');
+    expect(tester.widget<RatingBadge>(find.byType(RatingBadge)).stars, 5);
+    expect(tester.widget<RatingBadge>(find.byType(RatingBadge)).tone, BadgeTone.positive);
+  });
+
+  testWidgets('dev-mode validation names component, prop, expected type and nearest value', (tester) async {
+    await tester.pumpWidget(GenE2eApp(runtime: runtime));
+    await pumpUntil(tester, text('validation errors: 0'));
+
+    // Renders <Broken/>, whose props are typed `any`. The bad values still
+    // cross the bridge; adapters that cannot decode them render solid-fuse's
+    // dev error box instead of throwing.
+    await tapVisible(tester, text('Break it'));
+    await pumpUntil(tester, text('[fuse] <'), reason: 'validation errors rendered');
+    final all = tester
+        .widgetList<RichText>(find.byType(RichText))
+        .map((t) => t.text.toPlainText())
+        .firstWhere((s) => s.contains('[fuse] <'));
+    // ignore: avoid_print
+    print('--- validation output ---\n$all\n--- end ---');
+
+    expect(all, contains('<percent_indicator.LinearPercentIndicator> in <Broken>: unknown prop "lineHeigth". Did you mean "lineHeight"?'));
+    expect(all, contains('prop "percent" expects number, got "0.5".'));
+    expect(all, contains('<app.RatingBadge> in <Broken>: prop "tone" expects BadgeTone (neutral | positive | negative), got "positiv". Did you mean "positive"?'));
+    expect(all, contains('<app.RatingBadge> in <Broken>: missing required prop "label" (string).'));
+    expect(all, contains('Did you mean "Colors.teal"?'));
+    expect(all, contains('prop "padding" has unknown EdgeInsets variant \$: "symetric". Did you mean "symmetric"?'));
+    expect(all, contains('prop "padding.horizontl" is not a field of EdgeInsets { \$: "symmetric" }. Did you mean "horizontal"?'));
+    expect(all, contains('prop "onPercentValue" exists on Flutter\'s LinearPercentIndicator but is not bridged (callback/sync-return).'));
+  });
+}
