+import { createSignal } from "solid-js";
+import { render, ScrollView, Show, Text, View, nativeValidationErrors } from "solid-fuse";
+import * as F from "~/_generated/flutter";
+import { LinearPercentIndicator } from "~/_generated/percent_indicator";
+import { RatingBadge } from "~/_generated/app";
+import { Gauge } from "./ui/gauge";
+
+function Settings() {
+  const [on, setOn] = createSignal(false);
+  const [level, setLevel] = createSignal(25);
+  const [stars, setStars] = createSignal(2);
+  const [taps, setTaps] = createSignal(0);
+  const [broken, setBroken] = createSignal(false);
+  const [errors, setErrors] = createSignal<string[]>([]);
+
+  return (
+    <F.Scaffold
+      appBar={
+        <F.AppBar
+          title={<Text>Generated interop</Text>}
+          actions={[<Text>{`taps ${taps()}`}</Text>]}
+        />
+      }
+    >
+      <ScrollView>
+      <View padding={16} flex={{ gap: 12 }}>
+        {/* pub package through a hand-written JS wrapper */}
+        <Gauge value={level()} label="level" tone={on() ? "good" : "info"} />
+        <Text>{`level ${level()}`}</Text>
+
+        {/* pub package, generated wrapper used directly */}
+        <LinearPercentIndicator percent={level() / 100} lineHeight={8} progressColor="Colors.teal" barRadius={4} />
+
+        {/* Flutter SDK widgets from the allow-list */}
+        <F.ListTile
+          title={<Text>Boost</Text>}
+          subtitle={<Text>{on() ? "boost is on" : "boost is off"}</Text>}
+          trailing={
+            <F.Switch
+              value={on()}
+              onChanged={(v) => {
+                setOn(v);
+                setLevel(v ? 75 : 25);
+              }}
+            />
+          }
+          onTap={() => setTaps(taps() + 1)}
+        />
+        <F.Slider value={level()} min={0} max={100} divisions={4} onChanged={(v) => setLevel(Math.round(v))} />
+
+        {/* the app's own plain Flutter widget (dart/lib/fuse/rating_badge.dart) */}
+        <RatingBadge label="Rating" stars={stars()} tone={stars() >= 4 ? "positive" : "neutral"} onRated={setStars} />
+        <Text>{`stars ${stars()}`}</Text>
+
+        {/* dev-mode validation: values TypeScript cannot see (any / JSON / spread) */}
+        <F.ListTile
+          title={<Text>Break it</Text>}
+          onTap={() => {
+            setBroken(true);
+            queueMicrotask(() => setErrors([...nativeValidationErrors]));
+          }}
+        />
+        <Show when={broken()}>
+          <Broken />
+        </Show>
+        <Text>{`validation errors: ${errors().length}`}</Text>
+        <Text fontSize={10}>{errors().join("\n")}</Text>
+      </View>
+      </ScrollView>
+    </F.Scaffold>
+  );
+}
+
+/** Deliberately wrong props, typed `any` so tsc cannot catch them. */
+function Broken() {
+  const typo: any = { percent: 0.5, lineHeigth: 8 };
+  const wrongType: any = { percent: "0.5" };
+  const badEnum: any = { label: "x", tone: "positiv" };
+  const missing: any = { stars: 3 };
+  const badData: any = { percent: 0.2, progressColor: "Colors.tael", padding: { $: "symetric", horizontal: 4 } };
+  const badField: any = { percent: 0.2, padding: { $: "symmetric", horizontl: 4 } };
+  const notBridged: any = { percent: 0.2, onPercentValue: () => {} };
+  return (
+    <View>
+      <LinearPercentIndicator {...typo} />
+      <LinearPercentIndicator {...wrongType} />
+      <RatingBadge {...badEnum} />
+      <RatingBadge {...missing} />
+      <LinearPercentIndicator {...badData} />
+      <LinearPercentIndicator {...badField} />
+      <LinearPercentIndicator {...notBridged} />
+    </View>
+  );
+}
+
+render(() => <Settings />);
