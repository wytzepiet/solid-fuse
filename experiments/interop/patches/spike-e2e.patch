@@ -0,0 +1,62 @@
+// Measures what the manifest-driven outputs cost for a given manifest.
+//   bun experiments/interop/e2e/measure.ts <manifest.json> <outDir>
+// Writes <unit>.ts, <unit>.nodocs.ts, NATIVE.md, native.catalog.json and
+// validation.json into outDir and prints sizes.
+import { mkdirSync, readFileSync, writeFileSync } from "fs";
+import { gzipSync } from "zlib";
+import { join } from "path";
+import {
+  emitCatalogJson,
+  emitCatalogMarkdown,
+  emitTsModule,
+  validationView,
+  type Manifest,
+} from "../../../packages/solid-fuse/cli/gen-emit";
+
+const [manifestPath, outDir] = process.argv.slice(2);
+mkdirSync(outDir, { recursive: true });
+const raw = readFileSync(manifestPath);
+const m = JSON.parse(raw.toString()) as Manifest;
+
+const stripDocs = (x: any): any =>
+  Array.isArray(x)
+    ? x.map(stripDocs)
+    : x && typeof x === "object"
+      ? Object.fromEntries(Object.entries(x).filter(([k]) => k !== "doc").map(([k, v]) => [k, stripDocs(v)]))
+      : x;
+
+const withDocs = emitTsModule(m);
+const noDocs = emitTsModule(stripDocs(m));
+const md = emitCatalogMarkdown([m], "~/_generated", "full");
+const mdIndex = emitCatalogMarkdown([m], "~/_generated", "index");
+const cat = JSON.stringify(emitCatalogJson([m], "~/_generated"));
+const view = JSON.stringify(validationView(m));
+writeFileSync(join(outDir, `${m.unit}.ts`), withDocs.ts);
+writeFileSync(join(outDir, `${m.unit}.nodocs.ts`), noDocs.ts);
+writeFileSync(join(outDir, "NATIVE.md"), md);
+writeFileSync(join(outDir, "NATIVE.index.md"), mdIndex);
+writeFileSync(join(outDir, "native.catalog.json"), cat);
+writeFileSync(join(outDir, "validation.json"), view);
+
+const n = Object.keys(m.widgets).length;
+const per = Object.values(withDocs.perWidgetBytes).sort((a, b) => a - b);
+const perNo = Object.values(noDocs.perWidgetBytes).sort((a, b) => a - b);
+const sum = (a: number[]) => a.reduce((x, y) => x + y, 0);
+const kb = (b: number) => `${(b / 1024).toFixed(1)} KB`;
+const gz = (s: string | Buffer) => kb(gzipSync(s).length);
+const row = (label: string, s: string | Buffer) =>
+  console.log(`${label.padEnd(44)} ${kb(Buffer.byteLength(s)).padStart(10)}  gzip ${gz(s).padStart(9)}  ~${Math.round(Buffer.byteLength(s) / 4 / 1000)}k tokens`);
+
+console.log(`${m.unit} ${m.version}: ${n} widgets, ${sum(Object.values(m.widgets).map((w) => Object.keys(w.props).length))} props, ${Object.keys(m.types).length} data types, ${Object.keys(m.enums).length} enums, ${Object.keys(m.payloads).length} payloads`);
+row("manifest.json (as committed, with docs)", raw);
+row("manifest.json (minified, no docs)", JSON.stringify(stripDocs(m)));
+row("TS module (with docs)", withDocs.ts);
+row("TS module (no docs)", noDocs.ts);
+row("  of which shared types (with docs)", "x".repeat(withDocs.sharedBytes));
+row("validation view (dev prelude)", view);
+row("NATIVE.md catalogue (full: every prop)", md);
+row("NATIVE.md catalogue (index: names + docs)", mdIndex);
+row("native.catalog.json", cat);
+console.log(`per widget TS, with docs: mean ${Math.round(sum(per) / n)} B, median ${per[n >> 1]} B, max ${per[n - 1]} B`);
+console.log(`per widget TS, no docs:   mean ${Math.round(sum(perNo) / n)} B, median ${perNo[n >> 1]} B, max ${perNo[n - 1]} B`);
+console.log(`per widget catalogue (md): mean ${Math.round(Buffer.byteLength(md) / n)} B`);
