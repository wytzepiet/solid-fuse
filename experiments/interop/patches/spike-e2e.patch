diff --git a/packages/solid-fuse/gen/bin/fuse_gen.dart b/packages/solid-fuse/gen/bin/fuse_gen.dart
new file mode 100644
index 0000000..9ac5b8e
--- /dev/null
+++ b/packages/solid-fuse/gen/bin/fuse_gen.dart
@@ -0,0 +1,144 @@
+// Generator entry point behind `fuse gen` / `fuse add`.
+//
+//   dart run bin/fuse_gen.dart --job job.json
+//
+// job.json:
+//   {
+//     "appRoot": "/abs/app/dart",          // analysis context: the app's package_config decides versions
+//     "outDart": "/abs/app/dart/lib/_generated",
+//     "outManifest": "/abs/app/src/_generated",
+//     "docs": "first",                      // none | first | full
+//     "units": [
+//       { "name": "flutter", "widgets": ["ListTile", "Image.network"] },
+//       { "name": "percent_indicator",
+//         "libs": [["package:percent_indicator/percent_indicator.dart", "percent_indicator"]],
+//         "include": null },                // null = every widget the libs export
+//       { "name": "app", "libs": [["package:my_app/fuse/badge.dart", "app_badge"]] }
+//     ]
+//   }
+//
+// Writes <outDart>/<unit>.fuse.g.dart and <outManifest>/<unit>.manifest.json,
+// and prints one JSON summary line on stdout.
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:fuse_gen/src/classify.dart';
+import 'package:fuse_gen/src/gen.dart';
+import 'package:fuse_gen/src/overrides.dart';
+import 'package:fuse_gen/src/world.dart';
+
+/// Bumped whenever generated output changes shape. Recorded in fuse.lock.
+const generatorVersion = '0.1.0';
+
+Future<void> main(List<String> args) async {
+  final i = args.indexOf('--job');
+  if (i < 0 || i + 1 >= args.length) {
+    stderr.writeln('usage: fuse_gen --job <job.json>');
+    exit(64);
+  }
+  final job = jsonDecode(File(args[i + 1]).readAsStringSync()) as Map<String, dynamic>;
+  final appRoot = job['appRoot'] as String;
+  final outDart = job['outDart'] as String;
+  final outManifest = job['outManifest'] as String;
+  final docs = job['docs'] as String? ?? 'first';
+  final units = (job['units'] as List).cast<Map<String, dynamic>>();
+
+  final sw = Stopwatch()..start();
+  final extra = <(String, String)>[
+    for (final u in units)
+      for (final l in (u['libs'] as List? ?? const [])) ((l as List)[0] as String, l[1] as String),
+  ];
+  final w = await World.load(appRoot, extraLibs: extra);
+  final loadMs = sw.elapsedMilliseconds;
+  Directory(outDart).createSync(recursive: true);
+  Directory(outManifest).createSync(recursive: true);
+
+  final summary = <String, Object?>{'generator': generatorVersion, 'loadMs': loadMs, 'units': <String, Object?>{}};
+  for (final u in units) {
+    final name = u['name'] as String;
+    final libs = [for (final l in (u['libs'] as List? ?? const [])) (l as List)[0] as String];
+    final include = (u['include'] as List?)?.cast<String>();
+    // One classifier per unit keeps a unit's output independent of the order
+    // units are generated in.
+    final c = Classifier(w, codecTypes: {for (final o in defaultOverrides) o.type});
+    final g = Generator(w, c, docs: docs, unit: name);
+    if (libs.isEmpty) {
+      for (final spec in (u['widgets'] as List? ?? const []).cast<String>()) {
+        g.addWidget(spec);
+      }
+    } else {
+      for (final lib in libs) {
+        final pkgPrefix = lib.substring(0, lib.indexOf('/'));
+        final classes = w.widgetsOf(lib)..sort((a, b) => a.name!.compareTo(b.name!));
+        for (final k in classes) {
+          // only classes declared by that package (not Flutter re-exports)
+          if (!k.library.uri.toString().startsWith(pkgPrefix)) continue;
+          for (final ctor in k.constructors.where((x) => x.isPublic && !x.metadata.hasDeprecated)) {
+            final spec = (ctor.name == null || ctor.name == 'new') ? k.name! : '${k.name}.${ctor.name}';
+            if (include != null && !include.contains(spec) && !include.contains(k.name)) continue;
+            g.addWidget(spec, libUri: lib);
+          }
+        }
+      }
+    }
+    final out = g.finish();
+    final manifest = <String, Object?>{
+      'manifestVersion': 1,
+      'generator': generatorVersion,
+      'unit': name,
+      'version': u['version'] ?? 'unknown',
+      ...out.manifest,
+      if (libs.isNotEmpty) 'libraries': libs,
+    };
+    File('$outDart/$name.fuse.g.dart').writeAsStringSync(out.dart);
+    File('$outManifest/$name.manifest.json').writeAsStringSync('${prettyManifest(manifest)}\n');
+    final ok = g.reports.where((r) => r.skipped == null).toList();
+    (summary['units'] as Map)[name] = {
+      'widgetsRequested': g.reports.length,
+      'widgetsEmitted': ok.length,
+      'paramsTotal': ok.fold<int>(0, (a, r) => a + r.params),
+      'paramsEmitted': ok.fold<int>(0, (a, r) => a + r.emitted),
+      'dartBytes': out.dart.length,
+      'dartLines': '\n'.allMatches(out.dart).length,
+      'dartAdapterLines': ok.fold<int>(0, (a, r) => a + r.dartLines),
+      'dartCodecLines': out.codecLines,
+      'decoders': g.decoderCount,
+      'encoders': g.encoderCount,
+      'enums': g.enumCount,
+      'skipped': {for (final r in g.reports.where((r) => r.skipped != null)) r.component: r.skipped},
+      'warnings': g.warnings.toSet().toList(),
+    };
+    stderr.writeln('[fuse gen] $name: ${ok.length}/${g.reports.length} widgets, '
+        '${ok.fold<int>(0, (a, r) => a + r.emitted)}/${ok.fold<int>(0, (a, r) => a + r.params)} params, '
+        '${'\n'.allMatches(out.dart).length} lines Dart');
+  }
+  summary['totalMs'] = sw.elapsedMilliseconds;
+  stdout.writeln(jsonEncode(summary));
+}
+
+/// Pretty-prints the manifest so that it diffs well when committed: one line
+/// per prop, per data-type variant and per payload field (depth 4), with the
+/// structure above that indented normally.
+String prettyManifest(Object? v, [int depth = 0]) {
+  final pad = ' ' * depth;
+  if (v is Map && v.isNotEmpty && depth < 4) {
+    final b = StringBuffer('{\n');
+    final keys = v.keys.toList();
+    for (var i = 0; i < keys.length; i++) {
+      b.write('$pad ${jsonEncode(keys[i])}: ${prettyManifest(v[keys[i]], depth + 1)}');
+      b.write(i == keys.length - 1 ? '\n' : ',\n');
+    }
+    b.write('$pad}');
+    return b.toString();
+  }
+  if (v is List && v.isNotEmpty && depth < 4 && v.any((e) => e is Map || e is List)) {
+    final b = StringBuffer('[\n');
+    for (var i = 0; i < v.length; i++) {
+      b.write('$pad ${prettyManifest(v[i], depth + 1)}');
+      b.write(i == v.length - 1 ? '\n' : ',\n');
+    }
+    b.write('$pad]');
+    return b.toString();
+  }
+  return jsonEncode(v);
+}
diff --git a/packages/solid-fuse/gen/lib/src/classify.dart b/packages/solid-fuse/gen/lib/src/classify.dart
new file mode 100644
index 0000000..be650f0
--- /dev/null
+++ b/packages/solid-fuse/gen/lib/src/classify.dart
@@ -0,0 +1,561 @@
+// The rule engine: DartType -> how it crosses the JSON bridge.
+//
+// Every rule here is *general* (structural); there is no per-type knowledge
+// except the short list of framework roots in [World] (Widget, Key,
+// Listenable, BuildContext, State, RenderObject, Element).
+import 'package:analyzer/dart/element/element.dart';
+import 'package:analyzer/dart/element/nullability_suffix.dart';
+import 'package:analyzer/dart/element/type.dart';
+
+import 'world.dart';
+
+/// Above this many concrete subclasses a hierarchy is considered open and only
+/// the declared type's own constructors are used.
+const kMaxSubclasses = 40;
+
+class Cls {
+  Cls(this.family, this.sub,
+      {this.ok = true,
+      this.partial = false,
+      this.data,
+      this.cb,
+      this.coll,
+      this.elem,
+      this.keyType});
+  final String family;
+  final String sub;
+
+  /// Covered by the general rules (possibly with dropped optional parts).
+  bool ok;
+  bool partial;
+  final DataInfo? data;
+  final CbInfo? cb;
+
+  /// 'list' | 'set' | 'iterable' | 'map' for collections; [elem] is the
+  /// element classification (the family/sub of a collection mirror elem's).
+  final String? coll;
+  final Cls? elem;
+  final DartType? keyType;
+
+  String get label => coll == null ? '$family/$sub' : '$family/$sub[$coll]';
+}
+
+class P {
+  P(this.el, this.type, this.cls);
+  final FormalParameterElement el;
+  final DartType type;
+  final Cls cls;
+  String get name => el.name ?? '_';
+  bool get nullable => type.nullabilitySuffix == NullabilitySuffix.question;
+
+  /// Caller must supply a non-null value.
+  bool get mustSupply => el.isRequired && !nullable && !el.hasDefaultValue;
+}
+
+class Variant {
+  Variant(this.tag, this.type, this.ctor);
+  final String? tag;
+  final InterfaceType type;
+  final ConstructorElement ctor;
+  final List<P> params = [];
+
+  /// name -> reason. Required-nullable dropped params are passed as null.
+  final Map<String, String> dropped = {};
+  final List<P> passNull = [];
+}
+
+class ConstRef {
+  ConstRef(this.label, this.owner, this.field);
+  final String label;
+  final InterfaceElement owner;
+  final FieldElement field;
+}
+
+class DataInfo {
+  DataInfo(this.type);
+  final InterfaceType type;
+  final List<Variant> variants = [];
+  final List<ConstRef> consts = [];
+  final Map<String, String> rejected = {}; // ctor -> reason
+  bool openHierarchy = false;
+  bool constsCapped = false;
+  int constCount = 0;
+  bool get usable => variants.isNotEmpty || consts.isNotEmpty;
+  bool get partial => variants.any((v) => v.dropped.isNotEmpty);
+}
+
+class CbArg {
+  CbArg(this.name, this.type, this.enc);
+  final String name;
+  final DartType type;
+  final Enc enc;
+}
+
+class CbInfo {
+  CbInfo(this.type, this.ret);
+  final FunctionType type;
+
+  /// void | future-void | widget | value | future-value
+  final String ret;
+  final List<CbArg> args = [];
+  bool hasContext = false;
+  bool hasNamed = false;
+  bool get argsEncodable => args.every((a) => a.enc.ok) && !hasNamed;
+}
+
+class Enc {
+  Enc(this.kind, {this.ok = true, this.elem});
+
+  /// prim | double | enum | generic | coll | class | none
+  final String kind;
+  bool ok;
+  final Enc? elem;
+  final List<(String, DartType, Enc)> fields = [];
+}
+
+class Classifier {
+  Classifier(this.w, {this.nested = false, this.maxConsts = 400, this.codecTypes = const {}});
+
+  /// Element names that have a hand-written codec override; such a type is
+  /// bridgeable even when no constructor/constant can be derived (IconData).
+  final Set<String> codecTypes;
+  final World w;
+
+  /// Allow widgets / void callbacks / handles *inside* data classes (needs the
+  /// wire format to carry node refs and function markers at nested paths).
+  final bool nested;
+  final int maxConsts;
+
+  final Map<String, Cls> _memo = {};
+  final Map<String, Enc> _encMemo = {};
+
+  String keyOf(DartType t) {
+    final nn = w.ts.promoteToNonNull(t);
+    final lib = nn.element?.library?.uri.toString() ?? '';
+    return '$lib|${nn.getDisplayString()}';
+  }
+
+  Cls classify(DartType t) {
+    final key = keyOf(t);
+    final hit = _memo[key];
+    if (hit != null) return hit;
+    return _memo[key] = _classify(w.ts.promoteToNonNull(t), key);
+  }
+
+  Cls _unb(String why) => Cls('unbridgeable', why, ok: false);
+
+  Cls _classify(DartType t, String key) {
+    if (t is DynamicType) return Cls('dynamic', 'dynamic');
+    if (t is VoidType || t is NeverType || t.isDartCoreNull) return _unb('void/never');
+    if (t is InvalidType) return _unb('invalid');
+    if (t is TypeParameterType) return Cls('generic', 'type-parameter');
+    if (t is RecordType) return _unb('record');
+    if (t is FunctionType) return _callback(t);
+    if (t is! InterfaceType) return _unb('other');
+
+    final el = t.element;
+    if (t.isDartCoreBool) return Cls('primitive', 'bool');
+    if (t.isDartCoreInt) return Cls('primitive', 'int');
+    if (t.isDartCoreDouble) return Cls('primitive', 'double');
+    if (t.isDartCoreNum) return Cls('primitive', 'num');
+    if (t.isDartCoreString) return Cls('primitive', 'String');
+    if (t.isDartCoreObject) return Cls('dynamic', 'Object');
+    if (t.isDartCoreFunction) return _unb('untyped-Function');
+    if (t.isDartCoreType) return _unb('Type');
+    if (el is EnumElement) return Cls('enum', 'enum');
+
+    if (t.isDartCoreList || t.isDartCoreSet || t.isDartCoreIterable) {
+      final e = classify(t.typeArguments.first);
+      final coll = t.isDartCoreList ? 'list' : t.isDartCoreSet ? 'set' : 'iterable';
+      if (e.coll != null && e.family != 'primitive' && e.family != 'data' && e.family != 'enum') {
+        return _unb('nested-collection');
+      }
+      return Cls(e.family, e.sub,
+          ok: e.ok, partial: e.partial, data: e.data, cb: e.cb, coll: coll, elem: e);
+    }
+    if (t.isDartCoreMap) {
+      final k = classify(t.typeArguments[0]);
+      final v = classify(t.typeArguments[1]);
+      final keyOk = k.coll == null &&
+          (k.family == 'enum' ||
+              (k.family == 'primitive' && (k.sub == 'String' || k.sub == 'int')) ||
+              k.family == 'dynamic' ||
+              k.family == 'generic');
+      if (!keyOk) return _unb('map-key');
+      return Cls(v.family, v.sub,
+          ok: v.ok,
+          partial: v.partial,
+          data: v.data,
+          cb: v.cb,
+          coll: 'map',
+          elem: v,
+          keyType: t.typeArguments[0]);
+    }
+    if (t.isDartAsyncFuture || t.isDartAsyncFutureOr || t.isDartAsyncStream) {
+      return _unb('future/stream');
+    }
+
+    if (el == w.widgetEl) return Cls('widget', 'slot');
+    if (w.isSubtypeOfEl(t, w.widgetEl)) {
+      if (el == w.preferredSizeWidgetEl) return Cls('widget', 'preferredSize');
+      return Cls('widget', 'subtype', ok: false);
+    }
+    if (w.isSubtypeOfEl(t, w.keyEl)) {
+      return el == w.keyEl || el.name == 'LocalKey'
+          ? Cls('key', 'key')
+          : Cls('key', el.name ?? 'key', ok: false);
+    }
+    if (el == w.buildContextEl ||
+        w.isSubtypeOfEl(t, w.stateEl) ||
+        w.isSubtypeOfEl(t, w.renderObjectEl) ||
+        w.isSubtypeOfEl(t, w.elementEl)) {
+      return _unb('framework-object');
+    }
+    if (!w.isExported(el) || el.isPrivate) return _unb('private/unexported-type');
+    if (el.library.uri.toString() == 'dart:typed_data') return _unb('binary/typed-data');
+
+    // Stateful objects -> handles.
+    final name = el.name ?? '';
+    final isListenable = w.isSubtypeOfEl(t, w.listenableEl);
+    if (isListenable || name.endsWith('Controller') || name.endsWith('FocusNode') || name == 'LayerLink') {
+      final concrete = (el is ClassElement && !el.isAbstract) ||
+          w.subclassesOf(el).any((c) => c is ClassElement && !c.isAbstract && c.isPublic);
+      if (!concrete) return _unb('abstract-user-subclass');
+      return Cls(
+          'handle',
+          name.endsWith('Controller')
+              ? 'controller'
+              : name.contains('Focus')
+                  ? 'focus'
+                  : name.startsWith('Animation') || w.subclassesOf(el).any((c) => c.name == 'AnimationController') || el.allSupertypes.any((s) => s.element.name == 'Animation')
+                      ? 'animation'
+                      : 'listenable');
+    }
+
+    // Data classes.
+    final info = DataInfo(t);
+    final cls = Cls('data', 'pending', data: info);
+    _memo[key] = cls; // provisional, for recursive types (coinductive)
+    _fillData(info);
+    if (!info.usable && codecTypes.contains(el.name)) {
+      return Cls('data', 'override-only', data: info);
+    }
+    if (!info.usable) {
+      _memo.remove(key);
+      final why = info.rejected.values.toSet();
+      final hasNested = why.any((r) => r.startsWith('nested:'));
+      return _unb(el is ClassElement && el.isAbstract && w.subclassesOf(el).isEmpty && !el.constructors.any((c) => c.isFactory && c.isPublic)
+          ? 'abstract-no-impl'
+          : hasNested
+              ? 'needs-nested-widget/callback'
+              : 'no-usable-constructor');
+    }
+    final isUnion = info.variants.map((v) => v.type.element).toSet().length > 1;
+    return Cls(
+        'data',
+        info.variants.isEmpty
+            ? 'enumlike-only'
+            : isUnion
+                ? 'union'
+                : (el is ClassElement && el.isAbstract ? 'union' : 'ctor'),
+        data: info,
+        partial: info.partial);
+  }
+
+  // ── data classes ─────────────────────────────────────────────────────────
+
+  bool _okInData(Cls c) {
+    if (!c.ok) return false;
+    switch (c.family) {
+      case 'primitive':
+      case 'enum':
+      case 'data':
+      case 'dynamic':
+      case 'generic':
+        return true;
+      case 'widget':
+        return nested && (c.sub == 'slot' || c.sub == 'preferredSize');
+      case 'handle':
+        return nested && c.coll == null;
+      case 'callback':
+        return nested && c.coll == null && c.cb!.ret == 'void';
+    }
+    return false;
+  }
+
+  bool _isNestedKind(Cls c) =>
+      c.family == 'widget' || c.family == 'callback' || c.family == 'builder' || c.family == 'handle';
+
+  InterfaceType? _instantiateSub(InterfaceElement c, InterfaceType target) {
+    if (c.typeParameters.isEmpty) {
+      final t = c.thisType;
+      return w.ts.isSubtypeOf(t, target) ? t : null;
+    }
+    final sup = c.thisType.asInstanceOf(target.element);
+    if (sup == null) return null;
+    final map = <TypeParameterElement, DartType>{};
+    for (var i = 0; i < sup.typeArguments.length; i++) {
+      final a = sup.typeArguments[i];
+      if (a is TypeParameterType && c.typeParameters.contains(a.element)) {
+        map[a.element] = target.typeArguments[i];
+      }
+    }
+    if (map.length != c.typeParameters.length) return null;
+    final t = c.instantiate(
+        typeArguments: [for (final p in c.typeParameters) map[p]!],
+        nullabilitySuffix: NullabilitySuffix.none);
+    return w.ts.isSubtypeOf(t, target) ? t : null;
+  }
+
+  void _fillData(DataInfo info) {
+    final t = info.type;
+    final el = t.element;
+    final candidates = <InterfaceType>[t];
+    final subs = w
+        .subclassesOf(el)
+        .where((c) => c is ClassElement && c.isPublic && !c.metadata.hasDeprecated)
+        .toList();
+    if (subs.length > kMaxSubclasses) {
+      info.openHierarchy = true;
+    } else {
+      for (final c in subs) {
+        final it = _instantiateSub(c, t);
+        if (it != null) candidates.add(it);
+      }
+    }
+    for (final ct in candidates) {
+      final ce = ct.element;
+      if (ce is! ClassElement) continue;
+      for (final ctor in ct.constructors) {
+        final cname = (ctor.name == null || ctor.name == 'new') ? null : ctor.name;
+        final tag = ce == el
+            ? cname
+            : cname == null
+                ? ce.name!
+                : '${ce.name}.$cname';
+        final label = tag ?? 'new';
+        if (ctor.isPrivate) continue;
+        if (ctor.metadata.hasDeprecated) continue;
+        if (ctor.metadata.hasProtected || ctor.metadata.hasVisibleForTesting || ctor.metadata.hasInternal) continue;
+        if (!ctor.isFactory && ce.isAbstract) continue;
+        final v = Variant(tag, ct, ctor);
+        String? reject;
+        var positionalCut = false;
+        for (final p in ctor.formalParameters) {
+          final c = classify(p.type);
+          final pp = P(p, p.type, c);
+          final deprecated = p.metadata.hasDeprecated;
+          if (p.metadata.hasMustBeConst) {
+            // e.g. IconData(codePoint): a decoded value can never be const.
+            reject = '${p.name}: @mustBeConst';
+            break;
+          }
+          if (!deprecated && _okInData(c) && !(positionalCut && p.isOptionalPositional)) {
+            v.params.add(pp);
+            continue;
+          }
+          final why = deprecated
+              ? 'deprecated'
+              : _isNestedKind(c)
+                  ? 'nested:${c.label}'
+                  : c.label;
+          if (pp.mustSupply) {
+            reject = '${p.name}: $why';
+            break;
+          }
+          v.dropped[pp.name] = why;
+          if (p.isRequired) v.passNull.add(pp); // required but nullable
+          if (p.isOptionalPositional) positionalCut = true;
+        }
+        if (reject != null) {
+          info.rejected[label] = reject.contains('nested:') ? 'nested:$reject' : reject;
+        } else {
+          info.variants.add(v);
+        }
+      }
+    }
+    // Static-const enum-likes.
+    final consts = <ConstRef>[];
+    for (final sc in w.staticConsts) {
+      final ft = sc.field.type;
+      if (ft is! InterfaceType) continue;
+      final owner = sc.owner;
+      final related = owner == el ||
+          owner.allSupertypes.any((s) => s.element == el) ||
+          _isNamespace(owner);
+      if (!related) continue;
+      if (owner.metadata.hasDeprecated) continue;
+      if (ft.element != el && !ft.allSupertypes.any((s) => s.element == el)) continue;
+      if (!w.ts.isSubtypeOf(ft, t)) continue;
+      consts.add(ConstRef(owner == el ? sc.field.name! : '${owner.name}.${sc.field.name}', owner, sc.field));
+    }
+    info.constCount = consts.length;
+    // Cap per owner so one huge namespace (Icons: ~8.9k) does not evict small ones.
+    final byOwner = <InterfaceElement, List<ConstRef>>{};
+    for (final c in consts) {
+      (byOwner[c.owner] ??= []).add(c);
+    }
+    byOwner.forEach((owner, list) {
+      if (list.length > maxConsts) {
+        info.constsCapped = true;
+      } else {
+        info.consts.addAll(list);
+      }
+    });
+  }
+
+  final Map<InterfaceElement, bool> _nsMemo = {};
+  bool _isNamespace(InterfaceElement owner) => _nsMemo[owner] ??= owner is ClassElement &&
+      (owner.constructors.every((c) => c.isPrivate) ||
+          (owner.isAbstract && !owner.constructors.any((c) => c.isFactory && c.isPublic) && owner.fields.every((f) => f.isStatic)));
+
+  // ── callbacks ────────────────────────────────────────────────────────────
+
+  Cls _callback(FunctionType f) {
+    final r = f.returnType;
+    String ret;
+    bool isWidgety(DartType x) =>
+        w.isSubtypeOfEl(x, w.widgetEl) ||
+        (x is InterfaceType && (x.isDartCoreList || x.isDartCoreIterable) && w.isSubtypeOfEl(x.typeArguments.first, w.widgetEl));
+    if (r is VoidType) {
+      ret = 'void';
+    } else if (r.isDartAsyncFuture || r.isDartAsyncFutureOr) {
+      final a = (r as InterfaceType).typeArguments.first;
+      ret = a is VoidType ? 'future-void' : 'future-value';
+    } else if (isWidgety(r)) {
+      ret = 'widget';
+    } else {
+      ret = 'value';
+    }
+    final info = CbInfo(f, ret);
+    var i = 0;
+    for (final p in f.formalParameters) {
+      if (p.isNamed) {
+        info.hasNamed = true;
+        continue;
+      }
+      if (p.type is InterfaceType && (p.type as InterfaceType).element == w.buildContextEl) {
+        info.hasContext = true;
+        info.args.add(CbArg(p.name ?? 'context', p.type, Enc('context')));
+        i++;
+        continue;
+      }
+      final n = (p.name == null || p.name!.isEmpty) ? 'arg$i' : p.name!;
+      info.args.add(CbArg(n, p.type, encodable(p.type)));
+      i++;
+    }
+    final real = info.args.where((a) => a.enc.kind != 'context').toList();
+    switch (ret) {
+      case 'void':
+        return Cls(
+            'callback',
+            real.isEmpty
+                ? 'void()'
+                : info.argsEncodable
+                    ? 'void(encodable args)'
+                    : 'void(unencodable args)',
+            cb: info,
+            ok: info.argsEncodable);
+      case 'future-void':
+        return Cls('callback', 'Future<void>', cb: info, ok: false);
+      case 'future-value':
+        return Cls('callback', 'Future<value>', cb: info, ok: false);
+      case 'widget':
+        return Cls(
+            'builder',
+            real.isEmpty
+                ? 'context-only'
+                : info.argsEncodable
+                    ? 'encodable args'
+                    : 'unencodable args',
+            cb: info,
+            ok: false);
+      default:
+        return Cls('callback', 'sync-return', cb: info, ok: false);
+    }
+  }
+
+  // ── Dart -> JSON (callback arguments) ────────────────────────────────────
+
+  Enc encodable(DartType type, [int depth = 0]) {
+    final key = keyOf(type);
+    final hit = _encMemo[key];
+    if (hit != null) return hit;
+    final t = w.ts.promoteToNonNull(type);
+    Enc r;
+    if (t is TypeParameterType || t is DynamicType) {
+      r = Enc('generic');
+    } else if (t is! InterfaceType) {
+      r = Enc('none', ok: false);
+    } else if (t.isDartCoreBool || t.isDartCoreInt || t.isDartCoreString || t.isDartCoreNum) {
+      r = Enc('prim');
+    } else if (t.isDartCoreDouble) {
+      r = Enc('double');
+    } else if (t.isDartCoreObject) {
+      r = Enc('generic');
+    } else if (t.element is EnumElement) {
+      r = Enc('enum');
+    } else if (t.asInstanceOf(w.material.typeProvider.iterableElement) != null) {
+      // List/Set/Iterable and their subtypes (Float64List, ...)
+      final e = encodable(t.asInstanceOf(w.material.typeProvider.iterableElement)!.typeArguments.first, depth + 1);
+      r = Enc('coll', ok: e.ok, elem: e);
+    } else if (t.isDartCoreMap ||
+        t.isDartAsyncFuture ||
+        t.isDartAsyncStream ||
+        t.isDartCoreFunction ||
+        t.isDartCoreType ||
+        w.isSubtypeOfEl(t, w.widgetEl) ||
+        w.isSubtypeOfEl(t, w.keyEl) ||
+        w.isSubtypeOfEl(t, w.listenableEl) ||
+        w.isSubtypeOfEl(t, w.stateEl) ||
+        w.isSubtypeOfEl(t, w.renderObjectEl) ||
+        w.isSubtypeOfEl(t, w.elementEl) ||
+        t.element == w.buildContextEl ||
+        !w.isExported(t.element) ||
+        depth > 3) {
+      r = Enc('none', ok: false);
+    } else {
+      r = Enc('class', ok: false);
+      _encMemo[key] = r; // cycles: an in-progress type is not encodable
+      // Prefer the unnamed constructor's parameters (Offset(dx, dy), not
+      // Offset.fromDirection(direction, distance)).
+      final names = <String>{};
+      final ctors = t.element.constructors.where((c) => c.isPublic).toList();
+      final unnamed = ctors.where((c) => c.name == null || c.name == 'new').toList();
+      for (final c in unnamed.isNotEmpty && unnamed.first.formalParameters.isNotEmpty ? unnamed : ctors) {
+        for (final p in c.formalParameters) {
+          if (p.name != null) names.add(p.name!);
+        }
+      }
+      final lib = w.material;
+      final seen = <String>{};
+      void consider(String n, DartType ft) {
+        if (n.startsWith('_') || n == 'hashCode' || n == 'runtimeType' || !seen.add(n)) return;
+        final e = encodable(ft, depth + 1);
+        if (e.ok) r.fields.add((n, ft, e));
+      }
+
+      for (final n in names) {
+        final g = t.lookUpGetter(n, lib, concrete: false, inherited: false) ??
+            t.lookUpGetter(n, lib, inherited: true);
+        if (g != null && !g.isStatic && !g.metadata.hasDeprecated) consider(n, g.returnType);
+      }
+      void scan(bool Function(GetterElement) pick) {
+        for (final st in [t, ...t.allSupertypes]) {
+          if (st.isDartCoreObject) continue;
+          for (final g in st.getters) {
+            if (g.isStatic || g.isPrivate || g.metadata.hasDeprecated) continue;
+            if (pick(g)) consider(g.name!, g.returnType);
+          }
+        }
+      }
+
+      // 1. getters named like a constructor parameter (round-trippable state)
+      // 2. else declared public fields  3. else every public getter
+      if (r.fields.isEmpty) scan((g) => g.isOriginVariable);
+      if (r.fields.isEmpty) scan((g) => true);
+      r.ok = r.fields.isNotEmpty;
+    }
+    return _encMemo[key] = r;
+  }
+}
diff --git a/packages/solid-fuse/gen/lib/src/gen.dart b/packages/solid-fuse/gen/lib/src/gen.dart
new file mode 100644
index 0000000..449cbe1
--- /dev/null
+++ b/packages/solid-fuse/gen/lib/src/gen.dart
@@ -0,0 +1,938 @@
+// Emits (a) Dart adapters + codecs and (b) a JSON manifest describing every
+// widget, prop, data type, enum and callback payload. Everything that is not
+// Dart (TS wrappers, dev validators, catalogue, lock hash) is produced from
+// the manifest by the CLI (cli/gen-emit.ts), never from the analyzer.
+import 'package:analyzer/dart/constant/value.dart';
+import 'package:analyzer/dart/element/element.dart';
+import 'package:analyzer/dart/element/nullability_suffix.dart';
+import 'package:analyzer/dart/element/type.dart';
+
+import 'classify.dart';
+import 'overrides.dart';
+import 'world.dart';
+
+class WidgetReport {
+  WidgetReport(this.component);
+  final String component;
+  String? skipped;
+  int params = 0, emitted = 0;
+  final Map<String, String> dropped = {};
+  final List<String> notes = [];
+  int dartLines = 0;
+  Map<String, Object?> toJson() => {
+        'component': component,
+        if (skipped != null) 'skipped': skipped,
+        'params': params,
+        'emitted': emitted,
+        'dropped': dropped,
+        'notes': notes,
+        'dartLines': dartLines,
+      };
+}
+
+class Generator {
+  Generator(this.w, this.c, {this.overrides = defaultOverrides, this.childrenHints = defaultChildrenHints, this.docs = 'first', required this.unit, this.supportImport = 'package:solid_fuse/gen_support.dart'});
+
+  /// Unit name: `flutter`, `app`, or a pub package name. Wire tags are
+  /// `<unit>.<Component>`, which cannot collide across packages.
+  final String unit;
+  final String supportImport;
+  final mWidgets = <String, Map<String, Object?>>{};
+  final mSkipped = <String, String>{};
+  final Map<String, String> childrenHints;
+  final World w;
+  final Classifier c;
+  final List<CodecOverride> overrides;
+  final String docs; // none | first | full
+
+  final _imports = <String, String?>{}; // uri -> prefix
+  final _decoders = <String, InterfaceType>{}; // ident -> type (insertion ordered)
+  final _encoders = <String, InterfaceType>{};
+  final _tsEnums = <String, EnumElement>{};
+  final _identOwner = <String, String>{}; // ident -> type key (collision check)
+  final _dartWidgets = StringBuffer();
+  final _registrations = <String>[];
+  final reports = <WidgetReport>[];
+  final warnings = <String>[];
+
+  // ── naming / printing ────────────────────────────────────────────────────
+
+  String ref(Element e) {
+    final lib = w.importOf(e);
+    if (lib == null) throw StateError('not importable: ${e.name}');
+    if (lib.uri == 'dart:core') return e.name!;
+    _imports[lib.uri] = lib.prefix;
+    return lib.prefix == null ? e.name! : '${lib.prefix}.${e.name}';
+  }
+
+  /// Dart source for a type.
+  String tc(DartType t) {
+    final q = t.nullabilitySuffix == NullabilitySuffix.question ? '?' : '';
+    if (t is DynamicType) return 'dynamic';
+    if (t is VoidType) return 'void';
+    if (t is TypeParameterType) return 'dynamic';
+    if (t is InterfaceType) {
+      final args = t.typeArguments.isEmpty ? '' : '<${t.typeArguments.map(tc).join(', ')}>';
+      return '${ref(t.element)}$args$q';
+    }
+    if (t is FunctionType) {
+      return '${tc(t.returnType)} Function(${t.formalParameters.where((p) => p.isPositional).map((p) => tc(p.type)).join(', ')})$q';
+    }
+    return 'dynamic';
+  }
+
+  DartType nn(DartType t) => w.ts.promoteToNonNull(t);
+  bool nullable(DartType t) => t.nullabilitySuffix == NullabilitySuffix.question || t is DynamicType;
+
+  String ident(DartType t) {
+    final s = nn(t).getDisplayString();
+    final id = s
+        .replaceAll('?', 'N')
+        .replaceAll('<', 'Of')
+        .replaceAll(RegExp(r',\s*'), 'And')
+        .replaceAll('>', '')
+        .replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
+    final key = c.keyOf(t);
+    final owner = _identOwner.putIfAbsent(id, () => key);
+    if (owner != key) return _identOwner.entries.firstWhere((e) => e.value == key, orElse: () {
+      final alt = '${id}_${_identOwner.length}';
+      _identOwner[alt] = key;
+      return MapEntry(alt, key);
+    }).key;
+    return id;
+  }
+
+  List<CodecOverride> _overridesFor(DataInfo d) {
+    bool match(CodecOverride o, InterfaceElement e) {
+      final lib = e.library.uri.toString();
+      return o.type == e.name && (lib.startsWith('dart:') || lib.startsWith('package:flutter/'));
+    }
+
+    final out = <CodecOverride>[];
+    for (final o in overrides) {
+      if (match(o, d.type.element)) {
+        out.add(o);
+      } else if (o.inherit && d.variants.any((v) => match(o, v.type.element))) {
+        out.add(o);
+      } else if (o.inherit && w.subclassesOf(d.type.element).any((s) => match(o, s)) == false && d.type.element.allSupertypes.any((s) => match(o, s.element))) {
+        // subclass of an overridden type (MaterialColor param): a nice Color is not a MaterialColor -> skip
+      }
+    }
+    return out;
+  }
+
+  // ── JSON -> Dart ─────────────────────────────────────────────────────────
+
+  /// Expression of type `T?` decoding [src].
+  String dec(DartType t, String src) {
+    final cls = c.classify(t);
+    final base = nn(t);
+    if (cls.coll != null && base is InterfaceType) {
+      if (cls.coll == 'map') {
+        final kt = base.typeArguments[0];
+        final vt = base.typeArguments[1];
+        final kc = c.classify(kt);
+        final kf = kc.family == 'enum'
+            ? '(k) => ${ref(kt.element!)}.values.byName(k)'
+            : kc.sub == 'int'
+                ? '(k) => int.parse(k)'
+                : '(k) => k';
+        return 'fuseMap<${tc(kt)}, ${tc(vt)}>($src, $kf, (e) => ${_elem(vt)})';
+      }
+      final et = base.typeArguments.first;
+      final list = 'fuseList<${tc(et)}>($src, (e) => ${_elem(et)})';
+      return cls.coll == 'set' ? '$list?.toSet()' : list;
+    }
+    switch (cls.family) {
+      case 'primitive':
+        return switch (cls.sub) {
+          'bool' => 'decBool($src)',
+          'int' => 'decInt($src)',
+          'double' => 'decDouble($src)',
+          'num' => 'decNum($src)',
+          _ => 'decString($src)',
+        };
+      case 'enum':
+        return 'fuseEnum(${ref(base.element!)}.values, $src)';
+      case 'dynamic':
+      case 'generic':
+        return src;
+      case 'data':
+        final id = ident(base);
+        _decoders.putIfAbsent(id, () => base as InterfaceType);
+        return 'dec$id($src)';
+    }
+    throw StateError('dec: unsupported ${cls.label} for ${t.getDisplayString()}');
+  }
+
+  String _elem(DartType et) {
+    final e = dec(et, 'e');
+    final cls = c.classify(et);
+    if (cls.family == 'dynamic' || cls.family == 'generic') return e;
+    return nullable(et) ? e : '$e!';
+  }
+
+  /// Argument expression for a parameter decoded from [src]; null if the
+  /// parameter cannot be emitted (non-null default not reproducible).
+  String? argExpr(P p, String src, String owner) {
+    final e = dec(p.type, src);
+    final cls = c.classify(p.type);
+    if (hasDefault(p.el)) {
+      final d = defaultCode(p.el);
+      if (d == null) return null;
+      if (d == 'null') return e;
+      return '$e ?? $d';
+    }
+    if (p.nullable || ((cls.family == 'dynamic' || cls.family == 'generic') && cls.coll == null)) return e;
+    if (p.mustSupply) return "fuseReq($e, '$owner', '${p.name}')";
+    return null;
+  }
+
+  // ── const default regeneration ───────────────────────────────────────────
+
+  /// The parameter a redirecting factory's parameter forwards to. Redirecting
+  /// factories (`const factory EdgeInsetsGeometry.only({double left, ...}) =
+  /// EdgeInsets.only;`) declare no defaults of their own.
+  FormalParameterElement? _redirectTarget(FormalParameterElement p) {
+    final ctor = p.baseElement.enclosingElement;
+    if (ctor is! ConstructorElement) return null;
+    final target = ctor.redirectedConstructor;
+    if (target == null) return null;
+    final own = ctor.formalParameters;
+    final theirs = target.formalParameters;
+    if (p.isNamed) return theirs.where((t) => t.isNamed && t.name == p.name).firstOrNull;
+    final i = own.where((x) => x.isPositional).toList().indexWhere((x) => x.name == p.name);
+    final pos = theirs.where((x) => x.isPositional).toList();
+    return i >= 0 && i < pos.length ? pos[i] : null;
+  }
+
+  bool hasDefault(FormalParameterElement p) {
+    final t = _redirectTarget(p);
+    if (t != null) return hasDefault(t);
+    return p.hasDefaultValue;
+  }
+
+  String? defaultCode(FormalParameterElement p) {
+    final base = p.baseElement;
+    final rt = _redirectTarget(p);
+    if (rt != null) return hasDefault(rt) ? defaultCode(rt) : (p.type.nullabilitySuffix == NullabilitySuffix.question ? 'null' : null);
+    final v = base.computeConstantValue();
+    if (v == null) return null;
+    try {
+      return constCode(v);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  String constCode(DartObject o, {bool inConst = false}) {
+    if (o.isNull) return 'null';
+    final t = o.type;
+    final variable = o.variable;
+    if (variable is FieldElement && variable.isStatic && variable.isPublic) {
+      final owner = variable.enclosingElement;
+      if (owner.isPublic && w.isExported(owner)) return '${ref(owner)}.${variable.name}';
+    }
+    if (variable is TopLevelVariableElement && variable.isPublic && w.isExported(variable)) {
+      return ref(variable);
+    }
+    if (t == null) throw 'no type';
+    if (t.isDartCoreBool) return '${o.toBoolValue()!}';
+    if (t.isDartCoreInt) return '${o.toIntValue()!}';
+    if (t.isDartCoreDouble) {
+      final d = o.toDoubleValue()!;
+      if (d.isNaN) return 'double.nan';
+      if (d.isInfinite) return d > 0 ? 'double.infinity' : 'double.negativeInfinity';
+      return '$d';
+    }
+    if (t.isDartCoreString) {
+      return "'${o.toStringValue()!.replaceAll(r'\', r'\\').replaceAll("'", r"\'").replaceAll(r'$', r'\$').replaceAll('\n', r'\n')}'";
+    }
+    final el = t.element;
+    if (el is EnumElement) {
+      final idx = o.getField('index')?.toIntValue();
+      if (idx != null && w.isExported(el)) return '${ref(el)}.${el.constants[idx].name}';
+      throw 'enum';
+    }
+    final k = inConst ? '' : 'const ';
+    final list = o.toListValue();
+    if (list != null) {
+      return '$k<${tc((t as InterfaceType).typeArguments.first)}>[${list.map((e) => constCode(e, inConst: true)).join(', ')}]';
+    }
+    final set = o.toSetValue();
+    if (set != null) {
+      return '$k<${tc((t as InterfaceType).typeArguments.first)}>{${set.map((e) => constCode(e, inConst: true)).join(', ')}}';
+    }
+    final fn = o.toFunctionValue();
+    if (fn != null) {
+      final owner = fn.enclosingElement;
+      if (fn.isPublic && owner is InterfaceElement && w.isExported(owner)) return '${ref(owner)}.${fn.name}';
+      if (fn.isPublic && w.isExported(fn)) return ref(fn);
+      throw 'private function';
+    }
+    final inv = o.constructorInvocation;
+    if (inv != null && t is InterfaceType) {
+      final ctor = inv.constructor;
+      if (ctor.isPrivate || !w.isExported(t.element) || t.element.isPrivate) throw 'private ctor';
+      final name = (ctor.name == null || ctor.name == 'new') ? '' : '.${ctor.name}';
+      final args = [
+        ...inv.positionalArguments.map((a) => constCode(a, inConst: true)),
+        ...inv.namedArguments.entries.map((e) => '${e.key}: ${constCode(e.value, inConst: true)}'),
+      ];
+      final ta = t.typeArguments.isEmpty ? '' : '<${t.typeArguments.map(tc).join(', ')}>';
+      return '$k${ref(t.element)}$ta$name(${args.join(', ')})';
+    }
+    throw 'unsupported const';
+  }
+
+  /// TS literal for a default, when it is one.
+  String? tsDefault(FormalParameterElement p) {
+    final v = p.baseElement.computeConstantValue();
+    if (v == null || v.isNull) return null;
+    final t = v.type;
+    if (t == null) return null;
+    if (t.isDartCoreBool) return '${v.toBoolValue()}';
+    if (t.isDartCoreInt) return '${v.toIntValue()}';
+    if (t.isDartCoreDouble) {
+      final d = v.toDoubleValue()!;
+      return d.isFinite ? (d == d.roundToDouble() ? '${d.toInt()}' : '$d') : (d.isNaN ? 'NaN' : (d > 0 ? 'Infinity' : '-Infinity'));
+    }
+    if (t.isDartCoreString) return '"${v.toStringValue()}"';
+    final el = t.element;
+    if (el is EnumElement) {
+      final idx = v.getField('index')?.toIntValue();
+      if (idx != null) return '"${el.constants[idx].name}"';
+    }
+    final code = p.defaultValueCode;
+    return code == null ? null : 'Dart `${code.replaceAll(RegExp(r'\s+'), ' ')}`';
+  }
+
+  // ── data decoders ────────────────────────────────────────────────────────
+
+  String _ctorCall(Variant v, String owner) {
+    final name = (v.ctor.name == null || v.ctor.name == 'new') ? '' : '.${v.ctor.name}';
+    final ta = v.type.typeArguments.isEmpty ? '' : '<${v.type.typeArguments.map(tc).join(', ')}>';
+    final pos = <String>[];
+    final named = <String>[];
+    var cut = false;
+    for (final p in v.ctor.formalParameters) {
+      final pp = v.params.where((x) => x.name == p.name).firstOrNull;
+      String? e;
+      if (pp != null && !cut) e = argExpr(pp, "m['${pp.name}']", owner);
+      if (e == null) {
+        if (pp != null) warnings.add('$owner.${p.name}: default not reproducible, param dropped');
+        if (p.isRequired) {
+          if (p.isPositional) {
+            pos.add('null');
+          } else {
+            named.add('${p.name}: null');
+          }
+        } else if (p.isOptionalPositional) {
+          cut = true;
+        }
+        continue;
+      }
+      if (p.isPositional) {
+        pos.add(e);
+      } else {
+        named.add('${p.name}: $e');
+      }
+    }
+    return '${ref(v.type.element)}$ta$name(${[...pos, ...named].join(', ')})';
+  }
+
+  String _emitDecoder(String id, InterfaceType t) {
+    final d = c.classify(t).data!;
+    final b = StringBuffer();
+    final tn = tc(t);
+    final ovs = _overridesFor(d);
+    b.writeln('$tn? dec$id(Object? v) {');
+    b.writeln('  if (v == null) return null;');
+    for (final o in ovs) {
+      b.writeln('  final n${o.type} = ${o.decode}(v);');
+      b.writeln('  if (n${o.type} != null) return n${o.type};');
+    }
+    if (!ovs.any((o) => o.replace)) {
+      if (d.consts.isNotEmpty) {
+        b.writeln('  if (v is String) {');
+        b.writeln('    return switch (v) {');
+        for (final k in d.consts) {
+          b.writeln("      '${k.label}' => ${ref(k.owner)}.${k.field.name},");
+        }
+        b.writeln("      _ => fuseBad('$tn', v),");
+        b.writeln('    };');
+        b.writeln('  }');
+      }
+      if (d.variants.isNotEmpty) {
+        b.writeln('  final m = v as Map;');
+        b.writeln("  switch (m[r'\$']) {");
+        for (final v in d.variants) {
+          final owner = '${v.type.element.name}${v.tag == null ? '' : '.${v.tag!.split('.').last}'}';
+          b.writeln('    case ${v.tag == null ? 'null' : "'${v.tag}'"}:');
+          b.writeln('      return ${_ctorCall(v, owner)};');
+        }
+        b.writeln('  }');
+      }
+    }
+    b.writeln("  return fuseBad('$tn', v);");
+    b.writeln('}');
+    return b.toString();
+  }
+
+  // ── Dart -> JSON (callback payloads) ─────────────────────────────────────
+
+  String enc(DartType t, Enc e, String src) {
+    final q = nullable(t);
+    switch (e.kind) {
+      case 'prim':
+      case 'generic':
+        return src;
+      case 'double':
+        return 'fuseNum($src)';
+      case 'enum':
+        return q ? '$src?.name' : '$src.name';
+      case 'coll':
+        final et = _iterArg(t);
+        return '$src${q ? '?' : ''}.map((e) => ${enc(et, e.elem!, 'e')}).toList()';
+      case 'class':
+        final o = _encOverride(nn(t) as InterfaceType);
+        if (o != null) return '${o.encode}($src)';
+        final id = ident(t);
+        _encoders.putIfAbsent(id, () => nn(t) as InterfaceType);
+        return 'enc$id($src)';
+    }
+    return 'null';
+  }
+
+  DartType _iterArg(DartType t) =>
+      (nn(t) as InterfaceType).asInstanceOf(w.material.typeProvider.iterableElement)!.typeArguments.first;
+
+  CodecOverride? _encOverride(InterfaceType t) {
+    final lib = t.element.library.uri.toString();
+    if (!(lib.startsWith('dart:') || lib.startsWith('package:flutter/'))) return null;
+    return overrides.where((o) => o.encode != null && o.type == t.element.name).firstOrNull;
+  }
+
+  String _emitEncoder(String id, InterfaceType t) {
+    final e = c.encodable(t);
+    final b = StringBuffer();
+    b.writeln('Map<String, Object?>? enc$id(${tc(t)}? v) => v == null');
+    b.writeln('    ? null');
+    b.writeln('    : {');
+    for (final (n, ft, fe) in e.fields) {
+      b.writeln("        '$n': ${enc(ft, fe, 'v.$n')},");
+    }
+    b.writeln('      };');
+    return b.toString();
+  }
+
+  // ── manifest types ───────────────────────────────────────────────────────
+
+  /// Manifest type descriptor for a JS -> Dart value.
+  Map<String, Object?> mt(DartType t) {
+    final cls = c.classify(t);
+    final base = nn(t);
+    if (cls.coll != null && base is InterfaceType) {
+      if (cls.coll == 'map') {
+        final kt = base.typeArguments[0];
+        final kc = c.classify(kt);
+        return {'k': 'map', 'key': kc.family == 'enum' ? mt(kt) : {'k': 'string'}, 'v': _mElem(base.typeArguments[1])};
+      }
+      return {'k': 'list', 'e': _mElem(base.typeArguments.first)};
+    }
+    switch (cls.family) {
+      case 'primitive':
+        return {
+          'k': switch (cls.sub) { 'bool' => 'bool', 'String' => 'string', 'int' => 'int', 'double' => 'double', _ => 'num' }
+        };
+      case 'enum':
+        final el = base.element as EnumElement;
+        _tsEnums[el.name!] = el;
+        return {'k': 'enum', 'n': el.name!};
+      case 'dynamic':
+      case 'generic':
+        return {'k': 'unknown'};
+      case 'data':
+        final id = ident(base);
+        _decoders.putIfAbsent(id, () => base as InterfaceType);
+        return {'k': 'data', 'n': id};
+      case 'widget':
+        return {'k': 'widget'};
+      case 'handle':
+        return {'k': 'handle', 'n': base.getDisplayString()};
+      case 'callback':
+        return _mCallback(cls.cb!);
+    }
+    return {'k': 'never'};
+  }
+
+  Map<String, Object?> _mElem(DartType t) => nullable(t) && t is! DynamicType ? {...mt(t), 'nullable': true} : mt(t);
+
+  Map<String, Object?> _mCallback(CbInfo cb) {
+    final real = cb.args.where((a) => a.enc.kind != 'context').toList();
+    return {
+      'k': 'callback',
+      'args': [
+        for (final a in real)
+          {'name': a.name, 'type': mOut(a.type, a.enc), if (nullable(a.type) && a.enc.kind != 'generic') 'nullable': true},
+      ],
+    };
+  }
+
+  /// Manifest type descriptor for a Dart -> JS value (callback payloads).
+  Map<String, Object?> mOut(DartType t, Enc e) {
+    switch (e.kind) {
+      case 'prim':
+        final b = nn(t);
+        return {'k': b.isDartCoreBool ? 'bool' : b.isDartCoreString ? 'string' : b.isDartCoreInt ? 'int' : 'num'};
+      case 'double':
+        return {'k': 'double'};
+      case 'enum':
+        final el = nn(t).element as EnumElement;
+        _tsEnums[el.name!] = el;
+        return {'k': 'enum', 'n': el.name!};
+      case 'generic':
+        return {'k': 'unknown'};
+      case 'coll':
+        final et = _iterArg(t);
+        return {'k': 'list', 'e': {...mOut(et, e.elem!), if (nullable(et)) 'nullable': true}};
+      case 'class':
+        final o = _encOverride(nn(t) as InterfaceType);
+        if (o != null) return {'k': o.tsOut == 'string' ? 'string' : o.tsOut == 'number' ? 'num' : 'unknown'};
+        final id = ident(t);
+        _encoders.putIfAbsent(id, () => nn(t) as InterfaceType);
+        return {'k': 'payload', 'n': id};
+    }
+    return {'k': 'never'};
+  }
+
+  Map<String, Object?> _mData(String id, InterfaceType t) {
+    final d = c.classify(t).data!;
+    final ovs = _overridesFor(d);
+    final replace = ovs.any((o) => o.replace);
+    final variants = <Map<String, Object?>>[];
+    if (!replace) {
+      for (final v in d.variants) {
+        final fields = <String, Object?>{};
+        for (final p in v.params) {
+          final cls = c.classify(p.type);
+          final optional = !p.mustSupply || cls.family == 'dynamic' || cls.family == 'generic';
+          // skip params whose default could not be regenerated
+          if (hasDefault(p.el) && defaultCode(p.el) == null) continue;
+          if (!hasDefault(p.el) && !p.nullable && !p.mustSupply && cls.family != 'dynamic' && cls.family != 'generic') continue;
+          fields[p.name] = {
+            'type': mt(p.type),
+            if (!optional) 'required': true,
+            if (p.nullable && cls.coll == null && cls.family != 'dynamic' && cls.family != 'generic') 'nullable': true,
+          };
+        }
+        variants.add({'tag': v.tag, 'fields': fields, if (v.dropped.isNotEmpty) 'omitted': v.dropped});
+      }
+    }
+    final doc = docs == 'none' ? null : _docText(t.element.documentationComment, first: true);
+    return {
+      'dart': t.getDisplayString(),
+      if (doc != null) 'doc': doc,
+      if (ovs.isNotEmpty)
+        'nice': [
+          for (final o in ovs) {'ts': o.tsIn, 'accepts': o.accepts},
+        ],
+      if (replace) 'replace': true,
+      if (!replace && d.consts.isNotEmpty) 'consts': [for (final k in d.consts) k.label],
+      if (variants.isNotEmpty) 'variants': variants,
+    };
+  }
+
+  Map<String, Object?> _mPayload(String id, InterfaceType t) {
+    final e = c.encodable(t);
+    return {
+      'dart': t.getDisplayString(),
+      'fields': {
+        for (final (n, ft, fe) in e.fields) n: {...mOut(ft, fe), if (nullable(ft) && fe.kind != 'generic') 'nullable': true},
+      },
+    };
+  }
+
+  // ── docs ─────────────────────────────────────────────────────────────────
+
+  String? _docText(String? raw, {bool first = false}) {
+    if (raw == null) return null;
+    var lines = raw.split('\n').map((l) => l.replaceFirst(RegExp(r'^\s*///? ?'), '')).toList();
+    final out = <String>[];
+    var skip = false;
+    for (final l in lines) {
+      if (l.contains('{@tool')) skip = true;
+      if (!skip && !RegExp(r'^\s*\{@(template|endtemplate|macro|youtube|animation|category|subCategory)').hasMatch(l)) out.add(l);
+      if (l.contains('{@end-tool}')) skip = false;
+    }
+    var text = out.join('\n').trim();
+    if (first || docs == 'first') {
+      final i = text.indexOf('\n\n');
+      if (i > 0) text = text.substring(0, i);
+    }
+    text = text.replaceAll('*/', '*\\/');
+    return text.isEmpty ? null : text;
+  }
+
+  String? _paramDoc(FormalParameterElement p, InterfaceType owner) {
+    final b = p.baseElement;
+    if (b is FieldFormalParameterElement) {
+      final d = b.field?.documentationComment;
+      if (d != null) return d;
+    }
+    if (b is SuperFormalParameterElement) {
+      final s = b.superConstructorParameter;
+      if (s != null) {
+        final d = _paramDoc(s, owner);
+        if (d != null) return d;
+      }
+    }
+    final g = owner.lookUpGetter(p.name ?? '', w.material, inherited: false) ?? owner.lookUpGetter(p.name ?? '', w.material, inherited: true);
+    return g?.documentationComment ?? g?.variable.documentationComment;
+  }
+
+  // ── widgets ──────────────────────────────────────────────────────────────
+
+  /// [spec] is `Class` or `Class.ctor`.
+  void addWidget(String spec, {String? libUri}) {
+    final parts = spec.split('.');
+    final cname = parts[0];
+    final ctorName = parts.length > 1 ? parts[1] : 'new';
+    Element? el;
+    for (final e in w.entries) {
+      if (libUri != null && e.uri != libUri) continue;
+      el = e.element.exportNamespace.get2(cname);
+      if (el != null) break;
+    }
+    var component = cname + (ctorName == 'new' ? '' : ctorName[0].toUpperCase() + ctorName.substring(1));
+    // Positioned.directional vs class PositionedDirectional
+    if (ctorName != 'new' && w.entries.any((e) => e.element.exportNamespace.get2(component) != null)) component = '${component}Ctor';
+    final rep = WidgetReport(component);
+    reports.add(rep);
+    if (el is! ClassElement) {
+      rep.skipped = 'class not found';
+      mSkipped[component] = rep.skipped!;
+      return;
+    }
+    final type = w.ts.instantiateInterfaceToBounds(element: el, nullabilitySuffix: NullabilitySuffix.none);
+    final ctor = type.constructors.where((k) => (k.name ?? 'new') == ctorName).firstOrNull;
+    if (ctor == null || ctor.isPrivate) {
+      rep.skipped = 'constructor not found';
+      mSkipped[component] = rep.skipped!;
+      return;
+    }
+    if (type.typeArguments.isNotEmpty) {
+      rep.notes.add('generic class instantiated to bounds: ${type.getDisplayString()}');
+    }
+    final params = ctor.formalParameters;
+    rep.params = params.length;
+    final hint = childrenHints[cname];
+    final hasChild = hint != null || params.any((p) => (p.name == 'child' || p.name == 'children') && c.classify(p.type).family == 'widget');
+    final pos = <String>[];
+    final named = <String>[];
+    final mProps = <String, Object?>{};
+    String? childrenKind; // child | children | text
+    String? childrenParam;
+    var acceptsChildren = false;
+
+    for (final p in params) {
+      final cls = c.classify(p.type);
+      final pp = P(p, p.type, cls);
+      final name = pp.name;
+      final src = "p['$name']";
+      String? expr;
+      Map<String, Object?>? tsT;
+      var tsOptional = !pp.mustSupply;
+      String? drop;
+
+      if (p.metadata.hasDeprecated) {
+        drop = 'deprecated';
+      } else if (cls.family == 'key') {
+        drop = name == 'key' ? 'key (FuseNodeWidget already keys by node id)' : 'key';
+      } else if (cls.family == 'widget' && cls.ok) {
+        if (cls.sub == 'preferredSize' && cls.coll == null) {
+          expr = "fusePreferredSize(node, '$name')";
+          tsT = {'k': 'widget', 'preferredSize': true};
+          rep.notes.add('$name: PreferredSizeWidget slot wrapped in PreferredSize (fixed height hack)');
+          if (pp.mustSupply) expr = "fuseReq($expr, '$component', '$name')";
+        } else if (cls.coll == null && (name == 'child' || name == hint)) {
+          expr = pp.nullable ? 'fuseChild(node)' : 'fuseChild(node) ?? const SizedBox.shrink()';
+          acceptsChildren = true;
+          childrenKind = 'child';
+          childrenParam = name;
+        } else if (cls.coll == 'list' && (name == 'children' || name == hint)) {
+          expr = 'node.childWidgets';
+          acceptsChildren = true;
+          childrenKind = 'children';
+          childrenParam = name;
+        } else if (cls.coll == null) {
+          expr = pp.nullable ? "node.widget('$name')" : "node.widget('$name') ?? const SizedBox.shrink()";
+          tsT = {'k': 'widget'};
+          if (!pp.nullable && !p.hasDefaultValue) tsOptional = false;
+        } else if (cls.coll == 'list') {
+          expr = "fuseWidgetList(node, '$name')";
+          if (!pp.nullable) expr = '$expr ?? const <Widget>[]';
+          tsT = {'k': 'widgets'};
+          tsOptional = true;
+        } else {
+          drop = 'widget collection (${cls.coll})';
+        }
+      } else if (cls.family == 'callback' && cls.ok && cls.coll == null) {
+        final cb = cls.cb!;
+        final real = <(int, CbArg)>[];
+        for (var i = 0; i < cb.args.length; i++) {
+          if (cb.args[i].enc.kind != 'context') real.add((i, cb.args[i]));
+        }
+        final argList = [for (var i = 0; i < cb.args.length; i++) 'a$i'].join(', ');
+        if (cb.args.isEmpty && !pp.mustSupply) {
+          expr = "node.callback('$name')";
+        } else {
+          final payload = real.isEmpty
+              ? ''
+              : real.length == 1
+                  ? ', ${enc(real[0].$2.type, real[0].$2.enc, 'a${real[0].$1}')}'
+                  : ', [${real.map((r) => enc(r.$2.type, r.$2.enc, 'a${r.$1}')).join(', ')}]';
+          final call = "node.callFunction(node.id, '$name'$payload)";
+          expr = pp.mustSupply || !pp.nullable
+              ? "($argList) { if ($src == true) $call; }"
+              : "$src != true ? null : ($argList) => $call";
+          if (real.length > 1) rep.notes.add('$name: ${real.length} callback args cross as one array payload');
+        }
+        tsT = _mCallback(cb);
+        if (!pp.nullable) tsOptional = true;
+      } else if (cls.family == 'handle' && cls.coll == null) {
+        expr = "node.handle<${tc(nn(p.type))}>('$name')";
+        if (pp.mustSupply) expr = "fuseReq($expr, '$component', '$name')";
+        if (!pp.nullable && !pp.mustSupply) drop = 'handle with non-null default';
+        tsT = mt(p.type);
+      } else if (cls.ok && const {'primitive', 'enum', 'data', 'dynamic', 'generic'}.contains(cls.family)) {
+        // Text content rule: first required positional String, no child slot.
+        if (p.isRequiredPositional && nn(p.type).isDartCoreString && !hasChild && params.first == p) {
+          expr = '${dec(p.type, src)} ?? fuseText(node)';
+          tsOptional = true;
+          acceptsChildren = true;
+          childrenKind = 'text';
+          childrenParam = name;
+          rep.notes.add('$name: positional String is filled from text children when the prop is absent');
+        } else {
+          expr = argExpr(pp, src, component);
+          if (expr == null) drop = 'default value not reproducible (${p.defaultValueCode})';
+        }
+        tsT = mt(p.type);
+        if (cls.family == 'dynamic' || cls.family == 'generic') tsOptional = !p.isRequired;
+        if (cls.partial) rep.notes.add('$name: data type ${nn(p.type).getDisplayString()} has dropped optional ctor params');
+      } else {
+        drop = cls.label;
+      }
+
+      if (drop != null) {
+        if (pp.mustSupply) {
+          rep.skipped = 'required param `$name` (${p.type.getDisplayString()}) is not bridgeable: $drop';
+          mSkipped[component] = rep.skipped!;
+          return;
+        }
+        if (!(name == 'key' && cls.family == 'key')) rep.dropped[name] = drop;
+        if (p.isRequired) {
+          if (p.isPositional) {
+            pos.add('null');
+          } else {
+            named.add('$name: null');
+          }
+        }
+        continue;
+      }
+      rep.emitted++;
+      if (p.isPositional) {
+        pos.add(expr!);
+      } else {
+        named.add('$name: ${expr!}');
+      }
+      if (tsT != null) {
+        final dflt = p.hasDefaultValue ? tsDefault(p) : null;
+        final doc = docs == 'none' ? null : _docText(_paramDoc(p, type));
+        final nullish = pp.nullable && p.isRequired;
+        mProps[name] = {
+          'type': tsT,
+          'dart': p.type.getDisplayString(),
+          if (!tsOptional) 'required': true,
+          if (nullish) 'nullable': true,
+          if (dflt != null) 'default': dflt,
+          if (doc != null) 'doc': doc,
+        };
+      }
+    }
+
+    final dartName = 'FuseGen$component';
+    final ctorSuffix = ctorName == 'new' ? '' : '.$ctorName';
+    final ta = type.typeArguments.isEmpty ? '' : '<${type.typeArguments.map(tc).join(', ')}>';
+    final d = StringBuffer();
+    d.writeln('/// Generated adapter for [${ref(el)}$ctorSuffix].');
+    if (rep.dropped.isNotEmpty) {
+      d.writeln('///');
+      d.writeln('/// Not bridged: ${rep.dropped.entries.map((e) => '`${e.key}` (${e.value})').join(', ')}.');
+    }
+    d.writeln('class $dartName extends StatelessWidget {');
+    d.writeln('  const $dartName(this.node, {super.key});');
+    d.writeln('  final FuseNode node;');
+    d.writeln();
+    d.writeln('  @override');
+    d.writeln('  Widget build(BuildContext context) {');
+    final usesP = [...pos, ...named].any((e) => e.contains("p['"));
+    if (usesP) d.writeln('    final p = node.props;');
+    d.writeln('    try {');
+    d.writeln('      return ${ref(el)}$ta$ctorSuffix(');
+    for (final a in [...pos, ...named]) {
+      d.writeln('        $a,');
+    }
+    d.writeln('      );');
+    d.writeln('    } catch (e, st) {');
+    d.writeln('      return fuseBuildError(context, node, e, st);');
+    d.writeln('    }');
+    d.writeln('  }');
+    d.writeln('}');
+    rep.dartLines = '\n'.allMatches(d.toString()).length;
+    _dartWidgets.writeln(d);
+    final tag = '$unit.$component';
+    _registrations.add("  runtime.registerWidget('$tag', $dartName.new);");
+
+    final ownFlex = params.any((p) => p.name == 'flex');
+    if (ownFlex && acceptsChildren) rep.notes.add('flex: collides with solid-fuse\'s `flex` layout prop; the Flutter parameter wins');
+    final classDoc = docs == 'none' ? null : _docText(el.documentationComment);
+    mWidgets[component] = {
+      'tag': tag,
+      'dart': el.name,
+      if (ctorName != 'new') 'ctor': ctorName,
+      'library': el.library.uri.toString(),
+      if (classDoc != null) 'doc': classDoc,
+      if (childrenKind != null) 'children': childrenKind,
+      if (childrenParam != null) 'childrenParam': childrenParam,
+      // solid-fuse's `flex` layout convention applies when several JSX
+      // children fill a single `child:` (unless the widget has its own flex).
+      if (childrenKind == 'child' && !ownFlex) 'flexProp': true,
+      'props': mProps,
+      if (rep.dropped.isNotEmpty) 'omitted': rep.dropped,
+      if (rep.notes.isNotEmpty) 'notes': rep.notes,
+    };
+  }
+
+  // ── output ───────────────────────────────────────────────────────────────
+
+  ({String dart, Map<String, Object?> manifest, int codecLines}) finish() {
+    // Emit codecs to a fixpoint (emitting one may request more).
+    final decOut = <String, String>{};
+    final encOut = <String, String>{};
+    final mTypes = <String, Object?>{};
+    final mPayloads = <String, Object?>{};
+    var progress = true;
+    while (progress) {
+      progress = false;
+      for (final e in _decoders.entries.toList()) {
+        if (decOut.containsKey(e.key)) continue;
+        decOut[e.key] = _emitDecoder(e.key, e.value);
+        mTypes[e.key] = _mData(e.key, e.value);
+        progress = true;
+      }
+      for (final e in _encoders.entries.toList()) {
+        if (encOut.containsKey(e.key)) continue;
+        encOut[e.key] = _emitEncoder(e.key, e.value);
+        mPayloads[e.key] = _mPayload(e.key, e.value);
+        progress = true;
+      }
+    }
+    final codecs = StringBuffer();
+    codecs.writeln('// ── decoders (JSON -> Dart), one per data type ───────────────────────────────\n');
+    for (final k in decOut.keys.toList()..sort()) {
+      codecs.writeln(decOut[k]);
+    }
+    codecs.writeln('// ── encoders (Dart -> JSON), callback payloads ───────────────────────────────\n');
+    for (final k in encOut.keys.toList()..sort()) {
+      codecs.writeln(encOut[k]);
+    }
+
+    final dart = StringBuffer();
+    dart.writeln('// GENERATED by `fuse gen` from resolved Dart APIs. Do not edit.');
+    dart.writeln('// ignore_for_file: type=lint, deprecated_member_use');
+    final imports = {
+      'package:flutter/material.dart': null,
+      'package:solid_fuse/solid_fuse.dart': null,
+      supportImport: null,
+      ..._imports,
+    };
+    final uris = imports.keys.toList()..sort();
+    for (final u in uris) {
+      if (u == 'dart:core') continue;
+      dart.writeln(imports[u] == null ? "import '$u';" : "import '$u' as ${imports[u]};");
+    }
+    dart.writeln();
+    dart.writeln('void $registerName(FuseRuntime runtime) {');
+    _registrations.forEach(dart.writeln);
+    dart.writeln('}');
+    dart.writeln();
+    dart.write(_dartWidgets);
+    dart.write(codecs);
+
+    Map<String, Object?> sorted(Map<String, Object?> m) => {for (final k in m.keys.toList()..sort()) k: m[k]};
+    final manifest = <String, Object?>{
+      'unit': unit,
+      'register': registerName,
+      'widgets': mWidgets,
+      if (mSkipped.isNotEmpty) 'skipped': mSkipped,
+      'enums': {
+        for (final k in _tsEnums.keys.toList()..sort())
+          k: {
+            'values': [for (final c in _tsEnums[k]!.constants) c.name],
+            if (docs != 'none' && _docText(_tsEnums[k]!.documentationComment, first: true) != null)
+              'doc': _docText(_tsEnums[k]!.documentationComment, first: true),
+          },
+      },
+      'types': sorted(mTypes),
+      'payloads': sorted(mPayloads),
+    };
+    return (dart: dart.toString(), manifest: manifest, codecLines: '\n'.allMatches(codecs.toString()).length);
+  }
+
+  String get registerName {
+    final camel = unit.split(RegExp(r'[^A-Za-z0-9]+')).where((s) => s.isNotEmpty).map((s) => s[0].toUpperCase() + s.substring(1)).join();
+    return 'register${camel}Widgets';
+  }
+
+  /// Coverage inside the data classes that were emitted: constructor
+  /// parameters kept vs dropped (by reason), and constructors rejected.
+  Map<String, Object?> dataStats() {
+    var kept = 0, dropped = 0, variants = 0, rejected = 0, consts = 0;
+    final reasons = <String, int>{};
+    final examples = <String, List<String>>{};
+    final rejectedWhy = <String, String>{};
+    for (final e in _decoders.entries) {
+      final d = c.classify(e.value).data!;
+      variants += d.variants.length;
+      consts += d.consts.length;
+      rejected += d.rejected.length;
+      d.rejected.forEach((k, v) => rejectedWhy['${e.key}.$k'] = v);
+      for (final v in d.variants) {
+        kept += v.params.length;
+        dropped += v.dropped.length;
+        v.dropped.forEach((n, why) {
+          reasons[why] = (reasons[why] ?? 0) + 1;
+          final ex = examples[why] ??= [];
+          if (ex.length < 6) ex.add('${v.type.element.name}${v.tag == null ? '' : '(${v.tag})'}.$n');
+        });
+      }
+    }
+    return {
+      'types': _decoders.length,
+      'ctorVariants': variants,
+      'staticConsts': consts,
+      'ctorParamsKept': kept,
+      'ctorParamsDropped': dropped,
+      'droppedByReason': Map.fromEntries(reasons.entries.toList()..sort((a, b) => b.value.compareTo(a.value))),
+      'droppedExamples': examples,
+      'ctorsRejected': rejected,
+      'ctorsRejectedWhy': rejectedWhy,
+    };
+  }
+
+  int get decoderCount => _decoders.length;
+  int get encoderCount => _encoders.length;
+  int get enumCount => _tsEnums.length;
+}
diff --git a/packages/solid-fuse/gen/lib/src/overrides.dart b/packages/solid-fuse/gen/lib/src/overrides.dart
new file mode 100644
index 0000000..1a087d8
--- /dev/null
+++ b/packages/solid-fuse/gen/lib/src/overrides.dart
@@ -0,0 +1,89 @@
+// The "nice input" registry: hand-written codecs that sit IN FRONT of the
+// derived codec for a type. This is the only per-type knowledge in the
+// generator. Each entry names functions in lib/fuse_gen_support.dart.
+//
+// A decode hook has the shape `T? Function(Object? v)` and returns null when
+// the value is not in its nice form, so the derived (constructor / constant)
+// forms keep working: overrides *extend* the derived union unless `replace`.
+
+class CodecOverride {
+  const CodecOverride({
+    required this.type,
+    required this.tsIn,
+    required this.decode,
+    this.inherit = false,
+    this.replace = false,
+    this.tsOut,
+    this.encode,
+    this.accepts = const [],
+  });
+
+  /// Names of runtime matchers (see src/native-validate.ts) for the nice
+  /// input forms, so the dev-mode validator can accept them without knowing
+  /// the codec: `number`, `hexColor`, `namedColor`, `colorObject`,
+  /// `fontWeight`, `object`.
+  final List<String> accepts;
+
+  /// Element name; matched for types from dart:ui / package:flutter.
+  final String type;
+
+  /// Extra TS input type (unioned with the derived one).
+  final String tsIn;
+
+  /// Dart function name in fuse_gen_support.dart.
+  final String decode;
+
+  /// Also applies when [type] appears as one arm of a supertype's union
+  /// (EdgeInsets inside EdgeInsetsGeometry).
+  final bool inherit;
+
+  /// Drop the derived union entirely.
+  final bool replace;
+
+  /// Dart -> JS direction (callback payloads).
+  final String? tsOut;
+  final String? encode;
+}
+
+const defaultOverrides = <CodecOverride>[
+  // "#rrggbb" / "#rrggbbaa" / "red" / {r,g,b,a} / {h,s,l,a}: reuses solid-fuse's parseColor.
+  CodecOverride(
+      type: 'Color',
+      tsIn: 'NativeColorInput',
+      decode: 'niceColor',
+      inherit: true,
+      tsOut: 'string',
+      encode: 'niceEncColor',
+      accepts: ['hexColor', 'namedColor', 'colorObject']),
+  // 8 -> EdgeInsets.all(8)
+  CodecOverride(type: 'EdgeInsets', tsIn: 'number', decode: 'niceEdgeInsets', inherit: true, accepts: ['number']),
+  // 12 -> BorderRadius.circular(12)
+  CodecOverride(type: 'BorderRadius', tsIn: 'number', decode: 'niceBorderRadius', inherit: true, accepts: ['number']),
+  // 12 -> Radius.circular(12)
+  CodecOverride(type: 'Radius', tsIn: 'number', decode: 'niceRadius', accepts: ['number']),
+  // 300 -> Duration(milliseconds: 300)
+  CodecOverride(
+      type: 'Duration',
+      tsIn: 'number',
+      decode: 'niceDuration',
+      tsOut: 'number',
+      encode: 'niceEncDuration',
+      accepts: ['number']),
+  // 700 -> FontWeight.w700
+  CodecOverride(type: 'FontWeight', tsIn: '100 | 200 | 300 | 400 | 500 | 600 | 700 | 800 | 900', decode: 'niceFontWeight', accepts: ['fontWeight']),
+  // IconData's constructor params are @mustBeConst (icon-font tree shaking) and the
+  // Icons namespace has ~8.9k constants, so nothing usable is derived: codec only.
+  CodecOverride(
+      type: 'IconData',
+      tsIn: '{ codePoint: number; fontFamily?: string; fontPackage?: string; matchTextDirection?: boolean }',
+      decode: 'niceIconData',
+      replace: true,
+      accepts: ['object']),
+];
+
+/// Per-widget hints: which Widget / List<Widget> parameter JSX children map to
+/// when the constructor has no `child` / `children` parameter.
+const defaultChildrenHints = <String, String>{
+  'Scaffold': 'body',
+  'CustomScrollView': 'slivers',
+};
diff --git a/packages/solid-fuse/gen/lib/src/world.dart b/packages/solid-fuse/gen/lib/src/world.dart
new file mode 100644
index 0000000..79252ae
--- /dev/null
+++ b/packages/solid-fuse/gen/lib/src/world.dart
@@ -0,0 +1,159 @@
+// Loads resolved element models and builds the indexes the classifier needs:
+//  * entry libraries (what generated code is allowed to import)
+//  * element -> import (uri + prefix)
+//  * subclass index (for abstract / extendable data types -> tagged unions)
+//  * static-const index (for enum-likes: Colors.red, Curves.easeIn, ...)
+import 'dart:io';
+
+import 'package:analyzer/dart/analysis/analysis_context_collection.dart';
+import 'package:analyzer/dart/analysis/results.dart';
+import 'package:analyzer/dart/analysis/session.dart';
+import 'package:analyzer/dart/element/element.dart';
+import 'package:analyzer/dart/element/type.dart';
+import 'package:analyzer/dart/element/type_system.dart';
+
+class EntryLib {
+  EntryLib(this.uri, this.prefix, this.element);
+  final String uri;
+
+  /// Import prefix used by generated Dart code; null = unprefixed.
+  final String? prefix;
+  final LibraryElement element;
+}
+
+/// Flutter + SDK libraries generated code may import, in priority order.
+/// The first entry that exports an element wins.
+const _flutterEntries = <(String, String?)>[
+  ('package:flutter/material.dart', null),
+  ('package:flutter/cupertino.dart', 'cupertino'),
+  ('package:flutter/widgets.dart', 'widgets'),
+  ('package:flutter/gestures.dart', 'gestures'),
+  ('package:flutter/services.dart', 'services'),
+  ('package:flutter/rendering.dart', 'rendering'),
+  ('package:flutter/painting.dart', 'painting'),
+  ('package:flutter/foundation.dart', 'foundation'),
+  ('package:flutter/animation.dart', 'animation'),
+  ('package:flutter/physics.dart', 'physics'),
+  ('package:flutter/scheduler.dart', 'scheduler'),
+  ('package:flutter/semantics.dart', 'semantics'),
+  ('dart:ui', 'ui'),
+  ('dart:core', null),
+  ('dart:async', 'async'),
+  ('dart:typed_data', 'typed_data'),
+  ('dart:math', 'math'),
+];
+
+class StaticConst {
+  StaticConst(this.owner, this.field);
+  final InterfaceElement owner;
+  final FieldElement field;
+
+  /// Owner has no usable public generative constructor, i.e. it is a pure
+  /// namespace of constants (Colors, Icons, Curves, SystemMouseCursors, ...).
+  late final bool ownerIsNamespace = owner is ClassElement &&
+      owner.constructors.every((c) => c.isPrivate || (c.isFactory == false && (owner as ClassElement).isAbstract));
+}
+
+class World {
+  World._(this.session, this.entries);
+
+  final AnalysisSession session;
+  final List<EntryLib> entries;
+
+  late final LibraryElement material = entries.first.element;
+  TypeSystem get ts => material.typeSystem;
+
+  final Map<Element, EntryLib> _importOf = {};
+  final List<InterfaceElement> publicClasses = [];
+  final Map<InterfaceElement, List<InterfaceElement>> _subclasses = {};
+  final List<StaticConst> staticConsts = [];
+
+  late final InterfaceElement widgetEl = _cls('Widget');
+  late final InterfaceElement preferredSizeWidgetEl = _cls('PreferredSizeWidget');
+  late final InterfaceElement keyEl = _cls('Key');
+  late final InterfaceElement listenableEl = _cls('Listenable');
+  late final InterfaceElement buildContextEl = _cls('BuildContext');
+  late final InterfaceElement stateEl = _cls('State');
+  late final InterfaceElement renderObjectEl = _cls('RenderObject');
+  late final InterfaceElement elementEl = _cls('Element');
+
+  InterfaceElement _cls(String n) =>
+      material.exportNamespace.get2(n) as InterfaceElement;
+
+  static Future<World> load(String packageRoot,
+      {List<(String, String)> extraLibs = const []}) async {
+    final collection = AnalysisContextCollection(
+        includedPaths: [Directory(packageRoot).absolute.resolveSymbolicLinksSync()]);
+    final session = collection.contexts.first.currentSession;
+    final entries = <EntryLib>[];
+    Future<void> add(String uri, String? prefix) async {
+      final r = await session.getLibraryByUri(uri);
+      if (r is! LibraryElementResult) {
+        throw StateError('cannot resolve $uri: $r');
+      }
+      entries.add(EntryLib(uri, prefix, r.element));
+    }
+
+    // material first (unprefixed), then extra package libs, then the rest of
+    // Flutter and the SDK.
+    await add(_flutterEntries.first.$1, _flutterEntries.first.$2);
+    for (final (uri, prefix) in extraLibs) {
+      await add(uri, prefix);
+    }
+    for (final (uri, prefix) in _flutterEntries.skip(1)) {
+      await add(uri, prefix);
+    }
+    final w = World._(session, entries);
+    w._index();
+    return w;
+  }
+
+  void _index() {
+    final seen = <Element>{};
+    for (final e in entries) {
+      e.element.exportNamespace.definedNames2.forEach((name, el) {
+        if (name.startsWith('_')) return;
+        _importOf.putIfAbsent(el, () => e);
+        if (!seen.add(el)) return;
+        if (el is InterfaceElement) {
+          publicClasses.add(el);
+          for (final f in el.fields) {
+            if (f.isStatic && f.isConst && f.isPublic && !f.isEnumConstant &&
+                !f.metadata.hasDeprecated) {
+              staticConsts.add(StaticConst(el, f));
+            }
+          }
+        }
+      });
+    }
+    for (final c in publicClasses) {
+      for (final s in c.allSupertypes) {
+        (_subclasses[s.element] ??= []).add(c);
+      }
+    }
+  }
+
+  EntryLib? importOf(Element e) => _importOf[e];
+  bool isExported(Element e) => _importOf.containsKey(e);
+
+  List<InterfaceElement> subclassesOf(InterfaceElement e) =>
+      _subclasses[e] ?? const [];
+
+  bool isSubtypeOfEl(DartType t, InterfaceElement el) =>
+      t is InterfaceType && t.asInstanceOf(el) != null;
+
+  /// All public classes exported by [libUri] that are concrete Widgets.
+  List<ClassElement> widgetsOf(String libUri) {
+    final lib = entries.firstWhere((e) => e.uri == libUri).element;
+    final out = <ClassElement>[];
+    lib.exportNamespace.definedNames2.forEach((name, el) {
+      if (el is ClassElement &&
+          el.isPublic &&
+          !el.isAbstract &&
+          el.allSupertypes.any((s) => s.element == widgetEl)) {
+        out.add(el);
+      }
+    });
+    return out;
+  }
+}
