@@ -0,0 +1,28 @@
+import 'package:flutter/material.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+import '_generated/fuse_packages.dart';
+
+Future<FuseRuntime> startFuse() async {
+  final runtime = await FuseRuntime.create();
+  registerFusePackages(runtime);
+  await runtime.start();
+  return runtime;
+}
+
+class GenE2eApp extends StatelessWidget {
+  const GenE2eApp({super.key, required this.runtime});
+  final FuseRuntime runtime;
+
+  @override
+  Widget build(BuildContext context) => MaterialApp(
+        title: 'solid-fuse generated interop',
+        theme: ThemeData(colorScheme: ColorScheme.fromSeed(seedColor: Colors.blue)),
+        home: Material(child: SafeArea(child: FuseView(runtime: runtime))),
+      );
+}
+
+void main() async {
+  WidgetsFlutterBinding.ensureInitialized();
+  runApp(GenE2eApp(runtime: await startFuse()));
+}
