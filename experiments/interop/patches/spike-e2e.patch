+import { createHash } from "crypto";
+import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from "fs";
+import { tmpdir } from "os";
+import { dirname, join, resolve } from "path";
+import { spawnSync } from "child_process";
+import { fileURLToPath } from "url";
+import { defineCommand } from "citty";
+import { findProjectRoot, getDartRoot, readPubspecName } from "./utils";
+import { loadFuseConfig } from "./config";
+import type { FuseConfig, NativeConfig, NativePackageConfig } from "../src/config";
+import {
+  diffManifests,
+  emitCatalogJson,
+  emitCatalogMarkdown,
+  emitTsModule,
+  type Manifest,
+} from "./gen-emit";
+
+// Layout (all committed in the app):
+//
+//   fuse.lock                              versions + manifest hashes
+//   src/_generated/<unit>.manifest.json    the single artefact everything else reads
+//   src/_generated/<unit>.ts               typed wrapper components   (from the manifest)
+//   src/_generated/NATIVE.md               agent-facing catalogue     (from the manifests)
+//   src/_generated/native.catalog.json     same, machine-readable
+//   <dart>/lib/_generated/<unit>.fuse.g.dart   Dart adapters + register<Unit>Widgets
+//   <dart>/lib/_generated/fuse_generated.dart  registerFuseGenerated(), called by fuse_packages.dart
+//
+// A unit is `flutter`, `app`, or a pub package name. Wire tags are
+// `<unit>.<Component>`.
+
+export const LOCK_FILE = "fuse.lock";
+const GEN_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..", "gen");
+
+export interface Unit {
+  name: string;
+  /** Resolved version (pub version, Flutter version, or source hash for `app`). */
+  version: string;
+  /** [library uri, import prefix] pairs; empty for `flutter`. */
+  libs: [string, string][];
+  /** Flutter unit: constructor specs. */
+  widgets?: string[];
+  /** Package unit: allow-list, or null for everything. */
+  include?: string[] | null;
+}
+
+export interface NativeState {
+  generator: string;
+  flutter: string;
+  dart: string;
+  units: Unit[];
+  problems: string[];
+}
+
+export interface LockFile {
+  lockVersion: 1;
+  generator: string;
+  flutter: string;
+  dart: string;
+  units: Record<string, { version: string; config: string; manifest: string; widgets: number }>;
+  /** Hash of everything above: equal fingerprints mean the same native surface. */
+  fingerprint: string;
+}
+
+const sha = (s: string | Buffer) => createHash("sha256").update(s).digest("hex");
+
+export function generatedTsDir(projectRoot: string) {
+  return join(projectRoot, "src", "_generated");
+}
+export function generatedDartDir(dartRoot: string) {
+  return join(dartRoot, "lib", "_generated");
+}
+
+export function generatorVersion(): string {
+  const src = readFileSync(join(GEN_ROOT, "bin", "fuse_gen.dart"), "utf-8");
+  return src.match(/const generatorVersion = '([^']+)'/)?.[1] ?? "unknown";
+}
+
+interface PackageConfigEntry {
+  name: string;
+  rootUri: string;
+}
+
+function readPackageConfig(dartRoot: string): Map<string, string> | null {
+  const path = join(dartRoot, ".dart_tool", "package_config.json");
+  if (!existsSync(path)) return null;
+  const json = JSON.parse(readFileSync(path, "utf-8")) as { packages: PackageConfigEntry[] };
+  const out = new Map<string, string>();
+  for (const p of json.packages) {
+    const root = p.rootUri.startsWith("file:")
+      ? fileURLToPath(p.rootUri)
+      : resolve(dartRoot, ".dart_tool", p.rootUri);
+    out.set(p.name, root.replace(/\/$/, ""));
+  }
+  return out;
+}
+
+function pubspecVersion(packageRoot: string): string {
+  try {
+    return readFileSync(join(packageRoot, "pubspec.yaml"), "utf-8").match(/^version:\s*(\S+)/m)?.[1] ?? "0.0.0";
+  } catch {
+    return "unknown";
+  }
+}
+
+function flutterVersions(packages: Map<string, string>): { flutter: string; dart: string } {
+  const flutterPkg = packages.get("flutter");
+  if (flutterPkg) {
+    const sdk = resolve(flutterPkg, "..", "..");
+    try {
+      const v = JSON.parse(readFileSync(join(sdk, "bin", "cache", "flutter.version.json"), "utf-8"));
+      return { flutter: v.frameworkVersion ?? v.flutterVersion ?? "unknown", dart: v.dartSdkVersion ?? "unknown" };
+    } catch {
+      try {
+        return { flutter: readFileSync(join(sdk, "version"), "utf-8").trim(), dart: "unknown" };
+      } catch {}
+    }
+  }
+  return { flutter: "unknown", dart: "unknown" };
+}
+
+/** Expand `fuse/*.dart`-style patterns (one `*` per segment) under `<dart>/lib`. */
+function expandAppFiles(dartRoot: string, patterns: string[]): string[] {
+  const lib = join(dartRoot, "lib");
+  const out: string[] = [];
+  for (const pattern of patterns) {
+    const dir = join(lib, dirname(pattern));
+    const base = pattern.slice(pattern.lastIndexOf("/") + 1);
+    if (!base.includes("*")) {
+      if (existsSync(join(lib, pattern))) out.push(pattern);
+      continue;
+    }
+    const re = new RegExp(`^${base.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*")}$`);
+    let entries: string[] = [];
+    try {
+      entries = readdirSync(dir);
+    } catch {}
+    for (const e of entries.sort()) {
+      if (re.test(e) && !e.endsWith(".g.dart")) out.push(join(dirname(pattern), e).replace(/\\/g, "/"));
+    }
+  }
+  return [...new Set(out)];
+}
+
+/**
+ * What should be generated, resolved against the app's package_config. Cheap
+ * (no analyzer): this is also what `fuse dev` uses to detect skew.
+ */
+export function resolveNativeState(projectRoot: string, fuseConfig: FuseConfig | null): NativeState {
+  const native: NativeConfig = fuseConfig?.native ?? {};
+  const dartRoot = getDartRoot(projectRoot, fuseConfig);
+  const problems: string[] = [];
+  const packages = readPackageConfig(dartRoot);
+  const versions = packages ? flutterVersions(packages) : { flutter: "unknown", dart: "unknown" };
+  const units: Unit[] = [];
+
+  if (native.flutter?.length) {
+    units.push({ name: "flutter", version: versions.flutter, libs: [], widgets: native.flutter });
+  }
+  for (const [name, cfg] of Object.entries(native.packages ?? {})) {
+    if (name === "flutter" || name === "app") {
+      problems.push(`native.packages.${name}: "${name}" is a reserved unit name`);
+      continue;
+    }
+    const root = packages?.get(name);
+    if (!root) {
+      problems.push(`${name} is not a resolved Dart dependency. Run \`fuse add ${name}\` (or \`flutter pub get\`).`);
+      continue;
+    }
+    const library = cfg.library ?? `${name}.dart`;
+    if (!existsSync(join(root, "lib", library))) {
+      problems.push(`${name}: lib/${library} does not exist. Set native.packages.${name}.library.`);
+      continue;
+    }
+    units.push({
+      name,
+      version: pubspecVersion(root),
+      libs: [[`package:${name}/${library}`, name.replace(/[^A-Za-z0-9_]/g, "_")]],
+      include: cfg.include ?? null,
+    });
+  }
+  if (native.app !== false) {
+    const files = expandAppFiles(dartRoot, native.app ?? ["fuse/*.dart"]);
+    if (files.length) {
+      const appName = readPubspecName(join(dartRoot, "pubspec.yaml")) ?? "app";
+      const hash = createHash("sha256");
+      for (const f of files) hash.update(f).update(readFileSync(join(dartRoot, "lib", f)));
+      units.push({
+        name: "app",
+        version: `src-${hash.digest("hex").slice(0, 12)}`,
+        libs: files.map((f) => [
+          `package:${appName}/${f}`,
+          `app_${f.replace(/\.dart$/, "").replace(/[^A-Za-z0-9_]/g, "_")}`,
+        ]),
+        include: null,
+      });
+    }
+  }
+  if (!packages && units.length) problems.push("No .dart_tool/package_config.json. Run `flutter pub get` in the Dart project.");
+  return { generator: generatorVersion(), ...versions, units, problems };
+}
+
+function configHash(u: Unit): string {
+  return sha(JSON.stringify({ libs: u.libs, widgets: u.widgets ?? null, include: u.include ?? null })).slice(0, 16);
+}
+
+export function readLock(projectRoot: string): LockFile | null {
+  const path = join(projectRoot, LOCK_FILE);
+  if (!existsSync(path)) return null;
+  try {
+    return JSON.parse(readFileSync(path, "utf-8"));
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Why the generated output is stale, or [] when it matches the lock. Compares
+ * resolved versions, the config, the generator and the manifest hashes on disk.
+ */
+export function detectSkew(projectRoot: string, fuseConfig: FuseConfig | null, state = resolveNativeState(projectRoot, fuseConfig)): string[] {
+  const lock = readLock(projectRoot);
+  const reasons = [...state.problems];
+  if (state.units.length === 0 && !lock) return reasons;
+  if (!lock) return [...reasons, `no ${LOCK_FILE}: native widgets are configured but were never generated`];
+  if (lock.generator !== state.generator) reasons.push(`generator ${lock.generator} -> ${state.generator}`);
+  if (lock.flutter !== state.flutter) reasons.push(`Flutter ${lock.flutter} -> ${state.flutter}`);
+  const tsDir = generatedTsDir(projectRoot);
+  const dartDir = generatedDartDir(getDartRoot(projectRoot, fuseConfig));
+  for (const u of state.units) {
+    const l = lock.units[u.name];
+    if (!l) {
+      reasons.push(`${u.name}: configured but not generated`);
+      continue;
+    }
+    if (l.version !== u.version) {
+      reasons.push(u.name === "app" ? "app: Dart widget sources changed" : `${u.name} ${l.version} -> ${u.version}`);
+    }
+    if (l.config !== configHash(u)) reasons.push(`${u.name}: allow-list changed in fuse.config.ts`);
+    const manifestPath = join(tsDir, `${u.name}.manifest.json`);
+    if (!existsSync(manifestPath)) reasons.push(`${u.name}: ${u.name}.manifest.json is missing`);
+    else if (sha(readFileSync(manifestPath)) !== l.manifest) reasons.push(`${u.name}: manifest was modified since generation`);
+    if (!existsSync(join(tsDir, `${u.name}.ts`))) reasons.push(`${u.name}: src/_generated/${u.name}.ts is missing`);
+    if (!existsSync(join(dartDir, `${u.name}.fuse.g.dart`))) reasons.push(`${u.name}: ${u.name}.fuse.g.dart is missing`);
+  }
+  for (const name of Object.keys(lock.units)) {
+    if (!state.units.some((u) => u.name === name)) reasons.push(`${name}: generated but no longer configured`);
+  }
+  return reasons;
+}
+
+export function readManifests(projectRoot: string): Manifest[] {
+  const dir = generatedTsDir(projectRoot);
+  if (!existsSync(dir)) return [];
+  return readdirSync(dir)
+    .filter((f) => f.endsWith(".manifest.json"))
+    .sort()
+    .map((f) => JSON.parse(readFileSync(join(dir, f), "utf-8")) as Manifest);
+}
+
+function runDartGenerator(job: object): any {
+  if (!existsSync(join(GEN_ROOT, ".dart_tool", "package_config.json"))) {
+    console.log("[fuse gen] First run: resolving the generator's own dependencies...");
+    const r = spawnSync("dart", ["pub", "get"], { cwd: GEN_ROOT, stdio: ["ignore", "ignore", "inherit"] });
+    if (r.status !== 0) throw new Error("dart pub get failed for the solid-fuse generator");
+  }
+  const jobPath = join(tmpdir(), `fuse-gen-${process.pid}.json`);
+  writeFileSync(jobPath, JSON.stringify(job));
+  try {
+    const r = spawnSync("dart", ["run", join(GEN_ROOT, "bin", "fuse_gen.dart"), "--job", jobPath], {
+      cwd: GEN_ROOT,
+      encoding: "utf-8",
+      maxBuffer: 64 * 1024 * 1024,
+    });
+    const quiet = (s: string) => s.split("\n").filter((l) => l.startsWith("[fuse gen]")).join("\n");
+    if (r.status !== 0) {
+      throw new Error(`generator failed:\n${r.stderr}\n${r.stdout}`);
+    }
+    const log = quiet(r.stderr);
+    if (log) console.log(log);
+    const line = r.stdout.trim().split("\n").filter((l) => l.startsWith("{")).pop();
+    return line ? JSON.parse(line) : {};
+  } finally {
+    rmSync(jobPath, { force: true });
+  }
+}
+
+export interface GenResult {
+  manifests: Manifest[];
+  diff: string[];
+  summary: any;
+  sizes: Record<string, { tsBytes: number; manifestBytes: number; dartBytes: number; perWidgetTs: Record<string, number> }>;
+}
+
+/** Core of `fuse gen`: exported so `fuse add` and `fuse dev` can call it. */
+export async function runGen(
+  projectRoot?: string,
+  { quiet = false, extraPackages }: { quiet?: boolean; extraPackages?: Record<string, NativePackageConfig> } = {},
+): Promise<GenResult | null> {
+  const root = projectRoot ?? findProjectRoot();
+  let fuseConfig = await loadFuseConfig(root);
+  if (extraPackages) {
+    // `fuse add` edits fuse.config.ts after the module may have been imported.
+    fuseConfig = {
+      ...fuseConfig,
+      native: { ...fuseConfig?.native, packages: { ...fuseConfig?.native?.packages, ...extraPackages } },
+    };
+  }
+  const dartRoot = getDartRoot(root, fuseConfig);
+  const tsDir = generatedTsDir(root);
+  const dartDir = generatedDartDir(dartRoot);
+
+  if (!existsSync(join(dartRoot, ".dart_tool", "package_config.json"))) {
+    spawnSync("flutter", ["pub", "get"], { cwd: dartRoot, stdio: "inherit" });
+  }
+  const state = resolveNativeState(root, fuseConfig);
+  if (state.problems.length) {
+    for (const p of state.problems) console.error(`[fuse gen] ${p}`);
+    throw new Error("fuse gen: native config cannot be resolved");
+  }
+
+  const before = new Map(readManifests(root).map((m) => [m.unit, m]));
+  const keep = new Set(state.units.map((u) => u.name));
+
+  let summary: any = {};
+  if (state.units.length) {
+    const started = Date.now();
+    summary = runDartGenerator({
+      appRoot: dartRoot,
+      outDart: dartDir,
+      outManifest: tsDir,
+      docs: fuseConfig?.native?.docs ?? "first",
+      units: state.units,
+    });
+    summary.wallMs = Date.now() - started;
+  }
+
+  // Drop output of units that are no longer configured.
+  for (const dir of [tsDir, dartDir]) {
+    if (!existsSync(dir)) continue;
+    for (const f of readdirSync(dir)) {
+      const m = f.match(/^(.+?)\.(manifest\.json|fuse\.g\.dart|ts)$/);
+      if (!m || keep.has(m[1])) continue;
+      if (m[2] === "ts" && !before.has(m[1])) continue; // not ours
+      rmSync(join(dir, f));
+    }
+  }
+
+  // Everything below reads only the manifests.
+  const manifests = readManifests(root);
+  const sizes: GenResult["sizes"] = {};
+  const lock: LockFile = {
+    lockVersion: 1,
+    generator: state.generator,
+    flutter: state.flutter,
+    dart: state.dart,
+    units: {},
+    fingerprint: "",
+  };
+  const diff: string[] = [];
+  for (const m of manifests) {
+    const unit = state.units.find((u) => u.name === m.unit)!;
+    const { ts, perWidgetBytes } = emitTsModule(m);
+    writeFileSync(join(tsDir, `${m.unit}.ts`), ts);
+    const manifestRaw = readFileSync(join(tsDir, `${m.unit}.manifest.json`));
+    sizes[m.unit] = {
+      tsBytes: Buffer.byteLength(ts),
+      manifestBytes: manifestRaw.length,
+      dartBytes: readFileSync(join(dartDir, `${m.unit}.fuse.g.dart`)).length,
+      perWidgetTs: perWidgetBytes,
+    };
+    lock.units[m.unit] = {
+      version: unit.version,
+      config: configHash(unit),
+      manifest: sha(manifestRaw),
+      widgets: Object.keys(m.widgets).length,
+    };
+    diff.push(...diffManifests(before.get(m.unit) ?? null, m));
+  }
+  for (const name of before.keys()) if (!keep.has(name)) diff.push(`- ${name}: unit removed`);
+
+  if (manifests.length) {
+    mkdirSync(tsDir, { recursive: true });
+    writeFileSync(join(tsDir, "NATIVE.md"), emitCatalogMarkdown(manifests, "~/_generated"));
+    writeFileSync(join(tsDir, "native.catalog.json"), JSON.stringify(emitCatalogJson(manifests, "~/_generated"), null, 1) + "\n");
+  } else {
+    for (const f of ["NATIVE.md", "native.catalog.json"]) rmSync(join(tsDir, f), { force: true });
+  }
+  writeGeneratedRegistrar(dartDir, manifests);
+
+  lock.fingerprint = sha(JSON.stringify({ g: lock.generator, f: lock.flutter, u: lock.units }));
+  if (manifests.length) writeFileSync(join(root, LOCK_FILE), JSON.stringify(lock, null, 2) + "\n");
+  else rmSync(join(root, LOCK_FILE), { force: true });
+
+  if (!quiet) {
+    for (const m of manifests) {
+      const s = sizes[m.unit];
+      const skipped = Object.keys(m.skipped ?? {}).length;
+      console.log(
+        `  ${m.unit} ${m.version}: ${Object.keys(m.widgets).length} widget(s)` +
+          (skipped ? `, ${skipped} not generated` : "") +
+          ` -> src/_generated/${m.unit}.ts (${kb(s.tsBytes)}), ${m.unit}.fuse.g.dart (${kb(s.dartBytes)})`,
+      );
+    }
+    if (diff.length) {
+      console.log("\nAPI changes since the last generation:");
+      for (const d of diff) console.log(`  ${d}`);
+      if (diff.some((d) => d.startsWith("-") || d.startsWith("~"))) {
+        console.log("  Removed or changed props are now TypeScript errors at their call sites: run `tsc --noEmit`.");
+      }
+    }
+  }
+  return { manifests, diff, summary, sizes };
+}
+
+const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
+
+/** `<dart>/lib/_generated/fuse_generated.dart`: one call per generated unit. */
+function writeGeneratedRegistrar(dartDir: string, manifests: Manifest[]) {
+  const path = join(dartDir, "fuse_generated.dart");
+  if (manifests.length === 0) {
+    rmSync(path, { force: true });
+    return;
+  }
+  const alias = (u: string) => `gen_${u.replace(/[^A-Za-z0-9_]/g, "_")}`;
+  const lines = [
+    "// Generated by fuse gen. Do not edit.",
+    "import 'package:solid_fuse/solid_fuse.dart' show FuseRuntime;",
+    ...manifests.map((m) => `import '${m.unit}.fuse.g.dart' as ${alias(m.unit)};`),
+    "",
+    "/// Registers every adapter `fuse gen` generated (wire tags `<unit>.<Widget>`).",
+    "void registerFuseGenerated(FuseRuntime runtime) {",
+    ...manifests.map((m) => `  ${alias(m.unit)}.${m.register}(runtime);`),
+    "}",
+  ];
+  mkdirSync(dartDir, { recursive: true });
+  writeFileSync(path, lines.join("\n") + "\n");
+}
+
+/**
+ * Called by `fuse dev` / `fuse build`: regenerate when the lock no longer
+ * matches what is resolved. Returns true when it regenerated.
+ */
+export async function ensureGenerated(projectRoot: string): Promise<boolean> {
+  const fuseConfig = await loadFuseConfig(projectRoot);
+  const reasons = detectSkew(projectRoot, fuseConfig);
+  if (reasons.length === 0) return false;
+  console.log("\n[fuse] Generated native bindings are out of date:");
+  for (const r of reasons) console.log(`  - ${r}`);
+  console.log("[fuse] Regenerating (fuse gen)...");
+  await runGen(projectRoot);
+  console.log("[fuse] Native bindings regenerated. Dart adapters changed, so the app needs a native rebuild (not just a hot reload).\n");
+  return true;
+}
+
+export const genCommand = defineCommand({
+  meta: {
+    name: "gen",
+    description: "Generate typed JSX wrappers + Dart adapters for the widgets listed under `native` in fuse.config.ts",
+  },
+  args: {
+    check: {
+      type: "boolean",
+      description: "Do not write anything; exit 1 when generated output is stale (for CI)",
+    },
+  },
+  run: async ({ args }) => {
+    const root = findProjectRoot();
+    if (args.check) {
+      const reasons = detectSkew(root, await loadFuseConfig(root));
+      if (reasons.length === 0) {
+        console.log("Generated native bindings are up to date.");
+        return;
+      }
+      console.error("Generated native bindings are out of date:");
+      for (const r of reasons) console.error(`  - ${r}`);
+      console.error("Run `fuse gen`.");
+      process.exit(1);
+    }
+    console.log(`Project root: ${root}`);
+    const result = await runGen(root);
+    if (!result || result.manifests.length === 0) {
+      console.log("Nothing to generate: fuse.config.ts has no `native` widgets and <dart>/lib/fuse/ has no widgets.");
+      return;
+    }
+    // fuse link wires registerFuseGenerated() into fuse_packages.dart.
+    const { runLink } = await import("./link");
+    await runLink(root, { pubGet: false });
+  },
+});
