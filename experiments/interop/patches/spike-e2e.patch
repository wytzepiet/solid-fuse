--- /dev/null
+++ b/examples/gen_e2e/dart/lib/fuse/rating_badge.dart
@@ -0,0 +1,77 @@
+import 'package:flutter/material.dart';
+
+/// How a [RatingBadge] is tinted.
+enum BadgeTone { neutral, positive, negative }
+
+/// A pill showing a label and a star count.
+///
+/// This is the escape hatch: an ordinary Flutter widget with typed
+/// constructor parameters. `fuse gen` reads this constructor and writes the
+/// FuseNode adapter, the registration and the typed JSX component; nothing in
+/// this file knows about solid-fuse.
+class RatingBadge extends StatelessWidget {
+  const RatingBadge({
+    super.key,
+    required this.label,
+    this.stars = 0,
+    this.tone = BadgeTone.neutral,
+    this.color,
+    this.padding = const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+    this.onTap,
+    this.onRated,
+    this.child,
+  });
+
+  /// Text shown before the stars.
+  final String label;
+
+  /// Number of filled stars (0 to 5).
+  final int stars;
+
+  /// Colour scheme of the pill.
+  final BadgeTone tone;
+
+  /// Overrides the colour chosen by [tone].
+  final Color? color;
+
+  /// Space around the content.
+  final EdgeInsetsGeometry padding;
+
+  /// Called when the pill is tapped.
+  final VoidCallback? onTap;
+
+  /// Called with the 1-based index of the star that was tapped.
+  final ValueChanged<int>? onRated;
+
+  /// Optional trailing widget.
+  final Widget? child;
+
+  @override
+  Widget build(BuildContext context) {
+    final bg = color ??
+        switch (tone) {
+          BadgeTone.neutral => Colors.grey.shade300,
+          BadgeTone.positive => Colors.green.shade200,
+          BadgeTone.negative => Colors.red.shade200,
+        };
+    return GestureDetector(
+      onTap: onTap,
+      child: Container(
+        padding: padding,
+        decoration: BoxDecoration(color: bg, borderRadius: BorderRadius.circular(999)),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Text(label),
+            for (var i = 1; i <= 5; i++)
+              GestureDetector(
+                onTap: onRated == null ? null : () => onRated!(i),
+                child: Icon(i <= stars ? Icons.star : Icons.star_border, size: 16, key: ValueKey('star-$i')),
+              ),
+            ?child,
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/examples/gen_e2e/dart/lib/main.dart b/examples/gen_e2e/dart/lib/main.dart
