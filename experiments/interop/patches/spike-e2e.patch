diff --git a/packages/solid-fuse/cli/add.ts b/packages/solid-fuse/cli/add.ts
new file mode 100644
index 0000000..312f2f3
--- /dev/null
+++ b/packages/solid-fuse/cli/add.ts
@@ -0,0 +1,114 @@
+import { readFileSync, writeFileSync, existsSync } from "fs";
+import { join } from "path";
+import { spawnSync } from "child_process";
+import { defineCommand } from "citty";
+import { findProjectRoot } from "./utils";
+import { CONFIG_FILES } from "./config";
+import { runGen } from "./gen";
+import { runLink } from "./link";
+import type { Manifest } from "./gen-emit";
+
+/**
+ * Add `pkg` to `native.packages` in the source of a fuse.config.ts.
+ * Text edit on purpose (no TS AST dependency); returns null when the file has
+ * a shape it does not recognise, and the caller prints what to add by hand.
+ */
+export function addPackageToConfig(source: string, pkg: string, include?: string[]): string | null {
+  const key = /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(pkg) ? pkg : JSON.stringify(pkg);
+  const value = include?.length ? `{ include: ${JSON.stringify(include)} }` : "{}";
+  const packages = source.match(/\bpackages\s*:\s*\{/);
+  if (packages) {
+    const body = source.slice(packages.index! + packages[0].length);
+    if (new RegExp(`(^|[\\s,{])["']?${pkg}["']?\\s*:`).test(body.slice(0, matchingBrace(body)))) return source;
+    const at = packages.index! + packages[0].length;
+    return `${source.slice(0, at)}\n      ${key}: ${value},${source.slice(at)}`;
+  }
+  const native = source.match(/\bnative\s*:\s*\{/);
+  if (native) {
+    const at = native.index! + native[0].length;
+    return `${source.slice(0, at)}\n    packages: {\n      ${key}: ${value},\n    },${source.slice(at)}`;
+  }
+  const define = source.match(/defineConfig\(\s*\{/);
+  if (define) {
+    const at = define.index! + define[0].length;
+    return `${source.slice(0, at)}\n  native: {\n    packages: {\n      ${key}: ${value},\n    },\n  },${source.slice(at)}`;
+  }
+  return null;
+}
+
+function matchingBrace(body: string): number {
+  let depth = 1;
+  for (let i = 0; i < body.length; i++) {
+    if (body[i] === "{") depth++;
+    else if (body[i] === "}" && --depth === 0) return i;
+  }
+  return body.length;
+}
+
+/** What the package offers, from its manifest: the survey an agent reads after `fuse add`. */
+export function printSurvey(m: Manifest) {
+  const widgets = Object.entries(m.widgets);
+  console.log(`\n${m.unit} ${m.version}: ${widgets.length} widget(s) generated`);
+  for (const [name, w] of widgets) {
+    const props = Object.keys(w.props).length;
+    const omitted = Object.entries(w.omitted ?? {});
+    console.log(`  ${name}: ${props} props${w.children ? `, children (${w.children})` : ""}`);
+    for (const [p, why] of omitted) console.log(`      not bridged: ${p} (${why})`);
+  }
+  for (const [name, why] of Object.entries(m.skipped ?? {})) console.log(`  ${name}: NOT generated: ${why}`);
+  const names = widgets.map(([n]) => n);
+  console.log(`\nUse it:\n  import { ${names.slice(0, 4).join(", ")}${names.length > 4 ? ", …" : ""} } from "~/_generated/${m.unit}";`);
+  console.log(`  fuse catalog ${names[0] ?? "<Widget>"}      # props, defaults, docs`);
+}
+
+export const addCommand = defineCommand({
+  meta: {
+    name: "add",
+    description: "Add a pub.dev package and generate typed JSX wrappers for its widgets",
+  },
+  args: {
+    package: { type: "positional", required: true, description: "pub.dev package, optionally with a constraint: fl_chart or fl_chart:^1.0.0" },
+    include: { type: "string", description: "Comma-separated widgets to generate (default: every widget the package exports)" },
+  },
+  run: async ({ args }) => {
+    const root = findProjectRoot();
+    const spec = args.package as string;
+    const pkg = spec.split(":")[0];
+    const include = (args.include as string | undefined)?.split(",").map((s) => s.trim()).filter(Boolean);
+
+    // 1. fuse.config.ts first: the config is imported (and cached) by runGen below.
+    const configFile = CONFIG_FILES.map((f) => join(root, f)).find((f) => existsSync(f))!;
+    const source = readFileSync(configFile, "utf-8");
+    const updated = addPackageToConfig(source, pkg, include);
+    if (updated === null) {
+      console.error(
+        `Could not edit ${configFile} automatically. Add this by hand, then run \`fuse gen\`:\n\n` +
+          `  native: { packages: { ${pkg}: {} } }\n`,
+      );
+      process.exit(1);
+    }
+
+    // 2. pub dependency in the app's Dart package (a real constraint, not `any`).
+    const { loadFuseConfig } = await import("./config");
+    const dartRoot = join(root, (await loadFuseConfig(root))?.dart ?? "dart");
+    console.log(`Adding ${spec} to ${join(dartRoot, "pubspec.yaml")}...`);
+    const pub = spawnSync("flutter", ["pub", "add", spec], { cwd: dartRoot, stdio: "inherit" });
+    if (pub.status !== 0) {
+      // Already a dependency is fine (pub add fails on duplicates); anything else is fatal.
+      const pubspec = readFileSync(join(dartRoot, "pubspec.yaml"), "utf-8");
+      if (!new RegExp(`^\\s+${pkg}:`, "m").test(pubspec)) process.exit(pub.status ?? 1);
+      spawnSync("flutter", ["pub", "get"], { cwd: dartRoot, stdio: "inherit" });
+    }
+    if (updated !== source) {
+      writeFileSync(configFile, updated);
+      console.log(`Added ${pkg} to native.packages in ${configFile}`);
+    }
+
+    // 3. generate. The config module was imported before the edit, so pass the package explicitly.
+    const result = await runGen(root, { extraPackages: { [pkg]: include?.length ? { include } : {} } });
+    await runLink(root, { pubGet: false });
+    const manifest = result?.manifests.find((m) => m.unit === pkg);
+    if (manifest) printSurvey(manifest);
+    console.log("\nA new pub package means new native code: rebuild the app (`fuse dev` restarts `flutter run`).");
+  },
+});
