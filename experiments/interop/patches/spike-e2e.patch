diff --git a/packages/solid-fuse/cli/catalog.ts b/packages/solid-fuse/cli/catalog.ts
new file mode 100644
index 0000000..a8d1324
--- /dev/null
+++ b/packages/solid-fuse/cli/catalog.ts
@@ -0,0 +1,46 @@
+import { defineCommand } from "citty";
+import { findProjectRoot } from "./utils";
+import { readManifests } from "./gen";
+import { describeWidget, emitCatalogJson, emitCatalogMarkdown } from "./gen-emit";
+
+export const catalogCommand = defineCommand({
+  meta: {
+    name: "catalog",
+    description: "Print the native widgets available to JSX (from the generated manifests)",
+  },
+  args: {
+    widget: { type: "positional", required: false, description: "Widget name, or unit.Widget, for full detail" },
+    json: { type: "boolean", description: "Machine-readable output" },
+  },
+  run: async ({ args }) => {
+    const manifests = readManifests(findProjectRoot());
+    if (manifests.length === 0) {
+      console.log("No generated native widgets. Configure `native` in fuse.config.ts and run `fuse gen`.");
+      return;
+    }
+    const query = args.widget as string | undefined;
+    if (!query) {
+      console.log(
+        args.json
+          ? JSON.stringify(emitCatalogJson(manifests, "~/_generated"), null, 1)
+          : emitCatalogMarkdown(manifests, "~/_generated"),
+      );
+      return;
+    }
+    const [unit, name] = query.includes(".") ? query.split(".", 2) : [undefined, query];
+    const hits = manifests.filter((m) => (!unit || m.unit === unit) && m.widgets[name]);
+    if (hits.length === 0) {
+      const all = manifests.flatMap((m) => Object.keys(m.widgets).map((w) => `${m.unit}.${w}`));
+      const skipped = manifests.map((m) => m.skipped?.[name]).find(Boolean);
+      console.error(
+        skipped
+          ? `${name} cannot be generated: ${skipped}`
+          : `${query} is not generated. Add it to \`native\` in fuse.config.ts and run \`fuse gen\`.\nAvailable: ${all.join(", ")}`,
+      );
+      process.exit(1);
+    }
+    for (const m of hits) {
+      console.log(args.json ? JSON.stringify({ unit: m.unit, version: m.version, ...m.widgets[name] }, null, 1) : describeWidget(m, name));
+    }
+  },
+});
