diff --git a/packages/solid-fuse/cli/native-manifest-plugin.ts b/packages/solid-fuse/cli/native-manifest-plugin.ts
new file mode 100644
index 0000000..1320a7e
--- /dev/null
+++ b/packages/solid-fuse/cli/native-manifest-plugin.ts
@@ -0,0 +1,52 @@
+import { existsSync, readFileSync, readdirSync } from "fs";
+import { join, resolve } from "path";
+import type { Plugin } from "vite";
+import { validationView, type Manifest } from "./gen-emit";
+
+const VIRTUAL = "virtual:fuse-native-manifests";
+
+/**
+ * Dev-mode prop validation, wired by the toolchain rather than by app code.
+ *
+ * In `fuse dev` (and `fuse build --dev`) this appends an import of a virtual
+ * prelude to the app entry. The prelude registers every manifest that
+ * `fuse gen` wrote, without doc strings, with solid-fuse's validator. In a
+ * release build nothing is injected, so neither the manifests nor the
+ * validator end up in the bundle.
+ *
+ * The import is appended, not prepended, so line numbers in the entry file
+ * (and therefore dev error traces) do not shift. Imports are hoisted, so the
+ * prelude still runs before the entry's own body calls `render()`.
+ */
+export function fuseNativeManifestPlugin(projectRoot: string): Plugin {
+  const dir = join(projectRoot, "src", "_generated");
+  const entry = resolve(projectRoot, "src/index.tsx");
+  let enabled = false;
+
+  return {
+    name: "fuse:native-manifests",
+    enforce: "pre",
+    configResolved(config) {
+      enabled = config.command === "serve" || config.mode === "development";
+    },
+    resolveId(id) {
+      if (id === VIRTUAL) return `\0${VIRTUAL}`;
+    },
+    load(id) {
+      if (id !== `\0${VIRTUAL}`) return;
+      const files = existsSync(dir) ? readdirSync(dir).filter((f) => f.endsWith(".manifest.json")).sort() : [];
+      const lines = ['import { registerNativeManifest } from "solid-fuse";'];
+      for (const f of files) {
+        this.addWatchFile(join(dir, f));
+        const manifest = JSON.parse(readFileSync(join(dir, f), "utf-8")) as Manifest;
+        lines.push(`registerNativeManifest(${JSON.stringify(validationView(manifest))});`);
+      }
+      return lines.join("\n") + "\n";
+    },
+    transform(code, id) {
+      if (!enabled || id.split("?")[0] !== entry) return;
+      if (!existsSync(dir)) return;
+      return { code: `${code}\nimport ${JSON.stringify(VIRTUAL)};\n`, map: null };
+    },
+  };
+}
diff --git a/packages/solid-fuse/dart/lib/gen_support.dart b/packages/solid-fuse/dart/lib/gen_support.dart
new file mode 100644
index 0000000..e6afec1
--- /dev/null
+++ b/packages/solid-fuse/dart/lib/gen_support.dart
@@ -0,0 +1,151 @@
+// ignore_for_file: deprecated_member_use
+// Hand-written runtime support for the adapters `fuse gen` writes into an
+// app's `lib/_generated/*.fuse.g.dart`. Everything generated calls into this
+// file plus FuseNode. Not exported from the solid_fuse barrel on purpose:
+// only generated code imports it.
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import 'src/node.dart';
+import 'src/node_widget.dart';
+import 'src/runtime.dart';
+import 'src/utils.dart' show parseColor;
+
+/// A generated adapter could not turn the node's props into its widget
+/// (missing required prop, value of the wrong shape, constructor assert).
+/// In debug this renders solid-fuse's dev error box in place of the widget,
+/// naming the node and the component that rendered it; in release it
+/// rethrows.
+Widget fuseBuildError(BuildContext context, FuseNode node, Object error, StackTrace stack) {
+  if (!kDebugMode) Error.throwWithStackTrace(error, stack);
+  return FuseRuntimeScope.of(context).devError(node, error.toString());
+}
+
+// ── primitives ──────────────────────────────────────────────────────────────
+
+bool? decBool(Object? v) => v as bool?;
+int? decInt(Object? v) => (v as num?)?.toInt();
+double? decDouble(Object? v) => (v as num?)?.toDouble();
+num? decNum(Object? v) => v as num?;
+String? decString(Object? v) => v as String?;
+
+T? fuseEnum<T extends Enum>(List<T> values, Object? v) =>
+    v == null ? null : values.byName(v as String);
+
+List<T>? fuseList<T>(Object? v, T Function(Object? e) f) =>
+    (v as List?)?.map(f).toList();
+
+Map<K, V>? fuseMap<K, V>(
+  Object? v,
+  K Function(String k) kf,
+  V Function(Object? e) vf,
+) =>
+    (v as Map?)?.map((k, e) => MapEntry(kf(k as String), vf(e)));
+
+/// A required prop was not supplied.
+T fuseReq<T>(T? v, String owner, String name) {
+  if (v == null) {
+    throw ArgumentError('$owner: required prop "$name" is missing');
+  }
+  return v;
+}
+
+Never fuseBad(String type, Object? v) =>
+    throw ArgumentError('Cannot decode $type from ${v.runtimeType}: $v');
+
+/// JSON cannot carry NaN / infinity.
+Object? fuseNum(num? v) => v == null || v.isFinite ? v : v.toString();
+
+// ── children / slots ────────────────────────────────────────────────────────
+
+/// JSX children -> a single `child:`. Zero children = null; one = itself;
+/// many = solid-fuse's existing `flex` convention (Column by default).
+Widget? fuseChild(FuseNode node) =>
+    node.children.isEmpty ? null : node.flexChildren;
+
+/// Text content rule: concatenated text children (same as FuseText).
+String fuseText(FuseNode node) {
+  final b = StringBuffer();
+  for (final c in node.children) {
+    if (c.type == '__text__') {
+      b.write(c.props['text'] ?? '');
+    } else {
+      b.write(fuseText(c));
+    }
+  }
+  return b.toString();
+}
+
+/// A `List<Widget>` prop that is not `children` (AppBar.actions, ...).
+/// The renderer sends an array of `{_node: id}` and the runtime resolves each
+/// to its FuseNode; a single JSX element is accepted too.
+List<Widget>? fuseWidgetList(FuseNode node, String name) {
+  final v = node.props[name];
+  if (v is FuseNode) return [FuseNodeWidget(node: v)];
+  if (v is List) {
+    return [
+      for (final e in v)
+        if (e is FuseNode) FuseNodeWidget(node: e),
+    ];
+  }
+  return null;
+}
+
+/// `PreferredSizeWidget` slots (Scaffold.appBar, AppBar.bottom): a
+/// FuseNodeWidget is not a PreferredSizeWidget, and the size must be known
+/// before layout. HACK: fixed toolbar height unless the slot node carries a
+/// numeric `preferredHeight` prop.
+PreferredSizeWidget? fusePreferredSize(FuseNode node, String name) {
+  final v = node.props[name];
+  if (v is! FuseNode) return null;
+  final h = (v.props['preferredHeight'] as num?)?.toDouble() ?? kToolbarHeight;
+  return PreferredSize(
+    preferredSize: Size.fromHeight(h),
+    child: FuseNodeWidget(node: v),
+  );
+}
+
+// ── "nice" codec overrides (see tool/src/overrides.dart) ────────────────────
+// Each returns null when the value is not in its nice form.
+
+Color? niceColor(Object? v) =>
+    v is String && (v.startsWith('#') || !v.contains('.')) || (v is Map && (v['r'] != null || v['h'] != null))
+        ? parseColor(v)
+        : null;
+
+String? niceEncColor(Color? c) {
+  if (c == null) return null;
+  String h(double x) => (x * 255).round().clamp(0, 255).toRadixString(16).padLeft(2, '0');
+  return '#${h(c.r)}${h(c.g)}${h(c.b)}${h(c.a)}';
+}
+
+EdgeInsets? niceEdgeInsets(Object? v) =>
+    v is num ? EdgeInsets.all(v.toDouble()) : null;
+
+BorderRadius? niceBorderRadius(Object? v) =>
+    v is num ? BorderRadius.circular(v.toDouble()) : null;
+
+Radius? niceRadius(Object? v) => v is num ? Radius.circular(v.toDouble()) : null;
+
+Duration? niceDuration(Object? v) =>
+    v is num ? Duration(microseconds: (v * 1000).round()) : null;
+
+num? niceEncDuration(Duration? d) => d == null ? null : d.inMicroseconds / 1000;
+
+FontWeight? niceFontWeight(Object? v) =>
+    v is num && v >= 100 && v <= 900 && v % 100 == 0 ? FontWeight.values[v ~/ 100 - 1] : null;
+
+/// IconData cannot be derived (its params are @mustBeConst so the icon font
+/// can be tree-shaken); this codec knowingly gives that up, like FuseIcon.
+IconData? niceIconData(Object? v) {
+  if (v is! Map) return null;
+  return IconData(
+    // ignore: non_const_argument_for_const_parameter
+    (v['codePoint'] as num).toInt(),
+    // ignore: non_const_argument_for_const_parameter
+    fontFamily: v['fontFamily'] as String? ?? 'MaterialIcons',
+    // ignore: non_const_argument_for_const_parameter
+    fontPackage: v['fontPackage'] as String?,
+    matchTextDirection: v['matchTextDirection'] as bool? ?? false,
+  );
+}
