+// A hand-written ergonomic layer over a generated wrapper. Pure JS: it adds
+// no Dart and needs no native rebuild, because the native surface it uses
+// (percent_indicator.CircularPercentIndicator, already in the binary) does
+// not change. This is the layer that could ship over the air.
+import { Text } from "solid-fuse";
+import { CircularPercentIndicator, type CircularPercentIndicatorProps } from "~/_generated/percent_indicator";
+
+type Tone = "info" | "good" | "warn";
+
+const TONES: Record<Tone, { progress: CircularPercentIndicatorProps["progressColor"]; track: CircularPercentIndicatorProps["backgroundColor"] }> = {
+  info: { progress: "#3366ff", track: "#3366ff22" },
+  good: { progress: "#2e9e5b", track: "#2e9e5b22" },
+  warn: { progress: "#e08a00", track: "#e08a0022" },
+};
+
+export interface GaugeProps {
+  /** 0 to 100. Clamped, so callers cannot trip Flutter's `percent` assert. */
+  value: number;
+  /** Diameter in logical pixels. */
+  size?: number;
+  tone?: Tone;
+  /** Shown under the percentage. */
+  label?: string;
+}
+
+export function Gauge(props: GaugeProps) {
+  const size = () => props.size ?? 96;
+  const tone = () => TONES[props.tone ?? "info"];
+  return (
+    <CircularPercentIndicator
+      radius={size() / 2}
+      lineWidth={Math.max(4, size() / 12)}
+      percent={Math.min(1, Math.max(0, props.value / 100))}
+      progressColor={tone().progress}
+      backgroundColor={tone().track}
+      circularStrokeCap="round"
+      animation
+      animateFromLastPercent
+      animationDuration={250}
+      center={<Text fontSize={size() / 4} fontWeight="bold">{`${Math.round(props.value)}%`}</Text>}
+      footer={props.label ? <Text>{props.label}</Text> : undefined}
+    />
+  );
+}
