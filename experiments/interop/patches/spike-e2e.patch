diff --git a/packages/solid-fuse/src/native-validate.ts b/packages/solid-fuse/src/native-validate.ts
new file mode 100644
index 0000000..e7aa711
--- /dev/null
+++ b/packages/solid-fuse/src/native-validate.ts
@@ -0,0 +1,385 @@
+// Dev-mode validation of props crossing the bridge, driven by the manifests
+// that `fuse gen` writes (src/_generated/<unit>.manifest.json).
+//
+// Why on the JS side: this is where the mistake is made. The component stack
+// is known, the error can be raised before the op is sent, and the manifest
+// does not have to be compiled into the native binary. The Dart adapters
+// still throw on values they cannot decode, as a backstop.
+//
+// Nothing here runs in release: `fuse dev` / `fuse build --dev` inject a
+// prelude that calls `registerNativeManifest`; release bundles never import
+// it, so the validator is tree-shaken and `_validateProp` stays undefined.
+
+import { FuseNode, _setPropValidator } from "./renderer";
+import { reportDevError } from "./dev-error";
+
+// ── manifest shape (the subset validation reads) ────────────────────────────
+
+export type NativeType =
+  | { k: "bool" | "int" | "double" | "num" | "string" | "unknown" | "never"; nullable?: boolean }
+  | { k: "enum" | "data" | "handle" | "payload"; n: string; nullable?: boolean }
+  | { k: "list"; e: NativeType; nullable?: boolean }
+  | { k: "map"; key: NativeType; v: NativeType; nullable?: boolean }
+  | { k: "widget"; preferredSize?: boolean; nullable?: boolean }
+  | { k: "widgets"; nullable?: boolean }
+  | { k: "callback"; args: { name: string; type: NativeType; nullable?: boolean }[]; nullable?: boolean };
+
+export interface NativeProp {
+  type: NativeType;
+  dart?: string;
+  required?: boolean;
+  nullable?: boolean;
+  default?: string;
+  doc?: string;
+}
+
+export interface NativeWidget {
+  tag: string;
+  dart: string;
+  ctor?: string;
+  doc?: string;
+  children?: "child" | "children" | "text";
+  flexProp?: boolean;
+  props: Record<string, NativeProp>;
+  omitted?: Record<string, string>;
+}
+
+export interface NativeDataType {
+  dart: string;
+  nice?: { ts: string; accepts: string[] }[];
+  replace?: boolean;
+  consts?: string[];
+  variants?: {
+    tag: string | null;
+    fields: Record<string, { type: NativeType; required?: boolean; nullable?: boolean }>;
+  }[];
+}
+
+export interface NativeManifest {
+  manifestVersion: number;
+  unit: string;
+  widgets: Record<string, NativeWidget>;
+  enums: Record<string, { values: string[] }>;
+  types: Record<string, NativeDataType>;
+}
+
+// ── registry ────────────────────────────────────────────────────────────────
+
+interface Entry {
+  widget: NativeWidget;
+  manifest: NativeManifest;
+}
+const byTag = new Map<string, Entry>();
+
+/** Errors raised so far (dev tooling and tests read this). */
+export const nativeValidationErrors: string[] = [];
+
+let sink: (message: string) => void = (message) => {
+  // console.error reaches the Flutter log; reportDevError reaches the
+  // `fuse dev` terminal (source-mapped) when a dev server is attached.
+  if ((globalThis as any).__fuseDevServer) reportDevError(new NativeValidationError(message));
+  else console.error(message);
+};
+
+export class NativeValidationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "NativeValidationError";
+  }
+}
+
+/** Replace where validation errors go (tests). */
+export function setNativeValidationSink(fn: (message: string) => void) {
+  sink = fn;
+}
+
+/**
+ * Register a manifest written by `fuse gen`. From then on every prop set on a
+ * node whose tag the manifest describes is checked before it is sent.
+ */
+export function registerNativeManifest(manifest: NativeManifest) {
+  for (const name in manifest.widgets) {
+    const widget = manifest.widgets[name];
+    byTag.set(widget.tag, { widget, manifest });
+  }
+  _setPropValidator(validate);
+}
+
+// ── validation ──────────────────────────────────────────────────────────────
+
+const RESERVED = new Set(["children", "ref", "_component"]);
+const seen = new Set<string>();
+
+function fail(node: FuseNode, entry: Entry, detail: string) {
+  const where = node.component ? ` in <${node.component}>` : "";
+  const message = `[fuse] <${entry.widget.tag}>${where}: ${detail}`;
+  // A reactive prop re-runs; report each distinct problem once per node.
+  const key = `${node.id}|${message}`;
+  if (seen.has(key)) return;
+  seen.add(key);
+  nativeValidationErrors.push(message);
+  sink(message);
+}
+
+function validate(node: FuseNode, name: string, value: any) {
+  const entry = byTag.get(node.type);
+  if (!entry) return; // hand-written builder or built-in: nothing declared
+  const { widget, manifest } = entry;
+
+  if (name === "$create") {
+    // `value` is the props object handed to the wrapper.
+    for (const prop in widget.props) {
+      if (widget.props[prop].required && !(prop in value)) {
+        fail(node, entry, `missing required prop "${prop}" (${describe(widget.props[prop].type, manifest)}).`);
+      }
+    }
+    return;
+  }
+
+  if (RESERVED.has(name)) return;
+  if (name === "flex" && widget.flexProp) return;
+  const prop = widget.props[name];
+  if (!prop) {
+    const omitted = widget.omitted?.[name];
+    if (omitted) {
+      fail(node, entry, `prop "${name}" exists on Flutter's ${widget.dart} but is not bridged (${omitted}).`);
+      return;
+    }
+    const near = nearest(name, Object.keys(widget.props));
+    fail(node, entry, `unknown prop "${name}".${near ? ` Did you mean "${near}"?` : ""}`);
+    return;
+  }
+  if (value === undefined) return; // prop removed
+  if (value === null) {
+    if (prop.required && !prop.nullable) {
+      fail(node, entry, `prop "${name}" is required (${describe(prop.type, manifest)}), got null.`);
+    }
+    return;
+  }
+  const problem = check(prop.type, value, manifest, name);
+  if (problem) fail(node, entry, problem);
+}
+
+/** Returns a problem description, or null when [value] fits [type]. */
+function check(type: NativeType, value: any, m: NativeManifest, path: string): string | null {
+  const expects = (what: string, hint = "") => `${at(path)} expects ${what}, got ${show(value)}.${hint}`;
+  switch (type.k) {
+    case "bool":
+      return typeof value === "boolean" ? null : expects("boolean");
+    case "int":
+      return typeof value === "number" && Number.isInteger(value) ? null : expects("an integer");
+    case "double":
+    case "num":
+      return typeof value === "number" ? null : expects("number");
+    case "string":
+      return typeof value === "string" ? null : expects("string");
+    case "unknown":
+      return null;
+    case "enum": {
+      const values = m.enums[type.n]?.values ?? [];
+      if (typeof value === "string" && values.includes(value)) return null;
+      return expects(`${type.n} (${list(values)})`, didYouMean(value, values));
+    }
+    case "list": {
+      if (!Array.isArray(value)) return expects(`${describe(type, m)}`);
+      for (let i = 0; i < value.length; i++) {
+        if (value[i] == null) {
+          if (type.e.nullable) continue;
+          return `${at(`${path}[${i}]`)} expects ${describe(type.e, m)}, got ${show(value[i])}.`;
+        }
+        const p = check(type.e, value[i], m, `${path}[${i}]`);
+        if (p) return p;
+      }
+      return null;
+    }
+    case "map": {
+      if (!isPlainObject(value)) return expects(describe(type, m));
+      for (const k in value) {
+        if (value[k] == null) continue;
+        const p = check(type.v, value[k], m, `${path}.${k}`);
+        if (p) return p;
+      }
+      return null;
+    }
+    case "widget":
+      return isNode(value) ? null : expects("a JSX element");
+    case "widgets":
+      return isNode(value) || (Array.isArray(value) && value.every(isNode)) ? null : expects("a JSX element or an array of them");
+    case "handle":
+      return value && value.node instanceof FuseNode ? null : expects(`a ${type.n} handle`);
+    case "callback":
+      return typeof value === "function" ? null : expects("a function");
+    case "data":
+      return checkData(type.n, value, m, path);
+  }
+  return null;
+}
+
+const NICE: Record<string, (v: any) => boolean> = {
+  number: (v) => typeof v === "number",
+  object: (v) => isPlainObject(v) && !("$" in v),
+  hexColor: (v) => typeof v === "string" && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(v),
+  namedColor: (v) => typeof v === "string" && NAMED_COLORS.includes(v),
+  colorObject: (v) => isPlainObject(v) && !("$" in v) && ("r" in v || "h" in v),
+  fontWeight: (v) => typeof v === "number" && v >= 100 && v <= 900 && v % 100 === 0,
+};
+
+// Mirrors parseColor in dart/lib/src/utils.dart.
+const NAMED_COLORS = [
+  "red", "blue", "green", "white", "black", "grey", "orange", "purple",
+  "yellow", "teal", "cyan", "amber", "indigo", "pink", "brown", "transparent",
+];
+
+function checkData(name: string, value: any, m: NativeManifest, path: string): string | null {
+  const t = m.types[name];
+  if (!t) return null;
+  for (const n of t.nice ?? []) {
+    for (const a of n.accepts) if (NICE[a]?.(value)) return null;
+  }
+  const expects = (hint = "") => `${at(path)} expects ${name} (${describeData(t)}), got ${show(value)}.${hint}`;
+  if (typeof value === "string") {
+    const consts = t.consts ?? [];
+    if (consts.includes(value)) return null;
+    const candidates = t.nice?.some((n) => n.accepts.includes("namedColor")) ? [...NAMED_COLORS, ...consts] : consts;
+    return expects(didYouMean(value, candidates));
+  }
+  if (!isPlainObject(value)) return expects();
+  const variants = t.variants ?? [];
+  if (variants.length === 0) return expects();
+  const tag = "$" in value ? value.$ : null;
+  const variant = variants.find((v) => v.tag === tag);
+  if (!variant) {
+    const tags = variants.map((v) => v.tag).filter((x): x is string => x != null);
+    if (tag == null) {
+      return `${at(path)} expects ${name}, got an object without "$". ${name} needs a tag: ${list(tags.map((x) => `{ $: "${x}" }`), 4)}.`;
+    }
+    return `${at(path)} has unknown ${name} variant $: ${show(tag)}.${didYouMean(tag, tags)}`;
+  }
+  const label = variant.tag ? `${name} { $: "${variant.tag}" }` : name;
+  for (const key in value) {
+    if (key === "$") continue;
+    const field = variant.fields[key];
+    if (!field) {
+      return `${at(`${path}.${key}`)} is not a field of ${label}.${didYouMean(key, Object.keys(variant.fields))}`;
+    }
+    if (value[key] == null) continue;
+    const p = check(field.type, value[key], m, `${path}.${key}`);
+    if (p) return p;
+  }
+  for (const key in variant.fields) {
+    if (variant.fields[key].required && value[key] == null) {
+      return `${at(`${path}.${key}`)} is required by ${label} (${describe(variant.fields[key].type, m)}).`;
+    }
+  }
+  return null;
+}
+
+// ── messages ────────────────────────────────────────────────────────────────
+
+const at = (path: string) => `prop "${path}"`;
+
+function describe(type: NativeType, m: NativeManifest): string {
+  switch (type.k) {
+    case "bool":
+      return "boolean";
+    case "int":
+    case "double":
+    case "num":
+      return "number";
+    case "enum":
+      return `${type.n}: ${list(m.enums[type.n]?.values ?? [])}`;
+    case "data":
+    case "handle":
+    case "payload":
+      return type.n;
+    case "list":
+      return `${describe(type.e, m)}[]`;
+    case "map":
+      return `Record<string, ${describe(type.v, m)}>`;
+    case "widget":
+    case "widgets":
+      return "JSX element";
+    case "callback":
+      return "function";
+    default:
+      return type.k;
+  }
+}
+
+function describeData(t: NativeDataType): string {
+  const parts: string[] = [];
+  for (const n of t.nice ?? []) {
+    parts.push(n.ts === "NativeColorInput" ? '"#rrggbb" | "red" | {r,g,b}' : n.ts.length > 40 ? "object" : n.ts);
+  }
+  if (t.consts?.length) parts.push(list(t.consts.map((c) => `"${c}"`), 3));
+  const tags = (t.variants ?? []).map((v) => (v.tag == null ? "{…}" : `{ $: "${v.tag}" }`));
+  if (tags.length) parts.push(list(tags, 2));
+  return parts.join(" | ");
+}
+
+function list(values: string[], max = 8): string {
+  return values.length <= max ? values.join(" | ") : `${values.slice(0, max).join(" | ")} | … ${values.length - max} more`;
+}
+
+function show(v: any): string {
+  if (typeof v === "string") return JSON.stringify(v);
+  if (typeof v === "function") return "a function";
+  if (v instanceof FuseNode) return `<${v.type}>`;
+  if (Array.isArray(v)) return "an array";
+  if (v && typeof v === "object") {
+    try {
+      const s = JSON.stringify(v);
+      return s.length > 60 ? `${s.slice(0, 57)}…` : s;
+    } catch {
+      return "an object";
+    }
+  }
+  return String(v);
+}
+
+function didYouMean(value: unknown, candidates: string[]): string {
+  if (typeof value !== "string") return "";
+  const near = nearest(value, candidates);
+  return near ? ` Did you mean "${near}"?` : "";
+}
+
+function isNode(v: any): boolean {
+  return v instanceof FuseNode || (v != null && v.node instanceof FuseNode);
+}
+
+function isPlainObject(v: any): boolean {
+  return v != null && typeof v === "object" && !Array.isArray(v) && !(v instanceof FuseNode);
+}
+
+/** Closest candidate by edit distance, if it is close enough to be a typo. */
+export function nearest(value: string, candidates: string[]): string | undefined {
+  let best: string | undefined;
+  let bestD = Infinity;
+  const a = value.toLowerCase();
+  for (const c of candidates) {
+    const b = c.toLowerCase();
+    // "Curves.easeIn" should match "easeIn": compare against the last segment too.
+    const d = Math.min(distance(a, b), b.includes(".") ? distance(a, b.slice(b.lastIndexOf(".") + 1)) + 1 : Infinity);
+    if (d < bestD) {
+      bestD = d;
+      best = c;
+    }
+  }
+  return best !== undefined && bestD <= Math.max(2, Math.floor(value.length / 3)) ? best : undefined;
+}
+
+function distance(a: string, b: string): number {
+  if (a === b) return 0;
+  const prev = new Array(b.length + 1);
+  for (let j = 0; j <= b.length; j++) prev[j] = j;
+  for (let i = 1; i <= a.length; i++) {
+    let last = prev[0];
+    prev[0] = i;
+    for (let j = 1; j <= b.length; j++) {
+      const tmp = prev[j];
+      prev[j] = Math.min(prev[j] + 1, prev[j - 1] + 1, last + (a[i - 1] === b[j - 1] ? 0 : 1));
+      last = tmp;
+    }
+  }
+  return prev[b.length];
+}
