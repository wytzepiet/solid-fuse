+  | "CupertinoColors.tertiarySystemFill" | "CupertinoColors.quaternarySystemFill" | "CupertinoColors.placeholderText" | "CupertinoColors.systemBackground" | "CupertinoColors.secondarySystemBackground" | "CupertinoColors.tertiarySystemBackground" | "CupertinoColors.systemGroupedBackground" | "CupertinoColors.secondarySystemGroupedBackground"
+  | "CupertinoColors.tertiarySystemGroupedBackground" | "CupertinoColors.separator" | "CupertinoColors.opaqueSeparator" | "CupertinoColors.link"
+  | { value: number }
+  | { $: "from"; alpha: number; red: number; green: number; blue: number; colorSpace?: ColorSpace }
+  | { $: "fromARGB"; a: number; r: number; g: number; b: number }
+  | { $: "fromRGBO"; r: number; g: number; b: number; opacity: number }
+  | { $: "MaterialColor"; primary: number; swatch: Partial<Record<string, Color>> }
+  | { $: "MaterialAccentColor"; primary: number; swatch: Partial<Record<string, Color>> }
+  | { $: "CupertinoDynamicColor"; debugLabel?: string | null; color: Color; darkColor: Color; highContrastColor: Color; darkHighContrastColor: Color; elevatedColor: Color; darkElevatedColor: Color; highContrastElevatedColor: Color; darkHighContrastElevatedColor: Color }
+  | { $: "CupertinoDynamicColor.withBrightnessAndContrast"; debugLabel?: string | null; color: Color; darkColor: Color; highContrastColor: Color; darkHighContrastColor: Color }
+  | { $: "CupertinoDynamicColor.withBrightness"; debugLabel?: string | null; color: Color; darkColor: Color };
+
+/**
+ * An parametric animation easing curve, i.e. a mapping of the unit interval to
+ * the unit interval.
+ *
+ * Dart: `Curve`
+ */
+export type Curve =
+  | "Easing.emphasizedAccelerate" | "Easing.emphasizedDecelerate" | "Easing.linear" | "Easing.standard" | "Easing.standardAccelerate" | "Easing.standardDecelerate" | "Easing.legacyDecelerate" | "Easing.legacyAccelerate"
+  | "Easing.legacy" | "Curves.linear" | "Curves.decelerate" | "Curves.fastLinearToSlowEaseIn" | "Curves.fastEaseInToSlowEaseOut" | "Curves.ease" | "Curves.easeIn" | "Curves.easeInToLinear"
+  | "Curves.easeInSine" | "Curves.easeInQuad" | "Curves.easeInCubic" | "Curves.easeInQuart" | "Curves.easeInQuint" | "Curves.easeInExpo" | "Curves.easeInCirc" | "Curves.easeInBack"
+  | "Curves.easeOut" | "Curves.linearToEaseOut" | "Curves.easeOutSine" | "Curves.easeOutQuad" | "Curves.easeOutCubic" | "Curves.easeOutQuart" | "Curves.easeOutQuint" | "Curves.easeOutExpo"
+  | "Curves.easeOutCirc" | "Curves.easeOutBack" | "Curves.easeInOut" | "Curves.easeInOutSine" | "Curves.easeInOutQuad" | "Curves.easeInOutCubic" | "Curves.easeInOutCubicEmphasized" | "Curves.easeInOutQuart"
+  | "Curves.easeInOutQuint" | "Curves.easeInOutExpo" | "Curves.easeInOutCirc" | "Curves.easeInOutBack" | "Curves.fastOutSlowIn" | "Curves.slowMiddle" | "Curves.bounceIn" | "Curves.bounceOut"
+  | "Curves.bounceInOut" | "Curves.elasticIn" | "Curves.elasticOut" | "Curves.elasticInOut"
+  | { $: "SawTooth"; count: number }
+  | { $: "Interval"; begin: number; end: number; curve?: Curve }
+  | { $: "Split"; split: number; beginCurve?: Curve; endCurve?: Curve }
+  | { $: "Threshold"; threshold: number }
+  | { $: "Cubic"; a: number; b: number; c: number; d: number }
+  | { $: "ThreePointCubic"; a1: Offset; b1: Offset; midpoint: Offset; a2: Offset; b2: Offset }
+  | { $: "CatmullRomCurve"; controlPoints: Offset[]; tension?: number }
+  | { $: "CatmullRomCurve.precompute"; controlPoints: Offset[]; tension?: number }
+  | { $: "FlippedCurve"; curve: Curve }
+  | { $: "ElasticInCurve"; period?: number }
+  | { $: "ElasticOutCurve"; period?: number }
+  | { $: "ElasticInOutCurve"; period?: number };
+
+/**
+ * An immutable set of offsets in each of the four cardinal directions.
+ *
+ * Dart: `EdgeInsets`
+ */
+export type EdgeInsets =
+  | number
+  | "zero"
+  | { $: "fromLTRB"; left: number; top: number; right: number; bottom: number }
+  | { $: "all"; value: number }
+  | { $: "only"; left?: number; top?: number; right?: number; bottom?: number }
+  | { $: "symmetric"; vertical?: number; horizontal?: number }
+  | { $: "fromViewPadding"; padding: ViewPadding; devicePixelRatio: number };
+
+/**
+ * Base class for transforming gradient shaders without applying the same
+ * transform to the entire canvas.
+ *
+ * Dart: `GradientTransform`
+ */
+export type GradientTransform =
+  | { $: "GradientRotation"; radians: number };
+
+/**
+ * A 2D linear gradient.
+ *
+ * Dart: `LinearGradient`
+ */
+export type LinearGradient =
+  | { begin?: AlignmentGeometry; end?: AlignmentGeometry; colors: Color[]; stops?: number[]; tileMode?: TileMode; transform?: GradientTransform | null };
+
+/**
+ * A mask filter to apply to shapes as they are painted. A mask filter is a
+ * function that takes a bitmap of color pixels, and returns another bitmap of
+ * color pixels.
+ *
+ * Dart: `MaskFilter`
+ */
+export type MaskFilter =
+  | { $: "blur"; _style: BlurStyle; _sigma: number };
+
+/**
+ * An immutable 2D floating-point offset.
+ *
+ * Dart: `Offset`
+ */
+export type Offset =
+  | "zero" | "infinite"
+  | { dx: number; dy: number }
+  | { $: "fromDirection"; direction: number; distance?: number };
+
+/**
+ * A radius for either circular or elliptical shapes.
+ *
+ * Dart: `Radius`
+ */
+export type Radius =
+  | number
+  | "zero"
+  | { $: "circular"; radius: number }
+  | { $: "elliptical"; x: number; y: number };
+
+/**
+ * An immutable, 2D, axis-aligned, floating-point rectangle whose coordinates
+ * are relative to a given origin.
+ *
+ * Dart: `Rect`
+ */
+export type Rect =
+  | "zero" | "largest"
+  | { $: "fromLTRB"; left: number; top: number; right: number; bottom: number }
+  | { $: "fromLTWH"; left: number; top: number; width: number; height: number }
+  | { $: "fromCircle"; center: Offset; radius: number }
+  | { $: "fromCenter"; center: Offset; width: number; height: number }
+  | { $: "fromPoints"; a: Offset; b: Offset };
+
+/**
+ * Holds a 2D floating-point size.
+ *
+ * Dart: `Size`
+ */
+export type Size =
+  | "zero" | "infinite"
+  | { width: number; height: number }
+  | { $: "copy"; source: Size }
+  | { $: "square"; dimension: number }
+  | { $: "fromWidth"; width: number }
+  | { $: "fromHeight"; height: number }
+  | { $: "fromRadius"; radius: number };
+
+/**
+ * A representation of distances for each of the four edges of a rectangle,
+ * used to encode the view insets and padding that applications should place
+ * around their user interface, as exposed by [FlutterView.viewInsets] and
+ * [FlutterView.padding]. View insets and padding are preferably read via
+ * [MediaQuery.of].
+ *
+ * Dart: `ViewPadding`
+ */
+export type ViewPadding =
+  | "zero";
+
+// ── callback payloads (Dart -> JS) ──
