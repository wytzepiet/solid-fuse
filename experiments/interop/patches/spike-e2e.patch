+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "fs";
+import { join } from "path";
+import { addPackageToConfig } from "./add";
+import {
+  diffManifests,
+  emitCatalogJson,
+  emitCatalogMarkdown,
+  emitTsModule,
+  tsType,
+  validationView,
+  type Manifest,
+} from "./gen-emit";
+
+// A real manifest written by `fuse gen` (examples/gen_e2e, percent_indicator 4.2.5).
+const fixture = JSON.parse(
+  readFileSync(join(import.meta.dir, "../../../examples/gen_e2e/src/_generated/percent_indicator.manifest.json"), "utf-8"),
+) as Manifest;
+
+describe("tsType", () => {
+  test("primitives, enums, data, lists, maps", () => {
+    expect(tsType({ k: "bool" })).toBe("boolean");
+    expect(tsType({ k: "int" })).toBe("number");
+    expect(tsType({ k: "enum", n: "Clip" })).toBe("Clip");
+    expect(tsType({ k: "list", e: { k: "data", n: "Color" } })).toBe("Color[]");
+    expect(tsType({ k: "list", e: { k: "data", n: "Color", nullable: true } })).toBe("(Color | null)[]");
+    expect(tsType({ k: "map", key: { k: "enum", n: "Side" }, v: { k: "double" } })).toBe("Partial<Record<Side, number>>");
+  });
+  test("slots, handles, callbacks", () => {
+    expect(tsType({ k: "widget" })).toBe("FuseElement");
+    expect(tsType({ k: "widgets" })).toBe("FuseElement | FuseElement[]");
+    expect(tsType({ k: "handle", n: "ScrollController" })).toBe('FuseHandle<"ScrollController">');
+    expect(tsType({ k: "callback", args: [] })).toBe("() => void");
+    expect(tsType({ k: "callback", args: [{ name: "value", type: { k: "bool" }, nullable: true }] })).toBe("(value: boolean | null) => void");
+    expect(
+      tsType({ k: "callback", args: [{ name: "a", type: { k: "int" } }, { name: "d", type: { k: "payload", n: "DragUpdateDetails" } }] }),
+    ).toBe("(args: [a: number, d: DragUpdateDetailsOut]) => void");
+  });
+});
+
+describe("emitTsModule", () => {
+  const { ts, perWidgetBytes } = emitTsModule(fixture);
+  test("exports a typed wrapper per widget with a collision-free wire tag", () => {
+    expect(ts).toContain("export interface CircularPercentIndicatorProps extends NativeBaseProps {");
+    expect(ts).toContain('export const CircularPercentIndicator = /*#__PURE__*/ nativeComponent<CircularPercentIndicatorProps>("percent_indicator.CircularPercentIndicator");');
+    expect(Object.keys(perWidgetBytes)).toEqual(Object.keys(fixture.widgets));
+  });
+  test("required props, defaults and docs come from the manifest", () => {
+    expect(ts).toMatch(/\n  radius: number;/);
+    expect(ts).toMatch(/@default 0\n\s+\*\/\n  percent\?: number;/);
+    expect(ts).toContain('export type CircularStrokeCap = "butt" | "round" | "square";');
+  });
+  test("imports only the base types it uses", () => {
+    const line = ts.split("\n").find((l) => l.startsWith("import type"))!;
+    expect(line).toContain("NativeColorInput");
+    expect(line).not.toContain("FuseHandle");
+  });
+});
+
+describe("catalogue", () => {
+  test("full markdown lists every prop with * and defaults", () => {
+    const md = emitCatalogMarkdown([fixture], "~/_generated", "full");
+    expect(md).toContain("### CircularPercentIndicator");
+    expect(md).toContain("`radius*: number`");
+    expect(md).toContain("`percent: number = 0`");
+    expect(md).toContain("not bridged: `onPercentValue` (callback/sync-return)");
+  });
+  test("index markdown is one line per widget", () => {
+    const md = emitCatalogMarkdown([fixture], "~/_generated", "index");
+    expect(md).toContain("- CircularPercentIndicator");
+    expect(md).not.toContain("radius");
+  });
+  test("json is keyed by unit and widget", () => {
+    const cat = emitCatalogJson([fixture], "~/_generated");
+    expect(cat.units.percent_indicator.import).toBe("~/_generated/percent_indicator");
+    expect(cat.units.percent_indicator.widgets.CircularPercentIndicator.props.radius).toBe("number*");
+  });
+  test("validation view drops docs", () => {
+    expect(JSON.stringify(validationView(fixture))).not.toContain('"doc"');
+  });
+});
+
+describe("diffManifests", () => {
+  test("reports removed, added and retyped props", () => {
+    const after = structuredClone(fixture);
+    const w = after.widgets.CircularPercentIndicator;
+    delete w.props.lineWidth;
+    w.props.percent = { ...w.props.percent, type: { k: "string" } };
+    w.props.brandNew = { type: { k: "bool" }, dart: "bool", required: true };
+    delete after.widgets.LinearPercentIndicator;
+    expect(diffManifests(fixture, after)).toEqual([
+      "~ percent_indicator.CircularPercentIndicator.percent: type number -> string",
+      "- percent_indicator.CircularPercentIndicator.lineWidth: prop removed",
+      "+ percent_indicator.CircularPercentIndicator.brandNew: boolean (required)",
+      "- percent_indicator.LinearPercentIndicator: widget removed",
+    ]);
+    expect(diffManifests(fixture, fixture)).toEqual([]);
+    expect(diffManifests(null, fixture)).toEqual([]);
+  });
+});
+
+describe("addPackageToConfig", () => {
+  test("creates native.packages in a bare config", () => {
+    const out = addPackageToConfig('export default defineConfig({});\n', "fl_chart")!;
+    expect(out).toContain("native: {\n    packages: {\n      fl_chart: {},");
+  });
+  test("adds to an existing native block and keeps what is there", () => {
+    const src = 'export default defineConfig({\n  native: {\n    flutter: ["Card"],\n  },\n});\n';
+    const out = addPackageToConfig(src, "fl_chart", ["LineChart"])!;
+    expect(out).toContain('fl_chart: { include: ["LineChart"] },');
+    expect(out).toContain('flutter: ["Card"]');
+  });
+  test("is idempotent and appends to an existing packages block", () => {
+    const src = "export default defineConfig({ native: { packages: { fl_chart: {} } } });\n";
+    expect(addPackageToConfig(src, "fl_chart")).toBe(src);
+    expect(addPackageToConfig(src, "badges")).toContain("badges: {},");
+  });
+  test("gives up on a shape it does not recognise", () => {
+    expect(addPackageToConfig("export default { dart: 'dart' };\n", "fl_chart")).toBeNull();
+  });
+});
