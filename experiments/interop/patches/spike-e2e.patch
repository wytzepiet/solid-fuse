+#!/usr/bin/env bash
+# Prisma-style upgrade safety, demonstrated on a real pub package:
+# badges 2.0.3 -> 3.x moved eleven constructor params into BadgeStyle /
+# BadgeAnimation. Generate against 2.0.3, write a call site, bump the package,
+# and watch `fuse gen --check`, the API diff and tsc point at the call site.
+# Leaves examples/gen_e2e as it was (git checkout + regenerate).
+set -uo pipefail
+cd "$(dirname "$0")/../../../examples/gen_e2e"
+export PATH=/opt/flutter/bin:$PATH
+fuse() { bun ../../packages/solid-fuse/cli/index.ts "$@" 2>&1 | grep -v "superuser\|as root\|^  /$\|📎\|^$"; return "${PIPESTATUS[0]}"; }
+
+echo "\$ fuse add badges:2.0.3"
+fuse add badges:2.0.3 | sed -n '/widget(s) generated/,/fuse catalog/p'
+
+cat > src/skew-demo.tsx <<'TSX'
+import { Text } from "solid-fuse";
+import { Badge } from "~/_generated/badges";
+
+export function Inbox(props: { unread: number }) {
+  return (
+    <Badge
+      badgeContent={<Text color="white">{String(props.unread)}</Text>}
+      badgeColor="red"
+      elevation={0}
+      toAnimate={false}
+      shape="circle"
+      showBadge={props.unread > 0}
+    >
+      <Text>Inbox</Text>
+    </Badge>
+  );
+}
+TSX
+echo; echo "\$ tsc --noEmit        # call site written against badges 2.0.3"
+./node_modules/.bin/tsc --noEmit && echo "ok, no errors"
+
+echo; echo "\$ (cd dart && flutter pub add 'badges:^3.1.2')"
+(cd dart && flutter pub add 'badges:^3.1.2' 2>&1 | grep "> badges")
+
+echo; echo "\$ fuse gen --check    # what CI and \`fuse dev\` see"
+fuse gen --check; echo "exit code $?"
+
+echo; echo "\$ fuse gen"
+fuse gen | sed -n '/badges 3/p;/API changes/,/tsc --noEmit/p'
+
+echo; echo "\$ tsc --noEmit"
+./node_modules/.bin/tsc --noEmit; echo "exit code $?"
+
+echo; echo "(restoring examples/gen_e2e)"
+git checkout -q . && git clean -fdq src dart/lib
+(cd dart && flutter pub get >/dev/null 2>&1)
+fuse gen --check
