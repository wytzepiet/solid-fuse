+// Where the generated 1:1 API is awkward from JSX. Type-checked against a
+// generation of ALL of material.dart (498 widgets); see ../reports/06-e2e-fuse-add.md
+// section "Friction". Every `@ts-expect-error` is a real error; every line
+// without one compiles.
+import { createSignal } from "solid-js";
+import { Text as FuseText, Switch as SolidSwitch, Match } from "solid-fuse";
+import { home } from "solid-fuse/icons/material";
+import * as F from "~/_generated/flutter";
+
+const [name] = createSignal("Ada");
+const [picked, setPicked] = createSignal<"a" | "b">("a");
+
+export const samples = [
+  // 1. Tagged unions. Abstract Dart types need `$`, and nested ones need it again.
+  <F.Container
+    decoration={{
+      $: "BoxDecoration",
+      color: "#ffffff",
+      borderRadius: 12,
+      border: { $: "all", color: "#00000022", width: 1 },
+      gradient: { $: "LinearGradient", colors: ["#fff", "#eee"], begin: "topLeft", end: "bottomRight" },
+    }}
+  />,
+  // @ts-expect-error  Decoration is abstract: the tag is mandatory, `{ color }` alone is not a Decoration
+  <F.Container decoration={{ color: "#ffffff" }} />,
+  // ...while the built-in View takes the untagged form:  <View decoration={{ color: "#fff", borderRadius: 12 }} />
+
+  // 2. Text: Flutter's positional `data` is filled from text children, and both spellings exist.
+  <F.Text>Hello</F.Text>,
+  <F.Text data="Hello" />,
+  <F.Text style={{ fontSize: 18, fontWeight: 700, color: "#3366ff" }}>Hello {name()}</F.Text>,
+  // Not an error, although Flutter's Text cannot hold widgets: JSX.Element is `any` in solid-fuse.
+  <F.Text>
+    <F.Text>nested</F.Text>
+  </F.Text>,
+
+  // 3. PreferredSizeWidget: any element type-checks; the adapter wraps it in PreferredSize(kToolbarHeight).
+  <F.Scaffold appBar={<F.AppBar title={<FuseText>Title</FuseText>} />} />,
+  <F.Scaffold appBar={<FuseText>not an app bar, still accepted</FuseText>} />,
+
+  // 4. `flex`: Flutter's int on Expanded/Flexible, solid-fuse's layout object everywhere else.
+  <F.Expanded flex={2}>
+    <FuseText>a</FuseText>
+  </F.Expanded>,
+  // @ts-expect-error  on Expanded, `flex` is Flutter's number, not solid-fuse's FuseFlex
+  <F.Expanded flex={{ direction: "horizontal" }} />,
+  <F.Padding padding={8} flex={{ direction: "horizontal", gap: 4 }}>
+    <FuseText>a</FuseText>
+    <FuseText>b</FuseText>
+  </F.Padding>,
+
+  // 5. Generics are erased: `value` and the callback argument are `unknown`, and not tied together.
+  <F.Radio value="a" />,
+  <F.DropdownButton value={picked()} onChanged={(v) => setPicked(v as "a" | "b")} />,
+  // @ts-expect-error  v is unknown, not "a" | "b"
+  <F.DropdownButton value={picked()} onChanged={(v: "a" | "b") => setPicked(v)} />,
+
+  // 6. Stateful styling: only the constant arm of WidgetStateProperty is derivable.
+  <F.ElevatedButton
+    onPressed={() => {}}
+    style={{ backgroundColor: { $: "WidgetStatePropertyAll", value: "red" }, elevation: { $: "WidgetStatePropertyAll", value: 2 } }}
+  >
+    <FuseText>Save</FuseText>
+  </F.ElevatedButton>,
+
+  // 7. Several callback arguments arrive as one tuple.
+  <F.ReorderableListView onReorderItem={([oldIndex, newIndex]) => console.log(oldIndex, newIndex)}>{[]}</F.ReorderableListView>,
+
+  // 8. Icons: IconData is an object, which solid-fuse's icon modules already export in that shape.
+  <F.Icon icon={home} />,
+  <F.Icon icon={{ codePoint: 0xe318, fontFamily: "MaterialIcons" }} />,
+
+  // 9. Names collide with solid-fuse's own exports (Text, Stack, Icon, GestureDetector) and with
+  //    Solid's control flow (Switch): a namespace import is the only comfortable spelling.
+  <SolidSwitch>
+    <Match when={picked() === "a"}>
+      <F.Switch value={true} onChanged={() => {}} />
+    </Match>
+  </SolidSwitch>,
+
+  // 10. Required-but-nullable Dart params become optional: forgetting onPressed compiles and
+  //     renders a disabled button, which is Flutter's behaviour but not its compile-time nudge.
+  <F.ElevatedButton>
+    <FuseText>disabled</FuseText>
+  </F.ElevatedButton>,
+];
