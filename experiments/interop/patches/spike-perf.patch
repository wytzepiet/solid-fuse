+#!/usr/bin/env python3
+"""Report 11 stage tables: one row per build, median (min-max) per metric.
+   python3 tools/agg11-stages.py <op> label=file[,file...] ...
+"""
+import json, sys
+from statistics import median
+def load(paths, op):
+    out, det, loads, checks = [], None, [], [0, 0]
+    for p in paths.split(","):
+        for line in open(p):
+            if not line.startswith("BENCH {"): continue
+            d = json.loads(line[6:])
+            if d["name"] == "list_order_check":
+                checks[1] += 1; checks[0] += 1 if d.get("dartTreeMatchesJs") else 0; continue
+            if d["name"] != op: continue
+            if d.get("detail"): det = d; continue
+            out.append(d)
+            try: loads.append(float(d["load"]))
+            except Exception: pass
+    return out, det, loads, checks
+def cell(v):
+    return f"{median(v):.3g} ({min(v):.3g}–{max(v):.3g})" if v else "–"
+op = sys.argv[1]
+print(f"**{op}** (ms, median (min–max))\n")
+print("| build | n | JS | bridge call | decode | apply | frame | UI total | e2e | ops | KB | load | order |")
+print("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|---|")
+for a in sys.argv[2:]:
+    label, paths = a.split("=")
+    r, det, loads, checks = load(paths, op)
+    g = lambda k: [d[k] for d in r if isinstance(d.get(k), (int, float))]
+    ui = [d.get("decodeMs", 0) + d.get("applyMs", 0) + d["uiFrameMs"] for d in r if "uiFrameMs" in d]
+    print(f"| {label} | {len(r)} | {cell(g('jsMs'))} | {cell(g('sendMs'))} | {cell(g('decodeMs'))} | {cell(g('applyMs'))} | {cell(g('uiFrameMs'))} | {cell(ui)} | {cell(g('e2eMs'))} | {det.get('ops') if det else '–'} | {round(det.get('bytes', 0) / 1024, 1) if det else '–'} | {min(loads):.2f}–{max(loads):.2f} | {checks[0]}/{checks[1]} |")
+print()
