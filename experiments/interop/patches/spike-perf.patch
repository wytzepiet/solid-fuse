+#[test]
+fn test_from_js_plain_object_leaves_no_pending_exception() {
+    // `JS_GetArrayBuffer` throws for anything that is not an ArrayBuffer; the
+    // conversion must not leave that TypeError pending on the context.
+    for install in [true, false] {
+        test_with(|ctx| {
+            if install {
+                crate::api::value::install_value_intrinsics(&ctx).unwrap();
+            }
+            let val: rquickjs::Value = ctx.eval("({ a: { b: {} } })").unwrap();
+            assert!(JsValue::from_js(&ctx, val).unwrap().is_object());
+            let pending = ctx.catch();
+            assert!(
+                pending.is_null() || pending.is_undefined() || pending.type_of() == rquickjs::Type::Uninitialized,
+                "pending exception after from_js (intrinsics installed: {install}): {:?}",
+                pending
+            );
+        });
+    }
+}
