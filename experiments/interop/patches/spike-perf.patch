+
+String makeJson(int bytes) {
+  final out = <Map<String, dynamic>>[];
+  var size = 2, i = 0;
+  while (size < bytes) {
+    final o = {
+      'id': i,
+      'uuid': '7f3c${(i * 2654435761 % 4294967296).toRadixString(16)}-4b1d-9e2a-${i.toRadixString(16).padLeft(12, '0')}',
+      'name': 'Customer number $i',
+      'email': 'customer$i@example.com',
+      'active': i % 3 != 0,
+      'score': (i * 37) % 1000 / 10,
+      'tags': ['alpha', 'beta', i.isOdd ? 'gamma' : 'delta'],
+      'address': {
+        'street': '$i Main Street',
+        'city': 'Springfield',
+        'zip': '${10000 + (i % 89999)}',
+        'geo': {'lat': 52.1 + i / 1e4, 'lng': 4.3 - i / 1e4},
+      },
+      'createdAt': '2026-11-20T21:00:00.000Z',
+      'note': null,
+    };
+    size += jsonEncode(o).length + 1;
+    out.add(o);
+    i++;
+  }
+  return jsonEncode(out);
+}
+
+Future<void> part5() async {
+  const s = 'part5';
+  final reps = envInt('REPS', 3);
+
+  // (a) a 5,000-node mount while a box is being dragged: in one go, or in slices.
+  const cards = 454; // 4,994 nodes
+  final mounts = <String, Mid?>{
+    'none': null,
+    'bulk': () => cmd('bulkMount', {'cards': cards}),
+    'chunk5': () => cmd('chunkMount', {'cards': cards, 'chunk': 5}),
+    'chunk20': () => cmd('chunkMount', {'cards': cards, 'chunk': 20}),
+    'chunk60': () => cmd('chunkMount', {'cards': cards, 'chunk': 60}),
+  };
+  for (var r = 0; r < reps; r++) {
+    for (final e in mounts.entries) {
+      for (final owner in ['js', 'dart']) {
+        final res = await runDrag(owner: owner, load: 'mount_${e.key}', durMs: 4000, speed: 120, mid: e.value, settleMs: 1500);
+        queue(s, 'drag_during_mount', res, r);
+      }
+    }
+    await flushPending();
+  }
+  await cmd('clear');
+  await settle(300);
+
+  // (b) JSON parsing on a second engine.
+  final worker = await createEngine();
+  await worker.engine.eval(
+    source: JsCode.code('''
+      globalThis.__dispatch = async (ch, d) => {
+        if (ch === "parse") return JSON.parse(d.s);
+        if (ch === "parseReduce") return JSON.parse(d.s).slice(0, 50).map((o) => ({ id: o.id, name: o.name, email: o.email }));
+        if (ch === "parseCount") return JSON.parse(d.s).length;
+        if (ch === "parseTimed") { const t = performance.now(); const v = JSON.parse(d.s); return { ms: performance.now() - t, n: v.length }; }
+        if (ch === "noop") return 1;
+      };
+    '''),
+  );
+  final wch = worker.channels;
+  for (final kb in [100, 1024]) {
+    final json = makeJson(kb * 1024);
+    for (var r = 0; r < reps; r++) {
+      final tag = {'kb': kb, 'rep': r, 'bytes': json.length};
+
+      // A. parse on the main engine (string handed over from Dart).
+      var t = now();
+      final (a, aStall) = await withHeartbeat(() => cmd('parseStr', {'s': json}));
+      emit(s, 'json_main_engine', {...tag, 'totalMs': ms(now() - t), 'mainJsBusyMs': a['jsMs'], 'uiStallMs': aStall});
+
+      // B. parse on the worker, move the whole value to the main engine.
+      t = now();
+      final (v, bStall1) = await withHeartbeat(() => wch.call('parse', {'s': json}));
+      final t1 = now();
+      final sw = Stopwatch()..start();
+      final f = ch.call('bench', {'cmd': 'recv', 'data': v});
+      final encodeMs = sw.elapsedMicroseconds / 1000;
+      final (_, bStall2) = await withHeartbeat(() => f);
+      final t2 = now();
+      emit(s, 'json_worker_full_transfer', {
+        ...tag,
+        'workerParseAndReturnMs': ms(t1 - t),
+        'uiStallReceivingMs': bStall1,
+        'handOverToMainMs': ms(t2 - t1),
+        'uiEncodeSyncMs': (encodeMs * 100).round() / 100,
+        'uiStallSendingMs': bStall2,
+        'totalMs': ms(t2 - t),
+      });
+
+      // C. parse and reduce on the worker, move 50 small records.
+      t = now();
+      final (v2, cStall) = await withHeartbeat(() => wch.call('parseReduce', {'s': json}));
+      final t3 = now();
+      await ch.call('bench', {'cmd': 'recv', 'data': v2});
+      emit(s, 'json_worker_reduced_transfer', {
+        ...tag,
+        'workerMs': ms(t3 - t),
+        'handOverToMainMs': ms(now() - t3),
+        'uiStallMs': cStall,
+        'totalMs': ms(now() - t),
+      });
+
+      // D. the worker's own parse time, and whether it really runs beside a busy main engine.
+      final alone = await wch.call('parseTimed', {'s': json}) as Map;
+      final busyF = ch.call('bench', {'cmd': 'busy', 'ms': 400});
+      await Future<void>.delayed(const Duration(milliseconds: 20));
+      t = now();
+      final beside = await wch.call('parseTimed', {'s': json}) as Map;
+      final besideWall = ms(now() - t);
+      await busyF;
+      emit(s, 'json_worker_parallel', {
+        ...tag,
+        'workerParseAloneMs': alone['ms'],
+        'workerParseWhileMainBusyMs': beside['ms'],
+        'wallWhileMainBusyMs': besideWall,
+      });
+
+      // E. string transfer only: what it costs to hand the text to an engine.
+      t = now();
+      await wch.call('noop', {'s': json});
+      emit(s, 'json_string_handover', {...tag, 'totalMs': ms(now() - t)});
+    }
+  }
+}
