+/**
+ * `<tag {...props} />`: what every wrapper component (View, Text, the ones
+ * `fuse gen` writes) compiles to.
+ *
+ * @solidjs/universal's `spread` creates three render effects per element
+ * whatever the props are: one for `children`, one for `ref`, one that copies
+ * every prop and diffs it against the previous copy. An effect costs about
+ * 10 µs to create in QuickJS, so that was 35 to 50 µs per element, most of the
+ * JS cost of a mount. A props object written in JSX is a plain object whose
+ * dynamic expressions are getters, so the work can be decided per key:
+ *
+ * - a data property cannot change: set it now, no effect;
+ * - getters share one effect (same granularity as before);
+ * - `children` and `ref` get their effect only if present, and only a getter
+ *   `children` needs a tracking scope at all.
+ *
+ * Proxy-backed props (a store, or `mergeProps` over a function source) can
+ * gain and lose keys, so they keep the universal implementation.
+ */
+function spread(node: FuseNode, props: any, skipChildren?: boolean): void {
+  if (!props) return;
+  if (props[$PROXY]) {
