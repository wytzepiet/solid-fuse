index 0000000..b223486
--- /dev/null
+++ b/examples/perf_bench/src/index.tsx
@@ -0,0 +1,240 @@
+// perf_bench: JS side of the measurement spike (experiments/interop/reports/10-js-thread.md).
+// Dart (dart/lib/main.dart) drives everything through one channel, `bench`.
+import {
+  render, View, Text, ScrollView, For, Navigator, createNavigationController, channels, flushOps, setProp,
+  type FuseNode,
+} from "solid-fuse";
+import { createSignal } from "solid-js";
+import { now, clockKind, stats, timed, busy } from "./harness";
+import {
+  MountScreen, UpdateScreen, ListScreen, cardsFor, makeRows, makeJson, rows, setRows, rnd,
+  t1, setT1, t50, setT50, t1000, setT1000, c1, setC1, c50, setC50, c1000, setC1000,
+} from "./screens";
+import { BoxNaive, BoxJsx, BoxFine, DartBox, BoxC3, BoxC6, BoxC12, tone } from "./box";
+import { DragScreen, ScrollLinkedScreen, TextScreen, bgItems, setBgItems } from "./interact";
+
+const Empty = () => <View />;
+const [screen, setScreenRaw] = createSignal<{ render: () => any }>({ render: Empty });
+// (a function passed to createSignal or to a setter is treated as a compute/updater, hence the wrapper)
+const setScreen = (render: () => any) => setScreenRaw({ render });
+const nav = createNavigationController({ initialPage: () => <View>{screen().render()}</View> });
+render(() => <Navigator controller={nav} />);
+
+// ---- part 2 use sites --------------------------------------------------------------
+
+const [bg, setBg] = createSignal("surface");
+const [pad, setPad] = createSignal(12);
+const [op, setOp] = createSignal(0.9);
+
+type Variant = "direct" | "dart" | "naive" | "jsx" | "fine" | "composed";
+const WRAPPERS: Record<string, (p: any) => any> = { dart: DartBox, naive: BoxNaive, jsx: BoxJsx, fine: BoxFine };
+const COMPOSED: Record<number, (p: any) => any> = { 3: BoxC3, 6: BoxC6, 12: BoxC12 };
+
+function boxItem(variant: Variant, level: number, i: number) {
+  const label = <Text fontSize={13}>{`Item ${i}`}</Text>;
+  if (variant === "direct") {
+    // What the app author writes today against the fat Dart View.
+    if (level === 3)
+      return <View padding={pad()} decoration={{ color: tone(bg()) }} flex={{ gap: 4 }}>{label}</View>;
+    if (level === 6)
+      return (
+        <View
+          padding={{ horizontal: 16, vertical: pad() }}
+          decoration={{ color: tone(bg()), borderRadius: 8, shadow: { color: "#00000022", blurRadius: 2, offsetY: 1 } }}
+          width={320} height={48} alignment="center" opacity={op()} flex={{ gap: 4 }}
+        >{label}</View>
+      );
+    return (
+      <View
+        padding={{ horizontal: 16, vertical: pad() }}
+        margin={{ bottom: 8 }}
+        decoration={{
+          color: tone(bg()), borderRadius: 8, border: { width: 1, color: "#dddddd" },
+          shadow: { color: "#00000022", blurRadius: 2, offsetY: 1 },
+        }}
+        width={320} height={56} minHeight={40} maxWidth={600} alignment="center" opacity={op()}
+        flex={{ direction: "horizontal", gap: 4, align: "center" }}
+      >{label}</View>
+    );
+  }
+  const V = variant === "composed" ? COMPOSED[level] : WRAPPERS[variant];
+  if (level === 3) return <V p={pad()} bg={bg()} gap={4}>{label}</V>;
+  if (level === 6)
+    return (
+      <V px={16} py={pad()} bg={bg()} radius="md" shadow="sm" w={320} h={48} center opacity={op()} gap={4}>{label}</V>
+    );
+  return (
+    <V
+      px={16} py={pad()} mb={8} bg={bg()} radius="md" shadow="sm" border borderColor="#dddddd"
+      w={320} h={56} minH={40} maxW={600} center opacity={op()} row gap={4} align="center"
+    >{label}</V>
+  );
+}
+
+function BoxScreen(p: { variant: Variant; level: number; n: number }) {
+  const items = Array.from({ length: p.n }, (_, i) => i);
+  return (
+    <ScrollView>
+      <View padding={8} flex={{ gap: 2 }}>
+        <For each={items}>{(i) => boxItem(p.variant, p.level, i)}</For>
+      </View>
+    </ScrollView>
+  );
+}
+
+// ---- part 4: setProp by value type ---------------------------------------------------
+
+let propNodes: FuseNode[] = [];
+function PropScreen() {
+  propNodes = [];
+  const items = Array.from({ length: 100 }, (_, i) => i);
+  return (
+    <ScrollView>
+      <View>
+        <For each={items}>{() => <View ref={(el: FuseNode) => propNodes.push(el)} height={1} />}</For>
+      </View>
+    </ScrollView>
+  );
+}
+const PROP_VALUES: Record<string, (i: number) => any> = {
+  number: (i) => i,
+  bool: (i) => i % 2 === 0,
+  string: (i) => "label " + i,
+  string1k: (i) => "x".repeat(1000) + i,
+  color: (i) => (i % 2 ? "#3366ff" : "#ff6633"),
+  padding4: (i) => ({ left: i, top: 2, right: 3, bottom: 4 }),
+  decoration: (i) => ({
+    color: "#ffffff", borderRadius: { topLeft: i, topRight: 2, bottomLeft: 3, bottomRight: 4 },
+    border: { top: { width: 1, color: "#e2e2e2" }, bottom: { width: 1, color: "#e2e2e2" } },
+    shadow: [{ color: "#00000022", blurRadius: 2, offsetX: 0, offsetY: 1 }],
+    gradient: { type: "linear", colors: ["#fff", "#eee"], begin: "topLeft", end: "bottomRight" },
+  }),
+  array100: (i) => Array.from({ length: 100 }, (_, k) => k + i),
+  function: () => () => {},
+};
+
+// ---- loads ------------------------------------------------------------------------------
+
+let loadOn = false;
+let loadCount = 0;
+function startLoad(busyMs: number, everyMs: number) {
+  loadOn = true;
+  loadCount = 0;
+  const tick = () => {
+    if (!loadOn) return;
+    const t = now();
+    busy(busyMs);
+    loadCount++;
+    setTimeout(tick, Math.max(0, everyMs - (now() - t)));
+  };
+  setTimeout(tick, 0);
+}
+
+const jsonCache: Record<string, string> = {};
+let parsedKeep: any;
+const range = (a: number, b: number) => Array.from({ length: b - a }, (_, i) => a + i);
+const yieldToLoop = () => new Promise<void>((r) => setTimeout(r, 0));
+
+// ---- command table -------------------------------------------------------------------
+
+const cmds: Record<string, (a: any) => any> = {
+  info: () => ({ clock: clockKind, t: now() }),
+  detail: (a) => { stats.detail = !!a.on; return {}; },
+  clear: () => timed(() => setScreen(Empty)),
+
+  // part 1
+  mount: (a) => timed(() => setScreen(() => <MountScreen cards={cardsFor(a.nodes)} />), { cards: cardsFor(a.nodes) }),
+  updPrep: () => timed(() => setScreen(() => <UpdateScreen />)),
+  upd: (a) => {
+    const set = ({ t1: setT1, t50: setT50, t1000: setT1000, c1: setC1, c50: setC50, c1000: setC1000 } as any)[a.sig];
+    const get = ({ t1, t50, t1000, c1, c50, c1000 } as any)[a.sig];
+    const next = get() + 1;
+    return timed(() => set(next));
+  },
+  listPrep: (a) => timed(() => { setRows(makeRows(a.n)); setScreen(() => <ListScreen />); }),
+  listReplace: (a) => { const next = makeRows(a.n); return timed(() => setRows(next)); },
+  listShuffle: () => {
+    const next = rows().map((r) => ({ r, k: rnd() })).sort((x, y) => x.k - y.k).map((x) => x.r);
+    return timed(() => setRows(next));
+  },
+  listSort: () => {
+    // includes the sort itself, as an app would do it
+    return timed(() => setRows(rows().slice().sort((x, y) => x.value - y.value)));
+  },
+  listReverse: () => timed(() => setRows(rows().slice().reverse())),
+  listFilter: () => timed(() => setRows(rows().filter((r) => r.value % 2 === 0))),
+  listNames: () => ({ names: rows().map((r) => r.name) }),
+  jsonPrep: (a) => { jsonCache[a.kb] = makeJson(a.kb * 1024); return { len: jsonCache[a.kb].length }; },
+  jsonParse: (a) => { const s = jsonCache[a.kb]; return timed(() => { parsedKeep = JSON.parse(s); }, { len: s.length, items: 0 }); },
+  jsonStringify: (a) => { const v = JSON.parse(jsonCache[a.kb]); let n = 0; return timed(() => { n = JSON.stringify(v).length; }, { len: n }); },
+  navPush: (a) => timed(() => { nav.push(() => <MountScreen cards={cardsFor(a.nodes)} />); }),
+  navPop: () => timed(() => nav.pop()),
+
+  // part 2
+  boxMount: (a) => timed(() => setScreen(() => <BoxScreen variant={a.variant} level={a.level} n={a.n} />)),
+  boxUpd: (a) => {
+    if (a.prop === "bg") { const v = bg() === "surface" ? "muted" : "surface"; return timed(() => setBg(v)); }
+    if (a.prop === "pad") { const v = pad() === 12 ? 14 : 12; return timed(() => setPad(v)); }
+    const v = op() === 0.9 ? 0.8 : 0.9;
+    return timed(() => setOp(v));
+  },
+
+  // part 4
+  echo: (a) => a.v,
+  rtJsToDart: async (a) => {
+    const t0 = now();
+    for (let i = 0; i < a.n; i++) await channels.call("benchEcho", { v: i });
+    return { totalMs: now() - t0, n: a.n };
+  },
+  propsPrep: () => timed(() => setScreen(() => <PropScreen />)),
+  props: (a) => {
+    const make = PROP_VALUES[a.type];
+    const values = Array.from({ length: a.n }, (_, i) => make(i));
+    const nodes = propNodes;
+    return timed(() => {
+      for (let i = 0; i < values.length; i++) setProp(nodes[i % nodes.length], "benchProp", values[i]);
+    });
+  },
+
+  // part 3
+  ixMount: (a) =>
+    timed(() => {
+      setBgItems([]);
+      const S = a.kind === "drag" ? DragScreen : a.kind === "scroll" ? ScrollLinkedScreen : TextScreen;
+      setScreen(() => <S owner={a.owner} />);
+    }),
+  loadStart: (a) => { startLoad(a.busyMs, a.everyMs); return {}; },
+  loadStop: () => { loadOn = false; return { ticks: loadCount }; },
+  busy: (a) => { busy(a.ms); return {}; },
+
+  // part 5
+  bulkMount: (a) => timed(() => setBgItems(range(0, a.cards))),
+  chunkMount: async (a) => {
+    const t0 = now();
+    let sum = 0, max = 0, slices = 0;
+    for (let i = 0; i < a.cards; i += a.chunk) {
+      const s = now();
+      const add = range(i, Math.min(i + a.chunk, a.cards));
+      setBgItems((prev) => prev.concat(add));
+      flushOps();
+      const d = now() - s;
+      sum += d; if (d > max) max = d; slices++;
+      await yieldToLoop();
+    }
+    return { totalMs: now() - t0, jsMs: sum, maxSliceMs: max, slices };
+  },
+  bgClear: () => timed(() => setBgItems([])),
+  recv: (a) => ({ n: Array.isArray(a.data) ? a.data.length : -1 }),
+  parseStr: (a) => timed(() => { parsedKeep = JSON.parse(a.s); }),
+};
+
+channels.on("bench", async (d: any) => {
+  const fn = cmds[d.cmd];
+  if (!fn) return { error: "unknown cmd " + d.cmd };
+  try {
+    return await fn(d);
+  } catch (e: any) {
+    return { error: String(e && e.stack ? e.stack : e) };
+  }
+});
+channels.send("benchReady", {});
