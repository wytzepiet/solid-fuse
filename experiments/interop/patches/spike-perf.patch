--- /dev/null
+++ b/examples/perf_bench/tools/agg11.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Report 11 tables from `core` suite BENCH lines.
+
+    python3 tools/agg11.py results/r11/core-a.txt [core-b.txt ...]     # one table per file
+    python3 tools/agg11.py --cmp results/r11/core-a.txt core-b.txt ...  # medians side by side
+
+Cells are median (min-max) in ms over the timing reps (the `detail` pass is
+used only for op counts and bytes). "UI" is decode + apply + frame build.
+"""
+import json, sys, os
+from statistics import median
+
+ORDER = ["mount_200", "mount_1000", "mount_5000", "list_replace_500", "update_t1", "update_t50",
+         "update_t1000", "update_c1000", "list_sort_2000", "list_shuffle_2000", "list_reverse_2000",
+         "list_filter_2000_to_1000"]
+
+def load(path):
+    recs = {}
+    checks = [0, 0]
+    loads = []
+    for line in open(path):
+        if not line.startswith("BENCH {"):
+            continue
+        d = json.loads(line[6:])
+        if d.get("suite") != "core":
+            continue
+        if d["name"] == "list_order_check":
+            checks[1] += 1
+            checks[0] += 1 if d.get("dartTreeMatchesJs") else 0
+            continue
+        try:
+            loads.append(float(d.get("load")))
+        except (TypeError, ValueError):
+            pass
+        recs.setdefault(d["name"], []).append(d)
+    return recs, checks, loads
+
+def ui(d):
+    if "uiFrameMs" not in d:
+        return None
+    return d.get("decodeMs", 0) + d.get("applyMs", 0) + d["uiFrameMs"]
+
+def col(rs, fn):
+    v = [fn(r) for r in rs if not r.get("detail")]
+    v = [x for x in v if isinstance(x, (int, float))]
+    return v
+
+def fmt(v, rng=True):
+    if not v:
+        return "–"
+    m = median(v)
+    nd = 0 if m >= 100 else (1 if m >= 10 else 2)
+    s = f"{m:.{nd}f}"
+    if rng:
+        s += f" ({min(v):.{nd}f}–{max(v):.{nd}f})"
+    return s
+
+COLS = [("JS", lambda d: d.get("jsMs")), ("bridge_call", lambda d: d.get("sendMs")),
+        ("decode", lambda d: d.get("decodeMs")), ("apply", lambda d: d.get("applyMs")),
+        ("frame", lambda d: d.get("uiFrameMs")), ("UI", ui), ("e2e", lambda d: d.get("e2eMs"))]
+
+def one(path):
+    recs, checks, loads = load(path)
+    print(f"### {os.path.basename(path)}  (load {min(loads):.2f}–{max(loads):.2f}, order checks {checks[0]}/{checks[1]})\n")
+    print("| Operation | ops | bytes | n | " + " | ".join(c for c, _ in COLS) + " |")
+    print("|---|---:|---:|---:|" + "---:|" * len(COLS))
+    for name in ORDER:
+        rs = recs.get(name)
+        if not rs:
+            continue
+        det = [r for r in rs if r.get("detail")]
+        ops = det[0].get("ops") if det else rs[0].get("ops")
+        by = det[0].get("bytes") if det else None
+        n = len([r for r in rs if not r.get("detail")])
+        print(f"| {name} | {ops} | {by if by is not None else '–'} | {n} | " + " | ".join(fmt(col(rs, fn)) for _, fn in COLS) + " |")
+    print()
+
+def cmp(paths):
+    data = [load(p) for p in paths]
+    names = [os.path.basename(p).replace("core-", "").replace(".txt", "") for p in paths]
+    for title, fn in [("JS task ms", lambda d: d.get("jsMs")), ("UI thread ms (decode+apply+frame)", ui),
+                      ("End to end ms", lambda d: d.get("e2eMs"))]:
+        print(f"**{title}** (median)\n")
+        print("| Operation | " + " | ".join(names) + " |")
+        print("|---|" + "---:|" * len(names))
+        for name in ORDER:
+            if not any(name in d[0] for d in data):
+                continue
+            print(f"| {name} | " + " | ".join(fmt(col(d[0].get(name, []), fn), False) for d in data) + " |")
+        print()
+    print("| | " + " | ".join(names) + " |")
+    print("|---|" + "---:|" * len(names))
+    print("| load avg | " + " | ".join(f"{min(d[2]):.2f}–{max(d[2]):.2f}" for d in data) + " |")
+    print("| order checks | " + " | ".join(f"{d[1][0]}/{d[1][1]}" for d in data) + " |")
+
+if sys.argv[1] == "--cmp":
+    cmp(sys.argv[2:])
+else:
+    for p in sys.argv[1:]:
+        one(p)
