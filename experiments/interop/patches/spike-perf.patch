+    const isDynamic = !desc || desc.get !== undefined;
+    if (key === "children") {
+      if (!skipChildren) insert(node, isDynamic ? () => props.children : props.children);
+    } else if (key === "ref") {
+      if (isDynamic) {
+        effect(() => {
+          const r = props.ref;
+          (typeof r === "function" || Array.isArray(r)) && ref(() => r, node);
+        }, () => {});
+      } else {
+        const r = props.ref;
+        if (typeof r === "function" || Array.isArray(r)) ref(() => r, node);
+      }
+    } else if (isDynamic) {
+      (dynamic ??= []).push(key);
+    } else {
+      setProp(node, key, props[key]);
+    }
+  }
+  if (dynamic) {
+    const keys = dynamic;
+    const prev: Record<string, any> = {};
+    effect(
+      () => {
+        const next: Record<string, any> = {};
+        for (let i = 0; i < keys.length; i++) next[keys[i]] = props[keys[i]];
+        return next;
+      },
+      (next: Record<string, any>) => {
+        for (let i = 0; i < keys.length; i++) {
+          const key = keys[i];
+          const value = next[key];
+          if (value === prev[key]) continue;
+          setProp(node, key, value, prev[key]);
+          prev[key] = value;
+        }
+      },
