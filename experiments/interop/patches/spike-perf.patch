+      sum += d; if (d > max) max = d; slices++;
+      await channels.call("benchFrame", {});
+    }
+    return { totalMs: now() - t0, jsMs: sum, maxSliceMs: max, slices };
+  },
   bgClear: () => timed(() => setBgItems([])),
   recv: (a) => ({ n: Array.isArray(a.data) ? a.data.length : -1 }),
   parseStr: (a) => timed(() => { parsedKeep = JSON.parse(a.s); }),
