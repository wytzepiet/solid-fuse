@@ -0,0 +1,67 @@
+// perf_bench: Dart driver of the measurement spike
+// (experiments/interop/reports/10-js-thread.md). Runs the suites named in
+// $BENCH (comma separated: part1,part2,part3,part4,part5; default all), prints
+// one `BENCH {json}` line per measurement and exits.
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+import '_generated/fuse_packages.dart';
+import 'bench_widgets.dart';
+import 'harness.dart';
+import 'suite_basic.dart';
+import 'suite_interact.dart';
+
+void main() async {
+  WidgetsFlutterBinding.ensureInitialized();
+  rt = await FuseRuntime.create();
+  registerFusePackages(rt);
+  registerBenchWidgets(rt);
+  await rt.start();
+  ch = rt.perfChannels!;
+  ch.on('benchEcho', (d) => d['v']);
+  installHooks();
+  runApp(MaterialApp(
+    debugShowCheckedModeBanner: false,
+    home: Material(child: FuseView(runtime: rt)),
+  ));
+  await SchedulerBinding.instance.endOfFrame;
+  await settle(500);
+
+  final info = await cmd('info');
+  final view = WidgetsBinding.instance.platformDispatcher.views.first;
+  emit('meta', 'env', {
+    'jsClock': info['clock'],
+    'cores': Platform.numberOfProcessors,
+    'dart': Platform.version.split(' ').first,
+    'window': '${view.physicalSize.width.round()}x${view.physicalSize.height.round()}@${view.devicePixelRatio}',
+    'refreshHz': view.display.refreshRate,
+  });
+
+  final suites = (env['BENCH'] ?? 'part1,part2,part3,part4,part5').split(',');
+  final all = <String, Future<void> Function()>{
+    'part1': part1,
+    'part2': part2,
+    'part3': part3,
+    'part4': part4,
+    'part5': part5,
+    'smoke': smoke,
+  };
+  for (final s in suites) {
+    final fn = all[s.trim()];
+    if (fn == null) continue;
+    try {
+      await fn();
+    } catch (e, st) {
+      // ignore: avoid_print
+      print('BENCH_ERROR suite $s: $e\n$st');
+    }
+    await flushPending();
+  }
+  // ignore: avoid_print
+  print('BENCH_DONE');
+  exit(0);
+}
diff --git a/examples/perf_bench/dart/lib/suite_basic.dart b/examples/perf_bench/dart/lib/suite_basic.dart
new file mode 100644
index 0000000..ff06be4
--- /dev/null
+++ b/examples/perf_bench/dart/lib/suite_basic.dart
@@ -0,0 +1,271 @@
+// Parts 1, 2 and 4: JS task lengths, the cost of a TS layer, the bridge itself.
+import 'dart:async';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:solid_fuse/fjs.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+import 'harness.dart';
+
+Future<void> smoke() async {
+  await cmd('clear');
+  for (final n in [50, 1000]) {
+    await measure('smoke', 'mount_$n', 'mount', {'nodes': n});
+    await settle();
+    await cmd('clear');
+    await settle();
+  }
+}
+
+// ---- part 1 -------------------------------------------------------------------
+
+/// After sort/shuffle/reverse/filter: is the Dart node tree in the order JS thinks it is?
+Future<void> checkListOrder(String suite, Map<String, dynamic> x) async {
+  final want = ((await cmd('listNames'))['names'] as List).cast<String>();
+  FuseNode? list;
+  void visit(FuseNode n) {
+    if (list != null) return;
+    if (n.children.length == want.length && want.length > 1) {
+      list = n;
+      return;
+    }
+    n.children.forEach(visit);
+    for (final v in n.props.values) {
+      if (v is FuseNode) visit(v);
+    }
+  }
+
