+  fuse_generated.registerFuseGenerated(runtime);
+}
diff --git a/examples/perf_bench/dart/lib/bench_widgets.dart b/examples/perf_bench/dart/lib/bench_widgets.dart
new file mode 100644
index 0000000..70d846e
--- /dev/null
+++ b/examples/perf_bench/dart/lib/bench_widgets.dart
@@ -0,0 +1,219 @@
+// Bench-only native widgets (report 10-js-thread).
+//
+//   benchBox           part 2: the curated "Box" with friendly props mapped in Dart
+//   benchProbe         exposes a render box by name so the driver can read where it is
+//   benchSpinner       a Flutter-owned animation that keeps frames coming
+//   benchDragBox       part 3: draggable box, pan handled entirely in Dart
+//   benchShrinkHeader  part 3: header whose height follows a ScrollController in Dart
+//   benchUpperField    part 3: text field that uppercases with a TextInputFormatter
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+void registerBenchWidgets(FuseRuntime runtime) {
+  runtime.registerWidget('benchBox', BenchBox.new);
+  runtime.registerWidget('benchProbe', BenchProbe.new);
+  runtime.registerWidget('benchSpinner', (_) => const BenchSpinner());
+  runtime.registerWidget('benchDragBox', BenchDragBox.new);
+  runtime.registerWidget('benchShrinkHeader', BenchShrinkHeader.new);
+  runtime.registerWidget('benchUpperField', (_) => const BenchUpperField());
+}
+
+/// The curated layer written in Dart: same vocabulary as `BoxProps` in
+/// src/box.tsx, same widget layering as FuseViewWidget.
+class BenchBox extends StatelessWidget {
+  const BenchBox(this.node, {super.key});
+  final FuseNode node;
+
+  static const _tones = <String, Color>{
+    'surface': Color(0xFFFFFFFF),
+    'muted': Color(0xFFF2F3F5),
+    'primary': Color(0xFF3366FF),
+    'danger': Color(0xFFD64545),
+    'success': Color(0xFF2E9E5B),
+  };
+  static const _radii = <String, double>{'none': 0, 'sm': 4, 'md': 8, 'lg': 16, 'full': 999};
+  static const _shadows = <String, BoxShadow>{
+    'sm': BoxShadow(color: Color(0x22000000), blurRadius: 2, offset: Offset(0, 1)),
+    'md': BoxShadow(color: Color(0x33000000), blurRadius: 6, offset: Offset(0, 2)),
+    'lg': BoxShadow(color: Color(0x44000000), blurRadius: 16, offset: Offset(0, 6)),
+  };
+
+  @override
+  Widget build(BuildContext context) {
+    final p = node.double('p'), px = node.double('px'), py = node.double('py');
+    final EdgeInsets? padding = (px == null && py == null)
+        ? (p == null ? null : EdgeInsets.all(p))
+        : EdgeInsets.symmetric(horizontal: px ?? p ?? 0, vertical: py ?? p ?? 0);
+
+    final m = node.double('m'), mb = node.double('mb');
+    final EdgeInsets? margin = mb == null
+        ? (m == null ? null : EdgeInsets.all(m))
+        : EdgeInsets.fromLTRB(m ?? 0, m ?? 0, m ?? 0, mb);
+
+    final bgRaw = node.props['bg'];
+    final Color? bg = bgRaw is String ? (_tones[bgRaw] ?? node.color('bg')) : null;
+    final rRaw = node.props['radius'];
+    final double? radius = rRaw is num ? rRaw.toDouble() : (rRaw is String ? _radii[rRaw] : null);
+    final bRaw = node.props['border'];
+    final double? borderWidth = bRaw == true ? 1 : (bRaw is num ? bRaw.toDouble() : null);
+    final shadow = _shadows[node.string('shadow')];
+    final BoxDecoration? decoration = (bg == null && radius == null && borderWidth == null && shadow == null)
+        ? null
+        : BoxDecoration(
+            color: bg,
+            borderRadius: radius == null ? null : BorderRadius.circular(radius),
+            border: borderWidth == null
+                ? null
+                : Border.all(width: borderWidth, color: node.color('borderColor') ?? const Color(0xFFD0D0D0)),
+            boxShadow: shadow == null ? null : [shadow],
+          );
+
+    final wRaw = node.props['w'];
+    final double? width = wRaw == 'full' ? double.infinity : (wRaw is num ? wRaw.toDouble() : null);
+    final height = node.double('h');
+    final minH = node.double('minH'), maxW = node.double('maxW');
+
+    // children: same rule as FuseNode.flexChildren
+    final row = node.bool('row') ?? false;
+    final gap = node.double('gap') ?? 0;
+    final crossAxis = switch (node.string('align')) {
+      'center' => CrossAxisAlignment.center,
+      'end' => CrossAxisAlignment.end,
+      'stretch' => CrossAxisAlignment.stretch,
+      _ => CrossAxisAlignment.start,
+    };
+    final justify = node.string('justify');
+    final mainAxis = switch (justify) {
+      'center' => MainAxisAlignment.center,
+      'end' => MainAxisAlignment.end,
+      'between' => MainAxisAlignment.spaceBetween,
+      _ => MainAxisAlignment.start,
+    };
+    final c = node.childWidgets;
+    Widget result;
+    if (c.length == 1 && mainAxis == MainAxisAlignment.start && crossAxis == CrossAxisAlignment.start) {
+      result = c.first;
+    } else {
+      result = Flex(
+        direction: row ? Axis.horizontal : Axis.vertical,
+        mainAxisSize: (justify != null && justify != 'start') ? MainAxisSize.max : MainAxisSize.min,
+        mainAxisAlignment: mainAxis,
+        crossAxisAlignment: crossAxis,
+        spacing: gap,
+        children: c,
+      );
+    }
+
+    if (padding != null) result = Padding(padding: padding, child: result);
+    if (node.bool('center') ?? false) result = Align(alignment: Alignment.center, child: result);
+    if (decoration != null) result = DecoratedBox(decoration: decoration, child: result);
+    if (width != null || height != null) result = SizedBox(width: width, height: height, child: result);
+    if (minH != null || maxW != null) {
+      result = ConstrainedBox(
+        constraints: BoxConstraints(minHeight: minH ?? 0, maxWidth: maxW ?? double.infinity),
+        child: result,
+      );
+    }
+    final opacity = node.double('opacity');
+    if (opacity != null) result = Opacity(opacity: opacity.clamp(0.0, 1.0), child: result);
+    if (margin != null) result = Padding(padding: margin, child: result);
+    if (node.bool('hidden') ?? false) result = Visibility(visible: false, child: result);
+    return result;
+  }
+}
+
+class BenchProbe extends StatelessWidget {
+  const BenchProbe(this.node, {super.key});
+  final FuseNode node;
+  static final keys = <String, GlobalKey>{};
+
+  static RenderBox? box(String name) {
+    final ro = keys[name]?.currentContext?.findRenderObject();
+    return ro is RenderBox && ro.attached && ro.hasSize ? ro : null;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final key = keys.putIfAbsent(node.string('name') ?? '', GlobalKey.new);
+    return node.children.isEmpty
+        ? SizedBox.expand(key: key)
+        : KeyedSubtree(key: key, child: node.flexChildren);
+  }
+}
+
+class BenchSpinner extends StatefulWidget {
+  const BenchSpinner({super.key});
+  @override
+  State<BenchSpinner> createState() => _BenchSpinnerState();
+}
+
+class _BenchSpinnerState extends State<BenchSpinner> with SingleTickerProviderStateMixin {
+  late final AnimationController _c =
+      AnimationController(vsync: this, duration: const Duration(seconds: 1))..repeat();
+  @override
+  void dispose() {
+    _c.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => RotationTransition(
+        turns: _c,
+        child: const SizedBox(width: 24, height: 24, child: ColoredBox(color: Color(0xFFE08A00))),
+      );
+}
+
+class BenchDragBox extends StatefulWidget {
+  const BenchDragBox(this.node, {super.key});
+  final FuseNode node;
+  @override
+  State<BenchDragBox> createState() => _BenchDragBoxState();
+}
+
+class _BenchDragBoxState extends State<BenchDragBox> {
+  Offset _offset = Offset.zero;
+  @override
+  Widget build(BuildContext context) => Transform.translate(
+        offset: _offset,
+        child: GestureDetector(
+          onPanUpdate: (d) => setState(() => _offset += d.delta),
+          child: widget.node.flexChildren,
+        ),
+      );
+}
+
+class BenchShrinkHeader extends StatelessWidget {
+  const BenchShrinkHeader(this.node, {super.key});
+  final FuseNode node;
+  @override
+  Widget build(BuildContext context) {
+    final controller = node.handle<ScrollController>('controller');
+    final max = node.double('max') ?? 200, min = node.double('min') ?? 60;
+    final child = DecoratedBox(
+      decoration: const BoxDecoration(color: Color(0xFF3366FF)),
+      child: node.flexChildren,
+    );
+    if (controller == null) return SizedBox(height: max, child: child);
+    return AnimatedBuilder(
+      animation: controller,
+      builder: (context, child) => SizedBox(
+        height: (max - (controller.hasClients ? controller.offset : 0)).clamp(min, max).toDouble(),
+        child: child,
+      ),
+      child: child,
+    );
+  }
+}
+
+class _UpperCase extends TextInputFormatter {
+  @override
+  TextEditingValue formatEditUpdate(TextEditingValue oldValue, TextEditingValue newValue) =>
+      newValue.copyWith(text: newValue.text.toUpperCase());
+}
+
+class BenchUpperField extends StatelessWidget {
+  const BenchUpperField({super.key});
+  @override
+  Widget build(BuildContext context) => TextField(inputFormatters: [_UpperCase()]);
+}
diff --git a/examples/perf_bench/dart/lib/harness.dart b/examples/perf_bench/dart/lib/harness.dart
new file mode 100644
index 0000000..b59f794
--- /dev/null
+++ b/examples/perf_bench/dart/lib/harness.dart
@@ -0,0 +1,251 @@
+// Driver plumbing for the measurement spike (report 10-js-thread).
+import 'dart:async';
+import 'dart:convert';
+import 'dart:developer' show Timeline;
+import 'dart:io';
+import 'dart:ui' show FramePhase, FrameTiming;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/gestures.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/widgets.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+late FuseRuntime rt;
+late FuseChannels ch;
+
+const buildMode = kReleaseMode ? 'release' : (kProfileMode ? 'profile' : 'debug');
+final env = Platform.environment;
+int envInt(String k, int d) => int.tryParse(env[k] ?? '') ?? d;
+
+String loadavg() {
+  try {
+    return File('/proc/loadavg').readAsStringSync().split(' ').first;
+  } catch (_) {
+    return '?';
+  }
+}
+
+int now() => Timeline.now; // microseconds, monotonic; same clock as FrameTiming
+double ms(num micros) => (micros / 10).round() / 100;
+
+void emit(String suite, String name, Map<String, dynamic> data) {
+  // ignore: avoid_print
+  print('BENCH ${jsonEncode({'suite': suite, 'name': name, 'mode': buildMode, 'load': loadavg(), ...data})}');
+}
+
+Future<Map<String, dynamic>> cmd(String c, [Map<String, dynamic> a = const {}]) async {
+  final r = await ch.call('bench', {'cmd': c, ...a});
+  final m = r is Map ? Map<String, dynamic>.from(r) : <String, dynamic>{'value': r};
+  if (m['error'] != null) {
+    // ignore: avoid_print
+    print('BENCH_ERROR $c $a: ${m['error']}');
+  }
+  return m;
+}
+
+Future<void> settle([int millis = 60]) async {
+  await Future<void>.delayed(Duration(milliseconds: millis));
+  await SchedulerBinding.instance.endOfFrame;
+}
+
+// ---- frame timings ------------------------------------------------------------
+
+final frameTimings = <FrameTiming>[];
+
+Map<String, dynamic> frameStats(int from, int to) {
+  final fs = frameTimings
+      .where((f) =>
+          f.timestampInMicroseconds(FramePhase.buildStart) >= from &&
+          f.timestampInMicroseconds(FramePhase.buildStart) <= to)
+      .toList()
+    ..sort((a, b) => a
+        .timestampInMicroseconds(FramePhase.vsyncStart)
+        .compareTo(b.timestampInMicroseconds(FramePhase.vsyncStart)));
+  if (fs.isEmpty) return {'frames': 0};
+  final build = fs.map((f) => f.buildDuration.inMicroseconds).toList()..sort();
+  final raster = fs.map((f) => f.rasterDuration.inMicroseconds).toList()..sort();
+  var missed = 0, maxGap = 0, lateBuild = 0, lateTotal = 0;
+  for (var i = 0; i < fs.length; i++) {
+    if (fs[i].buildDuration.inMicroseconds > 16667) lateBuild++;
+    if (fs[i].totalSpan.inMicroseconds > 16667) lateTotal++;
+    if (i == 0) continue;
+    final gap = fs[i].timestampInMicroseconds(FramePhase.vsyncStart) -
+        fs[i - 1].timestampInMicroseconds(FramePhase.vsyncStart);
+    if (gap > maxGap) maxGap = gap;
+    if (gap > 25000) missed += (gap / 16667).round() - 1;
+  }
+  return {
+    'frames': fs.length,
+    'missedVsyncs': missed,
+    'maxFrameGapMs': ms(maxGap),
+    'buildP50Ms': ms(build[build.length ~/ 2]),
+    'buildMaxMs': ms(build.last),
+    'rasterP50Ms': ms(raster[raster.length ~/ 2]),
+    'rasterMaxMs': ms(raster.last),
+    'buildOver16': lateBuild,
+    'spanOver16': lateTotal,
+  };
+}
+
+/// FrameTiming batches are delivered up to a second late in release builds.
+Future<void> flushTimings() => Future<void>.delayed(const Duration(milliseconds: 1300));
+
+// ---- one timed JS operation, followed to the frame ------------------------------
+
+int _lastBeat = 0;
+
+class Run {
+  int ops = 0, batches = 0, applyUs = 0, maxStall = 0, preRecvStall = 0;
+  int? recv, applyEnd, frameStart, frameEnd;
+  final done = Completer<void>();
+}
+
+Run? _current;
+
+void installHooks() {
+  SchedulerBinding.instance.addTimingsCallback(frameTimings.addAll);
+  SchedulerBinding.instance.addPersistentFrameCallback((_) => sampler?.call(now()));
+  FuseRuntime.perfOnOps = (n, recv, apply) {
+    final m = _current;
+    if (m == null) return;
+    m.ops += n;
+    m.batches++;
+    m.applyUs += apply;
+    m.applyEnd = recv + apply;
+    if (m.recv == null) {
+      m.recv = recv;
+      // How long this event-loop turn had already run before applyOps started:
+      // receiving and decoding the op batch on the UI isolate.
+      m.preRecvStall = recv - _lastBeat;
+      SchedulerBinding.instance.scheduleFrameCallback((_) => m.frameStart = now());
+      SchedulerBinding.instance.addPostFrameCallback((_) {
+        m.frameEnd = now();
+        if (!m.done.isCompleted) m.done.complete();
+      });
+    }
+  };
+}
+
+/// Called after build/layout/paint of every frame (interaction suites).
+void Function(int t)? sampler;
+
+class Pending {
+  Pending(this.suite, this.name, this.data, this.from, this.to);
+  final String suite, name;
+  final Map<String, dynamic> data;
+  final int from, to;
+}
+
+final pending = <Pending>[];
+
+/// Emit everything collected so far, with raster/build figures joined from FrameTiming.
+Future<void> flushPending() async {
+  await flushTimings();
+  for (final p in pending) {
+    emit(p.suite, p.name, {...p.data, 'ft': frameStats(p.from, p.to)});
+  }
+  pending.clear();
+}
+
+/// Runs a JS command that reports {jsMs, ops, ...} and follows its ops to the
+/// end of the Flutter frame that shows them.
+Future<Map<String, dynamic>> measure(
+  String suite,
+  String name,
+  String c, [
+  Map<String, dynamic> a = const {},
+  Map<String, dynamic> extra = const {},
+]) async {
+  final m = Run();
+  _current = m;
+  // 1 ms heartbeat: the longest gap is the longest the UI isolate was blocked.
+  _lastBeat = now();
+  final beat = Timer.periodic(const Duration(milliseconds: 1), (_) {
+    final n = now();
+    if (n - _lastBeat > m.maxStall) m.maxStall = n - _lastBeat;
+    _lastBeat = n;
+  });
+  final t0 = now();
+  final r = await cmd(c, a);
+  final t1 = now();
+  final nOps = (r['ops'] as num?)?.toInt() ?? 0;
+  if (nOps > 0) {
+    try {
+      await m.done.future.timeout(const Duration(seconds: 20));
+    } on TimeoutException {
+      // ignore: avoid_print
+      print('BENCH_ERROR $name: frame never arrived (ops seen ${m.ops}/$nOps)');
+    }
+  }
+  await Future<void>.delayed(const Duration(milliseconds: 2));
+  beat.cancel();
+  _current = null;
+  final data = <String, dynamic>{
+    ...extra,
+    ...r,
+    'load': loadavg(),
+    'callMs': ms(t1 - t0),
+    'uiMaxStallMs': ms(m.maxStall),
+    if (m.recv != null) ...{
+      'dartOps': m.ops,
+      'toRecvMs': ms(m.recv! - t0),
+      'applyMs': ms(m.applyUs),
+      'decodeMs': ms(m.preRecvStall),
+      if (m.frameStart != null) 'vsyncWaitMs': ms(m.frameStart! - m.applyEnd!),
+      if (m.frameStart != null && m.frameEnd != null) 'uiFrameMs': ms(m.frameEnd! - m.frameStart!),
+      if (m.frameEnd != null) 'e2eMs': ms(m.frameEnd! - t0),
+    },
+  };
+  pending.add(Pending(suite, name, data, m.applyEnd ?? t0, (m.frameEnd ?? t1) + 2000));
+  return data;
+}
+
+// ---- synthetic input --------------------------------------------------------------
+
+const _pointer = 7;
+Duration _ts() => Duration(microseconds: now());
+void ptrDown(Offset p) =>
+    GestureBinding.instance.handlePointerEvent(PointerDownEvent(pointer: _pointer, position: p, timeStamp: _ts()));
+void ptrMove(Offset p, Offset delta) => GestureBinding.instance
+    .handlePointerEvent(PointerMoveEvent(pointer: _pointer, position: p, delta: delta, timeStamp: _ts()));
+void ptrUp(Offset p) =>
+    GestureBinding.instance.handlePointerEvent(PointerUpEvent(pointer: _pointer, position: p, timeStamp: _ts()));
+
+T? findState<T extends State>() {
+  T? found;
+  void visit(Element e) {
+    if (found != null) return;
+    if (e is StatefulElement && e.state is T) {
+      found = e.state as T;
+      return;
+    }
+    e.visitChildren(visit);
+  }
+
+  WidgetsBinding.instance.rootElement?.visitChildren(visit);
+  return found;
+}
+
+// ---- small stats --------------------------------------------------------------------
+
+Map<String, dynamic> dist(List<num> xs, {String unit = 'Ms', double scale = 0.001}) {
+  if (xs.isEmpty) return {'n': 0};
+  final s = [...xs]..sort();
+  double q(double p) => (s[((s.length - 1) * p).round()] * scale * 100).round() / 100;
+  return {'n': s.length, 'p50$unit': q(0.5), 'p95$unit': q(0.95), 'max$unit': q(1), 'min$unit': q(0)};
+}
+
+/// Largest stall of the UI isolate's event loop while [body] runs (1 ms heartbeat).
+Future<(T, double)> withHeartbeat<T>(Future<T> Function() body) async {
+  var last = now(), maxGap = 0;
+  final t = Timer.periodic(const Duration(milliseconds: 1), (_) {
+    final n = now();
+    if (n - last > maxGap) maxGap = n - last;
+    last = n;
+  });
+  final r = await body();
+  await Future<void>.delayed(const Duration(milliseconds: 3));
+  t.cancel();
+  return (r, ms(maxGap));
+}
diff --git a/examples/perf_bench/dart/lib/main.dart b/examples/perf_bench/dart/lib/main.dart
new file mode 100644
index 0000000..85fcb98
