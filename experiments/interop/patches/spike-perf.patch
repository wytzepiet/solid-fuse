+        keys = [k for k in rs[0] if k.endswith("Ms")]
+        rows = [[kb, len(g)] + [mmm(g, k) for k in keys] + [loads(g)] for kb, g in group(rs, lambda r: r["kb"]).items()]
+        print(f"### {name}\n")
+        table(["payload KB", "runs"] + keys + ["load avg"], rows)
