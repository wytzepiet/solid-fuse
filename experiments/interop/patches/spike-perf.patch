From 97d8c627f71d6dffbe9c6f2b374a31d50c0539e5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 23:46:59 +0000
Subject: [PATCH 09/18] perf(renderer): send each op batch as one JSON string;
 Dart decodes with jsonDecode

---
 examples/perf_bench/src/harness.ts            | 11 ++++---
 examples/perf_bench/tools/run-in-bun.ts       |  2 +-
 packages/solid-fuse/dart/lib/src/runtime.dart | 17 ++++++++--
 packages/solid-fuse/src/renderer.ts           | 33 +++++++++++++++++--
 4 files changed, 54 insertions(+), 9 deletions(-)

diff --git a/examples/perf_bench/src/harness.ts b/examples/perf_bench/src/harness.ts
index 19c8813..bed5e3e 100644
--- a/examples/perf_bench/src/harness.ts
+++ b/examples/perf_bench/src/harness.ts
@@ -37,11 +37,14 @@ const origBridgeCall = fjs.bridge_call;
 fjs.bridge_call = function (msg: any) {
   if (msg && msg.channel === "_ops") {
     stats.batches++;
-    stats.ops += msg.ops.length;
-    if (keep.on) keep.lastOps = msg.ops;
