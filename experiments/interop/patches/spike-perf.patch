+#!/usr/bin/env bash
+# The full measurement set of report 10, one fresh process per suite (about 35 minutes).
+#   NICE=-10 tools/run-all.sh a      -> results/part{1..5}-a.txt
+set -uo pipefail
+cd "$(dirname "$0")/.."
+tag=${1:-a}
+tools/run.sh part1 7 results/part1-$tag.txt
+tools/run.sh part4 5 results/part4-$tag.txt
+tools/run.sh part2 5 results/part2-$tag.txt
+tools/run.sh part5 3 results/part5-$tag.txt
+tools/run.sh part3 3 results/part3-$tag.txt
