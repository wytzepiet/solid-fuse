+
+#[test]
+fn test_from_js_fast_path_keeps_exotic_objects() {
+    test_with(|ctx| {
+        crate::api::value::install_value_intrinsics(&ctx).unwrap();
+
+        let val: rquickjs::Value = ctx
+            .eval("({ a: 1, nested: { b: 'x', list: [1, { c: true }] } })")
+            .unwrap();
+        let JsValue::Object(map) = JsValue::from_js(&ctx, val).unwrap() else {
+            panic!("expected object");
+        };
+        assert!(matches!(map.get("a"), Some(JsValue::Integer(1))));
+        let Some(JsValue::Object(nested)) = map.get("nested") else {
+            panic!("expected nested object");
+        };
+        assert!(matches!(nested.get("b"), Some(JsValue::String(s)) if s == "x"));
+        assert!(matches!(nested.get("list"), Some(JsValue::Array(l)) if l.len() == 2));
+
+        // A class instance is an ordinary object.
+        let val: rquickjs::Value = ctx
+            .eval("(() => { class P { constructor() { this.x = 3; } } return new P(); })()")
+            .unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Object(m) if m.len() == 1));
+
+        // Objects with their own class still take the exotic path.
+        let val: rquickjs::Value = ctx.eval("new Date(1609459200000)").unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Date(1609459200000)));
+        let val: rquickjs::Value = ctx
+            .eval("(() => { class D extends Date {} return new D(1609459200000); })()")
+            .unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Date(1609459200000)));
+        let val: rquickjs::Value = ctx.eval("new Uint8Array([1, 2, 3]).buffer").unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Bytes(b) if b == vec![1, 2, 3]));
+        let val: rquickjs::Value = ctx.eval("new Uint8Array([4, 5])").unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Bytes(b) if b == vec![4, 5]));
+        let val: rquickjs::Value = ctx
+            .eval("new DataView(new Uint8Array([7, 8, 9]).buffer, 1, 2)")
+            .unwrap();
+        assert!(matches!(JsValue::from_js(&ctx, val).unwrap(), JsValue::Bytes(b) if b == vec![8, 9]));
+        let val: rquickjs::Value = ctx
+            .eval("({ data: new Uint8Array([1]), when: new Date(5) })")
+            .unwrap();
+        let JsValue::Object(map) = JsValue::from_js(&ctx, val).unwrap() else {
+            panic!("expected object");
+        };
+        assert!(matches!(map.get("data"), Some(JsValue::Bytes(b)) if b == &vec![1]));
+        assert!(matches!(map.get("when"), Some(JsValue::Date(5))));
+    });
+}
