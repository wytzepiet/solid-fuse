new file mode 100644
index 0000000..6ae7bce
--- /dev/null
+++ b/packages/solid-fuse/cli/inline-wrappers-plugin.ts
@@ -0,0 +1,68 @@
+// Babel plugin: compile solid-fuse's built-in wrapper components as the
+// intrinsic elements they stand for.
+//
+// `View`, `Text`, ... are one-line components: `(props) => <view {...props} />`.
+// Going through them costs a component call plus a runtime `spread` of the
+// props object for every element, and hides the element from the Solid
+// compiler, which could otherwise see which props and children are static.
+// Renaming the JSX tag before the Solid transform runs gives the same node
+// with the compiler's direct output: `setProp` for static props, one effect
+// per dynamic prop, children inserted without a `children` getter.
+//
+// Only a JSX tag that resolves to a named import from "solid-fuse" is
+// renamed. A wrapper used as a value (`<Dynamic component={View} />`), a
+// re-export or a shadowing local of the same name is left alone and keeps
+// going through the component.
+//
+// Measured in experiments/interop/reports/11-render-cost.md.
+
+/** Wrapper component export name to the intrinsic element it renders. */
+export const INLINE_WRAPPERS: Record<string, string> = {
+  View: "view",
+  Text: "text",
+  Icon: "icon",
+  GestureDetector: "gestureDetector",
+  ScrollView: "scrollView",
+  Stack: "stack",
+  Positioned: "positioned",
+  TextField: "textField",
+};
+
+export function fuseInlineWrappersPlugin(): any {
+  return {
+    name: "fuse-inline-wrappers",
+    visitor: {
+      Program: {
+        // On enter, with an explicit traversal, so every tag is renamed before
+        // the Solid JSX transform (same Babel pass) visits it.
+        enter(program: any) {
+          const tags = new Map<string, string>(); // local binding name -> intrinsic tag
+          for (const stmt of program.node.body) {
+            if (stmt.type !== "ImportDeclaration" || stmt.source.value !== "solid-fuse") continue;
+            if (stmt.importKind === "type") continue;
+            for (const spec of stmt.specifiers) {
+              if (spec.type !== "ImportSpecifier" || spec.importKind === "type") continue;
+              const imported = spec.imported.type === "Identifier" ? spec.imported.name : spec.imported.value;
+              const tag = INLINE_WRAPPERS[imported];
+              if (tag) tags.set(spec.local.name, tag);
+            }
+          }
+          if (tags.size === 0) return;
+          program.traverse({
+            JSXElement(path: any) {
+              const opening = path.node.openingElement;
+              if (opening.name.type !== "JSXIdentifier") return;
+              const tag = tags.get(opening.name.name);
+              if (!tag) return;
+              const binding = path.scope.getBinding(opening.name.name);
+              if (!binding || binding.kind !== "module") return; // shadowed by a local
+              opening.name.name = tag;
+              const closing = path.node.closingElement;
+              if (closing && closing.name.type === "JSXIdentifier") closing.name.name = tag;
+            },
+          });
+        },
+      },
+    },
+  };
+}
