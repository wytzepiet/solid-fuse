+        rows.append([load[6:], owner, len(g), f(med(g, "lat_p50Ms")), f(med(g, "lat_p95Ms")), f(mx(g, "lat_maxMs")), f(mx(g, "lat_maxMs") / FRAME, 1),
+                     f(mx(g, "boxStallMs")), f(med(g, "mid.totalMs")), f(med(g, "mid.jsMs")), f(med(g, "mid.maxSliceMs")), f(med(g, "mid.slices"), 0),
+                     f(med(g, "ft.missedVsyncs"), 0), f(mx(g, "ft.missedVsyncs"), 0), f(mx(g, "ft.buildMaxMs")), f(mx(g, "ft.maxFrameGapMs")), loads(g)])
+    if rows:
