+BorderRadius? decBorderRadius(Object? v) {
+  if (v == null) return null;
+  final nBorderRadius = niceBorderRadius(v);
+  if (nBorderRadius != null) return nBorderRadius;
+  if (v is String) {
+    return switch (v) {
+      'zero' => BorderRadius.zero,
+      _ => fuseBad('BorderRadius', v),
+    };
+  }
+  final m = v as Map;
+  switch (m[r'$']) {
+    case 'all':
+      return BorderRadius.all(fuseReq(decRadius(m['radius']), 'BorderRadius.all', 'radius'));
+    case 'circular':
+      return BorderRadius.circular(fuseReq(decDouble(m['radius']), 'BorderRadius.circular', 'radius'));
+    case 'vertical':
+      return BorderRadius.vertical(top: decRadius(m['top']) ?? Radius.zero, bottom: decRadius(m['bottom']) ?? Radius.zero);
+    case 'horizontal':
