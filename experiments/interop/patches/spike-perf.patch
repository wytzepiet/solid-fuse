@@ -0,0 +1,103 @@
+// FuseNodeWidget: one element per node, rebuilt when the node notifies.
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+const create = 0, createText = 1, setProp = 2, setText = 3, insert = 4, remove = 5, dispose = 6;
+
+void main() {
+  late FuseRuntime rt;
+  late Map<int, int> builds;
+
+  setUp(() {
+    rt = FuseRuntime.forTest();
+    builds = {};
+    rt.registerWidget('probe', (node) {
+      builds[node.id] = (builds[node.id] ?? 0) + 1;
+      return Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [Text('p${node.id}:${node.string('label')}'), ...node.childWidgets],
+      );
+    });
+  });
+
+  Future<void> pump(WidgetTester tester) => tester.pumpWidget(
+    Directionality(textDirection: TextDirection.ltr, child: FuseView(runtime: rt)),
+  );
+
+  testWidgets('a node is one element and rebuilds alone when its prop changes', (tester) async {
+    rt.applyOps([
+      create, 1, 'probe', <String, dynamic>{'label': 'a'},
+      create, 2, 'probe', <String, dynamic>{'label': 'b'},
+      insert, 1, 2, 0,
+      insert, 0, 1, 0,
+    ]);
+    await pump(tester);
+    expect(find.text('p1:a'), findsOneWidget);
+    expect(find.text('p2:b'), findsOneWidget);
+    expect(builds, {1: 1, 2: 1});
+
+    // The node widget's element builds the node's widget directly: no
+    // ListenableBuilder between them.
+    final el = tester.element(find.byWidgetPredicate((w) => w is FuseNodeWidget && w.node.id == 2));
+    Element? child;
+    el.visitChildren((c) => child = c);
+    expect(child!.widget, isA<Column>());
+    expect(find.byType(ListenableBuilder), findsOneWidget); // FuseView's own
+
+    rt.applyOps([setProp, 2, 'label', 'c']);
+    await tester.pump();
+    expect(find.text('p2:c'), findsOneWidget);
+    expect(builds, {1: 1, 2: 2});
+  });
+
+  testWidgets('children changes rebuild the parent; a removed node stops listening', (tester) async {
+    rt.applyOps([
+      create, 1, 'probe', <String, dynamic>{'label': 'a'},
+      create, 2, 'probe', <String, dynamic>{'label': 'b'},
+      create, 3, 'probe', <String, dynamic>{'label': 'c'},
+      insert, 1, 2, 0,
+      insert, 0, 1, 0,
+    ]);
+    await pump(tester);
+    final n2 = rt.registry.get(2);
+
+    rt.applyOps([insert, 1, 3, 0]);
+    await tester.pump();
+    expect(find.text('p3:c'), findsOneWidget);
+    expect(builds[1], 2);
+    expect(builds[2], 1); // kept its element (keyed by node id)
+
+    rt.applyOps([remove, 1, 2]);
+    await tester.pump();
+    expect(find.text('p2:b'), findsNothing);
+    // ignore: invalid_use_of_protected_member
+    expect(n2.hasListeners, isFalse);
+    rt.applyOps([dispose, 2]);
+    await tester.pump();
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('a keyed reorder moves elements without rebuilding the rows', (tester) async {
+    rt.applyOps([
+      create, 1, 'probe', <String, dynamic>{'label': 'list'},
+      for (var i = 2; i < 6; i++) ...[create, i, 'probe', <String, dynamic>{'label': 'r'}, insert, 1, i, i - 2],
+      insert, 0, 1, 0,
+    ]);
+    await pump(tester);
+    rt.applyOps([remove, 1, 5, insert, 1, 5, 0]);
+    await tester.pump();
+    expect(rt.registry.get(1).children.map((c) => c.id), [5, 2, 3, 4]);
+    expect([for (var i = 2; i < 6; i++) builds[i]], [1, 1, 1, 1]);
+    final ys = [for (final i in [5, 2, 3, 4]) tester.getTopLeft(find.textContaining('p$i:')).dy];
+    expect(ys, [...ys]..sort());
+  });
+
+  testWidgets('a builder that throws shows the dev error box instead of breaking the tree', (tester) async {
+    rt.registerWidget('boom', (node) => throw StateError('bad prop'));
+    rt.applyOps([create, 1, 'boom', <String, dynamic>{}, insert, 0, 1, 0]);
+    await pump(tester);
+    expect(find.textContaining('bad prop'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+}
