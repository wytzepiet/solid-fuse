+// Loads the built bundle outside Flutter (Bun/JavaScriptCore, JIT) with a stub
+// bridge. Useful for debugging the JS side and as a "what a JIT would do"
+// reference point. Not QuickJS: do not quote these numbers as engine numbers.
+//   bun tools/run-in-bun.ts mount '{"nodes":1000}'
+import { readFileSync } from "fs";
+import { join } from "path";
+
+const g = globalThis as any;
+let opCount = 0;
+g.fjs = {
+  bridge_call(msg: any) {
+    if (msg.channel === "_ops") opCount += msg.ops.length;
+    if (msg.channel === "_log") process.stdout.write("[js] " + msg.message + "\n");
+    return Promise.resolve(msg.v);
+  },
+};
+g.__fuseHost = { mode: "release", platform: "linux", brightness: "light" };
+const src = readFileSync(join(import.meta.dir, "../dart/assets/js/bundle.js"), "utf8");
+(0, eval)(src);
+await new Promise((r) => setTimeout(r, 10));
+console.log("ops after boot:", opCount);
+const args = process.argv.slice(2);
+for (let i = 0; i < args.length; i += 2) {
+  const r = await g.__dispatch("bench", { cmd: args[i], ...JSON.parse(args[i + 1] ?? "{}") });
+  console.log(args[i], JSON.stringify(r));
+}
