new file mode 100644
index 0000000..3d9440c
--- /dev/null
+++ b/examples/perf_bench/tools/agg-attr.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Medians (min-max) of the `attr` suite records.  python3 tools/agg-attr.py results/r11/attr-x.txt"""
+import json, sys
+from statistics import median
+recs = {}
+for line in open(sys.argv[1]):
+    if line.startswith("BENCH {"):
+        d = json.loads(line[6:])
+        if d.get("suite") == "attr":
+            recs.setdefault(d["name"], []).append(d)
+def show(name, keys):
+    rs = recs.get(name)
+    if not rs: return
+    print(f"**{name}** (n={len(rs)}, load {min(float(r['load']) for r in rs):.2f}-{max(float(r['load']) for r in rs):.2f})\n")
+    print("| field | median | min | max |"); print("|---|---:|---:|---:|")
+    for k in keys:
+        v = [r[k] for r in rs if isinstance(r.get(k), (int, float))]
+        if v: print(f"| {k} | {median(v):.2f} | {min(v):.2f} | {max(v):.2f} |")
+    print()
+D = ["jsMs","sendMs","toRecvMs","decodeMs","bridgeValueMs","bridgeDecodeMs","applyMs","uiFrameMs","buildMs","nodeBuildMs","widgetBuildMs","layoutMs","paintMs","restMs","nodeBuilds","widgetBuilds","elements","renderObjects","fuseNodeWidgets","statefulElements"]
+N = ["totalMs","buildMs","layoutMs","paintMs","restMs","elements","renderObjects"]
+S = ["ops","leaves","bytes","jsonDecodeMs","dcoDecodeMs","valueMs","mapCopiesMs","createCopies"]
+for n in sorted(recs):
+    show(n, D if n.endswith("_detail") else N if n.startswith("native") else S if n.startswith("decode") else [])
