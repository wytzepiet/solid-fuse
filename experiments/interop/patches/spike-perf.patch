From 029f55f7ebde844e7be615285598e27e99e78171 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 23:46:03 +0000
Subject: [PATCH 08/18] perf(engine): start the QuickJS cycle collector at 32
 MB (fuseGcThresholdBytes)

---
 examples/perf_bench/dart/lib/main.dart       |  3 +++
 packages/solid-fuse/dart/lib/src/engine.dart | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/examples/perf_bench/dart/lib/main.dart b/examples/perf_bench/dart/lib/main.dart
index 40adf6b..d50052c 100644
--- a/examples/perf_bench/dart/lib/main.dart
+++ b/examples/perf_bench/dart/lib/main.dart
@@ -19,6 +19,9 @@ import 'suite_interact.dart';
 
 void main() async {
   BenchBinding();
+  // BENCH_GC_MB: QuickJS cycle-GC threshold for this run; 0 = QuickJS default.
+  final gcMb = env['BENCH_GC_MB'];
+  if (gcMb != null) fuseGcThresholdBytes = gcMb == '0' ? null : int.parse(gcMb) * 1024 * 1024;
   rt = await FuseRuntime.create();
   registerFusePackages(rt);
   registerBenchWidgets(rt);
diff --git a/packages/solid-fuse/dart/lib/src/engine.dart b/packages/solid-fuse/dart/lib/src/engine.dart
index e925ece..b9f4399 100644
--- a/packages/solid-fuse/dart/lib/src/engine.dart
+++ b/packages/solid-fuse/dart/lib/src/engine.dart
@@ -16,6 +16,19 @@ typedef EngineResult = ({
   WidgetsBindingObserver brightnessObserver,
 });
 
+/// QuickJS cycle-collector threshold for engines made by [createEngine], in
+/// bytes of JS heap; null keeps QuickJS's default (256 KB).
+///
+/// QuickJS frees most garbage by reference counting. The cycle collector is a
+/// separate full-heap mark that runs whenever the heap has grown past a
+/// threshold, after which the threshold becomes 1.5x the heap. Starting from
+/// 256 KB, a large mount walks the growing heap half a dozen times while it is
+/// being built (10 to 20% of the mount's JS time; see
+/// experiments/interop/reports/11-render-cost.md). A higher starting point
+/// trades that for cyclic garbage (disposed reactive scopes) living longer:
+/// up to this many bytes before the first collection.
+int? fuseGcThresholdBytes = 32 * 1024 * 1024;
+
 /// Creates a new engine with the channel system, console shim, and WebSocket
 /// manager wired up.
 ///
@@ -31,6 +44,11 @@ Future<EngineResult> createEngine({
   final engine = await JsEngine.create(
     builtins: builtins ?? JsBuiltinOptions.all(),
     modules: modules,
+    runtimeOptions: fuseGcThresholdBytes == null
+        ? null
+        : JsEngineRuntimeOptions(
+            gcThreshold: BigInt.from(fuseGcThresholdBytes!),
+          ),
   );
 
   await engine.init(
-- 
