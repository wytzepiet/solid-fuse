+// Parts 3 and 5: does a busy JS thread hurt interaction, and do mitigations help.
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+import 'package:solid_fuse/fjs.dart';
+
+import 'bench_widgets.dart';
+import 'harness.dart';
+
+const frameMs = 1000 / 60;
+
+/// What to do 600 ms into an interaction.
+typedef Mid = Future<dynamic> Function();
+
+Mid? midFor(String load) => switch (load) {
+      'long200' => () => ch.call('bench', {'cmd': 'busy', 'ms': 200}),
+      'long1000' => () => ch.call('bench', {'cmd': 'busy', 'ms': 1000}),
+      _ => null,
+    };
+
+Future<void> startLoad(String load) async {
+  if (load == 'periodic') await cmd('loadStart', {'busyMs': 5, 'everyMs': 16});
+}
+
+Future<void> stopLoad(String load) async {
+  if (load == 'periodic') await cmd('loadStop');
+}
+
+/// Drives a steady stream of pointer moves and samples after every frame.
+Future<(List<List<num>> inputs, int t0, int tEnd, dynamic mid)> drivePointer({
+  required Offset start,
+  required Offset velocity, // px per second
+  required int durMs,
+  Mid? mid,
+  int settleMs = 800,
+}) async {
+  final inputs = <List<num>>[];
+  final t0 = now();
+  ptrDown(start);
+  var last = start;
+  Future<dynamic>? midF;
+  var fired = false;
+  final done = Completer<void>();
+  Timer.periodic(const Duration(milliseconds: 16), (timer) {
+    final el = now() - t0;
+    if (!fired && el >= 600000) {
+      fired = true;
+      midF = mid?.call();
+    }
+    if (el >= durMs * 1000) {
+      timer.cancel();
+      ptrUp(last);
+      done.complete();
+      return;
+    }
+    final p = start + velocity * (el / 1e6);
+    ptrMove(p, p - last);
+    last = p;
+    inputs.add([now(), p.dx, p.dy]);
+  });
+  await done.future;
+  final tEnd = now();
+  final midRes = midF == null ? null : await midF;
+  await Future<void>.delayed(Duration(milliseconds: settleMs));
+  return (inputs, t0, tEnd, midRes);
+}
+
+// ---- drag ------------------------------------------------------------------------
+
+Future<Map<String, dynamic>> runDrag({
+  required String owner,
+  required String load,
+  int durMs = 2400,
+  double speed = 240,
+  Mid? mid,
+  int settleMs = 800,
+}) async {
+  await cmd('clear');
+  await cmd('ixMount', {'kind': 'drag', 'owner': owner});
+  await settle(400);
+  await startLoad(load);
+  final box = BenchProbe.box('box')!;
+  final start = box.localToGlobal(const Offset(40, 40));
+  final frames = <List<num>>[];
+  sampler = (t) {
+    final b = BenchProbe.box('box');
+    if (b != null) frames.add([t, b.localToGlobal(Offset.zero).dx]);
+  };
+  final (inputs, t0, tEnd, midRes) = await drivePointer(
+    start: start,
+    velocity: Offset(speed, 0),
+    durMs: durMs,
+    mid: mid ?? midFor(load),
+    settleMs: settleMs,
+  );
+  sampler = null;
+  await stopLoad(load);
+
+  // Constant offset between pointer and box once everything has settled.
+  final c = inputs.last[1] - frames.last[1];
+  final lat = <num>[];
+  var j = 0;
+  for (final inp in inputs) {
+    if (inp[1] - inputs.first[1] < 60) continue; // past the pan slop
+    while (j < frames.length && !(frames[j][0] >= inp[0] && frames[j][1] + c >= inp[1] - 0.01)) {
+      j++;
+    }
+    if (j >= frames.length) break;
+    lat.add(frames[j][0] - inp[0]);
+  }
+  // Longest time the box stood still while the pointer was moving.
+  var stall = 0, lastMove = t0;
+  for (var i = 1; i < frames.length; i++) {
+    if (frames[i][0] > tEnd) break;
+    if (frames[i][1] != frames[i - 1][1]) {
+      final g = frames[i][0].toInt() - lastMove;
+      if (lastMove > t0 + 400000 && g > stall) stall = g;
+      lastMove = frames[i][0].toInt();
+    }
+  }
+  final d = dist(lat);
+  return {
+    'owner': owner,
+    'load': load,
+    'inputs': inputs.length,
+    'inputHz': (inputs.length / (durMs / 1000)).round(),
+    ...d.map((k, v) => MapEntry('lat_$k', v)),
+    if (d['p50Ms'] != null) 'latP50Frames': ((d['p50Ms'] as num) / frameMs * 10).round() / 10,
+    if (d['maxMs'] != null) 'latMaxFrames': ((d['maxMs'] as num) / frameMs * 10).round() / 10,
+    'boxStallMs': ms(stall),
+    'travelPx': (frames.last[1] - frames.first[1]).round(),
+    'pointerTravelPx': (inputs.last[1] - inputs.first[1]).round(),
+    if (midRes is Map) 'mid': midRes,
+    '_from': t0,
+    '_to': tEnd,
+  };
+}
+
+// ---- scroll-linked header -----------------------------------------------------------
+
+Future<Map<String, dynamic>> runScroll({required String owner, required String load}) async {
+  await cmd('clear');
+  await cmd('ixMount', {'kind': 'scroll', 'owner': owner});
+  await settle(500);
+  await startLoad(load);
+  final scrollable = findState<ScrollableState>()!;
+  final frames = <List<num>>[]; // t, offset, headerHeight
+  sampler = (t) {
+    final h = BenchProbe.box('hdr');
+    if (h != null) frames.add([t, scrollable.position.pixels, h.size.height]);
+  };
+  // 60 px/s upwards: the header's 140 px of travel takes 2.3 s.
+  final (inputs, t0, tEnd, _) = await drivePointer(
+    start: const Offset(640, 620),
+    velocity: const Offset(0, -60),
+    durMs: 2800,
+    mid: midFor(load),
+    settleMs: load == 'long1000' ? 1500 : 800,
+  );
+  sampler = null;
+  await stopLoad(load);
+
+  double expected(num offset) => (200 - offset).clamp(60, 200).toDouble();
+  final lag = <num>[];
+  var maxErr = 0.0, staleFrames = 0, active = 0;
+  var k = 0;
+  for (final f in frames) {
+    if (f[0] > tEnd) break;
+    final want = expected(f[1]);
+    final err = (f[2] - want).abs();
+    if (f[1] > 0 && f[1] < 140) {
+      active++;
+      if (err > maxErr) maxErr = err;
+      if (err > 0.01) staleFrames++;
+      // When did the list first reach the offset the header is currently showing?
+      final shown = 200 - f[2];
+      while (k < frames.length && frames[k][1] < shown - 0.01) {
+        k++;
+      }
+      if (k < frames.length) lag.add(f[0] - frames[k][0]);
+    }
+  }
+  final d = dist(lag);
+  return {
+    'owner': owner,
+    'load': load,
+    'inputs': inputs.length,
+    'activeFrames': active,
+    'staleFrames': staleFrames,
+    'maxErrPx': (maxErr * 10).round() / 10,
+    ...d.map((k, v) => MapEntry('lag_$k', v)),
+    if (d['maxMs'] != null) 'lagMaxFrames': ((d['maxMs'] as num) / frameMs * 10).round() / 10,
+    'finalOffset': frames.last[1].round(),
+    'finalHeader': frames.last[2].round(),
+    '_from': t0,
+    '_to': tEnd,
+  };
+}
+
+// ---- text field ------------------------------------------------------------------------
+
+int lcs(String a, String b) {
+  final dp = List.generate(a.length + 1, (_) => List.filled(b.length + 1, 0));
+  for (var i = 1; i <= a.length; i++) {
+    for (var j = 1; j <= b.length; j++) {
+      dp[i][j] = a[i - 1] == b[j - 1] ? dp[i - 1][j - 1] + 1 : (dp[i - 1][j] > dp[i][j - 1] ? dp[i - 1][j] : dp[i][j - 1]);
+    }
+  }
+  return dp[a.length][b.length];
+}
+
+/// One key press, as the platform IME would deliver it: the IME's text is
+/// whatever Flutter last told it, i.e. the field's current value.
+void typeChar(EditableTextState st, String chr) {
+  final v = st.textEditingValue;
+  final pos = v.selection.isValid ? v.selection.baseOffset.clamp(0, v.text.length) : v.text.length;
+  st.updateEditingValue(TextEditingValue(
+    text: v.text.substring(0, pos) + chr + v.text.substring(pos),
+    selection: TextSelection.collapsed(offset: pos + 1),
+  ));
+}
+
+Future<Map<String, dynamic>> runText({
+  required String owner,
+  required String load,
+  required String test, // append | middle
+  int keyMs = 80,
+}) async {
+  await cmd('clear');
+  await cmd('ixMount', {'kind': 'text', 'owner': owner});
+  await settle(500);
+  final st = findState<EditableTextState>()!;
+  st.widget.focusNode.requestFocus();
+  await settle(200);
+
+  var phrase = 'the quick brown fox jumps over the lazy dog';
+  var expected = phrase.toUpperCase();
+  var expectedCursor = expected.length;
+  if (test == 'middle') {
+    for (final c in 'HELLO WORLD'.split('')) {
+      typeChar(st, c);
+      await Future<void>.delayed(const Duration(milliseconds: 30));
+    }
+    await settle(500);
+    st.updateEditingValue(st.textEditingValue.copyWith(selection: const TextSelection.collapsed(offset: 5)));
+    await settle(200);
+    phrase = 'abcdef';
+    expected = 'HELLOABCDEF WORLD';
+    expectedCursor = 11;
+  }
+  final base = test == 'middle' ? 5 : 0;
+
+  await startLoad(load);
+  final frames = <(int, String, int)>[];
+  sampler = (t) => frames.add((t, st.textEditingValue.text, st.textEditingValue.selection.baseOffset));
+  final keys = <int>[];
+  final cursorAfterKey = <int>[];
+  final t0 = now();
+  final mid = midFor(load);
+  Future<dynamic>? midF;
+  for (var i = 0; i < phrase.length; i++) {
+    if (midF == null && mid != null && now() - t0 >= 600000) midF = mid();
+    keys.add(now());
+    typeChar(st, phrase[i]);
+    cursorAfterKey.add(st.textEditingValue.selection.baseOffset);
+    await Future<void>.delayed(Duration(milliseconds: keyMs));
+  }
+  final tEnd = now();
+  if (midF != null) await midF;
+  await Future<void>.delayed(Duration(milliseconds: load == 'long1000' ? 2000 : 1000));
+  sampler = null;
+  await stopLoad(load);
+
+  final fin = st.textEditingValue;
+  // Latency: key i -> first frame whose text has the right upper-cased prefix through that key.
+  final lat = <num>[];
+  var j = 0;
+  for (var i = 0; i < keys.length; i++) {
+    final want = expected.substring(0, base + i + 1);
+    while (j < frames.length && !(frames[j].$1 >= keys[i] && frames[j].$2.startsWith(want))) {
+      j++;
+    }
+    if (j >= frames.length) break;
+    lat.add(frames[j].$1 - keys[i]);
+  }
+  var lowerFrames = 0, shrinks = 0, cursorJumps = 0;
+  for (var i = 0; i < frames.length; i++) {
+    if (frames[i].$2 != frames[i].$2.toUpperCase()) lowerFrames++;
+    if (i > 0 && frames[i].$2.length < frames[i - 1].$2.length) shrinks++;
+  }
+  // A cursor jump: before a key press the cursor is not where the previous key left it.
+  var expectCur = base;
+  for (var i = 0; i < cursorAfterKey.length; i++) {
+    if (cursorAfterKey[i] != expectCur + 1) cursorJumps++;
+    expectCur = cursorAfterKey[i];
+  }
+  final d = dist(lat);
+  return {
+    'owner': owner,
+    'load': load,
+    'test': test,
+    'keyMs': keyMs,
+    'typed': phrase.length,
+    'final': fin.text,
+    'correct': fin.text == expected,
+    'lostChars': expected.length - lcs(expected, fin.text),
+    'extraChars': fin.text.length - lcs(expected, fin.text),
+    'finalCursor': fin.selection.baseOffset,
+    'expectedCursor': expectedCursor,
+    'cursorJumps': cursorJumps,
+    'framesWithLowercase': lowerFrames,
+    'framesTextShrank': shrinks,
+    'keysResolved': lat.length,
+    ...d.map((k, v) => MapEntry('lat_$k', v)),
+    '_from': t0,
+    '_to': tEnd,
+  };
+}
+
+void queue(String suite, String name, Map<String, dynamic> r, int rep) {
+  final from = r.remove('_from') as int, to = r.remove('_to') as int;
+  pending.add(Pending(suite, name, {...r, 'rep': rep, 'load': loadavg()}, from, to));
+}
