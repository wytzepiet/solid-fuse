+                     f((med(t, "toRecvMs") - med(t, "jsMs")) * 1000 / n, 1),
+                     f(1e6 / js / 1000, 0) + "k", f(1e6 / (dec + app) / 1000, 0) + "k", loads(t)])
+    table(["setProp value", "ops per batch", "wire bytes/op", "JS emit µs/op", "(min)", "of which bridge_call µs/op",
+           "Dart decode µs/op", "(min)", "Dart apply µs/op", "JS done -> Dart handler µs/op", "JS emit ops/s", "Dart decode+apply ops/s", "load avg"], rows)
+
+# ---------------------------------------------------------------------------- part 5
+p5 = suite("part5")
+if p5:
+    print("## Part 5: mitigations\n")
+    rs = [r for r in p5 if r["name"] == "drag_during_mount"]
