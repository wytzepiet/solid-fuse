+// Parts 3 and 5: three interactions, each Dart-owned and JS-driven.
+import {
+  View, Text, ScrollView, GestureDetector, TextField, Stack, Positioned, For,
+  nativeComponent, createScrollController,
+} from "solid-fuse";
+import { createSignal } from "solid-js";
+import { Card } from "./screens";
+
+// Bench-only native nodes (dart/lib/bench_widgets.dart).
+const Probe = nativeComponent<{ name: string; children?: any }>("benchProbe");
+const Spinner = nativeComponent<{}>("benchSpinner");
+const DartDragBox = nativeComponent<{ children?: any }>("benchDragBox");
+const DartShrinkHeader = nativeComponent<{ controller: any; max: number; min: number; children?: any }>("benchShrinkHeader");
+const DartUpperField = nativeComponent<{}>("benchUpperField");
+
+/** Content mounted behind the draggable box while it is being dragged (part 5). */
+export const [bgItems, setBgItems] = createSignal<number[]>([]);
+
+const Box = () => (
+  <Probe name="box">
+    <View width={80} height={80} decoration={{ color: "#3366ff", borderRadius: 12 }} />
+  </Probe>
+);
+
+export function DragScreen(p: { owner: "js" | "dart" }) {
+  const [pos, setPos] = createSignal({ x: 0, y: 0 });
+  return (
+    <Stack fit="expand">
+      <ScrollView>
+        <View padding={16}>
+          <For each={bgItems()}>{(i) => <Card i={i} />}</For>
+        </View>
+      </ScrollView>
+      <Positioned left={100} top={300}>
+        {p.owner === "js" ? (
+          // Every pointer move: Dart -> JS (onPanUpdate) -> signal -> setProp(transform) -> Dart.
+          <View transform={{ translateX: pos().x, translateY: pos().y }}>
+            <GestureDetector onPanUpdate={(d) => setPos((o) => ({ x: o.x + d.dx, y: o.y + d.dy }))}>
+              <Box />
+            </GestureDetector>
+          </View>
+        ) : (
+          // Declared in JS, executed by Flutter: the pan never leaves Dart.
+          <DartDragBox>
+            <Box />
+          </DartDragBox>
+        )}
+      </Positioned>
+      <Positioned right={16} top={16}>
+        <Spinner />
+      </Positioned>
+    </Stack>
+  );
+}
+
+export function ScrollLinkedScreen(p: { owner: "js" | "dart" }) {
+  const sc = createScrollController();
+  const rows = Array.from({ length: 100 }, (_, i) => i);
+  return (
+    <View flex={{ expand: true, align: "stretch" }}>
+      {p.owner === "js" ? (
+        // Every scroll tick: Dart -> JS (setScrollOffset) -> signal -> setProp(height) -> Dart.
+        <View height={Math.max(60, 200 - sc.scrollOffset())} decoration={{ color: "#3366ff" }}>
+          <Probe name="hdr" />
+        </View>
+      ) : (
+        <DartShrinkHeader controller={sc} max={200} min={60}>
+          <Probe name="hdr" />
+        </DartShrinkHeader>
+      )}
+      <Spinner />
+      <View grow={1} fit="tight">
+        <ScrollView controller={sc}>
+          <View padding={16}>
+            <For each={rows}>{(i) => <Card i={i} />}</For>
+          </View>
+        </ScrollView>
+      </View>
+    </View>
+  );
+}
+
+export function TextScreen(p: { owner: "js" | "dart" }) {
+  const [v, setV] = createSignal("");
+  return (
+    <View padding={24} flex={{ gap: 16 }}>
+      {p.owner === "js" ? (
+        // Controlled field: every edit goes Dart -> JS -> signal -> setProp(value) -> Dart.
+        <TextField value={v()} onChanged={(t) => setV(t.toUpperCase())} />
+      ) : (
+        <DartUpperField />
+      )}
+      <Spinner />
+      <Text>typing probe</Text>
+    </View>
+  );
+}
