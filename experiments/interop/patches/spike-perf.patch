+#!/usr/bin/env python3
+"""Turns BENCH lines (tools/run.sh output) into the markdown tables of report 10.
+
+    python3 tools/aggregate.py results/part1-*.txt results/part2-*.txt ...
+"""
+import json
+import sys
+from collections import OrderedDict, defaultdict
+from statistics import median
+
+FRAME = 1000 / 60
+recs = []
+for path in sys.argv[1:]:
+    for line in open(path):
+        if line.startswith("BENCH {"):
+            d = json.loads(line[6:])
+            d["_file"] = path
+            recs.append(d)
+
+
+def f(x, nd=1):
+    if x is None:
+        return "–"
+    if isinstance(x, str):
+        return x
+    if abs(x) >= 100:
+        return f"{x:,.0f}"
+    return f"{x:.{nd}f}"
+
+
+def vals(rs, key):
+    out = []
+    for r in rs:
+        v = r
+        for k in key.split("."):
+            v = v.get(k) if isinstance(v, dict) else None
+        if isinstance(v, (int, float)):
+            out.append(v)
+    return out
+
+
+def med(rs, key):
+    v = vals(rs, key)
+    return median(v) if v else None
+
+
+def mn(rs, key):
+    v = vals(rs, key)
+    return min(v) if v else None
+
+
+def mx(rs, key):
+    v = vals(rs, key)
+    return max(v) if v else None
+
+
+def mmm(rs, key, nd=1):
+    if not vals(rs, key):
+        return "–"
+    return f"{f(mn(rs, key), nd)} / **{f(med(rs, key), nd)}** / {f(mx(rs, key), nd)}"
+
+
+def loads(rs):
+    v = [float(r["load"]) for r in rs if r.get("load") not in (None, "?")]
+    return f"{min(v):.1f}–{max(v):.1f}" if v else "–"
+
+
+def table(headers, rows):
+    print("| " + " | ".join(headers) + " |")
+    print("|" + "|".join("---" if i == 0 else "---:" for i in range(len(headers))) + "|")
+    for r in rows:
+        print("| " + " | ".join(str(c) for c in r) + " |")
+    print()
+
+
+def group(rs, keyfn):
+    g = OrderedDict()
+    for r in rs:
+        g.setdefault(keyfn(r), []).append(r)
+    return g
+
+
+def suite(name):
+    return [r for r in recs if r["suite"] == name]
+
+
+def split(rs):
+    return [r for r in rs if not r.get("detail")], [r for r in rs if r.get("detail")]
+
+
+meta = [r for r in recs if r["suite"] == "meta"]
+if meta:
+    m = meta[0]
+    print(f"build mode {m['mode']}, {m['cores']} cores, Dart {m['dart']}, window {m['window']}, JS clock {m['jsClock']}\n")
+
+# ---------------------------------------------------------------------------- part 1
+p1 = [r for r in suite("part1") if "jsMs" in r]
+if p1:
+    print("## Part 1: JS task length and end-to-end time\n")
+    print("ms; `min / **median** / max` over runs. Frames are at 60 Hz (16.7 ms).\n")
+    rows = []
+    for name, rs in group(p1, lambda r: r["name"]).items():
+        t, d = split(rs)
+        k = (d[0].get("kinds") or {}) if d else {}
+        uib = [r.get("decodeMs", 0) + r.get("applyMs", 0) + r.get("uiFrameMs", 0) for r in t if "uiFrameMs" in r]
+        rows.append([
+            name, len(t), k.get("create", "–"), f(med(t, "ops"), 0),
+            f((d[0].get("bytes") or 0) / 1024, 1) if d else "–",
+            mmm(t, "jsMs"), f(med(t, "jsMs") / FRAME, 1), f(med(t, "sendMs")),
+            mmm(t, "decodeMs"), f(med(t, "applyMs")), mmm(t, "uiFrameMs"),
+            f(median(uib)) if uib else "–",
+            mmm(t, "e2eMs"), f(med(t, "e2eMs") / FRAME, 1) if med(t, "e2eMs") else "–",
+            f(med(t, "ft.rasterMaxMs")), loads(t),
+        ])
+    table(["operation", "runs", "nodes created", "ops", "wire KB (JSON)", "JS task ms", "JS frames (med)",
+           "of which bridge_call ms", "Dart decode ms (UI isolate)", "apply ms", "frame build ms (UI thread)",
+           "UI thread busy ms (decode+apply+build, med)", "end to end ms", "e2e frames (med)", "raster ms (llvmpipe)", "load avg"], rows)
+    chk = [r for r in suite("part1") if r["name"] == "list_order_check"]
+    if chk:
+        print(f"list order check after sort/shuffle/reverse/filter: {sum(1 for r in chk if r['dartTreeMatchesJs'])}/{len(chk)} runs match\n")
+
+# ---------------------------------------------------------------------------- part 2
+p2 = suite("part2")
+if p2:
+    print("## Part 2: cost of a TS layer\n")
+    order = ["direct", "dart", "fine", "jsx", "naive", "composed"]
+    label = {"direct": "(i) View, props written by hand", "dart": "(i') friendly props mapped in Dart",
+             "fine": "(ii) TS wrapper, memo per composite prop", "jsx": "(ii) TS wrapper, plain JSX attributes",
+             "naive": "(ii) TS wrapper, one memo + spread", "composed": "(iii) composed from generated primitives"}
+    mounts = [r for r in p2 if r["name"] == "mount"]
+    mem = [r for r in p2 if r["name"] == "memory"]
+    print("### Mount, per component (µs unless noted; median over runs)\n")
+    for (n, level), rs in group(mounts, lambda r: (r["n"], r["level"])).items():
+        print(f"**{n} components, feature level {level}**\n")
+        byv = group(rs, lambda r: r["variant"])
+        base = {}
+        rows = []
+        for v in order:
+            if v not in byv:
+                continue
+            t, d = split(byv[v])
+            k = (d[0].get("kinds") or {}) if d else {}
+            js = med(t, "jsMs") * 1000 / n
+            dec = med(t, "decodeMs") * 1000 / n
+            app = med(t, "applyMs") * 1000 / n
+            ui = med(t, "uiFrameMs") * 1000 / n
+            m = [x for x in mem if x["variant"] == v and x["n"] == n and x["level"] == level and not x.get("detail")]
+            base[v] = (js, dec + app + ui)
+            rows.append([
+                label[v], f(k.get("create", 0) / n, 1) if d else "–", f(med(t, "ops") / n, 1),
+                f((d[0].get("bytes") or 0) / n, 0) if d else "–",
+                f(js, 0), f(mn(t, "jsMs") * 1000 / n, 0), f(dec, 0), f(app, 1), f(ui, 0), f(dec + app + ui, 0),
+                f(med(t, "jsMs")), f(med(t, "decodeMs") + med(t, "applyMs") + med(t, "uiFrameMs")), f(med(t, "e2eMs")),
+                f(med(m, "jsHeapDeltaKb") * 1024 / n, 0) if m else "–", f(med(m, "rssDeltaKb") * 1024 / n, 0) if m else "–",
+                loads(t),
+            ])
+        table(["variant", "nodes", "ops", "wire bytes", "JS µs", "JS µs (min)", "decode µs", "apply µs", "build µs",
+               "UI thread µs", f"JS ms / {n}", f"UI thread ms / {n}", f"e2e ms / {n}", "JS heap bytes", "RSS bytes", "load avg"], rows)
+        if "direct" in base:
+            rows = []
+            for v in order:
+                if v in base and v != "direct":
+                    rows.append([label[v], f(base[v][0] - base["direct"][0], 0), f(base[v][0] / base["direct"][0], 2) + "x",
+                                 f(base[v][1] - base["direct"][1], 0), f(base[v][1] / base["direct"][1], 2) + "x"])
+            table(["overhead vs (i)", "JS µs / component", "JS ratio", "UI thread µs / component", "UI ratio"], rows)
+
+    print("### One reactive prop changes on every component, per component (µs; median)\n")
+    upd = [r for r in p2 if r["name"].startswith("update_")]
+    for (n, level, prop), rs in group(upd, lambda r: (r["n"], r["level"], r["name"][7:])).items():
+        print(f"**{n} components, level {level}, prop `{prop}`**\n")
+        byv = group(rs, lambda r: r["variant"])
+        rows = []
+        for v in order:
+            if v not in byv:
+                continue
+            t, d = split(byv[v])
+            rows.append([
+                label[v], f(med(t, "ops") / n, 1), f((d[0].get("bytes") or 0) / n, 0) if d else "–",
+                f(med(t, "jsMs") * 1000 / n, 0), f(med(t, "decodeMs") * 1000 / n, 0),
+                f(med(t, "applyMs") * 1000 / n, 1), f(med(t, "uiFrameMs") * 1000 / n, 0),
+                f(med(t, "jsMs")), f(med(t, "e2eMs")),
+            ])
+        table(["variant", "setProps", "wire bytes", "JS µs", "decode µs", "apply µs", "build+layout µs", f"JS ms / {n}", f"e2e ms / {n}"], rows)
+
+# ---------------------------------------------------------------------------- part 3
+p3 = suite("part3")
+if p3:
+    print("## Part 3: interaction under JS load\n")
+    lo = ["idle", "periodic", "long200", "long1000"]
+    for name in ["drag", "scroll"]:
+        rs = [r for r in p3 if r["name"] == name]
+        if not rs:
+            continue
+        pre = "lat" if name == "drag" else "lag"
+        rows = []
+        for (owner, load), g in sorted(group(rs, lambda r: (r["owner"], r["jsLoad"])).items(), key=lambda kv: (lo.index(kv[0][1]), kv[0][0])):
+            row = [load, owner, len(g), f(med(g, f"{pre}_p50Ms")), f(med(g, f"{pre}_p50Ms") / FRAME, 1) if med(g, f"{pre}_p50Ms") is not None else "–",
+                   f(med(g, f"{pre}_p95Ms")), f(mx(g, f"{pre}_maxMs")), f(mx(g, f"{pre}_maxMs") / FRAME, 1) if mx(g, f"{pre}_maxMs") is not None else "–"]
+            if name == "drag":
+                row += [f(mx(g, "boxStallMs"))]
+            else:
+                row += [f(mx(g, "maxErrPx")), f(med(g, "staleFrames"), 0) + "/" + f(med(g, "activeFrames"), 0)]
+            row += [f(med(g, "ft.frames"), 0), f(mx(g, "ft.missedVsyncs"), 0), f(mx(g, "ft.buildMaxMs")), f(med(g, "ft.rasterP50Ms")), loads(g)]
+            rows.append(row)
+        extra = ["longest box freeze ms"] if name == "drag" else ["max header error px", "stale frames"]
+        print(f"### {name}\n")
+        table(["JS load", "owner", "runs", "latency p50 ms", "p50 frames", "p95 ms", "worst ms", "worst frames"] + extra +
+              ["frames", "missed vsyncs (worst run)", "worst build ms", "raster p50 ms", "load avg"], rows)
+    for name in ["text_append", "text_append_fast", "text_middle"]:
+        rs = [r for r in p3 if r["name"] == name]
+        if not rs:
+            continue
+        rows = []
+        for (owner, load), g in sorted(group(rs, lambda r: (r["owner"], r["jsLoad"])).items(), key=lambda kv: (lo.index(kv[0][1]), kv[0][0])):
+            rows.append([load, owner, len(g), f"{sum(1 for r in g if r['correct'])}/{len(g)}", f(mx(g, "lostChars"), 0), f(mx(g, "extraChars"), 0),
+                         f(mx(g, "cursorJumps"), 0), "/".join(str(r["finalCursor"]) for r in g) + f" (want {g[0]['expectedCursor']})",
+                         f(med(g, "framesWithLowercase"), 0), f(mx(g, "framesTextShrank"), 0),
+                         f(med(g, "lat_p50Ms")), f(mx(g, "lat_maxMs")), f(mx(g, "ft.missedVsyncs"), 0), g[-1]["final"], loads(g)])
+        print(f"### {name} ({rs[0]['typed']} keys, one every {rs[0]['keyMs']} ms)\n")
+        table(["JS load", "owner", "runs", "final text correct", "chars lost (worst)", "extra chars (worst)", "cursor jumps (worst)", "final cursor",
+               "frames showing lowercase (med)", "frames where text shrank (worst)", "key-to-correct p50 ms", "worst ms",
+               "missed vsyncs (worst)", "final text of last run", "load avg"], rows)
+
+# ---------------------------------------------------------------------------- part 4
+p4 = suite("part4")
+if p4:
+    print("## Part 4: the bridge\n")
+    rows = []
+    for name, g in group([r for r in p4 if r["name"].startswith("rt_")], lambda r: r["name"]).items():
+        rows.append([name, len(g), f(med(g, "meanUs"), 0), f(med(g, "p50Us"), 0), f(mn(g, "minUs"), 0), f(med(g, "p95Us"), 0), f(mx(g, "maxUs"), 0), loads(g)])
+    table(["round trip", "runs (x1000 calls)", "mean µs", "p50 µs", "min µs", "p95 µs", "max µs", "load avg"], rows)
+    for name, g in group([r for r in p4 if r["name"].startswith("ops_as_json")], lambda r: r["name"]).items():
+        keys = [k for k in g[0] if k.endswith("Ms")]
+        print(f"**{name}** ({g[0]['ops']} ops, {g[0]['bytes']/1024:.0f} KB of JSON, {len(g)} runs, load {loads(g)})\n")
+        table(["step", "ms (min / median / max)"], [[k, mmm(g, k)] for k in keys])
+    rows = []
+    for name, rs in group([r for r in p4 if r["name"].startswith("props_")], lambda r: r["name"]).items():
+        t, d = split(rs)
+        n = t[0]["n"]
+        js, dec, app = med(t, "jsMs") * 1000 / n, med(t, "decodeMs") * 1000 / n, med(t, "applyMs") * 1000 / n
+        rows.append([name[6:], n, f((d[0].get("bytes") or 0) / n, 0) if d else "–", f(js, 1), f(mn(t, "jsMs") * 1000 / n, 1),
