+AlignmentGeometry? decAlignmentGeometry(Object? v) {
+  if (v == null) return null;
+  if (v is String) {
+    return switch (v) {
+      'topLeft' => AlignmentGeometry.topLeft,
+      'topCenter' => AlignmentGeometry.topCenter,
+      'topRight' => AlignmentGeometry.topRight,
+      'topStart' => AlignmentGeometry.topStart,
+      'topEnd' => AlignmentGeometry.topEnd,
+      'centerLeft' => AlignmentGeometry.centerLeft,
+      'center' => AlignmentGeometry.center,
+      'centerRight' => AlignmentGeometry.centerRight,
+      'centerStart' => AlignmentGeometry.centerStart,
+      'centerEnd' => AlignmentGeometry.centerEnd,
+      'bottomLeft' => AlignmentGeometry.bottomLeft,
+      'bottomCenter' => AlignmentGeometry.bottomCenter,
+      'bottomRight' => AlignmentGeometry.bottomRight,
+      'bottomStart' => AlignmentGeometry.bottomStart,
+      'bottomEnd' => AlignmentGeometry.bottomEnd,
+      'Alignment.topLeft' => Alignment.topLeft,
+      'Alignment.topCenter' => Alignment.topCenter,
+      'Alignment.topRight' => Alignment.topRight,
+      'Alignment.centerLeft' => Alignment.centerLeft,
+      'Alignment.center' => Alignment.center,
+      'Alignment.centerRight' => Alignment.centerRight,
+      'Alignment.bottomLeft' => Alignment.bottomLeft,
+      'Alignment.bottomCenter' => Alignment.bottomCenter,
+      'Alignment.bottomRight' => Alignment.bottomRight,
+      'AlignmentDirectional.topStart' => AlignmentDirectional.topStart,
+      'AlignmentDirectional.topCenter' => AlignmentDirectional.topCenter,
+      'AlignmentDirectional.topEnd' => AlignmentDirectional.topEnd,
+      'AlignmentDirectional.centerStart' => AlignmentDirectional.centerStart,
+      'AlignmentDirectional.center' => AlignmentDirectional.center,
+      'AlignmentDirectional.centerEnd' => AlignmentDirectional.centerEnd,
+      'AlignmentDirectional.bottomStart' => AlignmentDirectional.bottomStart,
+      'AlignmentDirectional.bottomCenter' => AlignmentDirectional.bottomCenter,
+      'AlignmentDirectional.bottomEnd' => AlignmentDirectional.bottomEnd,
+      'FractionalOffset.topLeft' => FractionalOffset.topLeft,
+      'FractionalOffset.topCenter' => FractionalOffset.topCenter,
+      'FractionalOffset.topRight' => FractionalOffset.topRight,
+      'FractionalOffset.centerLeft' => FractionalOffset.centerLeft,
+      'FractionalOffset.center' => FractionalOffset.center,
+      'FractionalOffset.centerRight' => FractionalOffset.centerRight,
+      'FractionalOffset.bottomLeft' => FractionalOffset.bottomLeft,
+      'FractionalOffset.bottomCenter' => FractionalOffset.bottomCenter,
+      'FractionalOffset.bottomRight' => FractionalOffset.bottomRight,
+      _ => fuseBad('AlignmentGeometry', v),
+    };
+  }
+  final m = v as Map;
+  switch (m[r'$']) {
+    case 'xy':
+      return AlignmentGeometry.xy(fuseReq(decDouble(m['x']), 'AlignmentGeometry.xy', 'x'), fuseReq(decDouble(m['y']), 'AlignmentGeometry.xy', 'y'));
+    case 'directional':
+      return AlignmentGeometry.directional(fuseReq(decDouble(m['start']), 'AlignmentGeometry.directional', 'start'), fuseReq(decDouble(m['y']), 'AlignmentGeometry.directional', 'y'));
+    case 'Alignment':
+      return Alignment(fuseReq(decDouble(m['x']), 'Alignment.Alignment', 'x'), fuseReq(decDouble(m['y']), 'Alignment.Alignment', 'y'));
+    case 'AlignmentDirectional':
+      return AlignmentDirectional(fuseReq(decDouble(m['start']), 'AlignmentDirectional.AlignmentDirectional', 'start'), fuseReq(decDouble(m['y']), 'AlignmentDirectional.AlignmentDirectional', 'y'));
+    case 'FractionalOffset':
+      return FractionalOffset(fuseReq(decDouble(m['dx']), 'FractionalOffset.FractionalOffset', 'dx'), fuseReq(decDouble(m['dy']), 'FractionalOffset.FractionalOffset', 'dy'));
+    case 'FractionalOffset.fromOffsetAndSize':
+      return FractionalOffset.fromOffsetAndSize(fuseReq(decOffset(m['offset']), 'FractionalOffset.fromOffsetAndSize', 'offset'), fuseReq(decSize(m['size']), 'FractionalOffset.fromOffsetAndSize', 'size'));
+    case 'FractionalOffset.fromOffsetAndRect':
+      return FractionalOffset.fromOffsetAndRect(fuseReq(decOffset(m['offset']), 'FractionalOffset.fromOffsetAndRect', 'offset'), fuseReq(decRect(m['rect']), 'FractionalOffset.fromOffsetAndRect', 'rect'));
+  }
+  return fuseBad('AlignmentGeometry', v);
+}
