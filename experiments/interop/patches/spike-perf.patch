+
+describe("op batches", () => {
+  test("a batch is sent as one JSON string with its op count", () => {
+    const el = R.createElement("view");
+    R.setProp(el, "width", 40);
+    R.setProp(el, "padding", { left: 1, top: 2 });
+    R.flushOps();
+    expect(sent).toHaveLength(1);
+    expect(sent[0].channel).toBe("_ops");
+    expect(typeof sent[0].json).toBe("string");
+    expect(sent[0].ops).toBeUndefined();
+    expect(sent[0].n).toBe(3);
+    expect(JSON.parse(sent[0].json)).toEqual([
+      { op: "create", id: el.id, type: "view", props: {} },
+      { op: "setProp", id: el.id, name: "width", value: 40 },
+      { op: "setProp", id: el.id, name: "padding", value: { left: 1, top: 2 } },
+    ]);
+  });
+
+  test("a batch holding a value JSON cannot carry is sent structured", () => {
+    const el = R.createElement("view");
+    const when = new Date(5);
+    R.setProp(el, "when", when);
+    R.flushOps();
+    expect(sent[0].json).toBeUndefined();
+    expect(sent[0].ops[1]).toEqual({ op: "setProp", id: el.id, name: "when", value: when });
+    // ... and only that batch
+    R.setProp(el, "width", 1);
+    R.flushOps();
+    expect(typeof sent[1].json).toBe("string");
+
+    R.setProp(el, "bytes", new Uint8Array([1, 2]));
+    R.flushOps();
+    expect(sent[2].json).toBeUndefined();
+    R.setProp(el, "big", 10n);
+    R.flushOps();
+    expect(sent[3].json).toBeUndefined();
+    expect(sent[3].ops[0].value).toBe(10n);
+  });
+
+  test("function props become `true` and node props a `_node` reference", () => {
+    const el = R.createElement("view");
+    const child = R.createElement("view");
+    R.setProp(el, "onTap", () => {});
+    R.setProp(el, "leading", child);
+    expect(setProps(takeOps())).toEqual([["onTap", true], ["leading", { _node: child.id }]]);
+  });
+});
+
+describe("FuseNode", () => {
+  test("has its fields as own data properties", () => {
+    const el = R.createElement("view");
+    expect(Object.keys(el).sort()).toEqual(["children", "component", "id", "parent", "props", "type"]);
+    expect(el.type).toBe("view");
+    expect(el.children).toEqual([]);
+    expect(R.createElement("view").id).toBe(el.id + 1);
+  });
+});
+
+describe("spread", () => {
+  test("static props are set immediately, without waiting for a flush of effects", () => {
+    createRoot((_keep) => {
+      const el = R.createElement("view");
+      R.spread(el, { width: 40, alignment: "center" }, true);
+      // no Solid flush has run: the props are already on the node
+      expect(el.props).toEqual({ width: 40, alignment: "center" });
+    });
+    expect(setProps(takeOps())).toEqual([["width", 40], ["alignment", "center"]]);
+  });
+
+  test("getter props share one effect and resend only what changed", () => {
+    const [w, setW] = createSignal(1);
+    const [h, setH] = createSignal(2);
+    let el!: InstanceType<typeof R.FuseNode>;
+    const dispose = createRoot((d) => {
+      el = R.createElement("view");
+      R.spread(el, { color: "red", get width() { return w(); }, get height() { return h(); } }, true);
+      return d;
+    });
+    expect(setProps(takeOps())).toEqual([["color", "red"], ["width", 1], ["height", 2]]);
+    setW(10);
+    expect(setProps(takeOps())).toEqual([["width", 10]]);
+    setH(20);
+    setW(11);
+    expect(setProps(takeOps())).toEqual([["width", 11], ["height", 20]]);
+    dispose();
+    setW(12);
+    expect(takeOps()).toEqual([]);
+  });
+
+  test("an object-literal getter is resent when another getter changes (unchanged behaviour)", () => {
+    const [w, setW] = createSignal(1);
+    createRoot((_keep) => {
+      const el = R.createElement("view");
+      R.spread(el, { get width() { return w(); }, get padding() { return { all: 4 }; } }, true);
+    });
+    takeOps();
+    setW(2);
+    expect(setProps(takeOps())).toEqual([["width", 2], ["padding", { all: 4 }]]);
+  });
+
+  test("children: static value, getter, absent, and skipChildren", () => {
+    const [label, setLabel] = createSignal("a");
+    let stat!: any, dyn!: any, none!: any, skipped!: any;
+    createRoot((_keep) => {
+      stat = R.createElement("text");
+      R.spread(stat, { children: "hello" }, false);
+      dyn = R.createElement("text");
+      R.spread(dyn, { get children() { return label(); } }, false);
+      none = R.createElement("view");
+      R.spread(none, { width: 1 }, false);
+      skipped = R.createElement("text");
+      R.spread(skipped, { children: "ignored" }, true);
+    });
+    takeOps();
+    expect(stat.children.map((c: any) => c.props.text)).toEqual(["hello"]);
+    expect(dyn.children.map((c: any) => c.props.text)).toEqual(["a"]);
+    expect(none.children).toEqual([]);
+    expect(skipped.children).toEqual([]);
+    setLabel("b");
+    const ops = takeOps();
+    expect(ops).toEqual([{ op: "setText", id: dyn.children[0].id, text: "b" }]);
+  });
+
+  test("element children are inserted in order", () => {
+    let parent!: any, a!: any, b!: any;
+    createRoot((_keep) => {
+      a = R.createElement("view");
+      b = R.createElement("view");
+      parent = R.createElement("view");
+      R.spread(parent, { get children() { return [a, b]; } }, false);
+    });
+    takeOps();
+    expect(parent.children).toEqual([a, b]);
+    expect(a.parent).toBe(parent);
+  });
+
+  test("ref is called once with the node; a function prop is registered as a handler", () => {
+    const seen: any[] = [];
+    let el!: any;
+    createRoot((_keep) => {
+      el = R.createElement("view");
+      R.spread(el, { ref: (n: any) => seen.push(n), onTap: () => {} }, true);
+    });
+    expect(seen).toEqual([el]);
+    expect(setProps(takeOps())).toEqual([["onTap", true]]);
+  });
+
+  test("proxy-backed props keep the universal behaviour (keys can come and go)", () => {
+    const [extra, setExtra] = createSignal<Record<string, any>>({ width: 1 });
+    let el!: any;
+    createRoot((_keep) => {
+      el = R.createElement("view");
+      R.spread(el, merge({ color: "red" }, extra as any), true);
+    });
+    expect(setProps(takeOps()).sort()).toEqual([["color", "red"], ["width", 1]]);
+    setExtra({ height: 2 });
+    flush();
+    const after = setProps(takeOps());
+    expect(after).toContainEqual(["height", 2]);
+    expect(after).toContainEqual(["width", undefined]);
+  });
+
+  test("null or undefined props are a no-op", () => {
+    createRoot((_keep) => {
+      const el = R.createElement("view");
+      R.spread(el, undefined, false);
+      R.spread(el, null, false);
+      expect(el.props).toEqual({});
+    });
+  });
+});
