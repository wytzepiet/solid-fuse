@@ -0,0 +1,85 @@
+// Measurement plumbing shared by every scenario (report 10-js-thread).
+import { flushOps } from "solid-fuse";
+
+declare const fjs: { bridge_call: (v: any) => Promise<any> };
+
+const perf = (globalThis as any).performance;
+/** Monotonic milliseconds inside QuickJS. */
+export const now: () => number =
+  perf && typeof perf.now === "function" ? () => perf.now() : () => Date.now();
+export const clockKind = perf && typeof perf.now === "function" ? "performance.now" : "Date.now";
+
+export const stats = {
+  detail: false,
+  batches: 0,
+  ops: 0,
+  bytes: 0,
+  create: 0,
+  setProp: 0,
+  setText: 0,
+  insert: 0,
+  remove: 0,
+  sendMs: 0,
+};
+
+export function resetStats() {
+  stats.batches = stats.ops = stats.bytes = 0;
+  stats.create = stats.setProp = stats.setText = stats.insert = stats.remove = 0;
+  stats.sendMs = 0;
+}
+
+// Count what crosses the bridge. `detail` (op kinds + JSON byte size) costs JS
+// time, so timing passes run with it off and a separate pass turns it on.
+const origBridgeCall = fjs.bridge_call;
+fjs.bridge_call = function (msg: any) {
+  if (msg && msg.channel === "_ops") {
+    stats.batches++;
+    stats.ops += msg.ops.length;
+    if (stats.detail) {
+      stats.bytes += JSON.stringify(msg.ops).length;
+      for (const op of msg.ops) (stats as any)[op.op]++;
+      return origBridgeCall.call(fjs, msg);
+    }
+    const t = now();
+    const r = origBridgeCall.call(fjs, msg);
+    stats.sendMs += now() - t;
+    return r;
+  }
+  return origBridgeCall.call(fjs, msg);
+};
+
+export interface Timed {
+  jsMs: number;
+  sendMs: number;
+  ops: number;
+  batches: number;
+  bytes?: number;
+  kinds?: Record<string, number>;
+  [k: string]: any;
+}
+
+/** Run `fn`, then flush Solid effects and the op journal; report uninterrupted JS time. */
+export function timed(fn: () => void, extra: Record<string, any> = {}): Timed {
+  resetStats();
+  const t0 = now();
+  fn();
+  flushOps();
+  const jsMs = now() - t0;
+  const out: Timed = { jsMs, sendMs: stats.sendMs, ops: stats.ops, batches: stats.batches, ...extra };
+  if (stats.detail) {
+    out.bytes = stats.bytes;
+    out.kinds = {
+      create: stats.create,
+      setProp: stats.setProp,
+      setText: stats.setText,
+      insert: stats.insert,
+      remove: stats.remove,
+    };
+  }
+  return out;
+}
+
+export function busy(ms: number) {
+  const t = now();
+  while (now() - t < ms) {}
+}
diff --git a/examples/perf_bench/src/index.tsx b/examples/perf_bench/src/index.tsx
