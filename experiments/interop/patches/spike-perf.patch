+import 'dart:developer' show Timeline;
+
+/// Measurement instrumentation for the render-cost spike
+/// (experiments/interop/reports/11-render-cost.md). Every counter is inert
+/// unless [on] is set; nothing in the framework reads them.
+class FusePerf {
+  static bool on = false;
+
+  /// Bridge callback: `JsValue.value` (JsValue tree to Dart Map/List).
+  static int bridgeValueUs = 0;
+
+  /// Bridge callback: decoding a serialized op batch (JSON text to ops).
+  static int bridgeDecodeUs = 0;
+
+  /// Timeline.now when the last bridge callback was entered (after frb decode).
+  static int bridgeEnterAt = 0;
+
+  /// FuseNodeWidget.build plus its ListenableBuilder callback.
+  static int nodeBuildUs = 0;
+  static int nodeBuilds = 0;
+
+  /// build() of the registered widgets (FuseViewWidget, FuseText, ...).
+  static int widgetBuildUs = 0;
+  static int widgetBuilds = 0;
+
+  static int get now => Timeline.now;
+
+  static void reset() {
+    bridgeValueUs = bridgeDecodeUs = bridgeEnterAt = 0;
+    nodeBuildUs = nodeBuilds = widgetBuildUs = widgetBuilds = 0;
+  }
+}
