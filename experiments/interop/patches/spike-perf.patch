+// Part 2: the same curated component ("Box") implemented five ways.
+//
+//   Direct*   the app author writes the fat Dart `View` vocabulary by hand (baseline, one node)
+//   DartBox   friendly props cross the bridge raw; a Dart widget maps them (curated layer in Dart, one node)
+//   BoxNaive  TS wrapper: one memo maps everything, result is spread onto <View>            (one node)
+//   BoxJsx    TS wrapper: one JSX attribute expression per View prop                        (one node)
+//   BoxFine   TS wrapper: memo per composite prop, so unrelated changes resend nothing      (one node)
+//   BoxC3/6/12 the component composed in TS out of generated 1:1 primitives (3, 6, 12 nodes)
+import { View, nativeComponent } from "solid-fuse";
+import type { ViewProps } from "solid-fuse";
+import { createMemo } from "solid-js";
+import * as F from "~/_generated/flutter";
+
+export type Tone = "surface" | "muted" | "primary" | "danger" | "success";
+export type RadiusName = "none" | "sm" | "md" | "lg" | "full";
+export type ShadowName = "none" | "sm" | "md" | "lg";
+
+export interface BoxProps {
+  children?: any;
+  /** padding on all sides */
+  p?: number;
+  /** horizontal / vertical padding, override `p` */
+  px?: number;
+  py?: number;
+  /** margin on all sides / bottom only */
+  m?: number;
+  mb?: number;
+  /** background: a tone name or any colour */
+  bg?: Tone | (string & {});
+  radius?: RadiusName | number;
+  /** true = 1px */
+  border?: boolean | number;
+  borderColor?: string;
+  shadow?: ShadowName;
+  w?: number | "full";
+  h?: number;
+  minH?: number;
+  maxW?: number;
+  /** lay children out horizontally (default: vertically) */
+  row?: boolean;
+  gap?: number;
+  align?: "start" | "center" | "end" | "stretch";
+  justify?: "start" | "center" | "end" | "between";
+  /** centre the content inside the box */
+  center?: boolean;
+  opacity?: number;
+  hidden?: boolean;
+}
+
+const TONES: Record<string, string> = {
+  surface: "#ffffff",
+  muted: "#f2f3f5",
+  primary: "#3366ff",
+  danger: "#d64545",
+  success: "#2e9e5b",
+};
+const RADII: Record<string, number> = { none: 0, sm: 4, md: 8, lg: 16, full: 999 };
+const SHADOWS: Record<string, { color: string; blurRadius: number; offsetY: number }> = {
+  sm: { color: "#00000022", blurRadius: 2, offsetY: 1 },
+  md: { color: "#00000033", blurRadius: 6, offsetY: 2 },
+  lg: { color: "#00000044", blurRadius: 16, offsetY: 6 },
+};
+
+export const tone = (c: string | undefined) => (c == null ? undefined : TONES[c] ?? c);
+const radius = (r: BoxProps["radius"]) => (r == null ? undefined : typeof r === "number" ? r : RADII[r]);
+
+// ---- friendly -> View vocabulary ------------------------------------------------
+
+function vPadding(p?: number, px?: number, py?: number): ViewProps["padding"] {
+  if (px == null && py == null) return p;
+  return { horizontal: px ?? p ?? 0, vertical: py ?? p ?? 0 };
+}
+function vMargin(m?: number, mb?: number): ViewProps["margin"] {
+  if (mb == null) return m;
+  return m == null ? { bottom: mb } : { all: m, bottom: mb };
+}
+function vDecoration(
+  bg?: string, r?: BoxProps["radius"], border?: boolean | number, borderColor?: string, shadow?: ShadowName,
+): ViewProps["decoration"] {
+  if (bg == null && r == null && !border && (shadow == null || shadow === "none")) return undefined;
+  const d: NonNullable<ViewProps["decoration"]> = {};
+  if (bg != null) d.color = tone(bg);
+  if (r != null) d.borderRadius = radius(r);
+  if (border) d.border = { width: border === true ? 1 : border, color: borderColor ?? "#d0d0d0" };
+  if (shadow != null && shadow !== "none") d.shadow = SHADOWS[shadow];
+  return d;
+}
+function vFlex(row?: boolean, gap?: number, align?: BoxProps["align"], justify?: BoxProps["justify"]): ViewProps["flex"] {
+  if (!row && gap == null && align == null && justify == null) return undefined;
+  const f: NonNullable<ViewProps["flex"]> = {};
+  if (row) f.direction = "horizontal";
+  if (gap != null) f.gap = gap;
+  if (align != null) f.align = align;
+  if (justify != null) f.justify = justify === "between" ? "spaceBetween" : justify;
+  return f;
+}
+const vWidth = (w: BoxProps["w"]) => (w === "full" ? Infinity : w);
+const vWidthWire = (w: BoxProps["w"]) => (w === "full" ? 100000 : w); // Infinity is not JSON; View clamps
+
+function mapAll(props: BoxProps): ViewProps {
+  const out: ViewProps = {};
+  const padding = vPadding(props.p, props.px, props.py);
+  if (padding != null) out.padding = padding;
+  const margin = vMargin(props.m, props.mb);
+  if (margin != null) out.margin = margin;
+  const decoration = vDecoration(props.bg, props.radius, props.border, props.borderColor, props.shadow);
+  if (decoration) out.decoration = decoration;
+  const flex = vFlex(props.row, props.gap, props.align, props.justify);
+  if (flex) out.flex = flex;
+  if (props.w != null) out.width = vWidthWire(props.w);
+  if (props.h != null) out.height = props.h;
+  if (props.minH != null) out.minHeight = props.minH;
+  if (props.maxW != null) out.maxWidth = props.maxW;
+  if (props.center) out.alignment = "center";
+  if (props.opacity != null) out.opacity = props.opacity;
+  if (props.hidden) out.visible = false;
+  return out;
+}
+
+/** (ii-a) naive: any prop change re-runs the whole mapping and resends every object prop. */
+export function BoxNaive(props: BoxProps) {
+  const mapped = createMemo(() => mapAll(props));
+  return <View {...mapped()}>{props.children}</View>;
+}
+
+/** (ii-b) the obvious JSX: one expression per View prop. */
+export function BoxJsx(props: BoxProps) {
+  return (
+    <View
+      padding={vPadding(props.p, props.px, props.py)}
+      margin={vMargin(props.m, props.mb)}
+      decoration={vDecoration(props.bg, props.radius, props.border, props.borderColor, props.shadow)}
+      flex={vFlex(props.row, props.gap, props.align, props.justify)}
+      width={vWidthWire(props.w)}
+      height={props.h}
+      minHeight={props.minH}
+      maxWidth={props.maxW}
+      alignment={props.center ? "center" : undefined}
+      opacity={props.opacity}
+      visible={props.hidden ? false : undefined}
+    >
+      {props.children}
+    </View>
+  );
+}
+
+/** (ii-c) reactivity-preserving: composite props are memos, so identity is stable unless an input changed. */
+export function BoxFine(props: BoxProps) {
+  const padding = createMemo(() => vPadding(props.p, props.px, props.py));
+  const margin = createMemo(() => vMargin(props.m, props.mb));
+  const decoration = createMemo(() => vDecoration(props.bg, props.radius, props.border, props.borderColor, props.shadow));
+  const flex = createMemo(() => vFlex(props.row, props.gap, props.align, props.justify));
+  return (
+    <View
+      padding={padding()}
+      margin={margin()}
+      decoration={decoration()}
+      flex={flex()}
+      width={vWidthWire(props.w)}
+      height={props.h}
+      minHeight={props.minH}
+      maxWidth={props.maxW}
+      alignment={props.center ? "center" : undefined}
+      opacity={props.opacity}
+      visible={props.hidden ? false : undefined}
+    >
+      {props.children}
+    </View>
+  );
+}
+
+/** (i-b) curated layer in Dart: friendly props go over the bridge untouched. */
+export const DartBox = nativeComponent<BoxProps>("benchBox");
+
+// ---- friendly -> generated primitives ---------------------------------------------
+
+function gPadding(p?: number, px?: number, py?: number): F.EdgeInsetsGeometry {
+  if (px == null && py == null) return p ?? 0;
+  return { $: "symmetric", horizontal: px ?? p ?? 0, vertical: py ?? p ?? 0 };
+}
+function gDecoration(bg?: string, r?: BoxProps["radius"], shadow?: ShadowName): F.Decoration {
+  const d: any = { $: "BoxDecoration" };
+  if (bg != null) d.color = tone(bg);
+  if (r != null) d.borderRadius = radius(r);
+  if (shadow != null && shadow !== "none") {
+    const s = SHADOWS[shadow];
+    d.boxShadow = [{ color: s.color, blurRadius: s.blurRadius, offset: { dx: 0, dy: s.offsetY } }];
+  }
+  return d;
+}
+const gCross = (a: BoxProps["align"]): F.CrossAxisAlignment => a ?? "start";
+const gMain = (j: BoxProps["justify"]): F.MainAxisAlignment => (j === "between" ? "spaceBetween" : j ?? "start");
+
+function Flex(props: BoxProps) {
+  // row/column is structural; in this benchmark it never changes after mount.
+  return props.row ? (
+    <F.Row mainAxisSize="min" crossAxisAlignment={gCross(props.align)} mainAxisAlignment={gMain(props.justify)} spacing={props.gap ?? 0}>
+      {props.children}
+    </F.Row>
+  ) : (
+    <F.Column mainAxisSize="min" crossAxisAlignment={gCross(props.align)} mainAxisAlignment={gMain(props.justify)} spacing={props.gap ?? 0}>
+      {props.children}
+    </F.Column>
+  );
+}
+
+/** (iii) 3 nodes: DecoratedBox > Padding > Flex. Covers p/px/py, bg, row/gap/align/justify. */
+export function BoxC3(props: BoxProps) {
+  return (
+    <F.DecoratedBox decoration={gDecoration(props.bg, props.radius, props.shadow)}>
+      <F.Padding padding={gPadding(props.p, props.px, props.py)}>
+        <Flex {...props} />
+      </F.Padding>
+    </F.DecoratedBox>
+  );
+}
+
+/** (iii) 6 nodes: Opacity > SizedBox > DecoratedBox > Align > Padding > Flex. Adds radius, shadow, w/h, center, opacity. */
+export function BoxC6(props: BoxProps) {
+  return (
+    <F.Opacity opacity={props.opacity ?? 1}>
+      <F.SizedBox width={vWidth(props.w)} height={props.h}>
+        <F.DecoratedBox decoration={gDecoration(props.bg, props.radius, props.shadow)}>
+          <F.Align alignment={props.center ? "center" : "topLeft"}>
+            <F.Padding padding={gPadding(props.p, props.px, props.py)}>
+              <Flex {...props} />
+            </F.Padding>
+          </F.Align>
+        </F.DecoratedBox>
+      </F.SizedBox>
+    </F.Opacity>
+  );
+}
+
+/**
+ * (iii) 12 nodes: Flexible > Padding(margin) > Opacity > ConstrainedBox > SizedBox > DecoratedBox(border, foreground)
+ * > DecoratedBox > ClipRRect > ColoredBox > Align > Padding > Flex. Adds margin, min/max, border, clipping.
+ * Flexible(flex: 0) and the transparent ColoredBox are visual no-ops, present to reach 12 nodes.
+ */
+export function BoxC12(props: BoxProps) {
+  return (
+    <F.Flexible flex={0}>
+      <F.Padding padding={props.mb == null ? props.m ?? 0 : { $: "only", bottom: props.mb }}>
+        <F.Opacity opacity={props.opacity ?? 1}>
+          <F.ConstrainedBox constraints={{ minHeight: props.minH ?? 0, maxWidth: props.maxW ?? 100000 }}>
+            <F.SizedBox width={vWidth(props.w)} height={props.h}>
+              <F.DecoratedBox
+                position="foreground"
+                decoration={{
+                  $: "BoxDecoration",
+                  borderRadius: radius(props.radius),
+                  border: props.border
+                    ? { $: "all", width: props.border === true ? 1 : props.border, color: (props.borderColor ?? "#d0d0d0") as any }
+                    : undefined,
+                }}
+              >
+                <F.DecoratedBox decoration={gDecoration(props.bg, props.radius, props.shadow)}>
+                  <F.ClipRRect borderRadius={radius(props.radius) ?? 0}>
+                    <F.ColoredBox color="#00000000">
+                      <F.Align alignment={props.center ? "center" : "topLeft"}>
+                        <F.Padding padding={gPadding(props.p, props.px, props.py)}>
+                          <Flex {...props} />
+                        </F.Padding>
+                      </F.Align>
+                    </F.ColoredBox>
+                  </F.ClipRRect>
+                </F.DecoratedBox>
+              </F.DecoratedBox>
+            </F.SizedBox>
+          </F.ConstrainedBox>
+        </F.Opacity>
+      </F.Padding>
+    </F.Flexible>
+  );
+}
