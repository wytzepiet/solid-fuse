+// FuseRuntime.applyOps: the Dart end of the op journal written by
+// src/renderer.ts (flat array: opcode, operands, opcode, operands, ...).
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+// Opcodes, as in src/renderer.ts.
+const create = 0, createText = 1, setProp = 2, setText = 3, insert = 4, remove = 5, dispose = 6;
+
+void main() {
+  late FuseRuntime rt;
+  FuseNode node(int id) => rt.registry.get(id);
+  List<int> childIds(int id) => node(id).children.map((c) => c.id).toList();
+
+  setUp(() => rt = FuseRuntime.forTest());
+
+  test('create carries its props; insert builds the tree; returns the op count', () {
+    final n = rt.applyOps([
+      create, 1, 'view', {'width': 40, 'padding': {'left': 1}},
+      create, 2, 'text', <String, dynamic>{},
+      createText, 3, 'hello',
+      insert, 2, 3, 0,
+      insert, 1, 2, 0,
+      insert, 0, 1, 0,
+    ]);
+    expect(n, 6);
+    expect(node(1).type, 'view');
+    expect(node(1).props, {'width': 40, 'padding': {'left': 1}});
+    expect(node(3).type, '__text__');
+    expect(node(3).props['text'], 'hello');
+    expect(childIds(0), [1]);
+    expect(childIds(1), [2]);
+    expect(node(2).parent, same(node(1)));
+  });
+
+  test('the same batch decoded from JSON text applies identically', () {
+    rt.applyOps(jsonDecode('[0,1,"view",{"width":40,"flex":{"gap":2}},1,2,"a",4,1,2,0,4,0,1,0,2,1,"height",1.5,3,2,"b"]') as List);
+    expect(node(1).props, {'width': 40, 'flex': {'gap': 2}, 'height': 1.5});
+    expect(node(2).props['text'], 'b');
+    expect(childIds(0), [1]);
+  });
+
+  test('create takes the decoded props map without copying it', () {
+    final props = <String, dynamic>{'width': 1};
+    rt.applyOps([create, 1, 'view', props]);
+    expect(node(1).props, same(props));
+  });
+
+  test('the dev-only _component prop becomes FuseNode.component', () {
+    rt.applyOps([create, 1, 'view', <String, dynamic>{'_component': 'Profile', 'width': 1}]);
+    expect(node(1).component, 'Profile');
+    expect(node(1).props, {'width': 1});
+  });
+
+  test('setProp and setText notify the node (and a text node its parent)', () {
+    rt.applyOps([create, 1, 'text', <String, dynamic>{}, createText, 2, 'a', insert, 1, 2, 0]);
+    var parentNotified = 0, textNotified = 0;
+    node(1).addListener(() => parentNotified++);
+    node(2).addListener(() => textNotified++);
+    rt.applyOps([setText, 2, 'b']);
+    expect(node(2).props['text'], 'b');
+    expect([parentNotified, textNotified], [1, 1]);
+    rt.applyOps([setProp, 1, 'fontSize', 12, setProp, 1, 'color', 'red']);
+    expect(node(1).props, {'fontSize': 12, 'color': 'red'});
+    expect(parentNotified, 2); // once per batch, not once per op
+  });
+
+  test('a {_node: id} prop resolves to the node, also inside a list', () {
+    rt.applyOps([
+      create, 1, 'appBar', <String, dynamic>{},
+      create, 2, 'view', <String, dynamic>{},
+      create, 3, 'view', <String, dynamic>{},
+      setProp, 1, 'title', {'_node': 2},
+      setProp, 1, 'actions', [{'_node': 3}, 'plain'],
+    ]);
+    expect(node(1).props['title'], same(node(2)));
+    expect(node(1).props['actions'], [same(node(3)), 'plain']);
+  });
+
+  test('replacing a node-valued prop disposes the previous node', () {
+    rt.applyOps([
+      create, 1, 'appBar', <String, dynamic>{},
+      create, 2, 'view', <String, dynamic>{},
+      create, 3, 'view', <String, dynamic>{},
+      setProp, 1, 'title', {'_node': 2},
+    ]);
+    rt.applyOps([setProp, 1, 'title', {'_node': 3}]);
+    expect(rt.registry.tryGet(2), isNull);
+    expect(node(1).props['title'], same(node(3)));
+  });
+
+  test('remove disposes the subtree at the end of the batch', () {
+    rt.applyOps([
+      create, 1, 'view', <String, dynamic>{},
+      create, 2, 'view', <String, dynamic>{},
+      insert, 1, 2, 0,
+      insert, 0, 1, 0,
+    ]);
+    rt.applyOps([remove, 0, 1]);
+    expect(childIds(0), isEmpty);
+    expect(rt.registry.tryGet(1), isNull);
+    expect(rt.registry.tryGet(2), isNull);
+  });
+
+  test('remove followed by insert of the same node in one batch is a move, not a disposal', () {
+    // Solid's keyed reconciler moves a row as removeNode + insertNode.
+    rt.applyOps([
+      for (final id in [1, 2, 3]) ...[create, id, 'view', <String, dynamic>{}],
+      insert, 0, 1, 0, insert, 0, 2, 1, insert, 0, 3, 2,
+    ]);
+    final first = node(1);
+    rt.applyOps([remove, 0, 1, insert, 0, 1, 2]);
+    expect(childIds(0), [2, 3, 1]);
+    expect(rt.registry.tryGet(1), same(first));
+    expect(first.parent, same(node(0)));
+  });
+
+  test('insert of a node that is still attached moves it', () {
+    rt.applyOps([
+      for (final id in [1, 2, 3]) ...[create, id, 'view', <String, dynamic>{}],
+      insert, 0, 1, 0, insert, 0, 2, 1, insert, 0, 3, 2,
+    ]);
+    rt.applyOps([insert, 0, 3, 0]);
+    expect(childIds(0), [3, 1, 2]);
+    rt.applyOps([create, 4, 'view', <String, dynamic>{}, insert, 0, 4, 0, insert, 4, 1, 0]);
+    expect(childIds(0), [4, 3, 2]);
+    expect(childIds(4), [1]);
+  });
+
+  test('a full reversal expressed as moves keeps every node', () {
+    rt.applyOps([
+      for (var id = 1; id <= 5; id++) ...[create, id, 'view', <String, dynamic>{}, insert, 0, id, id - 1],
+    ]);
+    rt.applyOps([
+      for (var id = 4; id >= 1; id--) ...[remove, 0, id, insert, 0, id, 4],
+    ]);
+    expect(childIds(0), [5, 4, 3, 2, 1]);
+    for (var id = 1; id <= 5; id++) {
+      expect(rt.registry.tryGet(id), isNotNull);
+    }
+  });
+
+  test('dispose removes a node; disposing an unknown id is ignored', () {
+    rt.applyOps([create, 1, 'scrollController', <String, dynamic>{}]);
+    rt.applyOps([dispose, 1, dispose, 99]);
+    expect(rt.registry.tryGet(1), isNull);
+  });
+
+  test('a handle factory sees the props of the create op', () {
+    Map<String, dynamic>? seen;
+    rt.registerHandle('thing', (n) {
+      seen = Map.of(n.props);
+      return _Handle(n);
+    });
+    rt.applyOps([create, 1, 'thing', {'initialOffset': 12}]);
+    expect(seen, {'initialOffset': 12});
+    expect(node(1).ownHandle, isA<_Handle>());
+  });
+
+  test('an unknown opcode is an error', () {
+    expect(() => rt.applyOps([42, 1]), throwsStateError);
+  });
+}
+
+class _Handle extends FuseHandle<Object> {
+  _Handle(super.node);
+  @override
+  Object get object => this;
+}
