+// --- Template prototype (experimental, hand-wired) ---
+//
+// A template describes a fixed subtree once; `_cloneTemplate` then creates a
+// whole instance with one op carrying only the values of its holes. Dart
+// builds the nodes (ids firstId, firstId+1, ... in pre-order). JS keeps a
+// FuseNode for the instance root only, so nothing inside an instance can be
+// updated or listened to from JS yet: this exists to measure the ceiling of a
+// compiler-emitted template op, not to be used by apps.
+
+/** An element: static props `p`, props read from the hole values `h` (prop name to index), children `c`. A text leaf: `x` (static) or `xh` (hole index). */
+export type TemplateShape =
+  | { t: string; p?: Record<string, any>; h?: Record<string, number>; c?: TemplateShape[] }
+  | { x: string }
+  | { xh: number };
+
+export interface Template { id: number; type: string; size: number }
