diff --git a/examples/perf_bench/tools/run-builds.sh b/examples/perf_bench/tools/run-builds.sh
new file mode 100755
index 0000000..01d3cd3
--- /dev/null
+++ b/examples/perf_bench/tools/run-builds.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Runs one suite on several saved app bundles back to back (report 11).
+#   BUILDS=/path/to/builds tools/run-builds.sh <suite> <reps> <tag> <name> [<name> ...]
+# Each <name> is a directory under $BUILDS holding a copy of
+# dart/build/linux/x64/release/bundle. Output: results/r11/<suite>-<name><tag>.txt
+# Waits for the 1-minute load average to drop below 0.6 before each run.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+suite=$1; reps=$2; tag=$3; shift 3
+for name in "$@"; do
+  until awk '{exit !($1 < 0.6)}' /proc/loadavg; do sleep 5; done
+  BIN=$BUILDS/$name/perf_bench tools/run.sh "$suite" "$reps" "results/r11/$suite-$name$tag.txt"
+done
diff --git a/packages/solid-fuse/dart/lib/src/fjs/libfjs/Cargo.toml b/packages/solid-fuse/dart/lib/src/fjs/libfjs/Cargo.toml
index 93c29ff..3b264ed 100644
--- a/packages/solid-fuse/dart/lib/src/fjs/libfjs/Cargo.toml
+++ b/packages/solid-fuse/dart/lib/src/fjs/libfjs/Cargo.toml
@@ -67,6 +67,13 @@ lto = true  # Enable link time optimization
 codegen-units = 1  # Reduce parallel code generation units
 #panic = "abort"
 
+# The QuickJS interpreter itself is built for speed: its C sources are compiled
+# by rquickjs-sys's build script at this level (-O3 instead of -Os), which is
+# where the JS run time goes; the Rust crates stay size-optimized.
+# See solid-fuse experiments/interop/reports/11-render-cost.md.
+[profile.release.package.rquickjs-sys]
+opt-level = 3
+
 # Optimize dependencies even in dev builds. `flutter run` (debug) compiles via
 # the cargo dev profile, so QuickJS would otherwise be unoptimized: its big
 # recursive interpreter (JS_CallInternal) then spills every local to the stack,
-- 
