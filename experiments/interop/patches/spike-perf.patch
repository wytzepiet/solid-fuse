+// Report 11, part A.3: where the UI-thread time goes.
+//
+//   attr     mounts with FusePerf counters and per-phase frame timing (build /
+//            layout / paint), element and render-object counts, the cost of
+//            each decode step of the op batch, and the same cards written as
+//            plain Flutter widgets (what Flutter itself costs for this UI).
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/scheduler.dart';
+// ignore: implementation_imports
+import 'package:solid_fuse/src/fjs/lib/src/frb/frb_generated.dart';
+import 'package:solid_fuse/solid_fuse.dart';
+
+import 'harness.dart';
+
+/// Splits a frame into build, layout, paint and the rest (compositing,
+/// semantics). The early calls leave nothing dirty for super.drawFrame().
+class BenchBinding extends WidgetsFlutterBinding {
+  static int buildUs = 0, layoutUs = 0, paintUs = 0, restUs = 0;
+
+  @override
+  void drawFrame() {
+    final t0 = now();
+    final root = rootElement;
+    if (root != null) buildOwner!.buildScope(root);
+    final t1 = now();
+    rootPipelineOwner.flushLayout();
+    final t2 = now();
+    rootPipelineOwner.flushCompositingBits();
+    rootPipelineOwner.flushPaint();
+    final t3 = now();
+    super.drawFrame();
+    final t4 = now();
+    buildUs = t1 - t0;
+    layoutUs = t2 - t1;
+    paintUs = t3 - t2;
+    restUs = t4 - t3;
+  }
+}
+
+Map<String, dynamic> phases() => {
+      'buildMs': ms(BenchBinding.buildUs),
+      'layoutMs': ms(BenchBinding.layoutUs),
+      'paintMs': ms(BenchBinding.paintUs),
+      'restMs': ms(BenchBinding.restUs),
+    };
+
+Map<String, int> treeCounts() {
+  var elements = 0, renderObjects = 0, fuseNodes = 0, stateful = 0;
+  void visit(Element e) {
+    elements++;
+    if (e is RenderObjectElement) renderObjects++;
+    if (e is StatefulElement) stateful++;
+    if (e.widget is FuseNodeWidget) fuseNodes++;
+    e.visitChildren(visit);
+  }
+
+  WidgetsBinding.instance.rootElement?.visitChildren(visit);
+  return {'elements': elements, 'renderObjects': renderObjects, 'fuseNodeWidgets': fuseNodes, 'statefulElements': stateful};
+}
+
+// ---- the same card in plain Flutter ---------------------------------------------
+
+final nativeCards = ValueNotifier<int>(0);
+const _colors = [0xFF3366FF, 0xFF2E9E5B, 0xFFE08A00, 0xFFD64545, 0xFF7A4FD6, 0xFF0AA5A5, 0xFFC2478F, 0xFF5B6B7A];
+
+class NativeCard extends StatelessWidget {
+  const NativeCard(this.i, {super.key});
+  final int i;
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 8),
+      child: DecoratedBox(
+        decoration: BoxDecoration(
+          color: const Color(0xFFFFFFFF),
+          borderRadius: BorderRadius.circular(12),
+          border: Border.all(color: const Color(0xFFE2E2E2)),
+        ),
+        child: Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            spacing: 12,
+            children: [
+              SizedBox(
+                width: 40,
+                height: 40,
+                child: DecoratedBox(
+                  decoration: BoxDecoration(color: Color(_colors[i % 8]), shape: BoxShape.circle),
+                  child: Align(
+                    child: Text(String.fromCharCode(65 + i % 26),
+                        style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
+                  ),
+                ),
+              ),
+              Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.start,
+                spacing: 2,
+                children: [
+                  Text('Item title $i', style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
+                  Text('Subtitle for row $i, with some detail',
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(fontSize: 13, color: Color(0xFF666666))),
+                ],
+              ),
+              Text('${i % 60}m', style: const TextStyle(fontSize: 12, color: Color(0xFF999999))),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class NativeScreen extends StatelessWidget {
+  const NativeScreen(this.cards, {super.key});
+  final int cards;
+  @override
+  Widget build(BuildContext context) {
+    return SingleChildScrollView(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [for (var i = 0; i < cards; i++) NativeCard(i)],
+        ),
+      ),
+    );
+  }
+}
+
+// ---- decode steps ------------------------------------------------------------------
+
+/// A Dart value in the shape flutter_rust_bridge delivers a `JsValue` (DCO):
+/// `[tag, payload]`, objects as lists of `[key, value]`.
+dynamic toDco(dynamic v) {
+  if (v == null) return [0];
+  if (v is bool) return [1, v];
+  if (v is int) return [2, v];
+  if (v is double) return [3, v];
+  if (v is String) return [5, v];
+  if (v is List) return [7, v.map(toDco).toList()];
+  if (v is Map) return [8, v.entries.map((e) => [e.key as String, toDco(e.value)]).toList()];
+  throw StateError('unsupported ${v.runtimeType}');
+}
+
+int _leaves(dynamic v) {
+  if (v is List) return v.fold(0, (a, e) => a + _leaves(e));
+  if (v is Map) return v.values.fold(0, (a, e) => a + _leaves(e));
+  return 1;
+}
+
+Future<void> attr() async {
+  const s = 'attr';
+  final reps = envInt('REPS', 5);
+  FusePerf.on = true;
+
+  for (var r = 0; r < reps; r++) {
+    for (final n in [1000, 5000]) {
+      await cmd('clear');
+      await settle();
+      final before = treeCounts();
+      FusePerf.reset();
+      final m = await measure(s, 'mount_$n', 'mount', {'nodes': n}, {'rep': r});
+      final after = treeCounts();
+      emit(s, 'mount_${n}_detail', {
+        'rep': r,
+        'jsMs': m['jsMs'],
+        'sendMs': m['sendMs'],
+        'toRecvMs': m['toRecvMs'],
+        'decodeMs': m['decodeMs'],
+        'applyMs': m['applyMs'],
+        'uiFrameMs': m['uiFrameMs'],
+        ...phases(),
+        'bridgeValueMs': ms(FusePerf.bridgeValueUs),
+        'bridgeDecodeMs': ms(FusePerf.bridgeDecodeUs),
+        'nodeBuildMs': ms(FusePerf.nodeBuildUs),
+        'nodeBuilds': FusePerf.nodeBuilds,
+        'widgetBuildMs': ms(FusePerf.widgetBuildUs),
+        'widgetBuilds': FusePerf.widgetBuilds,
+        for (final k in after.keys) k: after[k]! - before[k]!,
+      });
+      await settle();
+    }
+    await cmd('clear');
+    await settle();
+
+    // The same UI as plain Flutter widgets.
+    for (final cards in [91, 454]) {
+      final before = treeCounts();
+      final t0 = now();
+      nativeCards.value = cards;
+      await SchedulerBinding.instance.endOfFrame;
+      final t1 = now();
+      final after = treeCounts();
+      emit(s, 'native_cards_$cards', {
+        'rep': r,
+        'totalMs': ms(t1 - t0),
+        ...phases(),
+        for (final k in after.keys) k: after[k]! - before[k]!,
+      });
+      await settle();
+      nativeCards.value = 0;
+      await settle(100);
+    }
+  }
+
+  // Decode steps on a captured 1,000- and 5,000-node batch.
+  await cmd('keepLast', {'on': true});
+  final api = LibFjs.instance.api as LibFjsApiImpl;
+  for (final n in [1000, 5000]) {
+    await cmd('clear');
+    await settle();
+    await cmd('mount', {'nodes': n});
+    await settle();
+    final j = await cmd('opsJsonText');
+    final text = j['s'] as String;
+    for (var r = 0; r < reps; r++) {
+      final t0 = now();
+      final ops = jsonDecode(text) as List;
+      final t1 = now();
+      final raw = toDco({'channel': '_ops', 'ops': ops});
+      final t2 = now();
+      // ignore: invalid_use_of_protected_member
+      final jsv = api.dco_decode_js_value(raw);
+      final t3 = now();
+      final value = jsv.value as Map;
+      final t4 = now();
+      final payload = Map<String, dynamic>.from(value)..remove('channel');
+      var copies = 0;
+      for (final op in payload['ops'] as List) {
+        final map = op is Map<String, dynamic> ? op : Map<String, dynamic>.from(op as Map);
+        if (map['op'] == 'create') {
+          Map<String, dynamic>.from(map['props'] as Map);
+          copies++;
+        }
+      }
+      final t5 = now();
+      emit(s, 'decode_steps_$n', {
+        'rep': r,
+        'ops': ops.length,
+        'leaves': _leaves(ops),
+        'bytes': text.length,
+        'jsonDecodeMs': ms(t1 - t0),
+        'dcoDecodeMs': ms(t3 - t2),
+        'valueMs': ms(t4 - t3),
+        'mapCopiesMs': ms(t5 - t4),
+        'createCopies': copies,
+      });
+      await settle(20);
+    }
+  }
+  await cmd('keepLast', {'on': false});
+  await cmd('clear');
+  FusePerf.on = false;
+}
