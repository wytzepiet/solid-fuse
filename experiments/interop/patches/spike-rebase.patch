diff --git a/packages/solid-fuse/dart/lib/src/fjs/libfjs/src/tests/bench_harness.rs b/packages/solid-fuse/dart/lib/src/fjs/libfjs/src/tests/bench_harness.rs
new file mode 100644
index 0000000..8cdbc96
--- /dev/null
+++ b/packages/solid-fuse/dart/lib/src/fjs/libfjs/src/tests/bench_harness.rs
@@ -0,0 +1,121 @@
+//! JS-only benchmark harness (solid-fuse examples/perf_bench; fork-only, not upstream).
+//!
+//! Loads a solid-fuse bundle into a real `JsEngine` with a Rust-side bridge
+//! sink, so the interpreter and `fjs.bridge_call` (JS value -> `JsValue`) can
+//! be timed and profiled without Flutter. Ignored by default:
+//!
+//! ```sh
+//! FJS_BENCH_BUNDLE=/path/bundle.js FJS_BENCH_CMDS=/path/cmds.jsonl \
+//!   cargo test --release bench_harness -- --ignored --nocapture
+//! ```
+//!
+//! `cmds.jsonl`: one JSON object per line, `{"cmd": "...", ...args}`, sent to
+//! the bundle's `bench` channel. `FJS_BENCH_GC=<bytes|off>` sets the GC
+//! threshold, `FJS_BENCH_NOMEM=1` skips the heap statistics (for profiling).
+
+use crate::api::engine::{JsEngine, JsEngineRuntimeOptions};
+use crate::api::error::JsResult;
+use crate::api::source::{JsBuiltinOptions, JsCode};
+use crate::api::value::JsValue;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+#[tokio::test(flavor = "multi_thread")]
+#[ignore]
+async fn bench_harness() {
+    let Ok(bundle_path) = std::env::var("FJS_BENCH_BUNDLE") else {
+        eprintln!("FJS_BENCH_BUNDLE not set");
+        return;
+    };
+    let cmds = std::fs::read_to_string(std::env::var("FJS_BENCH_CMDS").unwrap()).unwrap();
+    let source = std::fs::read_to_string(&bundle_path).unwrap();
+    let gc = std::env::var("FJS_BENCH_GC").ok().map(|v| {
+        if v == "off" { usize::MAX } else { v.parse::<usize>().unwrap() }
+    });
+
+    let engine = JsEngine::create(
+        Some(JsBuiltinOptions::all()),
+        None,
+        Some(JsEngineRuntimeOptions { gc_threshold: gc, ..Default::default() }),
+    )
+    .await
+    .unwrap();
+
+    let calls = Arc::new(AtomicU64::new(0));
+    let c2 = calls.clone();
+    // FJS_BENCH_INTODART=1: also do what flutter_rust_bridge does next with the
+    // value (JsValue -> DartCObject tree) and time it, and its drop.
+    let into_dart = std::env::var("FJS_BENCH_INTODART").is_ok();
+    let into_ns = Arc::new(AtomicU64::new(0));
+    let drop_ns = Arc::new(AtomicU64::new(0));
+    let (i2, d2) = (into_ns.clone(), drop_ns.clone());
+    engine
+        .init(move |_v: JsValue| {
+            c2.fetch_add(1, Ordering::Relaxed);
+            if into_dart {
+                use flutter_rust_bridge::{IntoDart, IntoIntoDart};
+                let t = Instant::now();
+                let d = _v.into_into_dart().into_dart();
+                i2.fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                let t = Instant::now();
+                drop(d);
+                d2.fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            }
+            Box::pin(async move { JsResult::Ok(JsValue::None) })
+        })
+        .await
+        .unwrap();
+    engine
+        .eval(
+            JsCode::Code(
+                "globalThis.__fuseHost = { mode: 'release', platform: 'linux', brightness: 'light' };"
+                    .to_string(),
+            ),
+            None,
+        )
+        .await
+        .unwrap();
+
+    let t = Instant::now();
+    engine.eval(JsCode::Code(source), None).await.unwrap();
+    println!("HARNESS eval_source_ms={:.2}", t.elapsed().as_secs_f64() * 1e3);
+
+    for line in cmds.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let mem = std::env::var("FJS_BENCH_NOMEM").is_err();
+        let (h0, o0) = if mem {
+            let m = engine.memory_usage().await.unwrap();
+            (m.memory_used_size(), m.obj_count())
+        } else {
+            (0, 0)
+        };
+        let (in0, dr0) = (into_ns.load(Ordering::Relaxed), drop_ns.load(Ordering::Relaxed));
+        let t = Instant::now();
+        let code = format!(
+            "globalThis.__dispatch('bench', {line}).then((r) => JSON.stringify(r))"
+        );
+        let r = engine.eval(JsCode::Code(code), None).await;
+        let wall = t.elapsed().as_secs_f64() * 1e3;
+        let (h1, o1) = if mem {
+            let m = engine.memory_usage().await.unwrap();
+            (m.memory_used_size(), m.obj_count())
+        } else {
+            (0, 0)
+        };
+        match r {
+            Ok(JsValue::String(s)) => println!(
+                "HARNESS {{\"in\":{line},\"wallMs\":{wall:.3},\"heap0\":{},\"heap1\":{},\"obj0\":{},\"obj1\":{},\"bridgeCalls\":{},\"intoDartMs\":{:.3},\"dropDartMs\":{:.3},\"out\":{s}}}",
+                h0, h1, o0, o1,
+                calls.load(Ordering::Relaxed),
+                (into_ns.load(Ordering::Relaxed) - in0) as f64 / 1e6,
+                (drop_ns.load(Ordering::Relaxed) - dr0) as f64 / 1e6
+            ),
+            other => println!("HARNESS_ERROR {line}: {other:?}"),
+        }
+    }
+    engine.close().await.unwrap();
+}
