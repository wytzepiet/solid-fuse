 import 'fuse_handle.dart';
 import 'node.dart';
+import 'perf.dart';
 import 'quickjs_connection.dart';
 
 /// Signature for a Fuse widget builder.
@@ -34,6 +36,9 @@ class FuseRuntime {
 
   FuseConnection? _connection;
 
+  /// The app-level channels, for benchmark drivers (examples/perf_bench).
+  FuseChannels? get perfChannels => _connection?.channels;
+
   final Map<String, FuseWidgetBuilder> _widgetBuilders = {};
   final Map<String, FuseHandle Function(FuseNode node)> _handleFactories = {};
   late final FuseNodeRegistry registry;
@@ -137,9 +142,22 @@ class FuseRuntime {
         // JS sends each batch as one JSON string (see flushOps in
         // renderer.ts); `ops` is accepted for older bundles.
         final json = data['json'];
-        applyOps(json is String
-            ? jsonDecode(json) as List<dynamic>
-            : data['ops'] as List<dynamic>);
+        final hook = FusePerf.onOps;
+        if (hook == null) {
+          applyOps(json is String
+              ? jsonDecode(json) as List<dynamic>
+              : data['ops'] as List<dynamic>);
+        } else {
+          // Benchmark only (examples/perf_bench): same calls, timed.
+          final td = FusePerf.now;
+          final ops = json is String
+              ? jsonDecode(json) as List<dynamic>
+              : data['ops'] as List<dynamic>;
+          final t0 = FusePerf.now;
+          FusePerf.decodeUs += t0 - td;
+          applyOps(ops);
+          hook(ops.length, t0, FusePerf.now - t0);
+        }
       } catch (e, st) {
         debugPrint('[Fuse] ops error: $e\n$st');
       }
