diff --git a/packages/solid-fuse/dart/lib/src/perf.dart b/packages/solid-fuse/dart/lib/src/perf.dart
new file mode 100644
index 0000000..c24ddee
--- /dev/null
+++ b/packages/solid-fuse/dart/lib/src/perf.dart
@@ -0,0 +1,20 @@
+import 'dart:developer' show Timeline;
+
+/// Measurement hooks for the render benchmark (examples/perf_bench). Inert
+/// unless [onOps] is set; nothing in the framework reads the counters.
+class FusePerf {
+  /// Called after every `_ops` batch with (op count, Timeline.now when
+  /// applyOps started, microseconds spent in applyOps). Null in normal use.
+  static void Function(int opCount, int recvMicros, int applyMicros)? onOps;
+
+  /// Microseconds spent in `jsonDecode` of op batches (only while [onOps] is set).
+  static int decodeUs = 0;
+
+  /// Timeline.now when the last bridge callback was entered (only while [onOps] is set).
+  static int bridgeEnterAt = 0;
+
+  /// Microseconds spent in `JsValue.value` in the bridge callback (only while [onOps] is set).
+  static int bridgeValueUs = 0;
+
+  static int get now => Timeline.now;
+}
