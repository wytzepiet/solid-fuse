+#!/usr/bin/env python3
+"""Command list for the JS-only harness, report 12 (tools/harness.sh): the
+operations of the `core` suite without Flutter, so the same list can be run
+against bundles built with different FUSE_TEMPLATES settings."""
+import json
+def p(**k): print(json.dumps(k))
+REPS = 9
+for _ in range(3):
+    p(cmd="mount", nodes=1000); p(cmd="clear")
+for n in (200, 1000, 5000):
+    for _ in range(REPS):
+        p(cmd="mount", nodes=n); p(cmd="clear")
+p(cmd="listPrep", n=500)
+for _ in range(REPS + 2):
+    p(cmd="listReplace", n=500)
+p(cmd="clear")
+for _ in range(REPS):
+    p(cmd="listPrep", n=500); p(cmd="clear")
+for c in ("listPrepStatic", "listPrepTpl"):
+    for _ in range(REPS):
+        p(cmd=c, n=500); p(cmd="clear")
+p(cmd="updPrep")
+for sig in ("t1", "t50", "t1000", "c1000"):
+    for _ in range(REPS + 2):
+        p(cmd="upd", sig=sig)
+p(cmd="clear")
+for _ in range(REPS):
+    p(cmd="listPrep", n=2000); p(cmd="listSort"); p(cmd="listShuffle"); p(cmd="listReverse"); p(cmd="listFilter"); p(cmd="clear")
+for m in ("effect_static", "effect_tracking", "memo", "signal", "createComponent", "closure", "node_plain", "insert_static_text", "insert_dynamic_text",
+          "tpl_const5", "tpl_once2", "tpl_once2_child", "tpl_dyn2_static", "tpl_dyn2_tracking", "tpl_dyn2_child", "tpl_dyn2_perhole", "tpl_dyn1_prop", "tpl_node_child",
+          "x_node_inst", "x_effect_arr", "x_effect_arr_apply"):
+    p(cmd="micro", m=m, n=5000, reps=9)
