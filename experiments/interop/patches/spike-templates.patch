+let moduleCount = 0;
+/**
+ * Mounts `src` (which exports `setup()` returning `{ view, steps, calls? }`)
+ * compiled with and without templates, and returns the tree after mount and
+ * after each step for both, with op counts.
+ */
+async function both(src: string, options: TemplateOptions = {}) {
+  const run = async (templates: TemplateOptions | false) => {
+    const code = compile(src, templates)
+      .replaceAll('from "solid-fuse"', `from ${JSON.stringify(join(import.meta.dir, "../src/renderer.ts"))}`);
+    const file = join(tmp, `m${moduleCount++}.mjs`);
+    writeFileSync(file, code);
+    const mod = await import(file);
+    R.flushOps();
+    sent.length = 0;
+    const model = new Model();
+    let s: any;
+    const dispose = R.render(() => {
+      s = mod.setup();
+      return s.view();
+    });
+    drain(model);
+    const mountOps = model.opCount;
+    const trees = [model.snapshot()];
+    for (const step of s.steps ?? []) {
+      step(model);
+      R.flush();
+      drain(model);
+      trees.push(model.snapshot());
+    }
+    const log = s.log;
+    dispose();
+    drain(model);
+    return { trees, mountOps, ops: model.opCount, bytes: model.bytes, log, model, code };
+  };
+  const plain = await run(false);
+  const tpl = await run(options);
+  return { plain, tpl };
+}
+
+/** Both compilations build the same tree after mount and after every step. */
+async function same(src: string, options?: TemplateOptions) {
+  const r = await both(src, options);
+  expect(r.tpl.trees).toEqual(r.plain.trees);
+  expect(r.tpl.log).toEqual(r.plain.log);
+  // and the tree is empty again after dispose in both
+  expect(r.tpl.model.get(0).children).toHaveLength(0);
+  return r;
+}
