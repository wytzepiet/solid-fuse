@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""JS-only harness results (HARNESS lines), report 12.
+
+    python3 tools/r12-agg.py results/r12/h-base.txt results/r12/h-block.txt ...
+
+One column per file: median (min-max) of jsMs over the repetitions of each
+command, the first 2 of a repeated update/replace dropped as warm-up, and the
+op count of one run.
+"""
+import json, sys, os
+from statistics import median
+
+def key(c):
+    cmd = c["cmd"]
+    if cmd == "mount": return f"mount {c['nodes']}"
+    if cmd == "upd": return f"upd {c['sig']}"
+    if cmd.startswith("listPrep") or cmd == "listReplace": return f"{cmd} {c['n']}"
+    if cmd == "micro": return f"micro {c['m']} (us each)"
+    return cmd
+
+def load(path):
+    rows, ops = {}, {}
+    for line in open(path):
+        if not line.startswith("HARNESS {"): continue
+        d = json.loads(line[8:])
+        c, out = d["in"], d["out"]
+        if not isinstance(out, dict): continue
+        k = key(c)
+        if c["cmd"] == "micro":
+            # runs: [{ms, ...}] for n iterations each
+            for r in out.get("runs", []):
+                rows.setdefault(k, []).append((r["nsPerIter"] + r["flushNsPerIter"]) / 1000)
+            continue
+        else:
+            v = out.get("jsMs")
+        if v is None: continue
+        rows.setdefault(k, []).append(v)
+        if "ops" in out: ops[k] = out["ops"]
+    return rows, ops
+
+def fmt(v):
+    if not v: return "–"
+    m = median(v)
+    nd = 0 if m >= 100 else (1 if m >= 10 else 2)
+    return f"{m:.{nd}f} ({min(v):.{nd}f}–{max(v):.{nd}f})"
+
+files = sys.argv[1:]
+data = [load(f) for f in files]
+keys = []
+for rows, _ in data:
+    for k in rows:
+        if k not in keys: keys.append(k)
+names = [os.path.basename(f).replace(".txt", "") for f in files]
+print("| JS ms | " + " | ".join(f"{n} | ops" for n in names) + " |")
+print("|---|" + "---:|---:|" * len(names))
+for k in keys:
+    if k == "clear": continue
+    cells = []
+    for rows, ops in data:
+        v = rows.get(k, [])
+        if k.startswith(("upd", "listReplace")) and len(v) > 4: v = v[2:]
+        cells.append(f"{fmt(v)} | {ops.get(k, '')}")
+    print(f"| {k} | " + " | ".join(cells) + " |")
+for f in files:
+    for line in open(f):
+        if line.startswith("#"): print(os.path.basename(f), line.strip())
