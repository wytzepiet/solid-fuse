diff --git a/examples/perf_bench/tools/r12-core.py b/examples/perf_bench/tools/r12-core.py
new file mode 100644
index 0000000..e1b92d1
--- /dev/null
+++ b/examples/perf_bench/tools/r12-core.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Report 12 tables: pools the `core` runs of each variant over all passes.
+
+    python3 tools/r12-core.py results/r12 base roots block props none roots-nospec
+
+Reads results/r12/core-<variant>-<pass>.txt. Cells are median (min-max) in ms
+over all timing reps of all passes; ops and bytes come from the detail pass.
+"""
+import glob, sys, os
+from statistics import median
+sys.path.insert(0, os.path.dirname(__file__))
+from agg11 import load, ui, ORDER  # noqa
+
+def fmt(v):
+    if not v:
+        return "–"
+    m = median(v)
+    nd = 0 if m >= 100 else (1 if m >= 10 else 2)
+    return f"{m:.{nd}f} ({min(v):.{nd}f}–{max(v):.{nd}f})"
+
+def main():
+    d, variants = sys.argv[1], sys.argv[2:]
+    pooled, meta = {}, {}
+    for v in variants:
+        recs, checks, loads, n = {}, [0, 0], [], 0
+        for p in sorted(glob.glob(f"{d}/core-{v}-?.txt")):
+            r, c, l = load(p)
+            n += 1
+            for k, rs in r.items():
+                recs.setdefault(k, []).extend(rs)
+            checks[0] += c[0]; checks[1] += c[1]; loads += l
+        pooled[v] = recs
+        meta[v] = (n, checks, loads)
+    cols = [("JS task", lambda r: r.get("jsMs")), ("decode", lambda r: r.get("decodeMs")),
+            ("apply", lambda r: r.get("applyMs")), ("frame", lambda r: r.get("uiFrameMs")),
+            ("UI thread (decode+apply+frame)", ui), ("end to end", lambda r: r.get("e2eMs"))]
+    for title, fn in cols:
+        print(f"**{title}, ms: median (min–max)**\n")
+        print("| Operation | " + " | ".join(variants) + " |")
+        print("|---|" + "---:|" * len(variants))
+        for name in ORDER:
+            cells = []
+            for v in variants:
+                vals = [fn(r) for r in pooled[v].get(name, []) if not r.get("detail")]
+                cells.append(fmt([x for x in vals if isinstance(x, (int, float))]))
+            print(f"| {name} | " + " | ".join(cells) + " |")
+        print()
+    print("**ops / bytes per operation (detail pass)**\n")
+    print("| Operation | " + " | ".join(variants) + " |")
+    print("|---|" + "---:|" * len(variants))
+    for name in ORDER:
+        cells = []
+        for v in variants:
+            det = [r for r in pooled[v].get(name, []) if r.get("detail")]
+            cells.append(f"{det[0].get('ops')} / {det[0].get('bytes')}" if det else "–")
+        print(f"| {name} | " + " | ".join(cells) + " |")
+    print()
+    print("| | " + " | ".join(variants) + " |")
+    print("|---|" + "---:|" * len(variants))
+    print("| passes x reps | " + " | ".join(f"{meta[v][0]} x 7" for v in variants) + " |")
+    print("| load avg | " + " | ".join(f"{min(meta[v][2]):.2f}–{max(meta[v][2]):.2f}" for v in variants) + " |")
+    print("| order checks | " + " | ".join(f"{meta[v][1][0]}/{meta[v][1][1]}" for v in variants) + " |")
+
+main()
diff --git a/packages/docs/content/docs/architecture.mdx b/packages/docs/content/docs/architecture.mdx
index 2e33044..d4d20bf 100644
--- a/packages/docs/content/docs/architecture.mdx
+++ b/packages/docs/content/docs/architecture.mdx
@@ -13,6 +13,8 @@ Components create a virtual tree of nodes using `@solidjs/universal` (the same r
 
 The batch crosses to Dart through FJS's Rust bridge as a single FFI call: the journal is one flat array (an opcode followed by its operands, op after op), sent as one JSON string and decoded once in Dart. Props set on a node before the batch leaves JS travel inside the node's `create` op. `FuseRuntime` applies the ops, and each node is a `ChangeNotifier`. Every node is rendered by one Flutter element that listens to its node and rebuilds when the node's props or children change — no custom diffing or reconciler needed.
 
+With the experimental `templates` build option, a JSX block of native elements is compiled to a template. The first use sends the template's shape once (a `tpl` op: nested element types, constant props and static text); each instance is then one `inst` op with the template id, the id of the root node and the dynamic values. Dart creates the whole subtree from the stored shape and gives the nodes consecutive ids starting at the root id, so later updates address a node inside an instance with the ordinary `setProp` / `setText` ops. A reloaded bundle sends its templates again.
+
 Events flow back the same way. A `GestureDetector` fires, Dart calls into JS with the node ID and event name, the signal updates, new ops flush to Dart. The whole loop runs automatically.
 
 ```
