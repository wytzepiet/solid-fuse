+++ b/packages/solid-fuse/cli/template-plugin.test.ts
@@ -0,0 +1,609 @@
+// The template compiler (cli/template-plugin.ts) and its runtime half
+// (src/renderer.ts `_tpl` / `_inst`).
+//
+// Run with `bun test --conditions browser cli/template-plugin.test.ts`.
+//
+// Two kinds of test:
+//   1. compile: JSX in, generated code out;
+//   2. differential: each sample is compiled twice, by the Solid transform
+//      alone and with templates, both are mounted and driven through the same
+//      signal changes, and the trees the ops build must be equal after every
+//      step. The tree is built by a JS model of `FuseRuntime.applyOps`.
+import { afterAll, beforeAll, describe, expect, test } from "bun:test";
+import { createRequire } from "module";
+import { mkdirSync, rmSync, writeFileSync } from "fs";
+import { join } from "path";
+import { fuseInlineWrappersPlugin } from "./inline-wrappers-plugin";
+import { emptyTemplateStats, fuseTemplatePlugin, type TemplateOptions } from "./template-plugin";
+
+const viaSolidPlugin = createRequire(createRequire(import.meta.url).resolve("vite-plugin-solid"));
+const babel = viaSolidPlugin("@babel/core");
+const solidPreset = viaSolidPlugin.resolve("babel-preset-solid");
+
+function compile(code: string, templates: TemplateOptions | false = {}): string {
+  return babel.transformSync(code, {
+    babelrc: false,
+    configFile: false,
+    filename: "app.jsx",
+    presets: [[solidPreset, { generate: "universal", moduleName: "solid-fuse" }]],
+    plugins: [fuseInlineWrappersPlugin, ...(templates ? [[fuseTemplatePlugin, templates]] : [])],
+  }).code;
+}
+
+/** The template declarations of a compiled module: [shape, size, rootType, holes, once] each. */
+function templatesOf(out: string): any[][] {
+  const found: any[][] = [];
+  const re = /_tpl\((".*?[^\\]")(, [^\n]*?)?\)(?:,|;)\n/g;
+  for (let m; (m = re.exec(out)); ) found.push(JSON.parse(`[${m[1]}${m[2] ?? ""}]`).map((v: any, i: number) => (i === 0 ? JSON.parse(v) : v)));
+  return found;
+}
+
+describe("template plugin: output", () => {
