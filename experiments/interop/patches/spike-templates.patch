+  return {
+    name: "fuse-templates",
+    visitor: {
+      Program: {
+        enter(program: any) {
+          const decls: any[] = [];
+          const byKey = new Map<string, any>();
+          const imports = new Map<string, any>();
+          const helper = (name: string) => {
+            let id = imports.get(name);
+            if (!id) imports.set(name, (id = program.scope.generateUidIdentifier(name.replace(/^_/, ""))));
+            return t.cloneNode(id);
+          };
+
+          // --- one block ---------------------------------------------------
+
+          interface Block { n: number; holes: Hole[]; refs: { off: number; path: any }[] }
+
+          function walkElement(path: any, b: Block): any[] {
+            const node = path.node;
+            const scope = path.scope;
+            const off = b.n++;
+            const props: Record<string, any> = {};
+            let propCount = 0;
+            const propHoles: any[] = [];
+            for (const attr of path.get("openingElement").get("attributes")) {
+              const name: string = attr.node.name.name;
+              const value = attr.node.value;
+              if (name === "ref" && value && value.type === "JSXExpressionContainer") {
+                b.refs.push({ off, path: attr.get("value").get("expression") });
+                continue;
+              }
+              if (value === null || value === undefined) {
+                props[name] = true;
+                propCount++;
+                continue;
+              }
+              if (value.type === "StringLiteral") {
+                props[name] = value.value;
+                propCount++;
+                continue;
+              }
+              const expr = value.type === "JSXExpressionContainer" ? value.expression : value;
+              const c = constOf(expr);
+              if (c.ok) {
+                props[name] = c.value;
+                propCount++;
+                continue;
+              }
+              const hole = new Hole(H_PROP, off, name, 0, expr, isDyn(expr, scope));
+              b.holes.push(hole);
+              propHoles.push(name, hole);
+            }
+
+            // Children: constant text and templatable elements become template
+            // nodes, everything else a hole.
+            const kids = filterChildren(path.get("children"));
+            const multi = isMulti(kids);
+            // item: { off } for a template node, { hole } for a hole
+            const items: { off?: number; hole?: Hole; shape: any }[] = [];
+            const pushText = (text: string) => {
+              const last = items[items.length - 1];
+              if (last && typeof last.shape === "string") last.shape += text;
+              else items.push({ off: b.n++, shape: text });
