+const sent: any[] = [];
+(globalThis as any).__fuseHost = { mode: "release", platform: "linux", brightness: "light" };
+(globalThis as any).fjs = { bridge_call: (msg: any) => (sent.push(msg), Promise.resolve(null)) };
