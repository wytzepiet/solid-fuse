+/** A model of `FuseRuntime.applyOps` (dart/lib/src/runtime.dart): builds the tree the ops describe. */
+class Model {
+  nodes = new Map<number, any>();
+  tpls = new Map<number, any>();
+  opCount = 0;
+  bytes = 0;
+  constructor() {
+    this.nodes.set(0, { id: 0, type: "root", props: {}, children: [], parent: null });
+  }
+  get(id: number) {
+    const n = this.nodes.get(id);
+    if (!n) throw new Error("no node " + id);
+    return n;
+  }
+  resolve(v: any): any {
+    if (Array.isArray(v)) return v.map((e) => (e && typeof e === "object" && "_node" in e ? this.get(e._node) : e));
+    if (v && typeof v === "object" && "_node" in v) return this.get(v._node);
+    return v;
+  }
+  removeSubtree(n: any) {
+    for (const c of n.children) this.removeSubtree(c);
+    this.nodes.delete(n.id);
+  }
+  instantiate(shape: any, values: any[] | 0, ids: { next: number }): any {
+    const id = ids.next++;
+    if (typeof shape === "string" || typeof shape === "number") {
+      const text = typeof shape === "number" ? (values ? values[shape] : null) : shape;
+      if (text == null) return null;
+      const n = { id, type: "__text__", props: { text }, children: [], parent: null };
+      this.nodes.set(id, n);
+      return n;
+    }
+    const props: any = { ...(shape[1] || {}) };
+    const holes = shape[2] || [];
+    for (let i = 0; i < holes.length; i += 2) if (values && holes[i + 1] < values.length) props[holes[i]] = this.resolve(values[holes[i + 1]]);
+    const n: any = { id, type: shape[0], props, children: [], parent: null };
+    this.nodes.set(id, n);
+    for (const c of shape[3] || []) {
+      const child = this.instantiate(c, values, ids);
+      if (child) { n.children.push(child); child.parent = n; }
+    }
+    return n;
+  }
+  apply(ops: any[]) {
+    const removed = new Set<any>();
+    for (let i = 0; i < ops.length; ) {
+      this.opCount++;
+      switch (ops[i]) {
+        case 0: this.nodes.set(ops[i + 1], { id: ops[i + 1], type: ops[i + 2], props: { ...ops[i + 3] }, children: [], parent: null }); i += 4; break;
+        case 1: this.nodes.set(ops[i + 1], { id: ops[i + 1], type: "__text__", props: { text: ops[i + 2] }, children: [], parent: null }); i += 3; break;
+        case 2: this.get(ops[i + 1]).props[ops[i + 2]] = this.resolve(ops[i + 3]); i += 4; break;
+        case 3: this.get(ops[i + 1]).props.text = ops[i + 2]; i += 3; break;
+        case 4: {
+          const parent = this.get(ops[i + 1]), child = this.get(ops[i + 2]);
+          removed.delete(child);
+          if (child.parent) child.parent.children.splice(child.parent.children.indexOf(child), 1);
+          parent.children.splice(Math.min(ops[i + 3], parent.children.length), 0, child);
+          child.parent = parent;
+          i += 4;
+          break;
+        }
+        case 5: {
+          const parent = this.get(ops[i + 1]), child = this.get(ops[i + 2]);
+          parent.children.splice(parent.children.indexOf(child), 1);
+          child.parent = null;
+          removed.add(child);
+          i += 3;
+          break;
+        }
+        case 6: { const n = this.nodes.get(ops[i + 1]); if (n) this.removeSubtree(n); i += 2; break; }
+        case 9: this.tpls.set(ops[i + 1], JSON.parse(ops[i + 2])); i += 3; break;
+        case 10: this.instantiate(this.tpls.get(ops[i + 1]), ops[i + 3], { next: ops[i + 2] }); i += 5; break;
+        default: throw new Error("unknown opcode " + ops[i]);
+      }
+    }
+    for (const n of removed) this.removeSubtree(n);
+  }
+  /** The tree under the root without ids: [type, props, children] / text. */
+  snapshot(n: any = this.get(0)): any {
+    if (n.type === "__text__") return String(n.props.text);
+    const props: any = {};
+    for (const k of Object.keys(n.props).sort()) {
+      const v = n.props[k];
+      if (v === undefined) continue;
+      props[k] = v && typeof v === "object" && "children" in v && "type" in v ? this.snapshot(v)
+        : Array.isArray(v) ? v.map((e) => (e && typeof e === "object" && "children" in e && "type" in e ? this.snapshot(e) : e))
+          : v;
+    }
+    return [n.type, props, n.children.map((c: any) => this.snapshot(c))];
+  }
+}
+
+function drain(model: Model) {
+  R.flushOps();
+  for (const m of sent) {
+    if (m.channel !== "_ops") continue;
+    if (m.json !== undefined) model.bytes += m.json.length;
+    model.apply(m.json !== undefined ? JSON.parse(m.json) : m.ops);
+  }
+  sent.length = 0;
+}
