+#!/usr/bin/env bash
+# Builds the perf_bench bundle once per template setting (report 12) into
+# $BUNDLES/<name>.js, and leaves the default (templates off) bundle in place.
+#   BUNDLES=/path tools/r12-bundles.sh
+set -euo pipefail
+cd "$(dirname "$0")/.."
+out=${BUNDLES:?set BUNDLES}
+mkdir -p "$out"
+build() { # name, FUSE_TEMPLATES value
+  FUSE_TEMPLATES=$2 FUSE_TEMPLATE_STATS=$out/$1.stats.json bun fuse build --js-only 2>&1 | grep -E "bundle.js|\[fuse\] templates" || true
+  cp dart/assets/js/bundle.js "$out/$1.js"
+}
+build base 0
+build roots 1                       # the default: effects grouped by common root, pure calls, static-props copies
+build block group=block
+build props group=props
+build none group=none
+build roots-nospec specialize=0     # no static-props copies
+build roots-plain pure=0,specialize=0   # templates only
+build base 0
+ls -l "$out"/*.js
