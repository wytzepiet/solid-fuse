+// Babel plugin: compile blocks of intrinsic JSX elements to templates.
+//
+// vite-plugin-solid's universal output creates every element, sets every prop
+// and inserts every child with a runtime call, and wraps every dynamic text in
+// its own `insert` effect. Solid's DOM output avoids most of that by hoisting
+// the static shape of a JSX block into a template that is cloned. This plugin
+// does the same for solid-fuse: for each block of intrinsic elements (a JSX
+// element with a lower-case tag and everything below it that is not a
+// component or an expression)
+//
+//   - the shape (element types, constant props, constant text, structure)
+//     becomes a module-level `_tpl(...)` constant, sent to Dart once;
+//   - the block itself becomes one `_inst(template, onceValues, () => dynamicValues)`
+//     call, which mounts the whole block with ONE op.
+//
+// Everything that is not constant is a "hole": a prop value, a text, or a
+// child (a component, `<For>`, `<Show>`, any expression). Which holes are
+// reactive is decided with the same rule the Solid compiler uses (an
+// expression that contains a call or a property access is reactive; `/*@static*/`
+// opts out), so user code keeps Solid's semantics. See src/renderer.ts for the
+// runtime half and the wire format.
+//
+// It runs before the Solid JSX transform, in the same Babel pass (like
+// inline-wrappers-plugin.ts, which must come first so `<View>` is already
+// `<view>`). JSX it does not take is left for the Solid transform:
+// components, fragments, and intrinsic elements it cannot handle (a spread
+// attribute, a namespaced attribute, `children=`), which keep the old output.
+//
+// Two optional analyses make more holes "evaluated once" (no effect):
+//   pure:        calls of side-effect-free globals with static arguments
+//                (`String.fromCharCode(65 + i)`), and reads of module-level
+//                `const` array/object literals (`COLORS[i % 8]`).
+//   specialize:  a component declared in the same module and used with props
+//                that are all static (`<Card i={i} />`) is called through a
+//                copy in which reads of its props count as static.
+
+export interface TemplateStats {
+  /** Files that contained at least one template. */
+  files: number;
+  /** JSX blocks compiled to a template instantiation. */
+  blocks: number;
+  /** Distinct templates emitted (blocks of the same shape in a module share one). */
+  templates: number;
+  /** Template nodes (elements and text leaves) over all templates. */
+  nodes: number;
+  /** Blocks with no hole at all. */
+  constant: number;
+  /** Blocks with holes, none of them reactive. */
+  onceOnly: number;
+  /** Blocks with at least one reactive hole. */
+  reactive: number;
+  holesOnce: number;
+  holesReactive: number;
+  /** Conditional / logical child expressions handed to the Solid transform (wrapped in a fragment). */
+  delegated: number;
+  /** Intrinsic elements left to the Solid transform, by reason. */
+  fallback: Record<string, number>;
+  /** Component call sites redirected to a static-props copy, and copies made. */
+  specializedSites: number;
+  specializedCopies: number;
+}
+
+export function emptyTemplateStats(): TemplateStats {
+  return {
+    files: 0, blocks: 0, templates: 0, nodes: 0, constant: 0, onceOnly: 0, reactive: 0, holesOnce: 0, holesReactive: 0,
+    delegated: 0, fallback: {}, specializedSites: 0, specializedCopies: 0,
+  };
+}
+
+export interface TemplateOptions {
+  /** Module the runtime helpers are imported from. Default "solid-fuse". */
+  moduleName?: string;
+  /** One effect per instance for all its reactive holes (default) instead of one per hole. */
+  group?: boolean;
+  /** Treat pure global calls and module-level const tables as static. Default true. */
+  pure?: boolean;
+  /** Static-props copies of components used with static props in the same module. Default true. */
+  specialize?: boolean;
+  /** Counters, added to across files. */
+  stats?: TemplateStats;
+}
+
+/** The comment that marks an expression as not reactive (the Solid 2 compiler's `staticMarker`). */
+const STATIC_MARKER = "@static";
+
+const H_PROP = 0, H_TEXT = 1, H_CHILD = 2, H_NODE = 3;
+const M_APPEND = -1, M_SINGLE = -2;
+
+const PURE_GLOBAL_CALLS = new Set(["String", "Number", "Boolean", "parseInt", "parseFloat", "isNaN", "isFinite"]);
+const PURE_NAMESPACES: Record<string, Set<string> | true> = {
+  Math: true,
+  Number: true,
+  String: new Set(["fromCharCode", "fromCodePoint"]),
+};
+
+class Hole {
+  index = -1;
+  constructor(
+    public kind: number,
+    public a: number,
+    public b: any,
+    public c: number,
+    public expr: any,
+    public dyn: boolean,
+  ) {}
+}
+
+export function fuseTemplatePlugin(babel: any, options: TemplateOptions = {}): any {
+  const t = babel.types;
+  const moduleName = options.moduleName ?? "solid-fuse";
+  const group = options.group !== false;
+  const pure = options.pure !== false;
+  const specialize = options.specialize !== false;
+  const stats = options.stats ?? emptyTemplateStats();
+
+  /** Tag of an intrinsic element, or undefined for a component. */
+  function intrinsicTag(node: any): string | undefined {
+    const name = node.openingElement.name;
+    if (name.type !== "JSXIdentifier") return undefined;
+    const c = name.name.charCodeAt(0);
+    // Same rule as the Solid compiler: lower-case first letter and no dot.
+    return c >= 97 && c <= 122 ? name.name : undefined;
+  }
+
+  /** Why an intrinsic element cannot be a template node, or undefined if it can. */
+  function cannotTemplate(node: any): string | undefined {
+    for (const attr of node.openingElement.attributes) {
+      if (attr.type === "JSXSpreadAttribute") return "spread";
+      if (attr.name.type === "JSXNamespacedName") return "namespaced attribute";
+      if (attr.name.name === "children") return "children attribute";
+    }
+    for (const child of node.children) if (child.type === "JSXSpreadChild") return "spread child";
+    return undefined;
+  }
+
+  function hasStaticMarker(node: any): boolean {
+    const c = node.leadingComments;
+    return !!(c && c[0] && c[0].value.trim() === STATIC_MARKER);
+  }
+
+  /** A compile-time constant that JSON can carry: `{ ok, value }`. */
+  function constOf(node: any): { ok: boolean; value?: any } {
+    switch (node.type) {
+      case "StringLiteral":
+      case "BooleanLiteral":
+        return { ok: true, value: node.value };
+      case "NumericLiteral":
+        return { ok: Number.isFinite(node.value), value: node.value };
+      case "NullLiteral":
+        return { ok: true, value: null };
+      case "TemplateLiteral":
+        return node.expressions.length === 0 ? { ok: true, value: node.quasis[0].value.cooked } : { ok: false };
+      case "UnaryExpression": {
+        if (node.operator !== "-" && node.operator !== "+") return { ok: false };
+        const arg = constOf(node.argument);
+        if (!arg.ok || typeof arg.value !== "number") return { ok: false };
+        return { ok: true, value: node.operator === "-" ? -arg.value : arg.value };
+      }
+      case "ParenthesizedExpression":
+      case "TSAsExpression":
+      case "TSSatisfiesExpression":
+      case "TSNonNullExpression":
+        return constOf(node.expression);
+      case "ArrayExpression": {
+        const out: any[] = [];
+        for (const el of node.elements) {
+          if (!el || el.type === "SpreadElement") return { ok: false };
+          const v = constOf(el);
+          if (!v.ok) return { ok: false };
+          out.push(v.value);
+        }
+        return { ok: true, value: out };
+      }
+      case "ObjectExpression": {
+        const out: Record<string, any> = {};
+        for (const p of node.properties) {
+          if (p.type !== "ObjectProperty" || p.computed) return { ok: false };
+          const key = p.key.type === "Identifier" ? p.key.name : p.key.type === "StringLiteral" ? p.key.value : undefined;
+          if (key === undefined || key === "__proto__" || key === "_node") return { ok: false };
+          const v = constOf(p.value);
+          if (!v.ok) return { ok: false };
+          out[key] = v.value;
+        }
+        return { ok: true, value: out };
+      }
+    }
+    return { ok: false };
+  }
+
+  // Functions whose single parameter (the props object) is known to hold only
+  // plain data properties: the static-props copies made by `specialize`.
+  const staticPropsFns = new WeakSet<object>();
+
+  /** An array or object literal with no getters, methods or spreads. */
+  function plainLiteral(node: any): boolean {
+    if (!node) return false;
+    if (node.type === "ArrayExpression") return node.elements.every((e: any) => e && e.type !== "SpreadElement");
+    if (node.type === "ObjectExpression") return node.properties.every((p: any) => p.type === "ObjectProperty" && !p.computed);
+    return false;
+  }
+
+  /** A property read that cannot be reactive (the object is known to be plain data). */
+  function staticMember(node: any, scope: any): boolean {
+    const object = node.object;
+    if (object.type !== "Identifier") return false;
+    const binding = scope.getBinding(object.name);
+    if (!binding) return pure && PURE_NAMESPACES[object.name] === true && !node.computed;
+    if (binding.path.isImportNamespaceSpecifier()) return true; // the Solid compiler's rule
+    if (binding.constantViolations.length > 0) return false;
+    if (binding.kind === "param" && staticPropsFns.has(binding.scope.block) && binding.scope.block.params[0] === binding.identifier) {
+      return true;
+    }
+    if (pure && binding.kind === "const" && binding.scope.path.isProgram() && binding.path.isVariableDeclarator()) {
+      return plainLiteral(binding.path.node.init);
+    }
+    return false;
+  }
+
+  function pureCall(node: any, scope: any): boolean {
+    if (!pure) return false;
+    const callee = node.callee;
+    if (callee.type === "Identifier") return PURE_GLOBAL_CALLS.has(callee.name) && !scope.getBinding(callee.name);
+    if (callee.type === "MemberExpression" && !callee.computed && callee.object.type === "Identifier" && callee.property.type === "Identifier") {
+      const ns = PURE_NAMESPACES[callee.object.name];
+      if (!ns || scope.getBinding(callee.object.name)) return false;
+      return ns === true || ns.has(callee.property.name);
+    }
+    return false;
+  }
+
+  /**
+   * The Solid compiler's question: can this expression change after it was
+   * first evaluated? A call or a property access may read a signal; anything
+   * inside a nested function or nested JSX is not evaluated here.
+   */
+  function isDyn(node: any, scope: any): boolean {
+    if (!node) return false;
+    if (hasStaticMarker(node)) return false;
+    switch (node.type) {
+      case "StringLiteral": case "NumericLiteral": case "BooleanLiteral": case "NullLiteral": case "BigIntLiteral":
+      case "RegExpLiteral": case "Identifier": case "ThisExpression": case "Super":
+      case "JSXElement": case "JSXFragment":
+      case "FunctionExpression": case "ArrowFunctionExpression": case "ClassExpression":
+        return false;
+      case "TemplateLiteral":
+        return node.expressions.some((e: any) => isDyn(e, scope));
+      case "BinaryExpression":
+        return node.operator === "in" || isDyn(node.left, scope) || isDyn(node.right, scope);
+      case "LogicalExpression":
+        return isDyn(node.left, scope) || isDyn(node.right, scope);
+      case "UnaryExpression": case "UpdateExpression": case "AwaitExpression": case "YieldExpression":
+        return isDyn(node.argument, scope);
+      case "ParenthesizedExpression": case "TSAsExpression": case "TSSatisfiesExpression": case "TSNonNullExpression":
+      case "TypeCastExpression":
+        return isDyn(node.expression, scope);
+      case "ConditionalExpression":
+        return isDyn(node.test, scope) || isDyn(node.consequent, scope) || isDyn(node.alternate, scope);
+      case "SequenceExpression":
+        return node.expressions.some((e: any) => isDyn(e, scope));
+      case "ArrayExpression":
+        return node.elements.some((e: any) => e && (e.type === "SpreadElement" || isDyn(e, scope)));
+      case "ObjectExpression":
+        return node.properties.some((p: any) =>
+          p.type === "SpreadElement" ? true
+            : p.type === "ObjectMethod" ? p.computed && isDyn(p.key, scope)
+              : (p.computed && isDyn(p.key, scope)) || isDyn(p.value, scope));
+      case "AssignmentExpression":
+        return node.left.type !== "Identifier" || isDyn(node.right, scope);
+      case "NewExpression":
+        return isDyn(node.callee, scope) || node.arguments.some((a: any) => a.type === "SpreadElement" || isDyn(a, scope));
+      case "MemberExpression":
+      case "OptionalMemberExpression":
+        return staticMember(node, scope) ? node.computed && isDyn(node.property, scope) : true;
+      case "CallExpression":
+        return pureCall(node, scope) ? node.arguments.some((a: any) => a.type === "SpreadElement" || isDyn(a, scope)) : true;
+    }
+    return true;
+  }
+
+  /** True if the expression can only evaluate to a string. */
+  function provesString(node: any, scope: any): boolean {
+    switch (node.type) {
+      case "StringLiteral":
+      case "TemplateLiteral":
+        return true;
+      case "BinaryExpression":
+        return node.operator === "+" && (provesString(node.left, scope) || provesString(node.right, scope));
+      case "ConditionalExpression":
+        return provesString(node.consequent, scope) && provesString(node.alternate, scope);
+      case "ParenthesizedExpression": case "TSAsExpression": case "TSSatisfiesExpression": case "TSNonNullExpression":
+        return provesString(node.expression, scope);
+      case "CallExpression": {
+        const c = node.callee;
+        if (c.type === "Identifier") return c.name === "String" && !scope.getBinding("String");
+        return c.type === "MemberExpression" && !c.computed && c.object.type === "Identifier" && c.object.name === "String"
+          && c.property.type === "Identifier" && c.property.name === "fromCharCode" && !scope.getBinding("String");
+      }
+    }
+    return false;
+  }
