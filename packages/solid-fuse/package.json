{
  "name": "solid-fuse",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./generated": {
      "import": "./dist/generated.js",
      "types": "./dist/generated.d.ts"
    },
    "./cli/create": {
      "import": "./dist/cli/create.js"
    }
  },
  "sideEffects": true,
  "bin": {
    "fuse": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "dart",
    "cli",
    "gen/bin",
    "gen/lib",
    "gen/pubspec.yaml",
    "gen/README.md",
    "templates",
    "fuse.config.ts"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cli.config.ts && tsc -p tsconfig.build.json && bun scripts/post-build.ts",
    "sync-solid-docs": "bun scripts/sync-solid-docs.ts",
    "test": "bun test --conditions browser"
  },
  "peerDependencies": {
    "solid-js": "^2.0.3"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solidjs/universal": "^2.0.3",
    "@solidjs/vite-plugin": "^3.0.1",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "magic-string": "^0.30.21",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
