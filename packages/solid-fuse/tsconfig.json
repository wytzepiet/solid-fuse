{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "#fuse/*": ["../../examples/demo/fuse/*"],
      "solid-fuse": ["./src/index.ts"],
      "solid-fuse/generated": ["./src/generated.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
